+            if (snapshot.IsRealMultiplayer && !profile.AllowRealMultiplayer)
+            {
+                reason = "feature-not-approved-for-real-multiplayer";
+                return false;
+            }
+
+            reason = "feature-context-allowed";
+            return true;
+        }
