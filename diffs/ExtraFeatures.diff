-                    viewModel,
-                    property,
-                    packet,
-                    ClonePendingValue(value),
-                    senderSteamId,
-                    CurrentLobbyId());
-                if (existing >= 0)
-                    pending[existing] = update;
-                else
-                    pending.Add(update);
