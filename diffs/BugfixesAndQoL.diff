+            int minY = Math.Max(0, bounds.MinY - 2);
+            int maxY = Math.Min(MapWidth - 1, bounds.MaxY + 2);
+            for (int y = minY; y <= maxY; y++) for (int x = minX; x <= maxX; x++)
