+                (IsCompletedMoat(endTile) && !IsEndpointRelationshipAllowed(GetMoatRelationship(playerId, endTile), traversalPolicy)))
+            { summary = WeightedMoatRouteSummary.Failed("enemy-or-invalid-moat-endpoint", 0); return false; }
