+      ]
+    },
+    {
+      "Version": "1.0.128",
+      "Changes": [
+        "Added an enabled-by-default host fix that makes newly recruited AI defenders refill the configured wall-defense count before adding further units to the outer patrol; existing assignments remain unchanged."
+      ]
+    },
+    {
+      "Version": "1.0.127",
+      "Changes": [
+        "Added an enabled-by-default host fix that restores AIV defender positions for Pikemen, European Swordsmen, and Arabian Swordsmen that Vanilla incorrectly ignores."
+      ]
+    },
+    {
+      "Version": "1.0.126",
+      "Changes": [
+        "Added an enabled-by-default host fix that makes units filling hostile moats choose another free valid edge tile or the next Vanilla moat instead of becoming idle when the first position is occupied."
+      ]
+    },
+    {
+      "Version": "1.0.125",
+      "Changes": [
+        "Added an enabled-by-default local fix that immediately removes disbanded units from control groups, preventing their peasants or later recruits from inheriting stale group membership.",
+        "Finalized immediate Vanilla-style control-group updates for sole-Lord selections."
+      ]
+    },
+    {
+      "Version": "1.0.123",
+      "Changes": [
+        "Integrated the controlled Lord into the full troop HUD and Vanilla control groups, including its icon, health, selection controls, and safe mixed-unit disband behavior."
+      ]
+    },
+    {
+      "Version": "1.0.122",
+      "Changes": [
+        "Added a default-enabled per-player option that centers the camera on a selected unit when its troop-type icon is middle-clicked in the troop HUD."
+      ]
+    },
+    {
+      "Version": "1.0.121",
+      "Changes": [
+        "Added a default-enabled host fix that keeps Bedouin Healers stationary when mixed troop groups are ordered to attack an enemy unit."
+      ]
+    },
+    {
+      "Version": "1.0.120",
+      "Changes": [
+        "Added a default-enabled host setting that repairs the selected building first and then attempts every other owned repairable building when Shift-clicking the Repair button."
+      ]
+    },
+    {
+      "Version": "1.0.119",
+      "Changes": [
+        "Added a default-enabled host fix that lets Knights, Horse Archers, Bedouin Camel Lancers, and Heavy Camels receive and execute movement commands onto passable stockpile tiles."
+      ]
+    },
+    {
+      "Version": "1.0.118",
+      "Changes": [
+        "Moved single-building pause, fast recruit rally movement, reachable-enemy gate closing, quarry-pile controls, and AI economy protection from Extra Features into this mod."
