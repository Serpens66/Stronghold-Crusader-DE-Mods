-            catch (Exception ex)
-            {
-                LogFailureOnce("controller-state", ex);
-                return "unavailable";
-            }
-        }
-
-        private static bool ReadBoolean(FieldInfo field, object instance)
-        {
-            try
-            {
-                return field != null && field.GetValue(instance) is bool value && value;
-            }
-            catch
-            {
-                return false;
-            }
-        }
