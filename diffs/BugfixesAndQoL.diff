@@ -0,0 +1,55 @@
+<?xml version="1.0" encoding="utf-8"?>
+<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+       xmlns:local="clr-namespace:CrusaderDE">
+  <Operation Type="Add" XPath="//n:Grid[@Name='WorkerPanel']">
+    <Content>
+      <Grid x:Name="BugfixesAndQoLQuarryPileRelocationButtonHost"
+            Width="36"
+            Height="35"
+            Margin="0,38,296,0"
+            HorizontalAlignment="Right"
+            VerticalAlignment="Top"
+            Visibility="{Binding ButtonVisibility}">
+        <Button x:Name="BugfixesAndQoLQuarryPileRelocationButton"
+                Width="36"
+                Height="35"
+                Margin="0"
+                local:PropEx.Sprite1="{StaticResource UI-Buttons L020}"
+                local:PropEx.Sprite2="{StaticResource UI-Buttons L021}"
+                local:PropEx.Sprite3="{StaticResource UI-Buttons L021}"
+                local:PropEx.Sprite4="{StaticResource UI-Buttons L021}"
+                Command="{Binding RelocateCommand}"
+                Content=""
+                Style="{StaticResource BTN_Image}" />
+      </Grid>
+    </Content>
+  </Operation>
+  <Operation Type="Add" XPath="//n:Grid[@Name='WorkerPanel']">
+    <Content>
+      <TextBlock x:Name="BugfixesAndQoLQuarryPileRelocationTooltipHost"
+                 Padding="4,2,4,0"
+                 Margin="140,-400,0,127"
+                 HorizontalAlignment="Left"
+                 VerticalAlignment="Bottom"
+                 Panel.ZIndex="1"
+                 FontSize="16"
+                 FontWeight="Normal"
+                 MaxWidth="380"
+                 TextWrapping="Wrap"
+                 Foreground="#FFDDDDDD"
+                 Background="#55000000"
+                 FlowDirection="{Binding GlobalTextFlowAL2R}"
+                 IsHitTestVisible="False"
+                 Tag="Ignore"
+                 Text=""
+                 Visibility="Hidden">
+        <TextBlock.Effect>
+          <DropShadowEffect ShadowDepth="2"
+                            Direction="315"
+                            Color="#CC000000"
+                            BlurRadius="0" />
+        </TextBlock.Effect>
+      </TextBlock>
+    </Content>
