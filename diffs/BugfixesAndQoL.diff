+        private bool IsCompletedEnemyMoatForPlayer(int playerId, int tileId) =>
+            IsValidTileId(tileId) && IsCompletedMoatTile(tileId) &&
+            ResolveCompletedMoatRelationship(playerId, tileId) ==
+                CompletedMoatRelationship.Enemy;
