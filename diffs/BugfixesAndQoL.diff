+            if (unit == null || unit->r_AttackMoveToTargetTileX < 0 ||
+                unit->r_AttackMoveToTargetTileX >= MapWidth ||
+                unit->r_AttackMoveToTargetTileY < 0 ||
+                unit->r_AttackMoveToTargetTileY >= MapWidth)
