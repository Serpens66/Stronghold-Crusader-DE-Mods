diff --git a/BugfixesAndQoL/BepInEx/plugins/BugfixesAndQoL_Serp/Patches/Assets/GUI/XAMLResources/HUD_Buildings.xaml b/BugfixesAndQoL/BepInEx/plugins/BugfixesAndQoL_Serp/Patches/Assets/GUI/XAMLResources/HUD_Buildings.xaml
