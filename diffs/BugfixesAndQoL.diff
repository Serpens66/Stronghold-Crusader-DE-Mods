+        private bool TryGetPclAt(int x, int y, out int pcl)
+        {
+            pcl = 0;
+            GameTileManagerAPI tiles = GameTileManagerAPI.Instance;
+            return tiles.IsTileInsideMapBounds(x, y) &&
+                TryGetPclByTileId(tiles.GetTileId(x, y), out pcl, "coordinate");
