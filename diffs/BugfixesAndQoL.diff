+                    int sourceCost = sourceCosts[node];
+                    if (sourceCost == int.MaxValue || sourceCost > totalCost)
+                        continue;
+                    int suffixCost = Math.Max(0, totalCost - sourceCost);
+                    if (!field.ContainsKey(node))
