-                error = string.Empty;
-                return true;
-            }
-
-            private static bool IsCurrentHuman(ulong steamId)
-            {
-                Platform_Multiplayer platform = Platform_Multiplayer.Instance;
-                if (platform?.activeLobby?.members != null)
