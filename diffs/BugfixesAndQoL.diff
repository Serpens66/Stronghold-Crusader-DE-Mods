+                        {
+                            fallback = vanillaCompleted
+                                ? TryApplyBuildingConsumerFallback(
+                                    scope, tribeManager, vanillaCandidates, vanillaAfter)
+                                : BuildingConsumerFallbackResult.NotAttempted("vanilla-threw");
+                        }
+                        finally
+                        {
