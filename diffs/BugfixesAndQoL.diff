-        private int AllowFillMoatApproachThroughFriendlyMoat(
-            IntPtr tileManager, int sourceRegion, int moatTileId, int moatY)
-        {
-            int vanillaResult = originalHasFillMoatApproach(
-                tileManager, sourceRegion, moatTileId, moatY);
