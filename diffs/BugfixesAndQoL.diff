+                        $"unit={shadow.UnitId} aiState={shadow.AiState} " +
+                        $"type={shadow.UnitType} commandSeq={shadow.CommandSequence} " +
+                        $"command={shadow.Command} " +
+                        $"start=({shadow.StartX},{shadow.StartY}) " +
+                        $"target=({shadow.TargetX},{shadow.TargetY}) " +
