+                {
+                    if (bytes[i] != 0xE8)
+                        continue;
+                    int displacement = bytes[i + 1] | bytes[i + 2] << 8 |
+                        bytes[i + 3] << 16 | bytes[i + 4] << 24;
+                    if (startRva + i + 5 + displacement == targetRva)
+                        count++;
+                }
+                return count;
+            }
+
+            private int RvaToOffset(int rva)
+            {
