+        private static void ValidateSize(Type type, int expected)
+        {
+            int actual = Marshal.SizeOf(type);
+            if (actual != expected)
+                throw new InvalidOperationException($"managed layout mismatch: sizeof({type.Name})=0x{actual:X}, expected=0x{expected:X}");
+        }
