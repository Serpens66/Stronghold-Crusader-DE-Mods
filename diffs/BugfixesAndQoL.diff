+        @('CrusaderDE.MainViewModel', 'Show_HUD_Confirmation'),
+        @('CrusaderDE.MainViewModel', 'Show_HUD_ConfirmationMP'),
+        @('MapFileManager', 'Instance'),
+        @('CrusaderDE.FileRow', 'Text1'))) {
