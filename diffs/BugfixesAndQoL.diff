+            ScanRegion region,
+            ReadOnlySpan<byte> memory,
+            ulong libraryBase,
+            bool referenceHashMatches)
+        {
+            this.log = log ?? throw new ArgumentNullException(nameof(log));
+            if (!referenceHashMatches)
+            {
