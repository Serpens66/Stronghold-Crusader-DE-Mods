+    if ([IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($fixture)) -cne $expectedParent) { throw 'Unsafe test cleanup path.' }
+    Remove-Item -LiteralPath $fixture -Recurse -Force
+}

