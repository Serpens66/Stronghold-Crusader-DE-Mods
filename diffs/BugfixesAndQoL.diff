+                        $"positiveBuilders={command?.PositiveBuilderCalls ?? 0} " +
+                        $"weightedUnits={command?.WeightedUnitIds.Count ?? 0} " +
+                        $"weightedDecisions={command?.WeightedDecisions ?? 0} " +
+                        $"weightedPublished={command?.WeightedPublished ?? 0} " +
