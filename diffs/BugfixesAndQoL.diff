-            if (scope == null || (!scope.ImprovedFillSelection && vanillaResult != 0) || scope.RelationshipMode != 2 ||
-                !scope.Matches(mapEpoch, tileManager) || moatY < 0 || moatY >= MapWidth)
-            {
-                return vanillaResult;
-            }
-
-            try
-            {
-                scope.FillFallbackEvaluations++;
