+                    if (relative < 0)
+                        break;
+                    offset += relative;
+                    if (!MatchesBytesAt(memory, offset, pattern))
+                    {
+                        offset++;
+                        continue;
+                    }
+                    match = offset;
+                    if (++count > 1)
+                        throw new InvalidOperationException($"{name} byte pattern matched more than once.");
