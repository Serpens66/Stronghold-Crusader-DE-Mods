+            }
+            return -1;
+        }
+
+        private static bool MatchesBytesAt(ReadOnlySpan<byte> memory, int offset, byte[] pattern)
+        {
+            if (offset < 0 || offset > memory.Length - pattern.Length)
+                return false;
+            for (int index = 0; index < pattern.Length; index++)
+            {
