-        private void RecordError(string message)
-        {
-            lock (errorSync)
-            {
-                if (seenErrors.Add(message)) pendingErrors.Enqueue(message);
-            }
-        }
-
-        private void FlushErrors()
-        {
-            lock (errorSync)
-            {
-                while (pendingErrors.Count > 0)
-                    NativeApiLog.Error(log, pendingErrors.Dequeue());
-            }
-        }
