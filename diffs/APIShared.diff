+            int count = 0;
+            int anchorIndex = pattern.Length - 1;
+            foreach (NativeCodeRange range in GetSearchRanges(memory, searchScope))
+            {
+                int end = range.Offset + range.Length - pattern.Length;
+                int offset = range.Offset;
+                while (offset <= end)
