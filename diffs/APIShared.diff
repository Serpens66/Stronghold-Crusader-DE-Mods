+        /// <summary>Checks the registered catalog for a filter match; returns true without a catalog to avoid incorrectly hiding unknown content.</summary>
+        public static bool HasMatches(
+            object viewModel,
+            string filterText,
+            bool includeToolTips,
+            string exactKey)
