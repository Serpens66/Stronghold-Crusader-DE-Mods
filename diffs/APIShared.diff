+            if (playersById.Count == 0)
+            {
+                error = "The active lobby contains no resolved human players.";
+                return false;
+            }
+            diagnostic = diagnostics.Count == 0
+                ? string.Empty
+                : "Lobby player-ID source differences: " + string.Join("; ", diagnostics) + ".";
+            error = string.Empty;
+            return true;
+        }
