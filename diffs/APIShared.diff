+        private static string FormatRoster(IReadOnlyDictionary<int, ulong> players) =>
+            string.Join(",", (players ?? new Dictionary<int, ulong>())
+                .OrderBy(player => player.Key)
+                .Select(player => $"{player.Key}:{player.Value}"));
