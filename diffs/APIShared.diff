+            setupTroopsHook.Apply();
+            leftClickHook = PrepareHook(RequireMethod(typeof(MainViewModel), "TroopsLeftClickCommand", new[] { typeof(object) }), (TroopClickDelegate)LeftClickHook, "APIShared.UnitHud.TroopsLeftClick", installed);
