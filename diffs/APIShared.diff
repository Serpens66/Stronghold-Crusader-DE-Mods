+            }
+            catch (Exception ex)
+            {
+                if (Interlocked.Exchange(ref callbackFailureLogged, 1) == 0)
+                    NativeApiLog.Error(log, $"gatehouse-automation query failed: buildingId={buildingId}, error={ex}");
