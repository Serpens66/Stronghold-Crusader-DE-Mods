+            string preferred = preferredSource?.Id ?? ModSettingsWorkingSourceRegistry.ModDefaultsId;
+            string preferredToken = preferred + "\n" + (preferredSource?.PreferenceContextId ?? string.Empty);
+            bool preferredChanged = !string.Equals(
