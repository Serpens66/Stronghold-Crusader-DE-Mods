<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:Shared;assembly=BugfixesAndQoL">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="#FF1D1710"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="BorderBrush" Value="#FFF2D48A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <TextBlock Text="{Binding LegacyModWarningText}"
                 Visibility="{Binding LegacyModWarningVisibility}"
                 Foreground="#FF6666"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Border Style="{StaticResource ClientActivationBorder}"><CheckBox IsEnabled="{Binding CanEditClientSettings}"
                  IsChecked="{Binding EnableClientFeatures, Mode=TwoWay}"
                  Content="{Binding EnableClientFeaturesText}"
                  ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableClientFeaturesHelpText}"
                  Foreground="White"
                  FontWeight="Bold"
                  VerticalAlignment="Center"/></Border>
        <TextBlock Text="{Binding PresetText}" Visibility="{Binding PresetVisibility}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"/>
        <ComboBox IsEnabled="{Binding CanChangePreset}"
                  Visibility="{Binding PresetVisibility}"
                  ItemsSource="{Binding PresetOptions}"
                  SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"
                  ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}"
                  Width="170"
                  VerticalAlignment="Center"/>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}"
                 Visibility="{Binding HostReadOnlyNoticeVisibility}"
                 Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding ClientOptionsText}" Style="{StaticResource ClientRoleHeader}" Margin="0,4,0,4"/>
      <StackPanel IsEnabled="{Binding CanEditClientSettings}">
      <TextBlock Text="{Binding ClientInterfaceTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <CheckBox IsChecked="{Binding EnableMinimapCursorFollowFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMinimapCursorFollowFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableMinimapCursorFollowFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableMarketKeyMainMenuFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMarketKeyMainMenuFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableMarketKeyMainMenuFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableAutoTradeSellZeroFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableAutoTradeSellZeroFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableAutoTradeSellZeroFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableEnemyProximityBulldozeCursorFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableEnemyProximityBulldozeCursorFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableEnemyProximityBulldozeCursorFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding AllowMinimapWhilePlacingBuilding, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowMinimapWhilePlacingBuildingHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding AllowMinimapWhilePlacingBuildingText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding AllowCameraMovementWithModifiers, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowCameraMovementWithModifiersHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding AllowCameraMovementWithModifiersText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding HdMarketView, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding HdMarketViewHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding HdMarketViewText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      </StackPanel>
      <Separator Background="#444466" Margin="0,8"/>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanEditHostSettings}"
                    IsChecked="{Binding EnableMod, Mode=TwoWay}"
                    Content="{Binding EnableHostFeaturesText}"
                    Foreground="White"
                    FontWeight="Bold"
                    ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableHostFeaturesHelpText}"/>
        </Border>
      </Grid>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <TextBlock Text="{Binding GameplayTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <CheckBox IsChecked="{Binding EnableAssemblyPointPlacementFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableAssemblyPointPlacementFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableAssemblyPointPlacementFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <TextBlock Text="{Binding AiAivTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <CheckBox IsChecked="{Binding RememberAiAivSettings, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding RememberAiAivSettingsHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding RememberAiAivSettingsText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <TextBlock Text="{Binding TroopMovementTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/>
      <CheckBox IsChecked="{Binding EnableTroopMovementFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableTroopMovementFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableTroopMovementFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <TextBlock Text="{Binding PlagueTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/>
      <CheckBox IsChecked="{Binding EnablePlaguePopularityFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnablePlaguePopularityFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnablePlaguePopularityFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnablePlagueCloudRemovalFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnablePlagueCloudRemovalFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnablePlagueCloudRemovalFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableStuckApothecaryFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableStuckApothecaryFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableStuckApothecaryFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnablePlagueTargetReservationFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnablePlagueTargetReservationFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnablePlagueTargetReservationFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
