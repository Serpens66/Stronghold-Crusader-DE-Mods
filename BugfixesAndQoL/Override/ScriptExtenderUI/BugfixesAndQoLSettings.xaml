<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=BugfixesAndQoL"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="#FF1D1710"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/>
      <Setter Property="BorderBrush" Value="#FFF2D48A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="CategoryHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#FFF2D48A"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchIcon" TargetType="{x:Type Path}"><Setter Property="Stroke" Value="#FF77AAFF"/><Style.Triggers><DataTrigger Binding="{Binding System_ModSettingsSearchHasActiveFilter}" Value="True"><Setter Property="Stroke" Value="#FFF2D48A"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <TextBlock Text="{Binding LegacyModWarningText}"
                 Visibility="{Binding LegacyModWarningVisibility}"
                 Foreground="#FF6666"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="145" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button Command="{Binding System_ToggleModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" Width="30" Height="28" Padding="5" Margin="8,0,0,0"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ModSettingsSearchIcon}" StrokeThickness="2" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16"/></Viewbox></Button>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" shared:ModSettingsSearch.FocusRequest="{Binding System_ModSettingsSearchFocusRequest}" Width="280" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchHelpText}" Foreground="White" Padding="5,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
          <CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button Command="{Binding System_ClearModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" Width="30" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0"><Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Stroke="#FFF2D48A" StrokeThickness="2" Data="M 1,1 L 9,9 M 9,1 L 1,9"/></Viewbox></Button>
        </StackPanel>
        <TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66" HorizontalAlignment="Left" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}"
                 Visibility="{Binding HostReadOnlyNoticeVisibility}"
                 Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding ClientOptionsText}" Style="{StaticResource ClientRoleHeader}" Margin="0,4,0,4"/>
      <StackPanel IsEnabled="{Binding CanEditClientSettings}">
      <TextBlock Text="{Binding QolTitleText}" Style="{StaticResource CategoryHeader}" Margin="0,8,0,4" shared:ModSettingsSearch.Key="bugfixes.category.client-qol" shared:ModSettingsSearch.Title="{Binding QolTitleText}"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.client-interface" shared:ModSettingsSearch.SectionTitle="{Binding ClientInterfaceTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding ClientInterfaceTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.show-vanilla-maps-in-editor" shared:ModSettingsSearch.Title="{Binding ShowVanillaMapsInEditorText}" shared:ModSettingsSearch.ToolTipText="{Binding ShowVanillaMapsInEditorHelpText}"><CheckBox IsChecked="{Binding ShowVanillaMapsInEditor, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding ShowVanillaMapsInEditorHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding ShowVanillaMapsInEditorText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.show-selected-unit-health" shared:ModSettingsSearch.Title="{Binding ShowSelectedUnitHealthText}" shared:ModSettingsSearch.ToolTipText="{Binding ShowSelectedUnitHealthHelpText}"><CheckBox IsChecked="{Binding ShowSelectedUnitHealth, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding ShowSelectedUnitHealthHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding ShowSelectedUnitHealthText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.troop-hud-middle-click-camera-jump" shared:ModSettingsSearch.Title="{Binding EnableTroopHudMiddleClickCameraJumpText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableTroopHudMiddleClickCameraJumpHelpText}"><CheckBox IsChecked="{Binding EnableTroopHudMiddleClickCameraJump, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableTroopHudMiddleClickCameraJumpHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableTroopHudMiddleClickCameraJumpText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-ingame-steam-invite-prompt" shared:ModSettingsSearch.Title="{Binding EnableIngameSteamInvitePromptText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableIngameSteamInvitePromptHelpText}"><CheckBox IsChecked="{Binding EnableIngameSteamInvitePrompt, Mode=TwoWay}"
                  Foreground="White" VerticalAlignment="Center"
                  ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableIngameSteamInvitePromptHelpText}"
                  Margin="0,0,10,0">
          <TextBlock Text="{Binding EnableIngameSteamInvitePromptText}" Foreground="White" TextWrapping="Wrap"/>
        </CheckBox></Grid>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.clear-steam-invite-blacklist" shared:ModSettingsSearch.Title="{Binding ClearSteamInviteBlacklistText}" shared:ModSettingsSearch.ToolTipText="{Binding ClearSteamInviteBlacklistHelpText}"><Button Content="{Binding ClearSteamInviteBlacklistText}"
                Command="{Binding ClearSteamInviteBlacklistCommand}"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding ClearSteamInviteBlacklistHelpText}"
                VerticalAlignment="Center" Padding="8,2"/></Grid>
      </StackPanel>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.allow-minimap-while-placing-building" shared:ModSettingsSearch.Title="{Binding AllowMinimapWhilePlacingBuildingText}" shared:ModSettingsSearch.ToolTipText="{Binding AllowMinimapWhilePlacingBuildingHelpText}"><CheckBox IsChecked="{Binding AllowMinimapWhilePlacingBuilding, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowMinimapWhilePlacingBuildingHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding AllowMinimapWhilePlacingBuildingText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.allow-camera-movement-with-modifiers" shared:ModSettingsSearch.Title="{Binding AllowCameraMovementWithModifiersText}" shared:ModSettingsSearch.ToolTipText="{Binding AllowCameraMovementWithModifiersHelpText}"><CheckBox IsChecked="{Binding AllowCameraMovementWithModifiers, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowCameraMovementWithModifiersHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding AllowCameraMovementWithModifiersText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-ally-goods-amount-modifiers" shared:ModSettingsSearch.Title="{Binding EnableAllyGoodsAmountModifiersText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableAllyGoodsAmountModifiersHelpText}"><CheckBox IsChecked="{Binding EnableAllyGoodsAmountModifiers, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableAllyGoodsAmountModifiersHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableAllyGoodsAmountModifiersText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.market-goods-order" shared:ModSettingsSearch.SectionTitle="{Binding MarketGoodsOrderTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding MarketGoodsOrderTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.hd-market-view" shared:ModSettingsSearch.Title="{Binding HdMarketViewText}" shared:ModSettingsSearch.ToolTipText="{Binding HdMarketViewHelpText}"><CheckBox IsChecked="{Binding HdMarketView, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding HdMarketViewHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding HdMarketViewText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <TextBlock Text="{Binding MarketGoodsOrderHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,0,14,8"/>
      <ItemsControl ItemsSource="{Binding MarketGoodsOrderItems}" Width="600" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Width="600"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="{Binding SearchKey}" shared:ModSettingsSearch.Title="{Binding SearchTitle}" shared:ModSettingsSearch.ToolTipText="{Binding GoodToolTip}"><Border Width="56" Height="78" Margin="2" Background="#33251D13" BorderBrush="#887B674B" BorderThickness="1" CornerRadius="3"
                    ToolTipService.ShowDuration="60000" ToolTip="{Binding GoodToolTip}">
              <Grid Margin="3">
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding PositionText}" Foreground="#FFF2D48A" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Image Grid.Row="0" Source="{Binding Icon}" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="&lt;" Command="{Binding MovePreviousCommand}" Padding="6,0"
                          ToolTipService.ShowDuration="60000" ToolTip="{Binding MovePreviousToolTip}"/>
                  <Button Grid.Column="2" Content="&gt;" Command="{Binding MoveNextCommand}" Padding="6,0"
                          ToolTipService.ShowDuration="60000" ToolTip="{Binding MoveNextToolTip}"/>
                </Grid>
              </Grid>
            </Border></Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.restore-hd-market-order" shared:ModSettingsSearch.Title="{Binding RestoreHdMarketOrderText}" shared:ModSettingsSearch.ToolTipText="{Binding RestoreHdMarketOrderHelpText}"><Button IsEnabled="{Binding CanEditClientSettings}" Content="{Binding RestoreHdMarketOrderText}" Command="{Binding RestoreHdMarketOrderCommand}"
              ToolTipService.ShowDuration="60000" ToolTip="{Binding RestoreHdMarketOrderHelpText}"
              HorizontalAlignment="Left" Padding="10,3" Margin="0,8,0,4"/></Grid>
      </StackPanel>
      <TextBlock Text="{Binding FixesTitleText}" Style="{StaticResource CategoryHeader}" Margin="0,8,0,4" shared:ModSettingsSearch.Key="bugfixes.category.client-fixes" shared:ModSettingsSearch.Title="{Binding FixesTitleText}"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.display" shared:ModSettingsSearch.SectionTitle="{Binding DisplayTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding DisplayTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.preserve-display-resolution" shared:ModSettingsSearch.Title="{Binding PreserveDisplayResolutionText}" shared:ModSettingsSearch.ToolTipText="{Binding PreserveDisplayResolutionHelpText}"><CheckBox IsChecked="{Binding PreserveDisplayResolution, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding PreserveDisplayResolutionHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding PreserveDisplayResolutionText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.client-interface" shared:ModSettingsSearch.SectionTitle="{Binding ClientInterfaceTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding ClientInterfaceTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-minimap-cursor-follow-fix" shared:ModSettingsSearch.Title="{Binding EnableMinimapCursorFollowFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableMinimapCursorFollowFixHelpText}"><CheckBox IsChecked="{Binding EnableMinimapCursorFollowFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMinimapCursorFollowFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableMinimapCursorFollowFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.disbanded-unit-control-group-cleanup" shared:ModSettingsSearch.Title="{Binding EnableDisbandedUnitControlGroupCleanupText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableDisbandedUnitControlGroupCleanupHelpText}"><CheckBox IsChecked="{Binding EnableDisbandedUnitControlGroupCleanup, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableDisbandedUnitControlGroupCleanupHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableDisbandedUnitControlGroupCleanupText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-market-key-main-menu-fix" shared:ModSettingsSearch.Title="{Binding EnableMarketKeyMainMenuFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableMarketKeyMainMenuFixHelpText}"><CheckBox IsChecked="{Binding EnableMarketKeyMainMenuFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMarketKeyMainMenuFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableMarketKeyMainMenuFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-auto-trade-sell-zero-fix" shared:ModSettingsSearch.Title="{Binding EnableAutoTradeSellZeroFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableAutoTradeSellZeroFixHelpText}"><CheckBox IsChecked="{Binding EnableAutoTradeSellZeroFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableAutoTradeSellZeroFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableAutoTradeSellZeroFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-enemy-proximity-bulldoze-cursor-fix" shared:ModSettingsSearch.Title="{Binding EnableEnemyProximityBulldozeCursorFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableEnemyProximityBulldozeCursorFixHelpText}"><CheckBox IsChecked="{Binding EnableEnemyProximityBulldozeCursorFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableEnemyProximityBulldozeCursorFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableEnemyProximityBulldozeCursorFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.custom-trails" shared:ModSettingsSearch.SectionTitle="{Binding CustomTrailsTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding CustomTrailsTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-custom-trail-extreme-gold-fix" shared:ModSettingsSearch.Title="{Binding EnableCustomTrailExtremeGoldFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableCustomTrailExtremeGoldFixHelpText}"><CheckBox IsChecked="{Binding EnableCustomTrailExtremeGoldFix, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableCustomTrailExtremeGoldFixHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableCustomTrailExtremeGoldFixText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      </StackPanel>
      </StackPanel>
      <Separator Background="#444466" Margin="0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <TextBlock Text="{Binding QolTitleText}" Style="{StaticResource CategoryHeader}" Margin="0,8,0,4" shared:ModSettingsSearch.Key="bugfixes.category.host-qol" shared:ModSettingsSearch.Title="{Binding QolTitleText}"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="bugfixes.section.multiplayer" shared:ModSettingsSearch.SectionTitle="{Binding MultiplayerTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding MultiplayerTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.allow-full-ai-multiplayer-lobby" shared:ModSettingsSearch.Title="{Binding AllowFullAiMultiplayerLobbyText}" shared:ModSettingsSearch.ToolTipText="{Binding AllowFullAiMultiplayerLobbyHelpText}"><CheckBox IsChecked="{Binding AllowFullAiMultiplayerLobby, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowFullAiMultiplayerLobbyHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding AllowFullAiMultiplayerLobbyText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-return-to-multiplayer-lobby" shared:ModSettingsSearch.Title="{Binding EnableReturnToMultiplayerLobbyText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableReturnToMultiplayerLobbyHelpText}"><CheckBox IsChecked="{Binding EnableReturnToMultiplayerLobby, Mode=TwoWay}"
                Foreground="White"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableReturnToMultiplayerLobbyHelpText}"
                Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableReturnToMultiplayerLobbyText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-multiplayer-game-speed-changes" shared:ModSettingsSearch.Title="{Binding EnableMultiplayerGameSpeedChangesText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableMultiplayerGameSpeedChangesHelpText}" Margin="0,0,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding EnableMultiplayerGameSpeedChangesText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding MultiplayerTimeControlPermissionOptions}" SelectedIndex="{Binding MultiplayerTimeControlPermissionIndex, Mode=TwoWay}"
                  ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMultiplayerGameSpeedChangesHelpText}"/>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-shift-game-speed-steps" shared:ModSettingsSearch.Title="{Binding EnableShiftGameSpeedStepsText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableShiftGameSpeedStepsHelpText}"><CheckBox IsChecked="{Binding EnableShiftGameSpeedSteps, Mode=TwoWay}"
