  <ItemGroup>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="ValidateReferences" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ExtenderDir)\SHCDESE.dll')" Text="Installed SHCDESE.dll missing; explicitly supply ExtenderDir." />
    <Error Condition="!Exists('$(ApiSharedDir)\APIShared.dll')" Text="Installed APIShared.dll missing." />
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="RuntimeHarness.cs" />
