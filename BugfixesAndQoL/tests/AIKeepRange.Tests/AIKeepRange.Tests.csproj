    <Reference Include="RedBird.Backends.NativeX64" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(ExtenderDir)\RedBird.Backends.NativeX64.dll</HintPath>
      <Private>true</Private>
