<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>AIKeepRangeTests</AssemblyName>
    <RootNamespace>BugfixesAndQoL</RootNamespace>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">E:\ProgrammeE\Steam\steamapps\common\Stronghold Crusader Definitive Edition</GameDir>
    <ExtenderDir Condition="'$(ExtenderDir)' == ''">$(GameDir)\BepInEx\plugins\000shcdese</ExtenderDir>
    <ApiSharedDir Condition="'$(ApiSharedDir)' == ''">$(GameDir)\BepInEx\plugins\APIShared_Serp</ApiSharedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" />
