    <Reference Include="BepInEx" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="APIShared" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(ApiSharedDir)\APIShared.dll</HintPath>
      <Private>true</Private>
