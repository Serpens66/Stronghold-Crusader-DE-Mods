    <Reference Include="UnityEngine" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(GameDir)\Stronghold Crusader Definitive Edition_Data\Managed\UnityEngine.dll</HintPath>
      <Private>true</Private>
