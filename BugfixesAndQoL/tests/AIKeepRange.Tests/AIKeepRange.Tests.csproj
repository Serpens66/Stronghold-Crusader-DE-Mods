      <Private>true</Private>
    </Reference>
    <Reference Include="Noesis.NoesisGUI" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(GameDir)\Stronghold Crusader Definitive Edition_Data\Managed\Noesis.NoesisGUI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SHCDESE" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(ExtenderDir)\SHCDESE.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="R3" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
      <HintPath>$(ExtenderDir)\R3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Memory" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
