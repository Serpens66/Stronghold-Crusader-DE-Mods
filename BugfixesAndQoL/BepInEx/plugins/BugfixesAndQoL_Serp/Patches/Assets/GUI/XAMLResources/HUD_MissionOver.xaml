<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:CrusaderDE">
  <Operation Type="Add" XPath="//n:StackPanel[@Name='RowStackMP']/n:Grid[n:Button[@CommandParameter='Exit']]">
    <Content>
      <Grid x:Name="BugfixesAndQoLSpectatorStatisticsRefreshHost"
            Width="300"
            Height="60"
            Margin="50,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Visibility="{Binding StatisticsPreviewControlsVisibility}">
        <Button Width="300"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                local:PropEx.TextCentre="{Binding RefreshStatisticsButtonText}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding RefreshStatisticsCommand}"
                ToolTip="{Binding RefreshStatisticsButtonHelpText}"
                ToolTipService.ShowDuration="60000"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowSDisable}" />
      </Grid>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[n:Grid.ColumnDefinitions/n:ColumnDefinition[2][@Width='470'] and n:Image[@Source='{Binding MO_MP_PlayersShields0}']]">
    <Content>
      <Image x:Name="BugfixesAndQoLTeamBadgePage1Row1" Grid.Column="0" Width="20" Height="20" Margin="22,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="20" Stretch="Uniform" />
    </Content>
  </Operation>
