          <Viewbox Width="52" Height="20" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot5.CurrentText}" FontSize="15" Foreground="{Binding Slot5.CurrentForeground}" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="20" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot6.CurrentText}" FontSize="15" Foreground="{Binding Slot6.CurrentForeground}" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="20" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot7.CurrentText}" FontSize="15" Foreground="{Binding Slot7.CurrentForeground}" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="20" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot8.CurrentText}" FontSize="15" Foreground="{Binding Slot8.CurrentForeground}" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Height="18"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Tag="Ignore">
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot1.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot2.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot3.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot4.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot5.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot6.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot7.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
          <Viewbox Width="52" Height="18" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Slot8.MaximumText}" FontSize="15" Foreground="#FF66CC66" TextAlignment="Center" Tag="Ignore"><TextBlock.Effect><DropShadowEffect ShadowDepth="1" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock></Viewbox>
        </StackPanel>
      </Grid>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[@Name='UnitControls']">
    <Content>
      <Grid x:Name="SerpTroopAction_0200_BugfixesAndQoLAssassinClimb"
            Width="36"
            Height="37"
            Margin="80,40,0,3"
            Panel.ZIndex="25"
            Visibility="{Binding ButtonVisibility}">
        <Button x:Name="BugfixesAndQoLAssassinClimbButton"
                local:PropEx.Sprite1="{StaticResource UI-Buttons K043}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons K044}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons K044}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons K044}"
                Width="36"
                Height="37"
                Margin="0"
                Command="{Binding ToggleCommand}"
                Content=""
                Style="{StaticResource BTN_Image}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseEnter">
              <b:InvokeCommandAction Command="{Binding MouseEnterCommand}" />
            </b:EventTrigger>
            <b:EventTrigger EventName="MouseLeave">
              <b:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Button>
        <Border Width="4"
                Height="43"
                Background="#FFE02020"
                BorderBrush="#FF5A0000"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Visibility="{Binding ForbiddenMarkVisibility}"
                RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <RotateTransform Angle="-45" />
          </Border.RenderTransform>
        </Border>
      </Grid>
    </Content>
  </Operation>
<Operation Type="Add" XPath="//n:Grid[@x:Name='LayoutRoot']">
    <Content>
      <Grid x:Name="BugfixesAndQoLFormationButtonHost" Visibility="{Binding FeatureAvailable, Converter={StaticResource booleanToVisibilityConverter}}" Width="35" Height="35" Margin="480,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="20">
        <Button Width="35" Height="35" Padding="0" Command="{Binding ToggleMenuCommand}">
          <Viewbox Width="27" Height="27"><Grid Width="32" Height="32" IsHitTestVisible="False">
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconVanilla}" Visibility="{Binding IsVanilla, Converter={StaticResource booleanToVisibilityConverter}}"/>
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconBlock}" Visibility="{Binding IsBlock, Converter={StaticResource booleanToVisibilityConverter}}"/>
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconLine}" Visibility="{Binding IsLine, Converter={StaticResource booleanToVisibilityConverter}}"/>
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconColumn}" Visibility="{Binding IsColumn, Converter={StaticResource booleanToVisibilityConverter}}"/>
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconWedge}" Visibility="{Binding IsWedge, Converter={StaticResource booleanToVisibilityConverter}}"/>
            <ContentControl Content="Formation" ContentTemplate="{StaticResource BugfixesFormationIconCircle}" Visibility="{Binding IsCircle, Converter={StaticResource booleanToVisibilityConverter}}"/>
          </Grid></Viewbox>
          <b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Formations"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers>
        </Button>
      </Grid>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconVanilla"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="3"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="4" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="10" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="16" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="22" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="27"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconBlock"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="21"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
