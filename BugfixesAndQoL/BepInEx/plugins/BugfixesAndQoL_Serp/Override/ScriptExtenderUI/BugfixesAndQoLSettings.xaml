          <StackPanel Visibility="{Binding SettingsPresentation.HostSiege.PossibleVisibility}" shared:ModSettingsSearch.SectionKey="bugfixes.topic.host-siege" shared:ModSettingsSearch.SectionTitle="{Binding SettingsPresentation.HostSiege.PossibleSearchTitle}">
            <TextBlock Text="{Binding PossibleFixesTitleText}" Style="{StaticResource CategoryHeader}" Margin="28,8,0,4" shared:ModSettingsSearch.Exclude="True"/>
            <TextBlock Text="{Binding SettingsPresentation.PossibleFixesHelpText}" Foreground="#FFBBBBBB" TextWrapping="Wrap" Margin="28,0,0,8" shared:ModSettingsSearch.Exclude="True"/>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-assassin-captured-gate-protection-fix" shared:ModSettingsSearch.Title="{Binding EnableAssassinCapturedGateProtectionFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableAssassinCapturedGateProtectionFixHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ContentControl Content="{Binding Symbol}" Style="{StaticResource RecommendationMarker}" ToolTipService.ShowDuration="60000" shared:ModSettingsSearch.Exclude="True" DataContext="{Binding SettingsPresentation.EnableAssassinCapturedGateProtectionFix}"><ContentControl.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" apiui:SharedToolTipSizing.Enabled="True" Content="{Binding ToolTip}"/></ContentControl.ToolTip></ContentControl>
              <Grid Grid.Column="1" IsEnabled="{Binding CanEditHostSettings}" Opacity="{Binding HostSettingsOpacity}">
                <CheckBox IsChecked="{Binding EnableAssassinCapturedGateProtectionFix, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" Margin="0,0,14,8"><CheckBox.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" apiui:SharedToolTipSizing.Enabled="True" Content="{Binding EnableAssassinCapturedGateProtectionFixHelpText}"/></CheckBox.ToolTip>
                  <TextBlock Text="{Binding EnableAssassinCapturedGateProtectionFixText}" Foreground="White" TextWrapping="Wrap"/>
                </CheckBox>
              </Grid>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding SettingsPresentation.HostPerformance.Visibility}" Margin="0,0,0,6" shared:ModSettingsSearch.SectionKey="bugfixes.topic.host-performance" shared:ModSettingsSearch.SectionTitle="{Binding SettingsPresentation.HostPerformance.Title}" shared:ModSettingsSearch.IsSection="True" Width="{Binding ViewportWidth, ElementName=SettingsViewport, Converter={StaticResource SettingsTopicWidthConverter}}" HorizontalAlignment="Left">
        <Button Command="{Binding SettingsPresentation.HostPerformance.ToggleCommand}" HorizontalContentAlignment="Stretch" ToolTipService.ShowDuration="60000" shared:ModSettingsSearch.Exclude="True" Style="{StaticResource TopicHeading}"><Button.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" apiui:SharedToolTipSizing.Enabled="True" Content="{Binding SettingsPresentation.TopicToggleHelpText}"/></Button.ToolTip>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path Style="{StaticResource TopicChevron}" DataContext="{Binding SettingsPresentation.HostPerformance}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" VerticalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" FontWeight="Bold">
              <Run Text="{Binding SettingsPresentation.HostPerformance.Title}"/>
              <Run Text=" "/>
              <Run Text="{Binding SettingsPresentation.HostPerformance.CountText}" Foreground="#FFBBBBBB" FontSize="14" FontWeight="Normal"/>
            </TextBlock>
          </Grid>
        </Button>
        <StackPanel Visibility="{Binding SettingsPresentation.HostPerformance.ContentVisibility}" Margin="8,2,8,6">
          <TextBlock Text="{Binding SettingsPresentation.PerformanceHelpText}" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="28,6,0,8" shared:ModSettingsSearch.Exclude="True"/>
          <StackPanel Visibility="{Binding SettingsPresentation.HostPerformance.FixesVisibility}" shared:ModSettingsSearch.SectionKey="bugfixes.topic.host-performance" shared:ModSettingsSearch.SectionTitle="{Binding SettingsPresentation.HostPerformance.FixesSearchTitle}">
            <TextBlock Text="{Binding FixesTitleText}" Style="{StaticResource CategoryHeader}" Margin="28,8,0,4" shared:ModSettingsSearch.Exclude="True"/>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="bugfixes.enable-ai-raid-retarget-fix" shared:ModSettingsSearch.Title="{Binding EnableAiRaidRetargetFixText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableAiRaidRetargetFixHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ContentControl Content="{Binding Symbol}" Style="{StaticResource RecommendationMarker}" ToolTipService.ShowDuration="60000" shared:ModSettingsSearch.Exclude="True" DataContext="{Binding SettingsPresentation.EnableAiRaidRetargetFix}"><ContentControl.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" apiui:SharedToolTipSizing.Enabled="True" Content="{Binding ToolTip}"/></ContentControl.ToolTip></ContentControl>
              <Grid Grid.Column="1" IsEnabled="{Binding CanEditHostSettings}" Opacity="{Binding HostSettingsOpacity}">
                <CheckBox IsChecked="{Binding EnableAiRaidRetargetFix, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" Margin="0,0,14,8"><CheckBox.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" apiui:SharedToolTipSizing.Enabled="True" Content="{Binding EnableAiRaidRetargetFixHelpText}"/></CheckBox.ToolTip>
                  <TextBlock Text="{Binding EnableAiRaidRetargetFixText}" Foreground="White" TextWrapping="Wrap"/>
                </CheckBox>
              </Grid>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
