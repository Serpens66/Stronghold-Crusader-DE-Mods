      <Canvas x:Name="ForeignTroopHudPanel" xmlns:local="clr-namespace:CrusaderDE"
              Width="416" Height="170" Margin="0,0,242,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Panel.ZIndex="10020" ClipToBounds="True" Visibility="Collapsed">
        <Canvas.Resources>
          <Style x:Key="BugfixesAndQoL-ForeignTroopPortrait" TargetType="Button" BasedOn="{StaticResource BTN_Image}">
            <Style.Triggers>
              <!-- The view sets the type label even when a portrait makes it invisible. -->
              <Trigger Property="Tag" Value="Typ 55">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1.07" ScaleY="1.07" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
          <!-- Vanilla page arrows without their box: the 70x70 sprites hold the outlined circle at (35,35)
               with radius ~20 and, in the hover sprite, a light ring up to ~23 before the box begins.
               At Vanilla's 21px (scale 0.3) that is radius 6 (idle) and 6.75 (hover, keeps the ring). The clip also limits the hit
               area; the ring only appears once the pointer is inside the idle circle, so it cannot flicker.
               NoFade has no Opacity storyboard that could fight the view's Visibility. -->
          <Style x:Key="BugfixesAndQoL-ForeignTroopPageArrow" TargetType="Button" BasedOn="{StaticResource BTN_BuildingNoFade}">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Clip">
              <Setter.Value><EllipseGeometry Center="10.5,10.5" RadiusX="6" RadiusY="6" /></Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Clip">
                  <Setter.Value><EllipseGeometry Center="10.5,10.5" RadiusX="6.75" RadiusY="6.75" /></Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Canvas.Resources>
