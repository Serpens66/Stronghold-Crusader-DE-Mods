<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Operation Type="InsertAfter" XPath="//n:TextBlock[@x:Name='TroopsPanelRollover']">
    <Content>
      <Border x:Name="BugfixesAndQoLSelectedUnitHealthHost"
              Width="210"
              Height="25"
              Margin="0,3,8,0"
              Padding="6,2,6,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Panel.ZIndex="2"
              Background="#66000000"
              IsHitTestVisible="False"
              Visibility="{Binding HealthVisibility}"
              Tag="Ignore">
        <TextBlock Text="{Binding HealthText}"
                   FontSize="16"
                   Foreground="#FFEFF3C6"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Tag="Ignore">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="2"
                              Direction="315"
                              Color="#CC000000"
                              BlurRadius="0"/>
          </TextBlock.Effect>
        </TextBlock>
      </Border>
    </Content>
  </Operation>
</Patch>
