<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:shared="clr-namespace:Shared;assembly=SpawnCastle">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="20"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <b:Interaction.Triggers>
    <b:EventTrigger EventName="PreviewKeyDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
    <b:EventTrigger EventName="KeyDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
    <b:EventTrigger EventName="PreviewMouseDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
  </b:Interaction.Triggers>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="10">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Border Style="{StaticResource ClientActivationBorder}"><CheckBox IsEnabled="{Binding CanEditClientSettings}"
                IsChecked="{Binding EnableMod, Mode=TwoWay}"
                Content="{Binding EnableModText}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding EnableModHelpText}"
                Foreground="White"
                FontWeight="Bold"
                VerticalAlignment="Center"/></Border>
      <TextBlock Text="{Binding PresetText}" Visibility="{Binding PresetVisibility}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"/>
      <ComboBox IsEnabled="{Binding CanChangePreset}"
                Visibility="{Binding PresetVisibility}"
                ItemsSource="{Binding PresetOptions}"
                SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding PresetHelpText}"
                Width="170"
                VerticalAlignment="Center"/>
      <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
    </StackPanel>
    <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding TitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
    <TextBlock Text="{Binding HelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock Text="{Binding LocalOptionsText}" Style="{StaticResource ClientRoleHeader}" Margin="0,4,0,6"/>
    <StackPanel IsEnabled="{Binding CanEditClientSettings}">
      <TextBlock Text="{Binding CastleSectionTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding CastleText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <ComboBox x:Name="SpawnCastleSelectionComboBox"
                ItemsSource="{Binding CastleOptions}"
                SelectedItem="{Binding SelectedCastle, Mode=TwoWay}"
                MaxDropDownHeight="120"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding CastleHelpText}"
                Margin="0,0,0,8"/>
      <TextBlock Text="{Binding InventoryText}"
                 Foreground="#999999"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <TextBlock Text="{Binding PlacementControlsTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/>
      <TextBlock Text="{Binding ModeText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding ModeOptions}"
                SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding ModeHelpText}"
                Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HotkeyText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <StackPanel Orientation="Horizontal">
        <Border Background="#33000000"
                BorderBrush="#6677AAFF"
                BorderThickness="1"
                MinWidth="150"
                Padding="8,4"
                Margin="0,0,8,0">
          <TextBlock Text="{Binding HotkeyDisplayText}"
                     Foreground="#EEEEEE"
                     VerticalAlignment="Center"/>
        </Border>
        <Button Content="{Binding HotkeyCaptureButtonText}"
                Command="{Binding AssignHotkeyCommand}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding HotkeyHelpText}"
                MinWidth="115"
                Margin="0,0,6,0"/>
        <Button Content="{Binding ClearText}"
                Command="{Binding ClearHotkeyCommand}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding ClearHelpText}"
                MinWidth="60"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Grid>
