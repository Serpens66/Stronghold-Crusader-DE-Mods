<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="10">
    <TextBlock Text="Human castle blueprint"
               Foreground="#77AAFF"
               FontWeight="Bold"
               Margin="0,0,0,8"/>
    <TextBlock Text="Choose an AIVJSON blueprint to spawn around the human keep after a new map starts."
               Foreground="#CCCCCC"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>
    <ComboBox ItemsSource="{Binding CastleOptions}"
              SelectedItem="{Binding SelectedCastle, Mode=TwoWay}"
              MaxDropDownHeight="420"
              Margin="0,0,0,8"/>
    <TextBlock Text="{Binding InventoryText}"
               Foreground="#999999"
               TextWrapping="Wrap"/>
  </StackPanel>
</Grid>
