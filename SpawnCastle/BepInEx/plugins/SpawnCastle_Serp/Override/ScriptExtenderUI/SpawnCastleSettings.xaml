<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
  <b:Interaction.Triggers>
    <b:EventTrigger EventName="PreviewKeyDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
    <b:EventTrigger EventName="KeyDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
    <b:EventTrigger EventName="PreviewMouseDown">
      <b:InvokeCommandAction Command="{Binding HotkeyInputCommand}"
                             PassEventArgsToCommand="True"/>
    </b:EventTrigger>
  </b:Interaction.Triggers>
  <StackPanel Margin="10">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Button IsEnabled="{Binding CanResetSettings}"
              Content="{Binding ResetToDefaultText}"
              Command="{Binding ResetToDefaultCommand}"
              ToolTipService.ShowDuration="60000"
              ToolTip="{Binding ResetToDefaultHelpText}"
              HorizontalAlignment="Left"
              Padding="10,3"/>
      <CheckBox IsEnabled="{Binding CanEditClientSettings}"
                IsChecked="{Binding EnableMod, Mode=TwoWay}"
                Content="{Binding EnableModText}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding EnableModHelpText}"
                Foreground="White"
                VerticalAlignment="Center"
                Margin="14,0,0,0"/>
      <ComboBox IsEnabled="{Binding CanChangePreset}"
                Visibility="{Binding PresetVisibility}"
                ItemsSource="{Binding PresetOptions}"
                SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding PresetHelpText}"
                Width="170"
                VerticalAlignment="Center"
                Margin="14,0,0,0"/>
    </StackPanel>
    <StackPanel IsEnabled="{Binding CanEditClientSettings}">
      <TextBlock Text="{Binding TitleText}"
                 Foreground="#77AAFF"
                 FontWeight="Bold"
                 Margin="0,0,0,4"/>
      <TextBlock Text="{Binding HelpText}"
                 Foreground="#CCCCCC"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <TextBlock Text="{Binding LocalOptionsText}"
                 Foreground="#77AAFF"
                 FontWeight="Bold"
                 Margin="0,4,0,6"/>
      <TextBlock Text="{Binding CastleText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding CastleOptions}"
                SelectedItem="{Binding SelectedCastle, Mode=TwoWay}"
                MaxDropDownHeight="420"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding CastleHelpText}"
                Margin="0,0,0,8"/>
      <TextBlock Text="{Binding InventoryText}"
                 Foreground="#999999"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <TextBlock Text="{Binding ModeText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding ModeOptions}"
                SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding ModeHelpText}"
                Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HotkeyText}"
                 Foreground="#DDDDDD"
                 Margin="0,0,0,3"/>
      <StackPanel Orientation="Horizontal">
        <Border Background="#33000000"
                BorderBrush="#6677AAFF"
                BorderThickness="1"
                MinWidth="150"
                Padding="8,4"
                Margin="0,0,8,0">
          <TextBlock Text="{Binding HotkeyDisplayText}"
                     Foreground="#EEEEEE"
                     VerticalAlignment="Center"/>
        </Border>
        <Button Content="{Binding HotkeyCaptureButtonText}"
                Command="{Binding AssignHotkeyCommand}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding HotkeyHelpText}"
                MinWidth="115"
                Margin="0,0,6,0"/>
        <Button Content="{Binding ClearText}"
                Command="{Binding ClearHotkeyCommand}"
                ToolTipService.ShowDuration="60000"
                ToolTip="{Binding ClearHelpText}"
                MinWidth="60"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Grid>
