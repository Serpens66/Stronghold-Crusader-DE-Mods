# Local/external dependencies and binaries
/shcde-script-extender/
/x86_64/

# Top-level local tool/config directories such as .agents, .codex, etc.
/.*/
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
/AGENTS.md
/info.txt

# Build outputs
**/bin/
**/obj/
/.release-output/
/release.local.json
/.nexusmods-api-key.dpapi

# Reproducible native-analysis search indexes (rebuilt from tracked exports)
/_inspect/CrusaderDE-Native-Baseline/sem/*/CrusaderDE-semantic.sqlite
/_inspect/CrusaderDE-Native-Baseline/sem/*/CrusaderDE-semantic.sqlite-wal
/_inspect/CrusaderDE-Native-Baseline/sem/*/CrusaderDE-semantic.sqlite-shm
/_inspect/CrusaderDE-Native-Baseline/sem/*/CrusaderDE-semantic.sqlite-journal
/_inspect/CrusaderDE-Native-Baseline/sem/*/CrusaderDE-semantic.sqlite-building

# IDE and OS files
.vs/
.vscode/
*.user
*.suo
Thumbs.db
Desktop.ini
