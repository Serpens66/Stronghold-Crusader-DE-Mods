<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=ImprovedHunters"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchIcon" TargetType="{x:Type Path}"><Setter Property="Stroke" Value="#FF77AAFF"/><Style.Triggers><DataTrigger Binding="{Binding System_ModSettingsSearchHasActiveFilter}" Value="True"><Setter Property="Stroke" Value="#FFF2D48A"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="145" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button Command="{Binding System_ToggleModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" Width="30" Height="28" Padding="5" Margin="8,0,0,0"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ModSettingsSearchIcon}" StrokeThickness="2" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16"/></Viewbox></Button>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchHelpText}" Foreground="White" Padding="5,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
          <CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button Command="{Binding System_ClearModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" Width="30" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0"><Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Stroke="#FFF2D48A" StrokeThickness="2" Data="M 1,1 L 9,9 M 9,1 L 1,9"/></Viewbox></Button>
        </StackPanel>
        <TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66" HorizontalAlignment="Left" Margin="0,4,0,0"/>
      </StackPanel>

      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <TextBlock Text="{Binding HelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,0,0,10"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="hunters.section.behavior" shared:ModSettingsSearch.SectionTitle="{Binding BehaviorTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding BehaviorTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.improved-target-selection" shared:ModSettingsSearch.Title="{Binding ImprovedTargetSelectionText}" shared:ModSettingsSearch.ToolTipText="{Binding ImprovedTargetSelectionHelpText}"><CheckBox IsChecked="{Binding ImprovedTargetSelection, Mode=TwoWay}"
                Content="{Binding ImprovedTargetSelectionText}"
                Foreground="White"
                Margin="0,0,14,8"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding ImprovedTargetSelectionHelpText}"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.improved-pathfinding" shared:ModSettingsSearch.Title="{Binding ImprovedPathfindingText}" shared:ModSettingsSearch.ToolTipText="{Binding ImprovedPathfindingHelpText}"><CheckBox IsChecked="{Binding ImprovedPathfinding, Mode=TwoWay}"
                Content="{Binding ImprovedPathfindingText}"
                Foreground="White"
                Margin="0,0,14,8"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding ImprovedPathfindingHelpText}"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.allow-dead-targets" shared:ModSettingsSearch.Title="{Binding AllowDeadTargetsText}" shared:ModSettingsSearch.ToolTipText="{Binding AllowDeadTargetsHelpText}"><CheckBox IsChecked="{Binding AllowDeadTargets, Mode=TwoWay}"
                Content="{Binding AllowDeadTargetsText}"
                Foreground="White"
                Margin="0,0,14,8"
                ToolTipService.ShowDuration="60000" ToolTip="{Binding AllowDeadTargetsHelpText}"/></Grid>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="hunters.section.chicken-population" shared:ModSettingsSearch.SectionTitle="{Binding ChickenPopulationTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding ChickenPopulationTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.max-neutral-chickens" shared:ModSettingsSearch.Title="{Binding MaxNeutralChickensPerPlayerText}" shared:ModSettingsSearch.ToolTipText="{Binding MaxNeutralChickensPerPlayerHelpText}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding MaxNeutralChickensPerPlayerText}" Foreground="White" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MaxNeutralChickensPerPlayerHelpText}"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MaxNeutralChickensPerPlayer, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MaxNeutralChickensPerPlayerHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding MaxNeutralChickensPerPlayerValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MaxNeutralChickensPerPlayerHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="hunters.section.targets-yield" shared:ModSettingsSearch.SectionTitle="{Binding TargetsYieldTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding TargetsYieldTitleText}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/></Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="70"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HuntText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="3"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding MeatText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.deer" shared:ModSettingsSearch.Title="{Binding DeerText}" shared:ModSettingsSearch.ToolTipText="{Binding MeatHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding DeerText}" Foreground="White" VerticalAlignment="Center" Margin="0,4"/><CheckBox Grid.Column="1" IsChecked="{Binding HuntDeer, Mode=TwoWay}" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HelpText}"/><Slider Grid.Column="2" Minimum="-1" Maximum="100" Value="{Binding DeerMeat, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="3" Text="{Binding DeerMeatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.goat" shared:ModSettingsSearch.Title="{Binding GoatText}" shared:ModSettingsSearch.ToolTipText="{Binding MeatHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding GoatText}" Foreground="White" VerticalAlignment="Center" Margin="0,4"/><CheckBox Grid.Column="1" IsChecked="{Binding HuntGoat, Mode=TwoWay}" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HelpText}"/><Slider Grid.Column="2" Minimum="-1" Maximum="100" Value="{Binding GoatMeat, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="3" Text="{Binding GoatMeatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="4" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.rabbit" shared:ModSettingsSearch.Title="{Binding RabbitText}" shared:ModSettingsSearch.ToolTipText="{Binding MeatHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding RabbitText}" Foreground="White" VerticalAlignment="Center" Margin="0,4"/><CheckBox Grid.Column="1" IsChecked="{Binding HuntRabbit, Mode=TwoWay}" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HelpText}"/><Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding RabbitMeat, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="3" Text="{Binding RabbitMeatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>

        <Grid Grid.Row="4" Grid.ColumnSpan="4" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.camel" shared:ModSettingsSearch.Title="{Binding CamelText}" shared:ModSettingsSearch.ToolTipText="{Binding MeatHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding CamelText}" Foreground="White" VerticalAlignment="Center" Margin="0,4"/><CheckBox Grid.Column="1" IsChecked="{Binding HuntCamel, Mode=TwoWay}" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HelpText}"/><Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding CamelMeat, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="3" Text="{Binding CamelMeatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MeatHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>

        <Grid Grid.Row="5" Grid.ColumnSpan="4" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="hunters.chicken" shared:ModSettingsSearch.Title="{Binding ChickenText}" shared:ModSettingsSearch.ToolTipText="{Binding ChickenHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding ChickenText}" Foreground="White" VerticalAlignment="Center" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChickenHelpText}"/><CheckBox Grid.Column="1" IsChecked="{Binding HuntChicken, Mode=TwoWay}" HorizontalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChickenHelpText}"/><Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding ChickenMeat, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChickenHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="3" Text="{Binding ChickenMeatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChickenHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>

      </Grid>
      </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
