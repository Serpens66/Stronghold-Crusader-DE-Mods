{
  "enabled": true,
  "series": "SP-hunters-matrix-chicken",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "no-granary-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickensPerPlayer", "0"]},
    {"id": "chicken-meat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickenMeat", "1"]},
    {"id": "only-deer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "false"]},
    {"id": "only-goat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "false"]},
    {"id": "only-rabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"]},
    {"id": "only-camel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"]},
    {"id": "only-chicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"]},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "animals", "do": "Hunt.LogAnimals"},
    {"id": "hut", "do": "Hunt.PlaceHut", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "open-start", "do": "Hunt.ExpectOpenStart", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "supply", "do": "Hunt.Supply", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["80"]},
    {"id": "settle-hunter", "do": "Wait", "args": ["6000"], "timeoutMs": 15000},
    {"id": "free-prey", "do": "Hunt.Prey", "args": ["chicken", "24", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "free-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "free-carried", "do": "Hunt.ExpectCarries", "args": ["1"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "free-free", "do": "Hunt.WaitHunterFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "free-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-granary-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickensPerPlayer", "4"]},
    {"id": "restore-deer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "restore-goat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "restore-rabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "true"]},
    {"id": "restore-camel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "true"]},
    {"id": "restore-chicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"]},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
