{
  "enabled": true,
  "series": "SP-hunters-editor",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "set-EnableMod", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "set-RespawnWildlife", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RespawnWildlife", "true"]},
    {"id": "set-RespawnIntervalSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RespawnIntervalSeconds", "30"]},
    {"id": "set-LimitWildlifeRange", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "LimitWildlifeRange", "true"]},
    {"id": "set-WildlifeRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "WildlifeRangeSize", "100"]},
    {"id": "editor", "do": "Editor.Start", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "deer", "do": "Hunt.SpawnHerd", "args": ["deer"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "goat", "do": "Hunt.SpawnHerd", "args": ["goat"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["300"]},
    {"id": "settle", "do": "Wait", "args": ["20000"], "timeoutMs": 30000},
    {"id": "herds", "do": "Hunt.LogHerds", "args": ["editor"], "timeoutMs": 15000},
    {"id": "pick", "do": "Hunt.PickHerd", "args": ["deer", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "kill", "do": "Hunt.KillHerd", "args": ["0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "no-return", "do": "Wait", "args": ["20000"], "timeoutMs": 30000},
    {"id": "herds-after", "do": "Hunt.LogHerds", "args": ["after"], "timeoutMs": 15000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
