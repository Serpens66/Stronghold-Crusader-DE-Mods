{
  "enabled": true,
  "series": "SP-hunters-tanner",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    { "id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"] },
    { "id": "mode", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "TannerMeatMode", "true"] },
    { "id": "meat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "TannerMeatPerTrip", "5"] },
    { "id": "no-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"] },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "settle", "do": "Wait", "args": ["4000"] },
    { "id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "setup", "do": "Tanner.Setup", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "open", "do": "Tanner.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "panel-default", "do": "Tanner.ExpectPanel", "args": ["3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "bonus-inputs", "do": "Tanner.LogBonusInputs" },
    { "id": "shot-panel", "do": "Screenshot", "args": ["tanner-panel"] },
    { "id": "no-meat-eating", "do": "Tanner.StopEatingMeat", "stopOnFail": true },
    { "id": "speed", "do": "Speed", "args": ["120"] },
    { "id": "only-armour", "do": "Tanner.Cycles", "args": ["4", "0"], "timeoutMs": 480000, "stopOnFail": true },
    { "id": "foreign-good", "do": "Tanner.SetForeignGood", "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-foreign", "do": "Tanner.ExpectPanel", "args": ["3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "slider-one", "do": "Tanner.DragSlider", "args": ["1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-one", "do": "Tanner.ExpectPanel", "args": ["1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "shot-slider", "do": "Screenshot", "args": ["tanner-slider"] },
    { "id": "foreign-after-slider", "do": "Tanner.ExpectForeignGood", "stopOnFail": true },
    { "id": "two-meat", "do": "Tanner.Cycles", "args": ["3", "30"], "timeoutMs": 600000, "stopOnFail": true },
    { "id": "foreign-after-meat", "do": "Tanner.ExpectForeignGood", "stopOnFail": true },
    { "id": "save", "do": "Tanner.Save", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "quit-for-reload", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "reload", "do": "Tanner.Reload", "timeoutMs": 120000, "stopOnFail": true },
    { "id": "ticks-load", "do": "WaitTicks", "args": ["100"], "timeoutMs": 30000 },
    { "id": "open-load", "do": "Tanner.Open", "timeoutMs": 15000 },
    { "id": "panel-load", "do": "Tanner.ExpectPanel", "args": ["1"], "timeoutMs": 10000 },
    { "id": "quit-load", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "skirmish-fresh", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map-fresh", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai-fresh", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "peace-fresh", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play-fresh", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing-fresh", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "unpause-fresh", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "settle-fresh", "do": "Wait", "args": ["4000"] },
    { "id": "setup-fresh", "do": "Tanner.Setup", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "open-fresh", "do": "Tanner.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "panel-fresh", "do": "Tanner.ExpectPanel", "args": ["3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "quit-fresh", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "mode-off", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "TannerMeatMode", "false"] },
    { "id": "skirmish2", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map2", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai2", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "peace2", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play2", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing2", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "unpause2", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "settle2", "do": "Wait", "args": ["4000"] },
    { "id": "setup2", "do": "Tanner.Setup", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "open2", "do": "Tanner.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "panel-hidden", "do": "Tanner.ExpectPanel", "args": ["hidden"], "timeoutMs": 10000 },
    { "id": "menu-end", "do": "QuitToMenu", "timeoutMs": 30000 },
    { "id": "restore-mode", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "TannerMeatMode", "true"] },
    { "id": "restore-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"] },
    { "id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000 }
  ]
}
