{
  "enabled": true,
  "series": "SP-hunters-followup",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "rule", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RabbitsOnlyOnOrder", "true"], "timeoutMs": 15000},
    {"id": "no-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"], "timeoutMs": 15000},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "speed", "do": "Speed", "args": ["120"], "timeoutMs": 15000},
    {"id": "rabbit-fixture", "do": "Hunt.Rabbits", "args": ["3", "1"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "far-rabbit", "do": "Hunt.FarRabbit", "args": ["7"], "timeoutMs": 15000},
    {"id": "wait-1", "do": "Hunt.RabbitsAlive", "args": ["6000"], "timeoutMs": 30000},
    {"id": "order", "do": "Hunt.AttackRabbit", "args": ["0"], "timeoutMs": 15000},
    {"id": "near-killed", "do": "Hunt.RabbitDead", "args": ["0"], "timeoutMs": 30000},
    {"id": "move", "do": "Hunt.MoveSoldiers", "args": ["10"], "timeoutMs": 15000},
    {"id": "after-move-settle", "do": "Wait", "args": ["3000"], "timeoutMs": 15000},
    {"id": "rabbit-after-move", "do": "Hunt.FarRabbit", "args": ["1", "clear"], "timeoutMs": 15000},
    {"id": "ignored-after-move", "do": "Hunt.RabbitsAlive", "args": ["8000"], "timeoutMs": 30000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"], "timeoutMs": 15000}
  ]
}
