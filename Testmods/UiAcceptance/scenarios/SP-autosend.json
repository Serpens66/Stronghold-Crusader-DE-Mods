{
  "enabled": true,
  "series": "SP-autosend",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 30000, "stopOnFail": true },
    { "id": "three-ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 30000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 120000, "stopOnFail": true },
    { "id": "resume-briefing", "do": "AutoSend.ResumeBriefing", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "initial-game-screenshot", "do": "Screenshot", "args": ["autosend-initial-game"], "stopOnFail": true },
    { "id": "arm-ui-native", "do": "AutoSend.Arm", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "ui-enabled-screenshot", "do": "Screenshot", "args": ["autosend-ui-enabled"], "stopOnFail": true },
    { "id": "ui-clicks-chore-ack", "do": "AutoSend.UiClicks", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "wood-equal-30-30", "do": "AutoSend.Case", "args": ["fair"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "minimum-60-0", "do": "AutoSend.Case", "args": ["emergency"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "recipient-cap", "do": "AutoSend.Case", "args": ["cap"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "own-reserve", "do": "AutoSend.Case", "args": ["reserve"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "paused-no-transfer", "do": "AutoSend.Case", "args": ["pause"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "disabled-no-transfer", "do": "AutoSend.Case", "args": ["off"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "gold-300-300", "do": "AutoSend.Case", "args": ["gold"], "timeoutMs": 45000, "stopOnFail": true },
    { "id": "native-cases-screenshot", "do": "Screenshot", "args": ["autosend-native-cases"], "stopOnFail": true },
    { "id": "manual-vanilla-gold", "do": "AutoSend.Manual", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "save-native-rules", "do": "AutoSend.Save", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "stop", "do": "AutoSend.Stop", "stopOnFail": true },
    { "id": "quit-for-reload", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "reload-native-rules", "do": "AutoSend.Reload", "timeoutMs": 120000, "stopOnFail": true },
    { "id": "restored-screenshot", "do": "Screenshot", "args": ["autosend-restored-rules"], "stopOnFail": true },
    { "id": "quit-for-fresh", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "fresh-skirmish", "do": "Skirmish.Open", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "fresh-map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 30000, "stopOnFail": true },
    { "id": "fresh-three-ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 30000, "stopOnFail": true },
    { "id": "fresh-play", "do": "Lobby.Play", "timeoutMs": 120000, "stopOnFail": true },
    { "id": "fresh-resume-briefing", "do": "AutoSend.ResumeBriefing", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "fresh-unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "fresh-arm", "do": "AutoSend.Arm", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "fresh-empty", "do": "AutoSend.Empty", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "stop-fresh", "do": "AutoSend.Stop", "stopOnFail": true },
    { "id": "quit", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true }
  ]
}
