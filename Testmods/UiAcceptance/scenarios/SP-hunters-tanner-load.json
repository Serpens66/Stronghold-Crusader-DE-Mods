{
  "enabled": true,
  "series": "SP-hunters-tanner-load",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    { "id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "load", "do": "LoadSave", "args": ["TannerCheck.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "ticks", "do": "WaitTicks", "args": ["100"], "timeoutMs": 30000, "stopOnFail": true },
    { "id": "foreign-after-load", "do": "Tanner.ExpectForeignGood", "stopOnFail": true },
    { "id": "open", "do": "Tanner.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "panel-one", "do": "Tanner.ExpectPanel", "args": ["1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "shot-panel", "do": "Screenshot", "args": ["tanner-load-panel"] },
    { "id": "click-check", "do": "Tanner.SetSlider", "args": ["0"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-click", "do": "Tanner.ExpectPanel", "args": ["0"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "click-back", "do": "Tanner.SetSlider", "args": ["1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-back", "do": "Tanner.ExpectPanel", "args": ["1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "speed", "do": "Speed", "args": ["120"] },
    { "id": "two-meat-after-load", "do": "Tanner.Cycles", "args": ["2", "15"], "timeoutMs": 480000, "stopOnFail": true },
    { "id": "slider-meat", "do": "Tanner.SetSlider", "args": ["0"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-meat", "do": "Tanner.ExpectPanel", "args": ["0"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "only-meat", "do": "Tanner.Cycles", "args": ["0", "22"], "timeoutMs": 480000, "stopOnFail": true },
    { "id": "slider-two", "do": "Tanner.SetSlider", "args": ["2"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-two", "do": "Tanner.ExpectPanel", "args": ["2"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "one-meat", "do": "Tanner.Cycles", "args": ["3", "8"], "timeoutMs": 480000, "stopOnFail": true },
    { "id": "slider-armour", "do": "Tanner.DragSlider", "args": ["3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "panel-armour", "do": "Tanner.ExpectPanel", "args": ["3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "armour-again", "do": "Tanner.Cycles", "args": ["4", "0"], "timeoutMs": 480000, "stopOnFail": true },
    { "id": "drag-repeatedly", "do": "Tanner.DragRepeatedly", "args": ["8"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "foreign-at-end", "do": "Tanner.ExpectForeignGood", "stopOnFail": true },
    { "id": "shot-end", "do": "Screenshot", "args": ["tanner-end"] },
    { "id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000 },
    { "id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000 }
  ]
}
