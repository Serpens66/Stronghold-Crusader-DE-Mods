{
  "enabled": true,
  "series": "SP-spectator-power-cancel",
  "role": "sp",
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true },
    { "id": "host-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableMod", "true"], "stopOnFail": true },
    { "id": "client-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableClientFeatures", "true"], "stopOnFail": true },
    { "id": "perspective-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSpectatorPerspective", "true"], "stopOnFail": true },
    { "id": "tools-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableTestTools", "true"], "stopOnFail": true },
    { "id": "participant-tools-off", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "false"], "stopOnFail": true },
    { "id": "random-events-off", "do": "RandomEvents", "args": ["off"], "stopOnFail": true },
    { "id": "load", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "speed", "do": "Speed", "args": ["90"], "stopOnFail": true },
    { "id": "unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "toolbar", "do": "Spectator.WaitToolbar", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "owner-2", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner2"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "enable-powers", "do": "Spectator.Cmd", "args": ["EnablePowers"], "stopOnFail": true },
    { "id": "begin", "do": "Spectator.PowerCheck.Begin", "timeoutMs": 10000, "stopOnFail": true },
    { "id": "select-first", "do": "Spectator.PowerCheck.Select", "args": ["first", "ArrowVolley", "2"], "stopOnFail": true },
    { "id": "hold-first", "do": "Spectator.PowerCheck.Pending", "args": ["first", "300"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "cancel-first", "do": "Spectator.Cmd", "args": ["CancelPower"], "stopOnFail": true },
    { "id": "first-cancelled", "do": "Spectator.PowerCheck.Cancelled", "args": ["first"], "stopOnFail": true },
    { "id": "capture-empty", "do": "Spectator.PowerCheck.Capture", "args": ["empty"], "stopOnFail": true },
    { "id": "cancel-empty", "do": "Spectator.Cmd", "args": ["CancelPower"], "stopOnFail": true },
    { "id": "empty-invalidated", "do": "Spectator.PowerCheck.Cancelled", "args": ["empty"], "stopOnFail": true },
    { "id": "select-for-owner-switch", "do": "Spectator.PowerCheck.Select", "args": ["switch", "ArrowVolley", "2"], "stopOnFail": true },
    { "id": "hold-before-switch", "do": "Spectator.PowerCheck.Pending", "args": ["switch", "200"], "stopOnFail": true },
    { "id": "owner-1", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner1"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "switch-cancelled", "do": "Spectator.PowerCheck.Cancelled", "args": ["switch"], "stopOnFail": true },
    { "id": "owner-2-again", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner2"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "select-confirm", "do": "Spectator.PowerCheck.Select", "args": ["confirm", "ArrowVolley", "2"], "stopOnFail": true },
    { "id": "hold-confirm", "do": "Spectator.PowerCheck.Pending", "args": ["confirm", "200"], "stopOnFail": true },
    { "id": "confirm-map-target", "do": "Spectator.PowerCheck.Confirm", "args": ["confirm", "210", "210"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "target-executed-once", "do": "Spectator.PowerCheck.Executed", "args": ["confirm"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "select-immediate-gold", "do": "Spectator.PowerCheck.Select", "args": ["gold", "GrantGold", "2"], "stopOnFail": true },
    { "id": "gold-executed-once", "do": "Spectator.PowerCheck.Executed", "args": ["gold"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "select-after-gold", "do": "Spectator.PowerCheck.Select", "args": ["final", "ArrowVolley", "2"], "stopOnFail": true },
    { "id": "hold-final", "do": "Spectator.PowerCheck.Pending", "args": ["final", "200"], "stopOnFail": true },
    { "id": "back-with-active-selection", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "reload", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "unpause-reloaded", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "selection-retired-across-map", "do": "Spectator.PowerCheck.ReplacedMission", "args": ["final"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "back-to-menu", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true }
  ]
}
