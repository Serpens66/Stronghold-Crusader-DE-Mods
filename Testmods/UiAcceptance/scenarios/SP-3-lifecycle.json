{
  "enabled": true,
  "series": "SP-3",
  "role": "sp",
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "tools-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableTestTools", "true"], "stopOnFail": true },
    { "id": "mark-all", "do": "Mark", "args": ["all"] },
    { "id": "load-spectator", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "toolbar-1", "do": "Spectator.WaitToolbar", "timeoutMs": 20000 },
    { "id": "quit-1", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "load-dialog", "do": "MainMenu", "args": ["Load"] },
    { "id": "load-dialog-wait", "do": "Wait", "args": ["1500"] },
    { "id": "load-cancel", "do": "ViewCommand", "args": ["ButtonLoadSaveCommand", "2"] },
    { "id": "menu-after-cancel", "do": "WaitMainMenu", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "load-human", "do": "LoadSave", "args": ["test_gates.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "describe-human", "do": "Describe" },
    { "id": "shot-human", "do": "Screenshot", "args": ["human"] },
    { "id": "quit-2", "do": "QuitToMenu", "timeoutMs": 60000, "stopOnFail": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 20000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 20000 },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 180000, "stopOnFail": true },
    { "id": "describe-new", "do": "Describe" },
    { "id": "no-toolbar-active-player", "do": "Spectator.ExpectNoToolbar", "args": ["2000"], "timeoutMs": 10000 },
    { "id": "shot-new", "do": "Screenshot", "args": ["newmap"] },
    { "id": "quit-3", "do": "QuitToMenu", "timeoutMs": 60000 },
    { "id": "load-spectator-again", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000 },
    { "id": "toolbar-again", "do": "Spectator.WaitToolbar", "timeoutMs": 20000 },
    { "id": "sessions", "do": "ExpectSince", "args": ["all", "SPECTATOR_EDITOR_SESSION_START", "4", "4"] },
    { "id": "session-ends", "do": "ExpectSince", "args": ["all", "SPECTATOR_EDITOR_SESSION_END", "3", "3"] },
    { "id": "quit-4", "do": "QuitToMenu", "timeoutMs": 60000 }
  ]
}
