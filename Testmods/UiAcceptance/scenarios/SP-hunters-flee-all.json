{
  "enabled": true,
  "series": "SP-hunters-flee-all",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "a-set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"]},
    {"id": "a-set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "0"]},
    {"id": "a-set-StartHerdMode", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "StartHerdMode", "0"]},
    {"id": "a-set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "a-set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "a-set-HuntChicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"]},
    {"id": "a-set-HuntRabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"]},
    {"id": "a-set-HuntCamel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"]},
    {"id": "a-set-DeerFleeOnlyInSight", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "DeerFleeOnlyInSight", "true"]},
    {"id": "a-set-HerdsIgnoreFleeingHerds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdsIgnoreFleeingHerds", "true"]},
    {"id": "a-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "a-map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "a-ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "a-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "a-play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "a-remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "a-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "a-unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "a-settle", "do": "Wait", "args": ["1500"], "timeoutMs": 15000},
    {"id": "a-supply", "do": "Hunt.Supply", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "a-speed", "do": "Speed", "args": ["120"]},
    {"id": "a-walled", "do": "Hunt.WalledUnitThenHerd", "args": ["deer"], "timeoutMs": 90000},
    {"id": "a-alive", "do": "Wait", "args": ["500"], "timeoutMs": 5000},
    {"id": "a-calm", "do": "Hunt.ExpectHerdFlight", "args": ["no", "7000"], "timeoutMs": 20000},
    {"id": "a-open", "do": "Hunt.UnitInHerdSector", "args": ["open"], "timeoutMs": 30000},
    {"id": "a-flees", "do": "Hunt.ExpectHerdFlight", "args": ["yes", "15000"], "timeoutMs": 30000},
    {"id": "a-back", "do": "QuitToMenu", "timeoutMs": 30000},
