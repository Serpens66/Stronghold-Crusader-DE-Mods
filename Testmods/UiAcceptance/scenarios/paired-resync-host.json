{
  "enabled": true,
  "quitWhenDone": true,
  "series": "paired-resync-host",
  "role": "host",
  "steps": [
    {"id":"menu","do":"WaitMainMenu","timeoutMs":180000,"allowErrors":true,"stopOnFail":true},
    {"id":"begin","do":"Paired.Begin"},
    {"id":"settings","do":"Paired.HostSettings","stopOnFail":true},
    {"id":"lobby","do":"Mp.Host","args":["DoHostDefault","private"],"timeoutMs":70000,"stopOnFail":true},
    {"id":"map","do":"Lobby.SelectMap","args":["TheJordanValley.map"],"stopOnFail":true},
    {"id":"client","do":"Mp.WaitMembers","args":["2"],"timeoutMs":900000,"stopOnFail":true},
    {"id":"ai","do":"Paired.AddTradingAi","args":["SerpMarketRest4"],"stopOnFail":true},
    {"id":"peace","do":"Lobby.PeaceTime","args":["0"],"stopOnFail":true},
    {"id":"ai-profile","do":"Paired.VerifyTradingAi","timeoutMs":12000,"stopOnFail":false},
    {"id":"peace-readback","do":"Paired.NoPeaceTime","stopOnFail":true},
    {"id":"ready","do":"Mp.Ready","args":["after-peers"],"timeoutMs":180000,"stopOnFail":true},
    {"id":"play","do":"Lobby.Play","timeoutMs":240000,"stopOnFail":true},
    {"id":"real-mp","do":"Mp.ExpectRealMultiplayer","stopOnFail":true},
    {"id":"fixture","do":"Paired.SelectFixture","timeoutMs":12000,"stopOnFail":false},
    {"id":"building-pause-before","do":"Paired.PauseBuildings","timeoutMs":35000,"stopOnFail":false},
    {"id":"market-units","do":"Paired.ExpectMarket","args":["2"],"timeoutMs":150000,"stopOnFail":false},
    {"id":"dig","do":"Paired.CreateMoat","timeoutMs":25000,"stopOnFail":false},
    {"id":"client-moat","do":"Paired.ClientCheckpoint","args":["moat"],"timeoutMs":90000,"stopOnFail":false},
    {"id":"fill","do":"Paired.RemoveMoat","timeoutMs":25000,"stopOnFail":false},
    {"id":"client-soil","do":"Paired.ClientCheckpoint","args":["soil"],"timeoutMs":45000,"stopOnFail":false},
    {"id":"building-pause-after","do":"Paired.CheckPausedBuilding","timeoutMs":12000,"stopOnFail":false},
    {"id":"market-all","do":"Paired.ExpectMarket","args":["2","partial"],"timeoutMs":10000,"stopOnFail":false},
    {"id":"restart-cancel","do":"Paired.Restart","args":["no"],"timeoutMs":60000,"stopOnFail":true},
    {"id":"restart-first","do":"Paired.Restart","args":["yes"],"timeoutMs":160000,"stopOnFail":true},
    {"id":"restart-second","do":"Paired.Restart","args":["yes"],"timeoutMs":160000,"stopOnFail":true},
    {"id":"screenshots","do":"Screenshot","args":["host-final"],"allowErrors":true},
    {"id":"finish","do":"WaitTicks","args":["130"],"timeoutMs":30000,"stopOnFail":true}
  ]
}
