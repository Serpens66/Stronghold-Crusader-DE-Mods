{
  "enabled": true,
  "series": "SP-hunters-blocked-own-chicken",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id":"menu","do":"WaitMainMenu","timeoutMs":60000,"stopOnFail":true,"allowErrors":true},
    {"id":"no-random-events","do":"RandomEvents","args":["off"],"timeoutMs":10000,"stopOnFail":true},
    {"id":"enable","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","EnableMod","true"]},
    {"id":"set-StartHerdMode","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","StartHerdMode","0"]},
    {"id":"set-HerdReturnSeconds","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HerdReturnSeconds","0"]},
    {"id":"set-HerdRangeSize","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HerdRangeSize","0"]},
    {"id":"set-HunterSearchRange","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HunterSearchRange","0"]},
    {"id":"only-goat","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntGoat","false"]},
    {"id":"only-rabbit","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntRabbit","false"]},
    {"id":"only-camel","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntCamel","false"]},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ImprovedPathfinding","true"],"do":"SetModSetting","id":"set-ImprovedPathfinding"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ImprovedTargetSelection","true"],"do":"SetModSetting","id":"set-ImprovedTargetSelection"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntDeer","false"],"do":"SetModSetting","id":"set-HuntDeer"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntChicken","true"],"do":"SetModSetting","id":"set-HuntChicken"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","CollectFreeCorpses","false"],"do":"SetModSetting","id":"set-CollectFreeCorpses"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ChickensPerPlayer","1"],"do":"SetModSetting","id":"set-ChickensPerPlayer"},
    {"args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ChickenRespawnSeconds","300"],"do":"SetModSetting","id":"set-ChickenRespawnSeconds"},
    {"id":"skirmish","do":"Skirmish.Open","timeoutMs":15000,"stopOnFail":true},
    {"id":"map","do":"Lobby.SelectMap","args":["4spielerkarte.map"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"ai","do":"Lobby.AddAI","args":["1","1"],"timeoutMs":15000},
    {"id":"start-places","do":"Lobby.StartPositions","timeoutMs":15000,"stopOnFail":true,"args":["0","1"]},
    {"id":"peace","do":"Lobby.PeaceTime","args":["60"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"play","do":"Lobby.Play","timeoutMs":45000,"stopOnFail":true},
    {"id":"briefing","do":"AiMilitary.ResumeBriefing","timeoutMs":15000},
    {"id":"unpause","do":"Pause","args":["off"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"settle","do":"Wait","args":["4000"],"timeoutMs":15000},
    {"id":"peace-active","do":"Hunt.ExpectPeace","timeoutMs":15000,"stopOnFail":true},
    {"id":"hut","do":"Hunt.PlaceHut","timeoutMs":15000,"stopOnFail":true},
    {"id":"supply","do":"Hunt.Supply","timeoutMs":10000,"stopOnFail":true},
    {"id":"clear-wildlife","do":"Hunt.ClearOtherAnimals","args":["all"],"stopOnFail":true},
    {"id":"hunter","do":"Hunt.WaitHunterFree","timeoutMs":20000,"stopOnFail":true},
    {"id":"speed","do":"Speed","timeoutMs":10000,"stopOnFail":true,"args":["40"]},
    {"id":"fixture","do":"Hunt.BlockedOwnChicken","timeoutMs":20000,"stopOnFail":true},
    {"id":"delivery","do":"Hunt.ExpectCorridorDelivery","timeoutMs":100000,"stopOnFail":true},
    {"id":"first-firing-position","do":"Hunt.ExpectFirstFiringPosition","timeoutMs":5000,"stopOnFail":true},
    {"id":"arrow","do":"Hunt.ExpectCorridorShot","timeoutMs":5000,"stopOnFail":true,"args":["blocked"]},
    {"id":"stop-trace","do":"Hunt.StopCorridorTrace","timeoutMs":5000,"stopOnFail":true}
  ]
}
