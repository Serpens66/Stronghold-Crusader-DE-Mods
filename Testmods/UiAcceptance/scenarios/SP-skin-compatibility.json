{
  "enabled": true,
  "series": "SP-skin-compatibility",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 90000, "stopOnFail": true, "allowErrors": true },
    { "id": "defaults", "do": "ModSettingsDefaults", "stopOnFail": true },
    { "id": "skin", "do": "Skin.Configure", "stopOnFail": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddCustomAi", "args": ["DoNothing"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "positions", "do": "Lobby.StartPositions", "args": ["0", "2"], "stopOnFail": true },
    { "id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "peace-active", "do": "Hunt.ExpectPeace", "stopOnFail": true },
    { "id": "native-ticks", "do": "WaitTicks", "args": ["100"], "timeoutMs": 25000, "stopOnFail": true },
    { "id": "world", "do": "Skin.World", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "extender-override", "do": "Skin.Override" },
    { "id": "animation-lease", "do": "Skin.AnimationLease" },
    { "id": "preview", "do": "Skin.Preview", "timeoutMs": 20000 }
  ]
}
