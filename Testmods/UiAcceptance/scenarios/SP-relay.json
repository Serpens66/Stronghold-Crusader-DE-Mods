{
  "enabled": true,
  "series": "SP-relay",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    { "id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "client-enabled", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableClientFeatures", "true"], "stopOnFail": true },
    { "id": "sp-tools", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "true"], "stopOnFail": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "warmup-unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "speed", "do": "Speed", "args": ["300"] },
    { "id": "ready", "do": "WaitMarker", "args": ["Relay ready", "any"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "toolbar", "do": "Spectator.WaitToolbar", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "ai-settle", "do": "Wait", "args": ["4000"] },
    { "id": "fixture", "do": "Relay.Fixture", "args": ["2", "150", "300"], "stopOnFail": true },

    { "id": "pick", "do": "Relay.PickCheck", "stopOnFail": true },

    {"id": "controls-left", "do": "Relay.Controls", "args": ["left"], "stopOnFail": true},

    {"id": "click-one", "do": "Relay.ClickUnit", "args": ["0"], "stopOnFail": true},
    {"id": "selected-one", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "markers-settle", "do": "Wait", "args": ["300"]},
    {"id": "markers-one", "do": "Screenshot", "args": ["markers-one"]},
    {"id": "move-one", "do": "Relay.MoveExpect", "args": ["0", "1"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "left-other-button", "do": "Relay.ExpectNoOrder", "stopOnFail": true},
    {"id": "right-down", "do": "Relay.RightDown", "stopOnFail": true},
    {"id": "cleared", "do": "Relay.ExpectLog", "args": ["Allied selection cleared"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "box-part", "do": "Relay.BoxUnits", "args": ["1", "7"], "stopOnFail": true},
    {"id": "selected-part", "do": "Relay.ExpectLog", "args": ["Selected allied units: 7 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "move-part", "do": "Relay.MoveExpect", "args": ["1", "7"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "right-down-2", "do": "Relay.RightDown", "stopOnFail": true},

    {"id": "click-shift-1", "do": "Relay.ClickUnit", "args": ["8"], "stopOnFail": true},
    {"id": "click-shift-2", "do": "Relay.ClickUnit", "args": ["9", "shift"], "stopOnFail": true},
    {"id": "selected-shift", "do": "Relay.ExpectLog", "args": ["Selected allied units: 2 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "move-shift", "do": "Relay.MoveExpect", "args": ["8", "2"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "right-down-3", "do": "Relay.RightDown", "stopOnFail": true},

    {"id": "owner-selected", "do": "Relay.MarkOwnerSelected", "args": ["10"], "stopOnFail": true},
    {"id": "click-owner", "do": "Relay.ClickUnit", "args": ["10"], "stopOnFail": true},
    {"id": "selected-owner", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "move-owner", "do": "Relay.MoveExpect", "args": ["10", "1"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "owner-not-skipped", "do": "Relay.ExpectLog", "args": ["skipped=0"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "right-down-4", "do": "Relay.RightDown", "stopOnFail": true},

    {"id": "controls-right", "do": "Relay.Controls", "args": ["right"], "stopOnFail": true},
    {"id": "right-click-unit", "do": "Relay.ClickUnit", "args": ["11"], "stopOnFail": true},
    {"id": "right-selected", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "right-other-button", "do": "Relay.ExpectNoOrder", "stopOnFail": true},
    {"id": "right-move", "do": "Relay.MoveExpect", "args": ["11", "1"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "right-left-ground", "do": "Relay.LeftGround", "stopOnFail": true},
    {"id": "right-cleared", "do": "Relay.ExpectLog", "args": ["Allied selection cleared"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "box-many", "do": "Relay.BoxUnits", "args": ["12", "138"], "stopOnFail": true},
    {"id": "selected-many", "do": "Relay.ExpectLog", "args": ["Selected allied units: 138 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "markers-many-settle", "do": "Wait", "args": ["300"]},
    {"id": "markers-many", "do": "Screenshot", "args": ["markers-many"]},
    {"id": "inject-marks", "do": "Relay.InjectMarks", "args": ["12", "138", "4"], "stopOnFail": true},
    {"id": "move-many", "do": "Relay.MoveExpect", "args": ["12", "138"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "right-left-ground-2", "do": "Relay.LeftGround", "stopOnFail": true},

    {"id": "click-stop", "do": "Relay.ClickUnit", "args": ["12"], "stopOnFail": true},
    {"id": "selected-stop", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "stop-hud", "do": "Relay.ExpectHud", "args": ["on", "1"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "stop", "do": "Relay.PressStop", "args": ["12", "1"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "right-left-ground-3", "do": "Relay.LeftGround", "stopOnFail": true},
    {"id": "motion-wait", "do": "Wait", "args": ["6000"]},
    {"id": "motion", "do": "Relay.CheckMotion", "args": ["12", "13"], "stopOnFail": true},

    {"id": "hud-click", "do": "Relay.ClickUnit", "args": ["14"], "stopOnFail": true},
    {"id": "hud-selected", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-on", "do": "Relay.ExpectHud", "args": ["on", "1"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-settle", "do": "Wait", "args": ["300"]},
    {"id": "hud-shot", "do": "Screenshot", "args": ["hud-troops"]},
    {"id": "hud-stance", "do": "Relay.HudStance", "args": ["14", "3"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "hud-still-on", "do": "Relay.ExpectHud", "args": ["on", "1"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-patrol", "do": "Relay.HudPatrol", "args": ["14"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "hud-arm-cancel", "do": "Relay.HudArm", "stopOnFail": true},
    {"id": "hud-armed", "do": "Relay.ExpectLog", "args": ["Armed Patrol"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-cancel-down", "do": "Relay.RightDown", "stopOnFail": true},
    {"id": "hud-disarmed", "do": "Relay.ExpectLog", "args": ["Disarmed Patrol"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-cancel-up", "do": "Relay.RightUp", "stopOnFail": true},
    {"id": "hud-cancel-settle", "do": "Wait", "args": ["300"]},
    {"id": "hud-left-ground", "do": "Relay.LeftGround", "stopOnFail": true},
    {"id": "hud-off", "do": "Relay.ExpectHud", "args": ["off"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "hud-box", "do": "Relay.BoxUnits", "args": ["15", "5"], "stopOnFail": true},
    {"id": "hud-box-selected", "do": "Relay.ExpectLog", "args": ["Selected allied units: 5 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-box-on", "do": "Relay.ExpectHud", "args": ["on", "5"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-attack", "do": "Relay.HudAttack", "args": ["15"], "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "hud-stop", "do": "Relay.HudStop", "stopOnFail": true},
    {"id": "hud-stop-settle", "do": "Wait", "args": ["500"]},
    {"id": "hud-left-ground-2", "do": "Relay.LeftGround", "stopOnFail": true},
    {"id": "hud-off-2", "do": "Relay.ExpectHud", "args": ["off"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "hud-disband-click", "do": "Relay.ClickUnit", "args": ["20"], "stopOnFail": true},
    {"id": "hud-disband-selected", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-disband-on", "do": "Relay.ExpectHud", "args": ["on", "1"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-disband", "do": "Relay.HudDisband", "args": ["20"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "hud-off-3", "do": "Relay.ExpectHud", "args": ["off"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "hud-filter-box", "do": "Relay.BoxUnits", "args": ["21", "3"], "stopOnFail": true},
    {"id": "hud-filter-selected", "do": "Relay.ExpectLog", "args": ["Selected allied units: 3 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-filter-except", "do": "Relay.HudFilter", "args": ["except"], "stopOnFail": true},
    {"id": "hud-filter-on", "do": "Relay.ExpectHud", "args": ["on", "3"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "hud-filter-type", "do": "Relay.HudFilter", "args": ["type"], "stopOnFail": true},
    {"id": "hud-off-4", "do": "Relay.ExpectHud", "args": ["off"], "timeoutMs": 5000, "stopOnFail": true},

    {"id": "controls-left-2", "do": "Relay.Controls", "args": ["left"], "stopOnFail": true},
    {"id": "box-no-lord", "do": "Relay.BoxUnits", "args": ["13", "3", "lord"], "stopOnFail": true},
    {"id": "selected-no-lord", "do": "Relay.ExpectLog", "args": ["Selected allied units: 3 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "right-down-5", "do": "Relay.RightDown", "stopOnFail": true},
    {"id": "click-lord", "do": "Relay.ClickLord", "stopOnFail": true},
    {"id": "selected-lord", "do": "Relay.ExpectLog", "args": ["Selected allied units: 1 "], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "lord-order", "do": "Relay.LordOrder", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "right-down-6", "do": "Relay.RightDown", "stopOnFail": true},
    {"id": "lord-wait", "do": "Wait", "args": ["6000"]},
    {"id": "lord-moved", "do": "Relay.LordMoved", "stopOnFail": true},

    {"id": "controls-restore", "do": "Relay.Controls", "args": ["restore"], "stopOnFail": true},

    {"id": "soak", "do": "Wait", "args": ["45000"], "timeoutMs": 60000},
    {"id": "soak-groups", "do": "Relay.CheckGroups", "stopOnFail": true},
    {"id": "soak-alive", "do": "Log", "args": ["regrouped-ai-units-still-running"]},

    { "id": "select-self", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner1"], "timeoutMs": 10000 },
    { "id": "settle-select", "do": "Wait", "args": ["500"] },
    { "id": "placement", "do": "Spectator.Cmd", "args": ["Placement"], "stopOnFail": true },
    { "id": "settle-after", "do": "Wait", "args": ["4000"] },
    { "id": "alive", "do": "Log", "args": ["still-responsive"] },
    { "id": "placement-off", "do": "Spectator.Cmd", "args": ["Placement"] },
    { "id": "settle-off", "do": "Wait", "args": ["1000"] },
    { "id": "quit", "do": "QuitToMenu", "timeoutMs": 25000 },
    { "id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000 }
  ]
}
