{
  "enabled": true,
  "series": "SP-hunters-matrix-deer",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "only-deer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "only-goat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "false"]},
    {"id": "only-rabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"]},
    {"id": "only-camel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"]},
    {"id": "only-chicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"]},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "animals", "do": "Hunt.LogAnimals"},
    {"id": "hut", "do": "Hunt.PlaceHut", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "open-start", "do": "Hunt.ExpectOpenStart", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "supply", "do": "Hunt.Supply", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["250"]},
    {"id": "settle-hunter", "do": "Wait", "args": ["6000"], "timeoutMs": 15000},
    {"id": "free-prey", "do": "Hunt.Prey", "args": ["deer", "24", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "free-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "free-carried", "do": "Hunt.ExpectCarries", "args": ["1"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "free-free", "do": "Hunt.WaitHunterFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "free-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "wall", "do": "Hunt.SightWall", "args": ["11", "9"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "wall-prey", "do": "Hunt.Prey", "args": ["deer", "18", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "wall-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "wall-carried", "do": "Hunt.ExpectCarries", "args": ["1"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "wall-free", "do": "Hunt.WaitHunterFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "wall-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "building", "do": "Hunt.SightBuilding", "args": ["-12", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "building-prey", "do": "Hunt.Prey", "args": ["deer", "-20", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "building-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "building-carried", "do": "Hunt.ExpectCarries", "args": ["1"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "building-free", "do": "Hunt.WaitHunterFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "building-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "ring", "do": "Hunt.Ring", "args": ["plug"], "timeoutMs": 120000, "stopOnFail": true},
    {"id": "ring-prey", "do": "Hunt.Prey", "args": ["deer", "ring"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ring-ignored", "do": "Hunt.ExpectNoDeerTarget", "args": ["15000"], "timeoutMs": 30000, "stopOnFail": true},
    {"id": "ring-open", "do": "Hunt.OpenRing", "timeoutMs": 30000, "stopOnFail": true},
    {"id": "ring-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "ring-carried", "do": "Hunt.ExpectCarries", "args": ["1"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "ring-free", "do": "Hunt.WaitHunterFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "ring-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "cut", "do": "Hunt.Ring", "args": ["gap"], "timeoutMs": 120000, "stopOnFail": true},
    {"id": "cut-prey", "do": "Hunt.Prey", "args": ["deer", "ring"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "cut-target", "do": "Hunt.ExpectDeerTarget", "timeoutMs": 60000, "stopOnFail": true},
    {"id": "cut-close", "do": "Hunt.CloseRing", "timeoutMs": 30000, "stopOnFail": true},
    {"id": "cut-dropped", "do": "Hunt.ExpectTargetDropped", "timeoutMs": 30000, "stopOnFail": true},
    {"id": "cut-clear", "do": "Hunt.ClearPrey", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "second-hut", "do": "Hunt.SecondHut", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "two-clear-others", "do": "Hunt.ClearOtherAnimals", "args": ["all"], "timeoutMs": 10000},
    {"id": "two-free", "do": "Hunt.WaitHuntersFree", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "two-prey-a", "do": "Hunt.Prey", "args": ["deer", "26", "6"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "two-prey-b", "do": "Hunt.Prey", "args": ["deer", "26", "-6"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "two-targets", "do": "Hunt.ExpectSeparateTargets", "args": ["8000"], "timeoutMs": 30000, "stopOnFail": true},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-deer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "restore-goat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "restore-rabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "true"]},
    {"id": "restore-camel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "true"]},
    {"id": "restore-chicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"]},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
