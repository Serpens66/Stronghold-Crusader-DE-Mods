{
  "enabled": true,
  "series": "SP-hunters-ai-castles",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 90000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "ih-enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"], "stopOnFail": true},
    {"id": "ih-control-aiv", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ControlAivHunters", "true"], "stopOnFail": true},
    {"id": "ih-auto-build", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "AutoBuildHunters", "true"], "stopOnFail": true},
    {"id": "ih-retire", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RetireEmptyHunters", "true"], "stopOnFail": true},
    {"id": "ih-no-deer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "false"], "stopOnFail": true},
    {"id": "ih-no-goats", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "false"], "stopOnFail": true},
    {"id": "ih-no-rabbits", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"], "stopOnFail": true},
    {"id": "ih-no-camels", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"], "stopOnFail": true},
    {"id": "ih-hunt-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"], "stopOnFail": true},
    {"id": "ih-chicken-population", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickensPerPlayer", "10"], "stopOnFail": true},
    {"id": "ih-chicken-renewal", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickenRespawnSeconds", "30"], "stopOnFail": true},
    {"id": "ih-no-start-herds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "StartHerdMode", "0"], "stopOnFail": true},
    {"id": "ih-no-return-herds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"], "stopOnFail": true},
    {"id": "disable-castle-planner", "do": "SetModSetting", "args": ["CastlePlanner.CastlePlannerPlugin::processSettings", "EnableMod", "false"], "stopOnFail": true},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["Distant Encounters.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "add-seven-pigs", "do": "Lobby.AddAI", "args": ["2", "7"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "start-positions", "do": "Lobby.StartPositions", "args": ["0", "1", "2", "3", "4", "5", "6", "7"], "stopOnFail": true},
    {"id": "starting-goods", "do": "Lobby.Button", "args": ["GameType3"], "stopOnFail": true},
    {"id": "prebuilt-castles", "do": "Lobby.Prebuild", "stopOnFail": true},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "arm-before-prebuild", "do": "HuntAiCastles.Arm", "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 90000, "stopOnFail": true},
    {"id": "begin", "do": "HuntAiCastles.Begin", "stopOnFail": true},
    {"id": "prebuilt-snapshot", "do": "HuntAiCastles.Snapshot", "args": ["prebuilt", "0"], "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["120"], "stopOnFail": true},
    {"id": "observe-natural-start", "do": "WaitTicks", "args": ["4500"], "timeoutMs": 150000, "stopOnFail": true},
    {"id": "first-cycle-snapshot", "do": "HuntAiCastles.Snapshot", "args": ["first-cycle", "1"], "stopOnFail": true},
    {"id": "supply-retry", "do": "HuntAiCastles.SupplyHutCosts", "stopOnFail": true},
    {"id": "observe-hunting", "do": "WaitTicks", "args": ["2200"], "timeoutMs": 120000, "stopOnFail": true},
    {"id": "retry-snapshot", "do": "HuntAiCastles.Snapshot", "args": ["retry", "1", "1"], "stopOnFail": true},
    {"id": "end", "do": "HuntAiCastles.End", "stopOnFail": true}
  ]
}
