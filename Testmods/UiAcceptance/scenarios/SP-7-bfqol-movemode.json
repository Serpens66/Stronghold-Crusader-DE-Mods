{
  "enabled": true,
  "series": "SP-7",
  "role": "sp",
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "wrapper", "do": "WaitMarker", "args": ["player-move wrapper reference-rva=0x196100", "any"], "timeoutMs": 5000, "allowErrors": true },
    { "id": "load", "do": "LoadSave", "args": ["test_gates.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "select", "do": "SelectOwnUnits", "args": ["1", "8"], "stopOnFail": true },
    { "id": "group", "do": "WaitGroup", "args": ["1", "1"], "timeoutMs": 20000, "stopOnFail": true },
    { "id": "scan", "do": "RegionScan", "args": ["4", "4", "796", "796", "6"], "stopOnFail": true },
    { "id": "mark", "do": "Mark", "args": ["probe"] },
    { "id": "arm-0", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c0", "do": "PlayerMove", "args": ["1", "c0", "0"] },
    { "id": "arm-1", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c1", "do": "PlayerMove", "args": ["1", "c1", "0"] },
    { "id": "arm-2", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c2", "do": "PlayerMove", "args": ["1", "c2", "0"] },
    { "id": "arm-3", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c3", "do": "PlayerMove", "args": ["1", "c3", "0"] },
    { "id": "arm-4", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c4", "do": "PlayerMove", "args": ["1", "c4", "0"] },
    { "id": "arm-5", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c5", "do": "PlayerMove", "args": ["1", "c5", "0"] },
    { "id": "arm-6", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c6", "do": "PlayerMove", "args": ["1", "c6", "0"] },
    { "id": "arm-7", "do": "PlayerMove", "args": ["1", "rel:3:3", "80"] },
    { "id": "c7", "do": "PlayerMove", "args": ["1", "c7", "0"] },
    { "id": "accepted-reachable", "do": "ExpectSince", "args": ["probe", "PLAYER_MOVE .*flags=0x80 .*accepted=True", "1"] },
    { "id": "note", "do": "Log", "args": ["compare accepted/rejected per candidate and moveMode with SP-7b (Vanilla control)"] },
    { "id": "reachable-normal", "do": "PlayerMove", "args": ["1", "rel:2:0", "0"] },
    { "id": "mode-0", "do": "ExpectMoveMode", "args": ["1", "0"] },
    { "id": "run", "do": "WaitTicks", "args": ["100"], "timeoutMs": 60000 },
    { "id": "quit", "do": "QuitToMenu", "timeoutMs": 90000 }
  ]
}
