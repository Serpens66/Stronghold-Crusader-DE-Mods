{
  "enabled": true,
  "series": "SP-gate-automation",
  "role": "sp",
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "mod-defaults", "do": "ModSettingsDefaults", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-client", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableClientFeatures", "true"], "stopOnFail": true},
    {"id": "own-no-tools", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "false"], "stopOnFail": true},
    {"id": "own-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "own-map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "own-ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "own-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "own-play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "own-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "own-unpause", "do": "Pause", "args": ["off"], "stopOnFail": true},
    {"id": "own-speed", "do": "Speed", "args": ["250"]},
    {"id": "own-settle", "do": "Wait", "args": ["2000"]},
    {"id": "own-gate", "do": "Gate.Place", "args": ["own", "local", "MAPPER_GATE_STONE1A", "STRUCT_GATE_INNER", "12"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-click", "do": "Gate.Click", "args": ["own"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-button", "do": "Gate.ExpectButton", "args": ["own"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-start-automatic", "do": "Gate.ExpectManual", "args": ["false"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "own-shot", "do": "Screenshot", "args": ["own-gate"]},
    {"id": "own-manual-click", "do": "NoesisClick", "args": ["ExtraFeaturesGatehouseAutomationButton"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-manual", "do": "Gate.ExpectManual", "args": ["true"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-manual-shot", "do": "Screenshot", "args": ["own-gate-manual"]},
    {"id": "own-auto-click", "do": "NoesisClick", "args": ["ExtraFeaturesGatehouseAutomationButton"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-auto", "do": "Gate.ExpectManual", "args": ["false"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "own-close", "do": "Hud", "args": ["default"]},
    {"id": "own-closed", "do": "Gate.ExpectNoButton", "args": ["1500"]},
    {"id": "own-quit", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true},

    {"id": "spec-tools", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "true"], "stopOnFail": true},
    {"id": "spec-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "spec-map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "spec-ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "spec-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "spec-play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "spec-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "spec-unpause", "do": "Pause", "args": ["off"], "stopOnFail": true},
    {"id": "spec-speed", "do": "Speed", "args": ["250"]},
    {"id": "spec-toolbar", "do": "Spectator.WaitToolbar", "timeoutMs": 20000, "stopOnFail": true},
    {"id": "spec-settle", "do": "Wait", "args": ["2000"]},
    {"id": "spec-gate", "do": "Gate.Place", "args": ["ai", "ai", "MAPPER_GATE_STONE1A", "STRUCT_GATE_INNER", "12"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-owner", "do": "Gate.SpectatorOwner", "args": ["ai"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-click", "do": "Gate.Click", "args": ["ai"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-acquired", "do": "WaitMarker", "args": ["TEST_GATE_HUD_TRANSITION reason=acquire", "any"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-button", "do": "Gate.ExpectButton", "args": ["ai"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-start-automatic", "do": "Gate.ExpectManual", "args": ["false"], "timeoutMs": 5000, "stopOnFail": true},
    {"id": "spec-shot", "do": "Screenshot", "args": ["spectator-gate"]},
    {"id": "spec-mark-manual", "do": "Mark", "args": ["manual"]},
    {"id": "spec-manual-click", "do": "NoesisClick", "args": ["ExtraFeaturesGatehouseAutomationButton"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-manual", "do": "Gate.ExpectManual", "args": ["true"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-manual-action", "do": "ExpectSince", "args": ["manual", "TEST_ACTION .*kind=BuildingAction .*result=", "1", "1"], "stopOnFail": true},
    {"id": "spec-mark-auto", "do": "Mark", "args": ["auto"]},
    {"id": "spec-auto-click", "do": "NoesisClick", "args": ["ExtraFeaturesGatehouseAutomationButton"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-auto", "do": "Gate.ExpectManual", "args": ["false"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "spec-auto-action", "do": "ExpectSince", "args": ["auto", "TEST_ACTION .*kind=BuildingAction .*result=", "1", "1"], "stopOnFail": true},
    {"id": "spec-tools-off", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true},
    {"id": "restore-test-mode", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "false"]},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"]}
  ]
}
