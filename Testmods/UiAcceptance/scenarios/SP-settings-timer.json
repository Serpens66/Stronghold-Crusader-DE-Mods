{
  "enabled": true,
  "series": "SP-settings-timer",
  "role": "sp",
  "quitDelayMs": 0,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "settle", "do": "Wait", "args": ["3000"] },
    { "id": "edit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickenMeat", "23"], "stopOnFail": true },
    { "id": "quiet-period", "do": "Wait", "args": ["3000"] }
  ]
}
