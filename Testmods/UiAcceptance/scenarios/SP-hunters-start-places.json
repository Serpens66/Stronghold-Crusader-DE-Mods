{
  "enabled": true,
  "series": "SP-hunters-start-places",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "s0-set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"]},
    {"id": "s0-set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "0"]},
    {"id": "s0-set-StartHerdMode", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "StartHerdMode", "1"]},
    {"id": "s0-set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "s0-set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "s0-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "s0-map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "s0-ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "s0-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "s0-play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "s0-remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "s0-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "s0-unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "s0-speed", "do": "Speed", "args": ["300"]},
    {"id": "s0-new", "do": "Hunt.ExpectNewHerds", "args": ["deer", "-1", "9"], "timeoutMs": 30000},
    {"id": "s0-back", "do": "QuitToMenu", "timeoutMs": 30000},
