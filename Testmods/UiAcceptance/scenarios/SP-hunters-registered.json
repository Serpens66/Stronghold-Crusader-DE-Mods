{
  "enabled": true,
  "series": "SP-hunters-registered",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "set-StartHerdMode", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "StartHerdMode", "0"]},
    {"id": "set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"]},
    {"id": "set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "0"]},
    {"id": "set-HunterSearchRange", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HunterSearchRange", "0"]},
    {"id": "register-crocodile", "do": "Hunt.RegisterPrey", "args": ["crocodile"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "start-places", "do": "Lobby.StartPositions", "args": ["0", "1"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "hut", "do": "Hunt.PlaceHut", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "supply", "do": "Hunt.Supply", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "clear-animals", "do": "Hunt.ClearOtherAnimals", "args": ["all"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["250"]},
    {"id": "settle-hunter", "do": "Wait", "args": ["6000"], "timeoutMs": 15000},
    {"id": "crocodile", "do": "Hunt.Prey", "args": ["crocodile", "8", "0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "crocodile-target", "do": "Hunt.ExpectTargetType", "args": ["crocodile"], "timeoutMs": 90000, "stopOnFail": true},
    {"id": "lease-released", "do": "Hunt.ExpectLeaseReleased", "args": ["crocodile", "40", "12"], "timeoutMs": 60000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
