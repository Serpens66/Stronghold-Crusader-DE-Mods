    {"id": "w-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000},
    {"id": "w-play", "do": "Lobby.Play", "timeoutMs": 45000},
    {"id": "w-remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000},
    {"id": "w-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "w-unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000},
    {"id": "w-speed", "do": "Speed", "args": ["300"]},
    {"id": "w-track", "do": "Hunt.TrackRange", "args": ["100", "120000", "inside", "40"], "timeoutMs": 150000},
    {"id": "w-menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
