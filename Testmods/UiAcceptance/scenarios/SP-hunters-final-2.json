{
  "enabled": true,
  "series": "SP-hunters-final-2",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "g-set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"]},
    {"id": "g-set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "100"]},
    {"id": "g-set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "g-set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "g-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000},
    {"id": "g-map", "do": "Lobby.SelectMap", "args": ["testanimals.map"], "timeoutMs": 15000},
    {"id": "g-ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "g-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000},
    {"id": "g-play", "do": "Lobby.Play", "timeoutMs": 45000},
    {"id": "g-remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000},
    {"id": "g-clear-others", "do": "Hunt.ClearOtherAnimals", "timeoutMs": 15000},
    {"id": "g-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "g-unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000},
    {"id": "g-speed", "do": "Speed", "args": ["300"]},
    {"id": "g-track", "do": "Hunt.TrackRange", "args": ["100", "120000", "inside", "12"], "timeoutMs": 150000},
    {"id": "g-pick", "do": "Hunt.PickHerd", "args": ["deer", "0"], "timeoutMs": 60000},
    {"id": "g-send", "do": "Hunt.SendHerdAway", "args": ["90"], "timeoutMs": 15000},
    {"id": "g-back", "do": "Hunt.ExpectHerdBack", "args": ["100", "90"], "timeoutMs": 180000},
    {"id": "g-menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "h-set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "0"]},
    {"id": "h-set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "100"]},
    {"id": "h-set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "h-set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "h-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000},
    {"id": "h-map", "do": "Lobby.SelectMap", "args": ["testanimals.map"], "timeoutMs": 15000},
    {"id": "h-ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "h-peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000},
    {"id": "h-play", "do": "Lobby.Play", "timeoutMs": 45000},
    {"id": "h-remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000},
    {"id": "h-clear-others", "do": "Hunt.ClearOtherAnimals", "timeoutMs": 15000},
    {"id": "h-briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "h-unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000},
    {"id": "h-speed", "do": "Speed", "args": ["300"]},
    {"id": "h-track", "do": "Hunt.TrackRange", "args": ["100", "120000", "inside", "12"], "timeoutMs": 150000},
    {"id": "h-pick", "do": "Hunt.PickHerd", "args": ["deer", "0"], "timeoutMs": 60000},
    {"id": "h-send", "do": "Hunt.SendHerdAway", "args": ["90"], "timeoutMs": 15000},
    {"id": "h-back", "do": "Hunt.ExpectHerdBack", "args": ["100", "90"], "timeoutMs": 180000},
