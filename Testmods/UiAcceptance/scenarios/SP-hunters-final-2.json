    {"id": "w-set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "100"]},
    {"id": "w-set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "w-set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "w-skirmish", "do": "Skirmish.Open", "timeoutMs": 15000},
    {"id": "w-map", "do": "Lobby.SelectMap", "args": ["testanimals.map"], "timeoutMs": 15000},
