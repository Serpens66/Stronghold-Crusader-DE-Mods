{
  "enabled": true,
  "series": "SP-fire-escape",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    { "id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "avoid-fire", "do": "SetModSetting", "args": ["Pathfinding.PathfindingPlugin::processRoot.Settings", "AvoidFire", "true"], "stopOnFail": true },
    { "id": "escape-fire", "do": "SetModSetting", "args": ["Pathfinding.PathfindingPlugin::processRoot.Settings", "EscapeFire", "true"], "stopOnFail": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddAI", "args": ["1", "3"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "warmup-unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "speed", "do": "Speed", "args": ["300"] },
    { "id": "frozen", "do": "WaitMarker", "args": ["avoidFire=True", "any"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai-settle", "do": "Wait", "args": ["4000"] },

    { "id": "fixture-1", "do": "FireEscape.Fixture", "args": ["2", "6", "1500"], "timeoutMs": 10000 },
    { "id": "ignite-1", "do": "FireEscape.Ignite" },
    { "id": "escape-1", "do": "FireEscape.Expect", "args": ["30000", "3"], "timeoutMs": 40000 },
    { "id": "shot-1", "do": "Screenshot", "args": ["fire-escape-1"] },
    { "id": "settle-1", "do": "Wait", "args": ["5000"] },

    { "id": "fixture-2", "do": "FireEscape.Fixture", "args": ["2", "9", "1500"], "timeoutMs": 10000 },
    { "id": "ignite-2", "do": "FireEscape.Ignite" },
    { "id": "escape-2", "do": "FireEscape.Expect", "args": ["30000", "3"], "timeoutMs": 40000 },
    { "id": "shot-2", "do": "Screenshot", "args": ["fire-escape-2"] },

    { "id": "quit", "do": "QuitToMenu", "timeoutMs": 25000 },
    { "id": "restore-avoid-fire", "do": "SetModSetting", "args": ["Pathfinding.PathfindingPlugin::processRoot.Settings", "AvoidFire", "false"], "timeoutMs": 10000 },
    { "id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000 }
  ]
}
