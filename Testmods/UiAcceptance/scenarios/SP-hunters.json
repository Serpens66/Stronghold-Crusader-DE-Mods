{
  "enabled": true,
  "series": "SP-hunters",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    { "id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"], "stopOnFail": true },
    { "id": "hunt", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"], "stopOnFail": true },
    { "id": "count", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickensPerPlayer", "4"], "stopOnFail": true },
    { "id": "meat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickenMeat", "37"], "stopOnFail": true },
    { "id": "rabbits", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RabbitsOnlyOnOrder", "true"], "stopOnFail": true },
    { "id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000 },
    { "id": "unpause", "do": "Pause", "args": ["off"], "stopOnFail": true },
    { "id": "installed", "do": "WaitMarker", "args": ["Improved Hunters runtime enabled", "any"], "timeoutMs": 5000 },
    { "id": "settle", "do": "Wait", "args": ["4000"] },
    { "id": "speed", "do": "Speed", "args": ["120"] },
    { "id": "rabbit-fixture", "do": "Hunt.Rabbits", "args": ["3", "3"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "rabbits-ignored", "do": "Hunt.RabbitsAlive", "args": ["12000"], "timeoutMs": 30000 },
    { "id": "shot-rabbits-ignored", "do": "Screenshot", "args": ["rabbits-ignored"] },
    { "id": "rabbit-order", "do": "Hunt.AttackRabbit", "args": ["0"], "timeoutMs": 10000 },
    { "id": "rabbit-killed", "do": "Hunt.RabbitDead", "args": ["0"], "timeoutMs": 60000 },
    { "id": "rabbit-follow-1", "do": "Hunt.RabbitDead", "args": ["1"], "timeoutMs": 60000 },
    { "id": "rabbit-follow-2", "do": "Hunt.RabbitDead", "args": ["2"], "timeoutMs": 60000 },
    { "id": "hut", "do": "Hunt.PlaceHut", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "chickens", "do": "Hunt.ExpectChickens", "args": ["4", "1"], "timeoutMs": 120000 },
    { "id": "chickens-walk", "do": "Hunt.ExpectChickens", "args": ["4", "6"], "timeoutMs": 90000 },
    { "id": "shot-chickens", "do": "Screenshot", "args": ["chickens"] },
    { "id": "cycle", "do": "Hunt.Cycle", "args": ["37"], "timeoutMs": 240000, "stopOnFail": true },
    { "id": "shot-after", "do": "Screenshot", "args": ["after-cycle"] },
    { "id": "refill", "do": "Hunt.ExpectChickens", "args": ["4", "1"], "timeoutMs": 90000 },
    { "id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000 },
    { "id": "restore-count", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickensPerPlayer", "10"] },
    { "id": "restore-meat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "ChickenMeat", "1"] }
  ]
}
