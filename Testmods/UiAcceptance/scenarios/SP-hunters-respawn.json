{
  "enabled": true,
  "series": "SP-hunters-respawn",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "set-EnableMod", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "set-HerdReturnSeconds", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdReturnSeconds", "30"]},
    {"id": "set-HerdRangeSize", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HerdRangeSize", "0"]},
    {"id": "set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["testanimals.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "remember", "do": "Hunt.RememberStarts", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "clear-others", "do": "Hunt.ClearOtherAnimals", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["300"]},
    {"id": "pick", "do": "Hunt.PickHerd", "args": ["deer", "0"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "leave-one", "do": "Hunt.KillHerd", "args": ["1"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "one-left-no-return", "do": "Hunt.ExpectNoReturn", "args": ["4000"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "one-left-grows", "do": "Hunt.ExpectHerdGrows", "args": ["3"], "timeoutMs": 120000, "stopOnFail": true},
    {"id": "kill-rest", "do": "Hunt.KillHerd", "args": ["0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "wait-holds", "do": "Hunt.ExpectNoReturn", "args": ["1100"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "returns", "do": "Hunt.ExpectReturn", "args": ["1200", "3900"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "watch-returned", "do": "Hunt.WatchHerds", "args": ["40000", "4000"], "timeoutMs": 60000},
    {"id": "grows", "do": "Hunt.ExpectHerdGrows", "args": ["4"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "pick-goat-moved", "do": "Hunt.PickHerd", "args": ["goat", "25"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "kill-goat", "do": "Hunt.KillHerd", "args": ["0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "goat-returns", "do": "Hunt.ExpectReturn", "args": ["1200", "3900"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "pick-deer-moved", "do": "Hunt.PickHerd", "args": ["deer", "25"], "timeoutMs": 180000, "stopOnFail": true},
    {"id": "kill-deer-moved", "do": "Hunt.KillHerd", "args": ["0"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "deer-moved-returns", "do": "Hunt.ExpectReturn", "args": ["1200", "3900"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "herds-end", "do": "Hunt.LogHerds", "args": ["end"], "timeoutMs": 15000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
