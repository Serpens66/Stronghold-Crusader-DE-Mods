{
  "enabled": true,
  "series": "SP-ai-box",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {
      "id": "menu",
      "do": "WaitMainMenu",
      "timeoutMs": 60000,
      "stopOnFail": true,
      "allowErrors": true
    },
    {
      "id": "viewport-1080",
      "do": "Resolution",
      "args": [
        "1920",
        "1080",
        "set"
      ],
      "timeoutMs": 10000,
      "stopOnFail": true
    },
    {
      "id": "client-enabled",
      "do": "SetModSetting",
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableClientFeatures",
        "true"
      ],
      "stopOnFail": true
    },
    {
      "id": "sp-tools",
      "do": "SetModSetting",
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableSingleplayerTestMode",
        "true"
      ],
      "stopOnFail": true
    },
    {
      "id": "editor-tools-off",
      "do": "SetModSetting",
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableTestTools",
        "false"
      ],
      "stopOnFail": true
    },
    {
      "id": "skirmish",
      "do": "Skirmish.Open",
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "map",
      "do": "Lobby.SelectMap",
      "args": [
        "4spielerkarte.map"
      ],
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "ai",
      "do": "Lobby.AddAI",
      "args": [
        "1",
        "1"
      ],
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "play",
      "do": "Lobby.Play",
      "timeoutMs": 45000,
      "stopOnFail": true
    },
    {
      "id": "briefing",
      "do": "AiMilitary.ResumeBriefing",
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "warmup-unpause",
      "do": "Pause",
      "args": [
        "off"
      ],
      "stopOnFail": true
    },
    {
      "id": "owner-ready",
      "do": "AiMilitary.WaitOwner",
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "sp-ui",
      "do": "AiUi.Prepare",
      "args": [
        "sp",
        "ai"
      ],
      "timeoutMs": 15000,
      "stopOnFail": true
    },
    {
      "id": "sp-role",
      "do": "AiUi.Select",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "SiegeEngineers",
        "Additional",
        "false"
      ]
    },
    {
      "id": "sp-box-full",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "full"
      ]
    },
    {
      "id": "sp-1080-shot",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-sp-docked"
      ]
    },
    {
      "id": "sp-resolution-1440",
      "do": "Resolution",
      "timeoutMs": 10000,
      "stopOnFail": true,
      "args": [
        "2560",
        "1440",
        "set"
      ]
    },
    {
      "id": "sp-layout-1440",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "layout"
      ]
    },
    {
      "id": "sp-shot-1440",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-sp-docked"
      ]
    },
    {
      "id": "sp-resolution-2160",
      "do": "Resolution",
      "timeoutMs": 10000,
      "stopOnFail": true,
      "args": [
        "3840",
        "2160",
        "set"
      ]
    },
    {
      "id": "sp-layout-2160",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "layout"
      ]
    },
    {
      "id": "sp-shot-2160",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-sp-docked"
      ]
    },
    {
      "id": "sp-cancel",
      "do": "AiUi.Cancel",
      "timeoutMs": 30000,
      "stopOnFail": true
    },
    {
      "id": "sp-menu",
      "do": "QuitToMenu",
      "timeoutMs": 25000,
      "stopOnFail": true
    },
    {
      "id": "editor-tools-on",
      "do": "SetModSetting",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableTestTools",
        "true"
      ]
    },
    {
      "id": "editor-resolution-1080",
      "do": "Resolution",
      "timeoutMs": 10000,
      "stopOnFail": true,
      "args": [
        "1920",
        "1080",
        "set"
      ]
    },
    {
      "id": "editor",
      "do": "Editor.Start",
      "timeoutMs": 30000,
      "stopOnFail": true
    },
    {
      "id": "editor-ui",
      "do": "AiUi.Prepare",
      "timeoutMs": 15000,
      "stopOnFail": true,
      "args": [
        "editor",
        "2"
      ]
    },
    {
      "id": "editor-role",
      "do": "AiUi.Select",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "SiegeEngineers",
        "Additional",
        "false"
      ]
    },
    {
      "id": "editor-box-full",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "full"
      ]
    },
    {
      "id": "editor-1080-shot",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-editor-docked"
      ]
    },
    {
      "id": "editor-resolution-1440",
      "do": "Resolution",
      "timeoutMs": 10000,
      "stopOnFail": true,
      "args": [
        "2560",
        "1440",
        "set"
      ]
    },
    {
      "id": "editor-layout-1440",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "layout"
      ]
    },
    {
      "id": "editor-shot-1440",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-editor-docked"
      ]
    },
    {
      "id": "editor-resolution-2160",
      "do": "Resolution",
      "timeoutMs": 10000,
      "stopOnFail": true,
      "args": [
        "3840",
        "2160",
        "set"
      ]
    },
    {
      "id": "editor-layout-2160",
      "do": "AiUi.Box",
      "timeoutMs": 100000,
      "stopOnFail": true,
      "args": [
        "layout"
      ]
    },
    {
      "id": "editor-shot-2160",
      "do": "Screenshot",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "ai-box-editor-docked"
      ]
    },
    {
      "id": "editor-menu",
      "do": "AiUi.Menu",
      "timeoutMs": 30000,
      "stopOnFail": true
    },
    {
      "id": "editor-no-toolbar",
      "do": "Spectator.ExpectNoToolbar",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "200"
      ]
    },
    {
      "id": "editor-quit",
      "do": "QuitToMenu",
      "timeoutMs": 25000,
      "stopOnFail": true
    },
    {
      "id": "restore-tools-off",
      "do": "SetModSetting",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableTestTools",
        "false"
      ]
    },
    {
      "id": "restore-sp-off",
      "do": "SetModSetting",
      "timeoutMs": 30000,
      "stopOnFail": true,
      "args": [
        "Spectator.SpectatorPlugin::processRoot.Settings",
        "EnableSingleplayerTestMode",
        "false"
      ]
    }
  ]
}
