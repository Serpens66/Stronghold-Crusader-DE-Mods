{
  "enabled": true,
  "series": "SP-hunters-flee",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "no-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"]},
    {"id": "no-rabbits", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"]},
    {"id": "no-camels", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"]},
    {"id": "respawn", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RespawnWildlife", "false"]},
    {"id": "flee-rule", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "DeerFleeOnlyInSight", "true"]},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "animals", "do": "Hunt.LogAnimals"},
    {"id": "supply", "do": "Hunt.Supply", "timeoutMs": 10000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["80"]},
    {"id": "wildlife", "do": "Hunt.SpawnHerd", "args": ["deer"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "herd-alive", "do": "Wait", "args": ["3000"], "timeoutMs": 15000},
    {"id": "speed-normal", "do": "Speed", "args": ["40"]},
    {"id": "baseline", "do": "Hunt.ExpectHerdFlight", "args": ["no", "8000"], "timeoutMs": 20000, "stopOnFail": true},
    {"id": "walled-unit", "do": "Hunt.UnitInHerdSector", "args": ["walled"], "timeoutMs": 60000, "stopOnFail": true},
    {"id": "shot-walled", "do": "Screenshot", "args": ["flee-walled"]},
    {"id": "calm", "do": "Hunt.ExpectHerdFlight", "args": ["no", "20000"], "timeoutMs": 40000, "stopOnFail": true},
    {"id": "open-unit", "do": "Hunt.UnitInHerdSector", "args": ["open"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "flees", "do": "Hunt.ExpectHerdFlight", "args": ["yes", "30000"], "timeoutMs": 45000, "stopOnFail": true},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-chickens", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "true"]},
    {"id": "restore-rabbits", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "true"]},
    {"id": "restore-camels", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "true"]},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
