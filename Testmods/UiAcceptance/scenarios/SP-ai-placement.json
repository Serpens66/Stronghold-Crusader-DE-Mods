{
  "enabled": true,
  "series": "SP-ai-placement",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id":"menu","do":"WaitMainMenu","timeoutMs":60000,"stopOnFail":true,"allowErrors":true},
    {"id":"client-enabled","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableClientFeatures","true"],"stopOnFail":true},
    {"id":"sp-tools","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableSingleplayerTestMode","true"],"stopOnFail":true},
    {"id":"editor-tools-off","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableTestTools","false"],"stopOnFail":true},
    {"id":"skirmish","do":"Skirmish.Open","timeoutMs":15000,"stopOnFail":true},
    {"id":"map","do":"Lobby.SelectMap","args":["4spielerkarte.map"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"ai","do":"Lobby.AddAI","args":["1","1"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"play","do":"Lobby.Play","timeoutMs":45000,"stopOnFail":true},
    {"id":"briefing","do":"AiMilitary.ResumeBriefing","timeoutMs":15000,"stopOnFail":true},
    {"id":"warmup-unpause","do":"Pause","args":["off"],"stopOnFail":true},
    {"id":"owner-ready","do":"AiMilitary.WaitOwner","timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-ui","do":"AiUi.Prepare","args":["sp","ai"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-normal-selection","do":"AiUi.SelectionTransitions","timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-none","do":"AiUi.Select","args":["None","Regular"],"stopOnFail":true},
    {"id":"sp-none-map","do":"AiUi.Place","stopOnFail":true},
    {"id":"sp-none-result","do":"AiUi.Check","args":["Applied","None","normal"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-regular","do":"AiUi.Select","args":["SiegeEngineers","Regular"],"stopOnFail":true},
    {"id":"sp-regular-map","do":"AiUi.Place","stopOnFail":true},
    {"id":"sp-regular-result","do":"AiUi.Check","args":["Applied","None","normal"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-extra","do":"AiUi.Select","args":["SiegeEngineers","Additional"],"stopOnFail":true},
    {"id":"sp-ui-shot","do":"Screenshot","args":["ai-ui-sp-additional"],"stopOnFail":true},
    {"id":"sp-extra-map","do":"AiUi.Place","stopOnFail":true},
    {"id":"sp-extra-result","do":"AiUi.Check","args":["Applied","None","normal"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"sp-menu","do":"AiUi.Menu","stopOnFail":true},
    {"id":"sp-cancel","do":"AiUi.Cancel","stopOnFail":true},
    {"id":"quit-sp","do":"QuitToMenu","timeoutMs":25000,"stopOnFail":true},
    {"id":"editor-tools-on","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableTestTools","true"],"stopOnFail":true},
    {"id":"editor","do":"Editor.Start","timeoutMs":30000,"stopOnFail":true},
    {"id":"editor-ui","do":"AiUi.Prepare","args":["editor","2"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"editor-role","do":"AiUi.Select","args":["SiegeEngineers","Additional","false"],"stopOnFail":true},
    {"id":"editor-place","do":"AiUi.Place","stopOnFail":true},
    {"id":"editor-declared","do":"AiUi.Check","args":["Declared","None","normal"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"editor-ui-shot","do":"Screenshot","args":["ai-ui-editor-declaration"],"stopOnFail":true},
    {"id":"editor-menu","do":"AiUi.Menu","stopOnFail":true},
    {"id":"quit-editor","do":"QuitToMenu","timeoutMs":25000,"stopOnFail":true},
    {"id":"restore-tools-off","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableTestTools","false"],"stopOnFail":true},
    {"id":"restore-sp-off","do":"SetModSetting","args":["Spectator.SpectatorPlugin::processRoot.Settings","EnableSingleplayerTestMode","false"],"stopOnFail":true}
  ]
}
