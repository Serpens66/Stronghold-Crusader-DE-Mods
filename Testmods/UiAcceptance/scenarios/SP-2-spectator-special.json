{
  "enabled": true,
  "series": "SP-2",
  "role": "sp",
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "tools-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableTestTools", "true"], "stopOnFail": true },
    { "id": "load", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "toolbar", "do": "Spectator.WaitToolbar", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "describe-before", "do": "Describe" },
    { "id": "select-1", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner1"], "timeoutMs": 10000 },
    { "id": "goods", "do": "Spectator.Cmd", "args": ["Goods"] },
    { "id": "amount", "do": "Spectator.Amount", "args": ["1000"] },
    { "id": "mark-credit", "do": "Mark", "args": ["credit"] },
    { "id": "credit", "do": "Spectator.Cmd", "args": ["Credit"] },
    { "id": "credit-done", "do": "ExpectSequence", "args": ["credit", "TEST_ACTION session=\\d+ operation=(\\d+) kind=Credit actor=1", "1"], "timeoutMs": 5000 },
    { "id": "debit", "do": "Spectator.Cmd", "args": ["Debit"] },
    { "id": "describe-after", "do": "Describe" },
    { "id": "orders", "do": "Spectator.Cmd", "args": ["Orders"] },
    { "id": "target-2", "do": "Spectator.Cmd", "args": ["Target2"] },
    { "id": "mark-orders", "do": "Mark", "args": ["orders"] },
    { "id": "attack", "do": "Spectator.Cmd", "args": ["Attack"] },
    { "id": "defend", "do": "Spectator.Cmd", "args": ["Defend"] },
    { "id": "cancel", "do": "Spectator.Cmd", "args": ["Cancel"] },
    { "id": "orders-done", "do": "ExpectSequence", "args": ["orders", "TEST_ACTION session=\\d+ operation=(\\d+) kind=(?:Attack|Defend|Cancel)", "3"], "timeoutMs": 8000 },
    { "id": "hud-building", "do": "Hud", "args": ["building"] },
    { "id": "hud-troops", "do": "Hud", "args": ["troops"] },
    { "id": "hud-default", "do": "Hud", "args": ["default"] },
    { "id": "toolbar-after-hud", "do": "Spectator.WaitToolbar", "timeoutMs": 5000 },
    { "id": "gate-empty-click", "do": "MapClick", "args": ["200", "200"], "timeoutMs": 10000 },
    { "id": "powers-enable", "do": "Spectator.Cmd", "args": ["EnablePowers"] },
    { "id": "power-toolbar", "do": "WaitMarker", "args": ["TEST_POWER_TOOLBAR_READY"], "timeoutMs": 10000 },
    { "id": "mark-power", "do": "Mark", "args": ["power"] },
    { "id": "power-1", "do": "Power", "args": ["1"] },
    { "id": "power-place", "do": "MapClick", "args": ["210", "210"], "timeoutMs": 10000 },
    { "id": "power-done", "do": "ExpectSince", "args": ["power", "TEST_ACTION .*kind=Power", "1"] },
    { "id": "power-2-cancel", "do": "Power", "args": ["2"] },
    { "id": "cancel-power", "do": "Spectator.Cmd", "args": ["CancelPower"] },
    { "id": "stop-cursor", "do": "Spectator.Cmd", "args": ["StopCursor"] },
    { "id": "shot-tools", "do": "Screenshot", "args": ["special"] },
    { "id": "statistics", "do": "MenuAction", "args": ["Spectator_Serp", "statistics"], "timeoutMs": 10000 },
    { "id": "statistics-visible", "do": "Wait", "args": ["1500"] },
    { "id": "shot-statistics", "do": "Screenshot", "args": ["statistics"] }
  ]
}
