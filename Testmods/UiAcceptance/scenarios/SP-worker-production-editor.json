{
  "enabled": true,
  "series": "SP-worker-production-editor",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 90000, "stopOnFail": true, "allowErrors": true },
    { "id": "profile", "do": "Production.Configure", "stopOnFail": true },
    { "id": "editor", "do": "Editor.Start", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "fixture", "do": "Production.Setup", "args": ["editor"], "timeoutMs": 15000, "stopOnFail": true },
    { "id": "installed-yield-crc", "do": "Production.QuarterAndCrc", "timeoutMs": 15000, "stopOnFail": true },
    { "id": "save-map", "do": "Production.Save", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "menu-for-map", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "load-map", "do": "Production.Reload", "timeoutMs": 45000, "stopOnFail": true },
    { "id": "menu-end", "do": "QuitToMenu", "timeoutMs": 30000, "stopOnFail": true },
    { "id": "disable", "do": "Production.Disable", "stopOnFail": true }
  ]
}
