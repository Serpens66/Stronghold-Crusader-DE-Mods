{
  "enabled": true,
  "series": "SP-hunters-perf-800-500",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id":"menu","do":"WaitMainMenu","timeoutMs":60000,"stopOnFail":true,"allowErrors":true},
    {"id":"no-random-events","do":"RandomEvents","args":["off"],"timeoutMs":10000,"stopOnFail":true},
    {"id":"enable","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","EnableMod","true"]},
    {"id":"pathfinding","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ImprovedPathfinding","true"]},
    {"id":"selection","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","ImprovedTargetSelection","true"]},
    {"id":"range","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HunterSearchRange","0"]},
    {"id":"hunt-deer","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntDeer","true"]},
    {"id":"hunt-goat","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntGoat","false"]},
    {"id":"hunt-rabbit","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntRabbit","false"]},
    {"id":"hunt-camel","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntCamel","false"]},
    {"id":"hunt-chicken","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HuntChicken","false"]},
    {"id":"start-herds","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","StartHerdMode","0"]},
    {"id":"respawn-herds","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","HerdReturnSeconds","0"]},
    {"id":"collect-corpses","do":"SetModSetting","args":["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings","CollectFreeCorpses","false"]},
    {"id":"load","do":"LoadSave","args":["huntertest2.sav"],"timeoutMs":180000,"stopOnFail":true},
    {"id":"unpause","do":"Pause","args":["off"],"timeoutMs":15000,"stopOnFail":true},
    {"id":"clear-wildlife","do":"Hunt.ClearOtherAnimals","args":["all"],"stopOnFail":true},
    {"id":"speed","do":"Speed","args":["250"],"stopOnFail":true},
    {"id":"prepare","do":"Hunt.PrepareStress800","args":["500"],"timeoutMs":180000,"stopOnFail":true},
    {"id":"measure","do":"Hunt.MeasureStress800","args":["1200","450"],"timeoutMs":180000,"stopOnFail":true},
    {"id":"menu-back","do":"QuitToMenu","timeoutMs":60000}
  ]
}
