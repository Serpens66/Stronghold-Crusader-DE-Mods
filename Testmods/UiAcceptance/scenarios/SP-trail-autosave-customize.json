    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-briefing",
      "do": "ViewCommand",
      "args": [
        "ButtonBriefingResumeCommand",
        ""
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-ticks",
      "do": "Wait",
      "args": [
        "1000"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-active",
      "do": "Autosave.ExpectInterval",
      "args": [
        "5",
        "VanillaTrail",
        "Customized"
      ],
      "timeoutMs": 15000
    },
    {
      "timeoutMs": 15000,
      "do": "IngameMenuOpen",
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-menu"
    },
    {
      "do": "ViewCommand",
      "timeoutMs": 15000,
      "args": [
        "ButtonIngameMenuCommand",
        "5"
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-action"
    },
    {
      "do": "ViewCommand",
      "timeoutMs": 15000,
      "args": [
        "ButtonConfirmationCommand",
        "1"
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-confirm"
    },
    {
      "do": "WaitMission",
      "timeoutMs": 75000,
      "args": [
        "any"
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-load"
    },
    {
      "do": "ViewCommand",
      "timeoutMs": 15000,
      "args": [
        "ButtonBriefingResumeCommand",
        ""
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-briefing"
    },
    {
      "do": "Wait",
      "timeoutMs": 15000,
      "args": [
        "1000"
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-ticks"
    },
    {
      "do": "Autosave.ExpectInterval",
      "timeoutMs": 15000,
      "args": [
        "5",
        "VanillaTrail",
        "Customized",
        "restart"
      ],
      "stopOnFail": true,
      "allowErrors": true,
      "id": "restart-interval"
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "next-menu",
      "do": "QuitToMenu",
