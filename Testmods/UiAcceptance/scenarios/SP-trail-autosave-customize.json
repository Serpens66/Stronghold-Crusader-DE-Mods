{
  "enabled": true,
  "quitDelayMs": 1800,
  "series": "SP-trail-autosave-customize",
  "steps": [
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "menu",
      "do": "WaitMainMenu",
      "args": [],
      "timeoutMs": 120000
    },
    {
      "id": "fixture-no-castle-preview",
      "stopOnFail": true,
      "do": "SetModSetting",
      "allowErrors": true,
      "timeoutMs": 15000,
      "args": [
        "CastlePlanner.CastlePlannerPlugin::processSettings",
        "EnableMod",
        "false"
      ]
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-menu",
      "do": "ViewCommand",
      "args": [
        "ButtonMainMenuCommand",
        "Trail"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-customize",
      "do": "ViewCommand",
      "args": [
        "ButtonMainMenuCommand",
        "Customize"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-open",
      "do": "Lobby.Button",
      "args": [
        "Setup"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-interval",
      "do": "Lobby.Button",
      "args": [
        "Settings_Autosave"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "VanillaTrail-apply",
      "do": "Lobby.Button",
      "args": [
        "ApplySettings"
      ],
      "timeoutMs": 15000
