    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "SandsOfTime-briefing",
      "do": "ViewCommand",
      "args": [
        "ButtonBriefingResumeCommand",
        ""
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "SandsOfTime-ticks",
      "do": "Wait",
      "args": [
