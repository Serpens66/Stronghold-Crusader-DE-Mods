        "Setup"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "cancel-draft",
      "do": "Lobby.Button",
      "args": [
        "Settings_Autosave"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "cancel",
      "do": "Lobby.Button",
      "args": [
        "CancelSettings"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "SandsOfTime-open",
      "do": "Lobby.Button",
      "args": [
        "Setup"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "SandsOfTime-interval",
      "do": "Lobby.Button",
      "args": [
        "Settings_Autosave"
      ],
      "timeoutMs": 15000
    },
    {
      "stopOnFail": true,
      "allowErrors": true,
      "id": "SandsOfTime-apply",
      "do": "Lobby.Button",
      "args": [
        "ApplySettings"
      ],
      "timeoutMs": 15000
