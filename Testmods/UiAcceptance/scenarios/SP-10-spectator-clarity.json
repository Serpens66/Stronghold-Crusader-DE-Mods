{
  "enabled": true,
  "series": "SP-10",
  "role": "sp",
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 180000, "stopOnFail": true, "allowErrors": true },
    { "id": "tools-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableTestTools", "true"], "stopOnFail": true },
    { "id": "participant-tools-on", "do": "SetModSetting", "args": ["Spectator.SpectatorPlugin::processRoot.Settings", "EnableSingleplayerTestMode", "true"], "stopOnFail": true },
    { "id": "load", "do": "LoadSave", "args": ["test_dustynoattack.sav"], "timeoutMs": 120000, "stopOnFail": true },
    { "id": "toolbar", "do": "Spectator.WaitToolbar", "timeoutMs": 20000, "stopOnFail": true },
    { "id": "select-ai", "do": "NoesisClick", "args": ["SpectatorEditorHumanOwner2"], "timeoutMs": 10000, "stopOnFail": true },
    { "id": "goods", "do": "Spectator.Cmd", "args": ["Goods"], "stopOnFail": true },
    { "id": "amount", "do": "Spectator.Amount", "args": ["100"] },
    { "id": "credit", "do": "Spectator.Cmd", "args": ["Credit"], "stopOnFail": true },
    { "id": "feedback-settle", "do": "Wait", "args": ["1000"] },
    { "id": "shot-goods", "do": "Screenshot", "args": ["goods"] },
    { "id": "orders", "do": "Spectator.Cmd", "args": ["Orders"] },
    { "id": "target", "do": "Spectator.Cmd", "args": ["Target1"] },
    { "id": "shot-orders", "do": "Screenshot", "args": ["orders"] },
    { "id": "hud-troops", "do": "Hud", "args": ["troops"] },
    { "id": "shot-troops", "do": "Screenshot", "args": ["troops"] },
    { "id": "tools-from-troops", "do": "NoesisClick", "args": ["SpectatorExpand"], "timeoutMs": 10000 },
    { "id": "shot-tools-return", "do": "Screenshot", "args": ["tools-return"] },
    { "id": "back", "do": "NoesisClick", "args": ["SpectatorExpand"] },
    { "id": "shot-vanilla", "do": "Screenshot", "args": ["vanilla"] },
    { "id": "place", "do": "Spectator.Cmd", "args": ["Placement"] },
    { "id": "place-settle", "do": "Wait", "args": ["500"] },
    { "id": "shot-place", "do": "Screenshot", "args": ["place"] },
    { "id": "stop-place", "do": "NoesisClick", "args": ["SpectatorStopPlacement"], "timeoutMs": 10000 },
    { "id": "hud-building", "do": "Hud", "args": ["building"] },
    { "id": "shot-building", "do": "Screenshot", "args": ["building"] },
    { "id": "tools-from-building", "do": "NoesisClick", "args": ["SpectatorExpand"], "timeoutMs": 10000 },
    { "id": "shot-final", "do": "Screenshot", "args": ["final"] },
    { "id": "quit", "do": "QuitToMenu", "timeoutMs": 60000 }
  ]
}
