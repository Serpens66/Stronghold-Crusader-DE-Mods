{
  "enabled": true,
  "series": "SP-hunters-chase",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    { "id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true },
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"], "timeoutMs": 15000},
    {"id": "rule", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "RabbitsOnlyOnOrder", "true"], "timeoutMs": 15000},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "speed", "do": "Speed", "args": ["120"], "timeoutMs": 15000},
    {"id": "rabbit-fixture", "do": "Hunt.Rabbits", "args": ["3", "1"], "timeoutMs": 15000},
    {"id": "aggressive", "do": "Hunt.Stance", "args": ["Aggressive"], "timeoutMs": 15000},
    {"id": "far-rabbit", "do": "Hunt.FarRabbit", "args": ["7"], "timeoutMs": 15000},
    {"id": "ignored-while-aggressive", "do": "Hunt.RabbitsAlive", "args": ["8000"], "timeoutMs": 30000},
    {"id": "order", "do": "Hunt.AttackRabbit", "args": ["0"], "timeoutMs": 15000},
    {"id": "near-killed", "do": "Hunt.RabbitDead", "args": ["0"], "timeoutMs": 30000},
    {"id": "far-chased", "do": "Hunt.RabbitDead", "args": ["1"], "timeoutMs": 60000},
    {"id": "shot", "do": "Screenshot", "args": ["chase"], "timeoutMs": 15000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000}
  ]
}
