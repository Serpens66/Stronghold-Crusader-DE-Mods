{
  "enabled": true,
  "series": "SP-hunters-corpse-once",
  "role": "sp",
  "quitWhenDone": true,
  "steps": [
    {"id": "menu", "do": "WaitMainMenu", "timeoutMs": 60000, "stopOnFail": true, "allowErrors": true},
    {"id": "no-random-events", "do": "RandomEvents", "args": ["off"], "timeoutMs": 10000, "stopOnFail": true},
    {"id": "enable", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "EnableMod", "true"]},
    {"id": "set-CollectFreeCorpses", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "CollectFreeCorpses", "true"]},
    {"id": "set-HuntDeer", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntDeer", "true"]},
    {"id": "set-HuntGoat", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntGoat", "true"]},
    {"id": "set-HuntRabbit", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntRabbit", "false"]},
    {"id": "set-HuntCamel", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntCamel", "false"]},
    {"id": "set-HuntChicken", "do": "SetModSetting", "args": ["ImprovedHunters.ImprovedHuntersPlugin::persistentSettings", "HuntChicken", "false"]},
    {"id": "skirmish", "do": "Skirmish.Open", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "map", "do": "Lobby.SelectMap", "args": ["4spielerkarte.map"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "ai", "do": "Lobby.AddAI", "args": ["1", "1"], "timeoutMs": 15000},
    {"id": "peace", "do": "Lobby.PeaceTime", "args": ["60"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "play", "do": "Lobby.Play", "timeoutMs": 45000, "stopOnFail": true},
    {"id": "briefing", "do": "AiMilitary.ResumeBriefing", "timeoutMs": 15000},
    {"id": "unpause", "do": "Pause", "args": ["off"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "settle", "do": "Wait", "args": ["4000"], "timeoutMs": 15000},
    {"id": "peace-active", "do": "Hunt.ExpectPeace", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "animals", "do": "Hunt.LogAnimals"},
    {"id": "hut", "do": "Hunt.PlaceHut", "timeoutMs": 15000, "stopOnFail": true},
    {"id": "speed", "do": "Speed", "args": ["40"]},
    {"id": "hunter-idle", "do": "Wait", "args": ["6000"], "timeoutMs": 15000},
    {"id": "fading", "do": "Hunt.Corpse", "args": ["deer", "16"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "fading-ignored", "do": "Hunt.FadingCorpseIgnored", "args": ["20000"], "timeoutMs": 30000},
    {"id": "second-hut", "do": "Hunt.SecondHut", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "third-hut", "do": "Hunt.SecondHut", "timeoutMs": 120000, "stopOnFail": true},
    {"id": "all-idle", "do": "Wait", "args": ["12000"], "timeoutMs": 30000},
    {"id": "deer", "do": "Hunt.Corpse", "args": ["deer", "16"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "deer-one", "do": "Hunt.ExpectOneCollector", "args": ["25000"], "timeoutMs": 40000},
    {"id": "idle-again", "do": "Wait", "args": ["45000"], "timeoutMs": 60000},
    {"id": "goat", "do": "Hunt.Corpse", "args": ["goat", "16"], "timeoutMs": 15000, "stopOnFail": true},
    {"id": "goat-one", "do": "Hunt.ExpectOneCollector", "args": ["25000"], "timeoutMs": 40000},
    {"id": "menu-back", "do": "QuitToMenu", "timeoutMs": 30000},
    {"id": "restore-random-events", "do": "RandomEvents", "args": ["on"], "timeoutMs": 10000}
  ]
}
