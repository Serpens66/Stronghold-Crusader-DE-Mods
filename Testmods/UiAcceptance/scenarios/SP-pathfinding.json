{
 "enabled": true,
 "series": "SP-pathfinding",
 "role": "sp",
 "steps": [
  {
   "id": "menu",
   "do": "WaitMainMenu",
   "timeoutMs": 180000,
   "stopOnFail": true,
   "allowErrors": true
  },
  {
   "id": "skirmish",
   "do": "Skirmish.Open",
   "timeoutMs": 30000,
   "stopOnFail": true
  },
  {
   "id": "hub",
   "do": "InvokeCommand",
   "args": [
    "SHCDESE.BepInEx.Bootstrap.Plugin::ModSettingsHubViewModel.ToggleWindowCommand"
   ],
   "stopOnFail": true
  },
  {
   "id": "tab",
   "do": "ModSettings.SelectTab",
   "args": [
    "Pathfinding_Serp"
   ],
   "stopOnFail": true
  },
  {
   "id": "wait-page",
   "do": "Wait",
   "args": [
    "2500"
   ]
  },
  {
   "id": "shot-page",
   "do": "Screenshot",
   "args": [
    "pathfinding-settings"
   ]
  },
  {
   "id": "hub-close",
   "do": "InvokeCommand",
   "args": [
    "SHCDESE.BepInEx.Bootstrap.Plugin::ModSettingsHubViewModel.ToggleWindowCommand"
   ],
   "allowErrors": true
  },
  {
   "id": "menu2",
   "do": "QuitToMenu",
   "timeoutMs": 30000,
   "allowErrors": true
  },
  {
   "id": "load",
   "do": "LoadSave",
   "args": [
    "test_gates.sav"
   ],
   "timeoutMs": 120000,
   "stopOnFail": true
  },
  {
   "id": "hud-canvas",
   "do": "ExpectElement",
   "args": [
    "PathfindingFormationPreviewCanvas"
   ],
   "timeoutMs": 5000
  },
  {
   "id": "run-before-select",
   "do": "Pause",
   "args": [
    "off"
   ]
  },
  {
   "id": "select",
   "do": "SelectOwnUnitsNative",
   "args": [
    "1",
    "8"
   ],
   "timeoutMs": 15000,
   "stopOnFail": true
  },
  {
   "id": "group",
   "do": "WaitGroup",
   "args": [
    "1",
    "1"
   ],
   "timeoutMs": 20000,
   "stopOnFail": true
  },
  {
   "id": "hud-host",
   "do": "ExpectElement",
   "args": [
    "PathfindingFormationMenuHost"
   ],
   "timeoutMs": 10000
  },
  {
   "id": "hud-rollover",
   "do": "ExpectElement",
   "args": [
    "PathfindingFormationRolloverHost"
   ],
   "timeoutMs": 5000
  },
  {
   "id": "menu-open",
   "do": "InvokeCommand",
   "args": [
    "Pathfinding.FormationHudButton::menu.ToggleMenuCommand"
   ]
  },
  {
   "id": "wait-menu",
   "do": "Wait",
   "args": [
    "800"
   ]
  },
  {
   "id": "rollover-show",
   "do": "InvokeCommand",
   "args": [
    "Pathfinding.FormationHudButton::menu.ShowRolloverCommand",
    "Block"
   ]
  },
  {
   "id": "rollover-visible",
   "do": "ExpectModSetting",
   "args": [
    "Pathfinding.FormationHudButton::menu",
    "RolloverVisible",
    "True"
   ]
  },
  {
   "id": "rollover-text",
   "do": "ExpectModSetting",
   "args": [
    "Pathfinding.FormationHudButton::menu",
    "RolloverText",
    "Block"
   ]
  },
  {
   "id": "wait-rollover",
   "do": "Wait",
   "args": [
    "300"
   ]
  },
  {
   "id": "shot-menu",
   "do": "Screenshot",
   "args": [
    "pathfinding-formation-menu"
   ]
  },
  {
   "id": "rollover-hide",
   "do": "InvokeCommand",
   "args": [
    "Pathfinding.FormationHudButton::menu.HideRolloverCommand"
   ]
  },
  {
   "id": "menu-close",
   "do": "InvokeCommand",
   "args": [
    "Pathfinding.FormationHudButton::menu.ToggleMenuCommand"
   ]
  },
  {
   "id": "speed",
   "do": "Speed",
   "args": [
    "250"
   ]
  },
  {
   "id": "mark",
   "do": "Mark",
   "args": [
    "probe"
   ]
  },
  {
   "id": "move",
   "do": "PlayerMove",
   "args": [
    "1",
    "rel:6:0",
    "0"
   ]
  },
  {
   "id": "mode-0",
   "do": "ExpectMoveMode",
   "args": [
    "1",
    "0"
   ]
  },
  {
   "id": "run",
   "do": "WaitTicks",
   "args": [
    "200"
   ],
   "timeoutMs": 60000
  },
  {
   "id": "accepted",
   "do": "ExpectSince",
   "args": [
    "probe",
    "PLAYER_MOVE .*accepted=True",
    "1"
   ]
  },
  {
   "id": "queue-1",
   "do": "PlayerMove",
   "args": [
    "1",
    "rel:3:3",
    "80"
   ]
  },
  {
   "id": "queue-2",
   "do": "PlayerMove",
   "args": [
    "1",
    "rel:-3:3",
    "80"
   ]
  },
  {
   "id": "run-queue",
   "do": "WaitTicks",
   "args": [
    "200"
   ],
   "timeoutMs": 60000
  },
  {
   "id": "shot-move",
   "do": "Screenshot",
   "args": [
    "pathfinding-moved"
   ]
  },
  {
   "id": "quit",
   "do": "QuitToMenu",
   "timeoutMs": 90000
  },
  {
   "id": "load2",
   "do": "LoadSave",
   "args": [
    "test_Assassins_stuck_at_drawbridge.sav"
   ],
   "timeoutMs": 120000,
   "stopOnFail": true
  },
  {
   "id": "run2",
   "do": "WaitTicks",
   "args": [
    "300"
   ],
   "timeoutMs": 60000
  },
  {
   "id": "quit2",
   "do": "QuitToMenu",
   "timeoutMs": 90000
  },
  {
   "id": "editor",
   "do": "Editor.Start",
   "timeoutMs": 120000
  },
  {
   "id": "editor-wait",
   "do": "Wait",
   "args": [
    "3000"
   ]
  },
  {
   "id": "editor-shot",
   "do": "Screenshot",
   "args": [
    "pathfinding-editor"
   ]
  },
  {
   "id": "quit3",
   "do": "QuitToMenu",
   "timeoutMs": 90000,
   "allowErrors": true
  }
 ]
}
