<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Operation Type="Add" XPath="/n:UserControl/n:Grid">
    <Content>
      <Canvas x:Name="SpectatorPerspectiveCanvas" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="4"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10030">
        <Border x:Name="SpectatorPerspectiveBar" Width="455" Height="32" Background="Transparent"
                Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="SpectatorPerspectiveDrag" Width="112" Height="30" Background="Transparent"
                    BorderBrush="#80FFFFFF" BorderThickness="1" Cursor="SizeAll">
              <TextBlock Text="Zuschauer" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Button x:Name="SpectatorPerspectivePlayer1" Width="42" Height="30" Content="1" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer2" Width="42" Height="30" Content="2" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer3" Width="42" Height="30" Content="3" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer4" Width="42" Height="30" Content="4" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer5" Width="42" Height="30" Content="5" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer6" Width="42" Height="30" Content="6" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer7" Width="42" Height="30" Content="7" Background="#40000000" Foreground="White"/>
            <Button x:Name="SpectatorPerspectivePlayer8" Width="42" Height="30" Content="8" Background="#40000000" Foreground="White"/>
          </StackPanel>
        </Border>
      </Canvas>
    </Content>
  </Operation>
</Patch>
