<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:CrusaderDE">
  <Operation Type="SetAttribute"
             XPath="//n:Grid[@Visibility='{Binding Show_MPSettings, Converter={StaticResource booleanToVisibilityConverter}}']"
             AttributeName="Panel.ZIndex"
             Value="1000" />
  <Operation Type="InsertBefore" XPath="//n:Button[@CommandParameter='Settings_SkirmishAdvanced']">
    <Content>
      <Button x:Name="SkirmishGameOptionsTestButton"
              Width="280"
              Margin="52,5,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              local:PropEx.TextCentre="{Binding Source={x:Static local:MainViewModel.Instance}, Path=MP_Settings_Button}"
              local:PropEx.TextLeft=""
              local:PropEx.TextRight=""
              Command="{Binding MultiplayerMenuCommand}"
              CommandParameter="Setup"
              MouseEnter="CommonRedButtonEnter"
              Visibility="{Binding SkirmishSetupMode, Converter={StaticResource booleanToVisibilityConverter}}"
              Style="{StaticResource BTN_SH_GlowS}" />
    </Content>
  </Operation>
</Patch>
