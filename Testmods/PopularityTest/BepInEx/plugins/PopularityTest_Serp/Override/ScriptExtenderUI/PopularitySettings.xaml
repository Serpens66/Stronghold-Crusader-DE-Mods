        <TextBox Grid.Column="2" Text="{Binding RationsPopModifierHalfValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding RationsPopModifierHalfEditable}" seui:KeyboardCaptureBinding.Enabled="True" Foreground="White" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Padding="4,1" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding RationsPopModifierHalfHelp}" ToolTipService.ShowDuration="60000"/>
