<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:APIShared.ModSettings;assembly=APIShared"
      xmlns:seui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/>
      <Setter Property="MaxWidth" Value="{x:Static shared:ToolTipPresentation.MaximumWidth}"/>
      <Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="seui:ToolTipResolutionScale.Enabled" Value="True"/>
      <Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}" MaxWidth="{TemplateBinding MaxWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44304069"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel IsEnabled="{Binding BetweenMissions}" Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PresetText}" Foreground="White" VerticalAlignment="Center" Margin="14,0,5,0"/>
        <Button IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" Content="{Binding System_PresetLoadText}" Command="{Binding System_OpenPresetLoadCommand}" ToolTip="{Binding PresetHelpText}" ToolTipService.ShowDuration="60000" Padding="10,3"/>
        <Button IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" Content="{Binding System_PresetSaveText}" Command="{Binding System_OpenPresetSaveCommand}" ToolTip="{Binding System_PresetSaveText}" ToolTipService.ShowDuration="60000" Padding="10,3" Margin="8,0,0,0"/>
        <Button Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" IsEnabled="{Binding CanConfigure}" ToolTip="{Binding ResetToDefaultText}" ToolTipService.ShowDuration="60000" Padding="10,3" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding System_PresetStatusText}" Visibility="{Binding System_PresetStatusVisibility}" Foreground="#FFF2D48A" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFFFCC66" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding System_TrailSourceNoticeText}" Visibility="{Binding System_TrailSourceNoticeVisibility}" Foreground="#FFFFCC66" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Border Visibility="{Binding System_PresetInlineConfirmationVisibility}" BorderBrush="#FFFFCC66" BorderThickness="1" Padding="8" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True"><StackPanel><TextBlock Text="{Binding System_PresetInlineConfirmationTitle}" Foreground="White" FontWeight="Bold"/><TextBlock Text="{Binding System_PresetInlineConfirmationMessage}" Foreground="White" TextWrapping="Wrap" MaxWidth="700"/><StackPanel Orientation="Horizontal"><Button Content="{Binding System_PresetInlineConfirmText}" Command="{Binding System_ConfirmPresetInlineActionCommand}" ToolTip="{Binding System_PresetInlineConfirmText}" ToolTipService.ShowDuration="60000"/><Button Content="{Binding System_PresetInlineCancelText}" Command="{Binding System_CancelPresetInlineActionCommand}" ToolTip="{Binding System_PresetInlineCancelText}" ToolTipService.ShowDuration="60000" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
      <Border Visibility="{Binding System_PresetOperationErrorVisibility}" BorderBrush="#FFFF7777" BorderThickness="1" Padding="8" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True"><StackPanel><TextBlock Text="{Binding System_PresetOperationStatusText}" Foreground="#FFFFAAAA" TextWrapping="Wrap" MaxWidth="700"/><Button Content="{Binding System_PresetStatusDismissText}" Command="{Binding System_DismissPresetStatusCommand}" ToolTip="{Binding System_PresetStatusDismissText}" ToolTipService.ShowDuration="60000"/></StackPanel></Border>
      <Border Visibility="{Binding System_PresetLoadPanelVisibility}" BorderBrush="#FF77AAFF" BorderThickness="1" Padding="8" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True"><StackPanel><TextBlock Text="{Binding System_PresetLoadText}" Foreground="White"/><ComboBox ItemsSource="{Binding System_PresetLoadEntries}" SelectedItem="{Binding System_SelectedPresetLoadEntry, Mode=TwoWay}" ToolTip="{Binding System_PresetLoadSelectionHelpText}" ToolTipService.ShowDuration="60000" Width="400"/><TextBlock Text="{Binding System_SelectedPresetLoadEntry.Description}" Foreground="White" TextWrapping="Wrap" MaxWidth="700"/><StackPanel Orientation="Horizontal"><Button Content="{Binding System_PresetLoadConfirmText}" Command="{Binding System_ConfirmPresetLoadCommand}" ToolTip="{Binding System_PresetLoadSelectionHelpText}" ToolTipService.ShowDuration="60000"/><Button Content="{Binding System_PresetDeleteText}" Command="{Binding System_DeletePresetCommand}" IsEnabled="{Binding System_CanDeleteSelectedPreset}" ToolTip="{Binding System_PresetDeleteText}" ToolTipService.ShowDuration="60000" Margin="8,0,0,0"/><Button Content="{Binding System_PresetLoadCancelText}" Command="{Binding System_CancelPresetLoadCommand}" ToolTip="{Binding System_PresetLoadCancelText}" ToolTipService.ShowDuration="60000" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
      <Border Visibility="{Binding System_PresetSavePanelVisibility}" BorderBrush="#FF77AAFF" BorderThickness="1" Padding="8" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True"><StackPanel><TextBlock Text="{Binding System_PresetSaveTargetText}" Foreground="White"/><ComboBox ItemsSource="{Binding System_PresetSaveTargets}" SelectedItem="{Binding System_SelectedPresetSaveTarget, Mode=TwoWay}" ToolTip="{Binding System_PresetSaveTargetText}" ToolTipService.ShowDuration="60000" Width="400"/><TextBox Text="{Binding System_PresetSaveName, Mode=TwoWay}" seui:KeyboardCaptureBinding.Enabled="True" ToolTip="{Binding System_PresetSaveNameText}" ToolTipService.ShowDuration="60000" Width="400" Margin="0,6,0,0"/><TextBox Text="{Binding System_PresetSaveDescription, Mode=TwoWay}" seui:KeyboardCaptureBinding.Enabled="True" ToolTip="{Binding System_PresetSaveDescriptionText}" ToolTipService.ShowDuration="60000" Width="400" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal"><Button Content="{Binding System_PresetSaveConfirmText}" Command="{Binding System_ConfirmPresetSaveCommand}" IsEnabled="{Binding System_CanConfirmPresetSave}" ToolTip="{Binding System_PresetSaveConfirmText}" ToolTipService.ShowDuration="60000"/><Button Content="{Binding System_PresetLoadCancelText}" Command="{Binding System_CancelPresetSaveCommand}" ToolTip="{Binding System_PresetLoadCancelText}" ToolTipService.ShowDuration="60000" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
      <TextBlock Text="{Binding HostOptionsText}" Foreground="#FF77AAFF" Background="#33304069" FontWeight="Bold" Padding="8,4" Margin="0,0,0,8"/>
      <Border Style="{StaticResource HostActivationBorder}" Margin="0,0,0,8"><CheckBox Content="{Binding ModEnabledText}" IsChecked="{Binding EnableMod, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" ToolTip="{Binding EnableModHelpText}" ToolTipService.ShowDuration="60000" Foreground="White" FontWeight="Bold"/></Border>
      <TextBlock Text="{Binding ScopeText}" Foreground="White" TextWrapping="Wrap" MaxWidth="700" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding RationsTitle}" Foreground="#FFF2D48A" FontWeight="Bold" Margin="0,14,0,6"/>
      <Grid Margin="0,3" shared:ModSettingsSearch.Key="popularity.RationsPopModifierNone" shared:ModSettingsSearch.Title="{Binding RationsPopModifierNoneTitle}" shared:ModSettingsSearch.ToolTipText="{Binding RationsPopModifierNoneHelp}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Content="{Binding RationsPopModifierNoneTitle}" IsChecked="{Binding RationsPopModifierNoneEnabled, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" Foreground="White" VerticalAlignment="Center" ToolTip="{Binding RationsPopModifierNoneHelp}" ToolTipService.ShowDuration="60000"/>
        <Slider Grid.Column="1" Minimum="-16" Maximum="16" Value="{Binding RationsPopModifierNone, Mode=TwoWay}" IsEnabled="{Binding RationsPopModifierNoneEditable}" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" Margin="6,0" ToolTip="{Binding RationsPopModifierNoneHelp}" ToolTipService.ShowDuration="60000"/>
        <TextBox Grid.Column="2" Text="{Binding RationsPopModifierNoneValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding RationsPopModifierNoneEditable}" seui:KeyboardCaptureBinding.Enabled="True" Foreground="White" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Padding="4,1" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding RationsPopModifierNoneHelp}" ToolTipService.ShowDuration="60000"/>
      </Grid>
