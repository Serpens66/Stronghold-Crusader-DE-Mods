<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Operation Type="Add" XPath="//n:Grid[@Name='ObjectiveTimer']">
    <Content>
      <TextBlock x:Name="TimerCountdownObjective"
                 Width="192" Height="14" Margin="155,41,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 TextAlignment="Center" FontSize="13"
                 FontWeight="Bold" Foreground="#FFFFFFFF"
                 Background="#AA000000" Panel.ZIndex="20"
                 IsHitTestVisible="False" Tag="Ignore"
                 Text="{Binding ObjectiveRemaining}">
        <TextBlock.Effect>
          <DropShadowEffect ShadowDepth="1" Direction="315" Color="#FF000000" BlurRadius="0" />
        </TextBlock.Effect>
      </TextBlock>
    </Content>
  </Operation>
</Patch>
