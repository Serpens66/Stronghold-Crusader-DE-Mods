<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Library</OutputType><AssemblyName>AIWoodSafetyTest</AssemblyName><RootNamespace>AIWoodSafetyTest</RootNamespace>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion><LangVersion>latest</LangVersion><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>BepInEx\plugins\AIWoodSafetyTest_Serp\</OutputPath><DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">E:\ProgrammeE\Steam\steamapps\common\Stronghold Crusader Definitive Edition</GameDir>
    <ExtenderDir Condition="'$(ExtenderDir)' == ''">$(GameDir)\BepInEx\plugins\000shcdese</ExtenderDir>
    <ApiSharedDir Condition="'$(ApiSharedDir)' == ''">$(GameDir)\BepInEx\plugins\APIShared_Serp</ApiSharedDir>
    <GeneralDiagnosticDir Condition="'$(GeneralDiagnosticDir)' == ''">..\AIBuildDiagnoseTest\BepInEx\plugins\AIBuildDiagnoseTest_Serp</GeneralDiagnosticDir>
