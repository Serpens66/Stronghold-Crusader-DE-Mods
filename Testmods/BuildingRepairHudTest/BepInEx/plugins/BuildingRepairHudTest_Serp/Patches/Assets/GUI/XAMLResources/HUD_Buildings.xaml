<Patch>
    <Operation Type="Add" XPath="//n:Grid[@x:Name='InBuildingLayoutRoot']">
        <Content>
            <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Name="BuildingRepairHudTestHoverHost"
                    Width="24" Height="24" Margin="0,0,262,44"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="Hidden" Background="Transparent">
                <Button x:Name="BuildingRepairHudTestButton"
                        IsEnabled="False"
                        Command="{Binding ButtonRepairCommand}" CommandParameter="1">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Fill="#FF654627" Stroke="#FFE3C685" StrokeThickness="2" />
                                <Path Data="M 2,2 L 8,2 L 8,4 L 11,7 L 8,10 L 5,7 L 5,5 L 2,5 Z M 9,10 L 11,8 L 18,15 L 16,18 Z"
                                      Fill="#FFF6E5B5" Stretch="Uniform" Margin="4" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Content>
    </Operation>
</Patch>
