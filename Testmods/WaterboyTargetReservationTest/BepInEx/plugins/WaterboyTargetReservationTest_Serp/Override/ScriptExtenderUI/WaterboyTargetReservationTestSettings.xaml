<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="10">
    <CheckBox IsChecked="{Binding EnableNearestWaterboyTargeting, Mode=TwoWay}"
              Content="{Binding EnableNearestWaterboyTargetingText}"
              ToolTipService.ShowDuration="60000"
              ToolTip="{Binding EnableNearestWaterboyTargetingHelpText}"
              Foreground="White" />
  </StackPanel>
</Grid>
