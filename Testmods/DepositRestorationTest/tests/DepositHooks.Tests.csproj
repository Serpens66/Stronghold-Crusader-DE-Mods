    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin/</OutputPath>
    <GameDir Condition="'$(GameDir)' == ''">E:/ProgrammeE/Steam/steamapps/common/Stronghold Crusader Definitive Edition</GameDir>
    <ExtenderDir Condition="'$(ExtenderDir)' == ''">$(GameDir)/BepInEx/plugins/000shcdese</ExtenderDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System;System.Core" />
    <Reference Include="Iced;SHCDESE;System.Memory;System.Runtime.CompilerServices.Unsafe;RedBird.Abstractions;RedBird.Core;RedBird.X64;RedBird.Backends.NativeX64;Microsoft.Extensions.Logging.Abstractions">
