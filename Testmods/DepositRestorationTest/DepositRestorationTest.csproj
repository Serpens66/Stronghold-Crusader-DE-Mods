    <Compile Include="src/*.cs" />
    <Compile Include="../../Shared/Runtime/Diagnostics/DebugLogHelper.cs"><Link>Shared/Runtime/Diagnostics/DebugLogHelper.cs</Link></Compile>
    <Compile Include="../../Shared/Runtime/Native/NativePatchGuard.cs"><Link>Shared/Runtime/Native/NativePatchGuard.cs</Link></Compile>
    <Compile Include="../../Shared/Runtime/Native/CommittedMemory.cs"><Link>Shared/Runtime/Native/CommittedMemory.cs</Link></Compile>
