<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets><Optimize>true</Optimize><ImplicitUsings>disable</ImplicitUsings><NuGetAudit>false</NuGetAudit>
    <GameDir Condition="'$(GameDir)' == ''">E:\ProgrammeE\Steam\steamapps\common\Stronghold Crusader Definitive Edition</GameDir>
    <ApiSharedDir Condition="'$(ApiSharedDir)' == ''">$(GameDir)\BepInEx\plugins\APIShared_Serp</ApiSharedDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Frozen copies; this probe never compiles BetterPathfindingTest sources. -->
    <Compile Include="../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <!-- Current unchanged production Precise kernel as comparison oracle, offline only. -->
    <Compile Include="../../../Pathfinding/src/UnitCommands/Movement/WeightedGridSearchKernel.cs" Link="Oracle/WeightedGridSearchKernel.cs" />
    <Compile Include="../../../Pathfinding/src/UnitCommands/Movement/WeightedMoatRoutePlanner.cs" Link="Oracle/WeightedMoatRoutePlanner.cs" />
    <Compile Include="../../../Pathfinding/src/UnitCommands/Moat/MoatCandidateField.cs" Link="Oracle/MoatCandidateField.cs" />
    <Compile Include="../../../Pathfinding/src/UnitCommands/Runtime/UnitCommandContracts.cs" Link="Oracle/UnitCommandContracts.cs" />
    <Reference Include="APIShared"><HintPath>$(ApiSharedDir)\APIShared.dll</HintPath></Reference>
  </ItemGroup>
</Project>
