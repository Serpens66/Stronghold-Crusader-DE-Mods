<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">


    <Style x:Key="BTN_RADIO_Image" TargetType="{x:Type RadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowDuration" Value="2500" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="1000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid
                        x:Name="BaseGrid"
                        RenderTransformOrigin="0.5,0.5"
                        UseLayoutRounding="False">

                        <Rectangle x:Name="HitBox" Fill="#00ffff00" />


                        <Image
                            x:Name="SpriteInactive"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            Source="{TemplateBinding local:PropEx.Sprite1}"
                            Visibility="Visible" />

                        <Image
                            x:Name="SpriteMouseOver"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            Source="{TemplateBinding local:PropEx.Sprite2}"
                            Visibility="Hidden" />

                        <Image
                            x:Name="SpriteActive"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            Source="{TemplateBinding local:PropEx.Sprite3}"
                            Visibility="Hidden" />

                        <Image
                            x:Name="SpriteLocked"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            Source="{TemplateBinding local:PropEx.Sprite4}"
                            Visibility="Hidden" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpriteActive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteActive" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteActive" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteActive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>