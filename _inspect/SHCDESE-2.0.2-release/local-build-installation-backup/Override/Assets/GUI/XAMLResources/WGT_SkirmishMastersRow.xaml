        <!-- Score column -->
        <Image
            Width="40"
            Margin="0,0,0,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Opacity="1"
            IsHitTestVisible="False"
            Grid.Column="3"
            Source="{StaticResource koth}">
        </Image>
        <TextBlock
            Grid.Column="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="50,0,0,0"
            IsHitTestVisible="False"
            Text="{Binding Score}">
        </TextBlock>
