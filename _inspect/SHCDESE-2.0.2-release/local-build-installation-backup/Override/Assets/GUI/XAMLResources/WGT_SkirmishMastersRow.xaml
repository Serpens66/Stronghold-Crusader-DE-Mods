<UserControl
    x:Class="CrusaderDE.WGT_SkirmishMastersRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="44"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>
            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        </UserControl.Resources>

<!-- Height 44 -->
    <Grid
        x:Name="SMLayoutRoot"
        Height="44"
        Width="1100"
        IsHitTestVisible="False"
        Background="#00004400">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="620" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image
            Width="1100"
            Height="44"
            Grid.ColumnSpan="4"
            Opacity="0.6"
            Stretch="Fill"
            FlowDirection="{Binding GlobalTextFlow}"
            Source="{Binding RowBackground}"
            />

        <TextBlock
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,0"
            IsHitTestVisible="False"
            Text="{Binding Order}">
        </TextBlock>
        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="0,0,0,0"
            FontSize="20"
            IsHitTestVisible="False"
            Text="{Binding MissionName}">
        </TextBlock>
        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="0,0,0,0"
            FontSize="16"
            IsHitTestVisible="False"
            Text="{Binding Date}">
        </TextBlock>
        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,20,0"
            FontSize="16"
            IsHitTestVisible="False"
            Text="{Binding Time}">
        </TextBlock>

        <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,15,0"
            FontSize="12"
            IsHitTestVisible="False"
            Text="{Binding TrailName}">
        </TextBlock>

        <!-- faces row -->
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="0,0,0,0"
            IsHitTestVisible="False"
            Orientation="Horizontal">
            <Grid
                Visibility="{Binding SkirmishBriefingAlly[0], Converter={StaticResource booleanToVisibilityConverter}}"
                Width="41">
                <Image
                    Width="36"
                    Source="{Binding AlliesFaceBackground0}" />
                <Image
                    Width="36"
                    Source="{Binding AlliesFace0}" />
                <Image
                    Visibility="{Binding AlliesHumanFaceVis[0], Converter={StaticResource booleanToVisibilityConverter}}"
                    Width="36"
                    Source="{StaticResource Face Border}" />
                <Image
                    Visibility="{Binding SkirmishBriefingAllyDead[0], Converter={StaticResource booleanToVisibilityConverter}}"
                    Margin="4,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="7"
                    Source="{StaticResource UI-Buttons S054}" />
                <Rectangle
                    Visibility="{Binding SkirmishBriefingAllyDead[0], Converter={StaticResource booleanToVisibilityConverter}}"
                    Width="36"
                    Height="36">
                    <Rectangle.Fill>
                        <SolidColorBrush
                            Color="#55000000" />
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Image
                Width="20"
                Visibility="{Binding SkirmishBriefingAllyFight[0], Converter={StaticResource booleanToVisibilityConverter}}"
