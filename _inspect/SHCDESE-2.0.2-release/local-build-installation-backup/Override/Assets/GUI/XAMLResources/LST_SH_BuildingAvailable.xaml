<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">


    <Style x:Key="LST_SH_BuildingAvailable" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowDuration" Value="2500" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="1000" />
        <Setter Property="FontSize" Value="22" />
        

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid
                        x:Name="BaseGrid"
                        RenderTransformOrigin="0.5,0.5"
                        UseLayoutRounding="False">

                        <Grid
                            x:Name="NormalMode"
                            Margin="-1.5,-1.5, -1.5, -1.5"
                            Height="31"
                            Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="29.5" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="29.5" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="1"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Source="{StaticResource Button_01_Left}" />

                            <Rectangle
                                Grid.Column="2"
                                Margin="-0.5,0,-0.5,0"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Opacity="1">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{StaticResource Button_01_Center}"
                                  Viewport="0,0,28,31"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Image
                                Grid.Column="3"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Source="{StaticResource Button_01_Right}" />
                            <TextBlock
                                x:Name="CenterText"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Height="24"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground ="{StaticResource Brush.Accent7}"
                                Text="{TemplateBinding local:PropEx.TextRight}"
                                TextAlignment="Center" />
                        </Grid>

                        <Grid
                            x:Name="GlowMode"
                            Margin="-1.5,-1.5, -1.5, -1.5"
                            Height="31"
                            Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="29.5" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="29.5" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="1"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Source="{StaticResource Button_02_Left_}" />

                            <Rectangle
                                Grid.Column="2"
                                Margin="-0.5,0,-0.5,0"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Opacity="1">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{StaticResource Button_02_Center}"
                                  Viewport="0,0,28,31"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Image
                                Grid.Column="3"
                                FlowDirection="{Binding GlobalTextFlow}"
                                Source="{StaticResource Button_02_Right}" />
                            <TextBlock
                                x:Name="CenterTextGlow"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Height="24"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground ="{StaticResource Brush.Accent7}"
                                Text="{TemplateBinding local:PropEx.TextRight}"
                                TextAlignment="Center" />
                        </Grid>

                        <TextBlock
                            x:Name="LeftText"
                            Height="24"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground ="#FF000000"
                            Text="{TemplateBinding local:PropEx.TextLeft}"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Name="CentreText"
                            Height="24"
                            Margin="50,0,120,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground ="#FF000000"
                            Text="{TemplateBinding local:PropEx.TextCentre}"
                            TextAlignment="Left" />

                        <TextBlock
                            x:Name="LeftTextHL"
                            Height="24"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground ="#FFFFFFFF"
                            Text="{TemplateBinding local:PropEx.TextLeftHL}"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Name="CentreTextHL"
                            Height="24"
                            Margin="50,0,120,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground ="#FFFFFFFF"
                            Text="{TemplateBinding local:PropEx.TextCentreHL}"
                            TextAlignment="Left" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LeftText" Property="Opacity" Value="0.9" />
                            <Setter TargetName="CenterText" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="MyGridViewColumnHeader" TargetType="GridViewColumnHeader">
        <Grid>
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
            <Thumb x:Name="PART_HeaderGripper" Style="{StaticResource Style.GridViewColumnHeader.Gripper}" BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Right" IsEnabled="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Header.Over}" TargetName="HeaderBorder"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Header.Pressed}" TargetName="HeaderBorder"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>