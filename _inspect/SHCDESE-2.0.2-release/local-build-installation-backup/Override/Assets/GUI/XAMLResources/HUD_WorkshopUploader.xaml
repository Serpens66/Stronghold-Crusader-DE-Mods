<UserControl
    x:Class="CrusaderDE.HUD_WorkshopUploader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="500"
    d:DesignWidth="930"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>
    </UserControl.Resources>


    <Grid
        x:Name="LayoutRoot"
        
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{StaticResource Brush.InsetColour1}"
        IsHitTestVisible="True"
        UseLayoutRounding="True">

        <Grid
            Width="930"
            Height="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            >

            <Button
            Name="WorkshopBorder"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Style="{StaticResource BDR_SH1DEa}" />

            <local:WGT_Heading
            x:Name="WorkshopHeader"
            Width="930"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Divider="{StaticResource Panel_Divider}"
            HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_112]}" />

            <TextBlock
            Width="275"
            Margin="20,80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextAlignment="Left"
            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_113]}"/>

            <TextBox
            Name="WorkshopMapTitle"
            Width="600"
            Margin="300,80,0,0"
            MaxLength="64"
            TextAlignment="Left"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"  />

            <TextBlock
            Width="275"
            Margin="20,120,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextAlignment="Left"
            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_114]}"/>

            <TextBox
            Name="WorkshopMapDescription"
            Width="600"
            Margin="300,120,0,0"
            MaxLength="2000"
            TextAlignment="Left"
            HorizontalAlignment="Left"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Height="176"/>

            <Grid
                Visibility="{Binding Show_WorkshopDifficulty, Converter={StaticResource booleanToVisibilityConverter}}">
                <TextBlock
                Width="275"
                Margin="20,297,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Left"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_124]}"/>

                <RadioButton
                    x:Name="EasyTag"
                    Margin="300,301,0,0"
                    Width="150"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    GroupName="Difficulty"
                    >
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_020]}"
                        Margin="0,0,0,0"
                        FontSize="20"
                        VerticalAlignment="Center">
                    </TextBlock>
                </RadioButton>

                <RadioButton
                    x:Name="NormalTag"
                    Margin="450,301,0,0"
                    Width="150"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    GroupName="Difficulty"
                    >
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_021]}"
                        Margin="0,0,0,0"
                        FontSize="20"
                        VerticalAlignment="Center">
                    </TextBlock>
                </RadioButton>

                <RadioButton
                    x:Name="HardTag"
                    Margin="600,301,0,0"
                    Width="150"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    GroupName="Difficulty"
                    >
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_022]}"
                        Margin="0,0,0,0"
                        FontSize="20"
                        VerticalAlignment="Center">
                    </TextBlock>
                </RadioButton>

                <RadioButton
                    x:Name="VeryHardTag"
                    Margin="750,301,0,0"
                    Width="150"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    GroupName="Difficulty"
                    >
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_023]}"
                        Margin="0,0,0,0"
                        FontSize="20"
                        VerticalAlignment="Center">
                    </TextBlock>
                </RadioButton>
            </Grid>
            <TextBlock
                Width="275"
                Margin="20,327,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Left"
                Visibility="Collapsed"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_184]}"/>

            <CheckBox 
                    x:Name="BalancedCheck"
                    Margin="300,327,0,0"
                    Width="50"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                Visibility="Collapsed"
                Style="{StaticResource CheckBox_Template}">
            </CheckBox>
            

            <TextBlock
                Name="WorkshopTOSText"
                Width="600"
                Margin="300,358,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Center"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_116]}"/>

            <Button
            Width="400"
            Margin="400,398,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_117]}"
            local:PropEx.TextLeft=""
            local:PropEx.TextRight=""
            Command="{Binding ButtonWorkshopCommand}"
            CommandParameter="ToS"
            MouseEnter="CommonRedButtonEnter"
            Style="{StaticResource BTN_SH_GlowS}" />

            <Button
            Width="200"
            Margin="40,0,0,30"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_HELP_003]}"
            local:PropEx.TextLeft=""
            local:PropEx.TextRight=""
            Command="{Binding ButtonWorkshopCommand}"
            CommandParameter="Exit"
            MouseEnter="CommonRedButtonEnter"
            Style="{StaticResource BTN_SH_GlowS}" />

            <Button
            x:Name="WorkshopUpload"
            Width="200"
            Margin="0,0,40,30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            local:PropEx.TextCentre="{Binding WorkshopUploadText}"
            local:PropEx.TextLeft=""
            local:PropEx.TextRight=""
            Command="{Binding ButtonWorkshopCommand}"
            CommandParameter="Upload"
            MouseEnter="CommonRedButtonEnter"
            Style="{StaticResource BTN_SH_GlowS}" />

            <Grid
            Name="UploadPanel"
            Width="930"
            Height="500"
            Background="{StaticResource Brush.InsetColour1}"
            Visibility="Hidden"
            >

                <Button
            Width="600"
            Height="150"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BDR_SH1DEb}" />

                <TextBlock
            Width="550"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_127]}"/>

            </Grid>
        </Grid>
    </Grid>


</UserControl>