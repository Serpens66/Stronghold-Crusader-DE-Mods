<UserControl
    x:Class="CrusaderDE.HUD_Scenario_Popup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="250"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Storyboard x:Key="Intro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-580" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Outtro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="-580">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="HiddenStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>



        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>


        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>

    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Outtro}" />
        </EventTrigger>
    </UserControl.Triggers>


    <Grid
        x:Name="LayoutRoot"
        Width="250"
        Height="600"
        
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>




        <Button
            Name="ScenarioBorder"
            Width="250"
            Height="600"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEb}" />


        <!--  Side Buttons & Controls  -->
        <Grid  >
            <StackPanel
                Name="LeftPanel"
                Width="240"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility ="Visible">
                <TextBlock
                    Name="MapType"
                    Width="224"
                    Margin="12,50,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="Type"/>

                <TextBlock
                    Name="MapName"
                    Width="224"
                    Margin="12,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="Name"/>

                <TextBlock
                    Name="MapSize"
                    Width="224"
                    Margin="12,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    FlowDirection="LeftToRight"
                    Text="100 x 100"/>

                <Button
                    Name="ButtonEditSettings"
                    Width="210"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding ButtonMapSettingsText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-1"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

                <TextBlock
                    Name="MapSizeLabel"
                    Width="224"
                    Margin="12,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAPEDIT_021]}"/>

                <Button
                    Name="ButtonEditMapSize160"
                    Width="100"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="160"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="160"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit160HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize200"
                    Width="100"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="200"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="200"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit200HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize300"
                    Width="100"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="300"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="300"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit300HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize400"
                    Width="100"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="400"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="400"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit400HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />

                <Button
                    Name="ButtonEditMapSize500"
                    Width="100"
                    Margin="130,-142,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="500"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="500"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit500HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize600"
                    Width="100"
                    Margin="130,-104,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="600"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="600"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit600HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize700"
                    Width="100"
                    Margin="130,-66,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="700"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="700"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit700HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
                <Button
                    Name="ButtonEditMapSize800"
                    Width="100"
                    Margin="130,-28,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="800"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="800"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEdit800HL, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />

                <Button
                    Name="ButtonEditMapPlayer"
                    Width="210"
                    Margin="20,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding ButtonScenarioEditSPMP}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-2"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

                <Button
                    Name="ButtonEditMapSPTypeInvasion"
                    Width="210"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_031]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="2"
                    Visibility="{Binding ButtonScenarioEditSinglePlayerVis, Converter={StaticResource booleanToVisibilityConverter}}"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEditSPInvasion, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />

                <Button
                    Name="ButtonEditMapSPTypeFreebuild"
                    Width="210"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_BUBBLE_HELP_TEXT_265]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="4"
                    Visibility="{Binding ButtonScenarioEditSinglePlayerVis, Converter={StaticResource booleanToVisibilityConverter}}"
                    local:PropEx.BorderVisibility="{Binding ButBordScenEditSPFreeBuild, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />

            </StackPanel>
            <Grid
                Name="ScenarioPopupNormalButtons"
                >
                <Button
                    Name="ScenarioPopupTimeButton"
                    Width="210"
                    Margin="20,190,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding ScenarioPopup_GameTimeText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-10"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
                <Button
                    Name="ScenarioPopupBalancedButton"
                    Width="210"
                    Margin="20,225,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding ScenarioPopup_BalancedText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-13"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
                <Button
                    Width="210"
                    Margin="20,260,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAPEDIT_004]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-11"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

                <Button
                    Name="ScenarioPopupQuitButton"
                    Width="210"
                    Margin="20,295,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_085]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonScenarioEditSettingsCommand}"
                    CommandParameter="-12"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />                
            </Grid>
        </Grid>



    </Grid>
</UserControl>