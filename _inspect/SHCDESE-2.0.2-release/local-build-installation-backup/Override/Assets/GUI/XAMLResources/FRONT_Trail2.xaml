            </Button>

            <Button
                Width="192"
                Height="176"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,100,160"
                local:PropEx.Sprite1="{StaticResource SkirmishMasters}"
                local:PropEx.Sprite2="{StaticResource SkirmishMastersOver}"
                local:PropEx.Sprite3="{StaticResource SkirmishMastersOver}"
                local:PropEx.Sprite4="{StaticResource SkirmishMasters}"
                Command="{Binding TrailCampaignMenuCommand}"
                CommandParameter="-11"
                Style="{StaticResource BTN_Image}" />

            <Button
                Name="Extra1QuitButtonX"
                Width="151"
                Height="66"
                Margin="60,0,0,30"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.ImageFlow="{Binding GlobalTextFlow}"
                local:PropEx.Sprite1="{StaticResource UI-Buttons B005}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons B006}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons B007}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons B008}"
                Command="{Binding TrailCampaignMenuCommand}"
                CommandParameter="-1"
                Style="{StaticResource BTN_Image}" />

            <Button
                Name="Extra1ResumeButtonX"
                Width="151"
                Height="66"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,60,30"
                local:PropEx.ImageFlow="{Binding GlobalTextFlow}"
                local:PropEx.Sprite1="{StaticResource UI-Buttons B001}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons B002}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons B003}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons B004}"
                Command="{Binding TrailCampaignMenuCommand}"
                CommandParameter="-10"
                Style="{StaticResource BTN_Image}" />

            <Button
                Name="Trail2_LoadButton"
                Height="103"
                Margin="0,0,250,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.Sprite1="{StaticResource Load Shield Up}"
                local:PropEx.Sprite2="{StaticResource Load Shield Over}"
                local:PropEx.Sprite3="{StaticResource Load Shield Over}"
                local:PropEx.Sprite4="{StaticResource Load Shield Up}"
                Command="{Binding ButtonMainMenuCommand}"
                CommandParameter="LoadTrail"
                Style="{StaticResource BTN_Image}">
            </Button>
            <TextBlock
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                FontSize="24"
                Foreground="#FFFFFFFF"
                VerticalAlignment="Bottom"
                Visibility="{Binding ChickenCheatRolloverVis}"
                Text="{Binding GameTexts[TEXT_CHEATS_001], Source={x:Static local:Translate.Instance}}" />
        </Grid>

        <!-- confirmation popup -->
        <Grid
            x:Name="HUD_ConfirmationPopupMain"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#00000000"
            Panel.ZIndex="20000"
            Visibility="{Binding Show_HUD_Confirmation, Converter={StaticResource booleanToVisibilityConverter}}">
            <Viewbox
                Width="{Binding FrontEndConfirmationWidth}"
                Height="{Binding FrontEndConfirmationHeight}">
                <Grid
                    Width="{Binding ConfirmationPanelWidthView}"
                    Height="{Binding ConfirmationPanelHeightView}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <local:HUD_ConfirmationPopup
                        Tag="1"
                        Margin="0" />
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>

