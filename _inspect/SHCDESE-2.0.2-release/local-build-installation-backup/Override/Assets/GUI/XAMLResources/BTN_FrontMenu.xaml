                    </ControlTemplate.Resources>

                    <Viewbox Stretch="Uniform">
                        <Grid
                            x:Name="BaseGrid"
                            Width="568"
                            Height="60"
                            RenderTransformOrigin="0.5,0.5"
                            UseLayoutRounding="False">
                            <Rectangle
                                x:Name="HitBox"
                                Fill="#00ffff00"
                                RadiusX="1"
                                RadiusY="1">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.05" />
                                        <ScaleTransform ScaleY="2.00" />
                                        <TranslateTransform X="-40" />
                                        <TranslateTransform Y="-30" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <Grid
                                x:Name="LayoutRoot"
                                Width="568"
                                Height="60"
                                RenderTransformOrigin="0.5,0.5"
                                UseLayoutRounding="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>

                                <Rectangle
                                    x:Name="GreenbuttonBody"
                                    RadiusX="30"
                                    RadiusY="30"
                                    Stroke="Black"
                                    StrokeThickness="2">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0.95" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="1.104,-0.404" EndPoint="0.047,0.825">
                                            <GradientStop Color="#FF222222" />
                                            <GradientStop Offset="1" Color="#FF000000" />
                                            <GradientStop Offset="0.521" Color="#FF444444" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Rectangle
                                    x:Name="GreenbuttonHighlight"
                                    Height="17"
                                    Margin="17,5,17,35"
                                    RadiusX="10.4"
                                    RadiusY="10.4"
                                    StrokeThickness="2">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0.95" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#44222222" />
                                            <GradientStop Offset="1" Color="#44888888" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>


                                <Path
                                    x:Name="Indicator"
                                    Width="300"
                                    Margin="0,2.75,0,18.75"
                                    HorizontalAlignment="Right"
                                    Data="{StaticResource SwordGeometry}"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    Stroke="#AACCCCCC"
                                    StrokeThickness="0">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="-260" />
                                            <TranslateTransform Y="-20" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                    <Path.Fill>
                                        <SolidColorBrush Opacity="1" Color="#FF000000" />
                                    </Path.Fill>
                                </Path>

                                <Path
                                    x:Name="Shield"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Data="{StaticResource ShieldGeometry}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    Stroke="#FFCCCCCC"
                                    StrokeThickness="0">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="-40" />
                                            <ScaleTransform ScaleX="1.0" />
                                            <ScaleTransform ScaleY="-1.4" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                    <Path.Fill>
                                        <SolidColorBrush Opacity="1" Color="#ff000000" />
                                    </Path.Fill>
                                </Path>

                                <Path
                                    x:Name="ButtonImage"
                                    Width="80"
                                    Height="60"
                                    HorizontalAlignment="Left"
                                    Data="{TemplateBinding local:PropEx.SvgImage}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    Stroke="#FF000000"
                                    StrokeThickness="0">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="-63" />
                                            <ScaleTransform ScaleX="0.45" />
                                            <ScaleTransform ScaleY="0.7" />
                                            <TranslateTransform Y="-5" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                    <Path.Fill>
                                        <SolidColorBrush Opacity="1" Color="#55CCCCCC" />
                                    </Path.Fill>
                                </Path>




                                <TextBlock
                                    x:Name="ContentHost"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FF888888"
                                    FlowDirection="{Binding GlobalTextFlowAL2R}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="{TemplateBinding Content}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="-30" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>


                            </Grid>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.6" To="Focused">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition GeneratedDuration="0:0:0.3" From="Focused">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused" />
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.4" To="MouseOver">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase Amplitude="1.2" EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition GeneratedDuration="0:0:0.2" From="MouseOver">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>


                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Pressed" />

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shield" Storyboard.TargetProperty="RenderTransform.Children[0].X">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shield" Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shield" Storyboard.TargetProperty="RenderTransform.Children[2].ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="-2.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shield" Storyboard.TargetProperty="StrokeThickness">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="2.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonImage" Storyboard.TargetProperty="RenderTransform.Children[0].X">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="-9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonImage" Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonImage" Storyboard.TargetProperty="RenderTransform.Children[2].ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1.1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonImage" Storyboard.TargetProperty="StrokeThickness">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(Shape.Fill).(Brush.Opacity)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.Children[0].X">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="StrokeThickness">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0.0" />
                                        </DoubleAnimationUsingKeyFrames>


                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="10" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="FontSize">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="34" />
                                        </DoubleAnimationUsingKeyFrames>


                                        <ColorAnimationUsingKeyFrames
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FF000000">
                                                <EasingColorKeyFrame.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </EasingColorKeyFrame.EasingFunction>
                                            </EasingColorKeyFrame>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FFFFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ButtonImage" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FFFFFFFF" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Viewbox>




                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>