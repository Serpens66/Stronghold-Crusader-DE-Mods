<UserControl
    x:Class="CrusaderDE.WGT_Popularity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="40"
    d:DesignWidth="40"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#FF000000" />
            <!--            <Setter Property="FontFamily" Value="Times New Roman" /> -->
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>
    </UserControl.Resources>


    <Grid
        x:Name="LayoutRoot"
        Width="60"
        Height="40"
        RenderTransformOrigin="0.5,0.5">

        <TextBlock
            x:Name="PopValueText"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="#FF000000"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5"
            FlowDirection="LeftToRight"
            Text="{Binding PopValue}">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="-24" />
                    <TranslateTransform Y="3" />
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <Image
            x:Name="PopHead"
            Width="20"
            Height="23"
            Margin="0,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Source="{StaticResource UISprites F007}" >
            <Image.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="2" />
                    <TranslateTransform Y="2" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

    </Grid>
</UserControl>