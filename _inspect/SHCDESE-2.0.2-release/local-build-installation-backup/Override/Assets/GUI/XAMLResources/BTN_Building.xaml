                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>





                </ControlTemplate>
            </Setter.Value>
        </Setter>

       
    </Style>
    
</ResourceDictionary>