        <Style x:Key="HiddenStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>


        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>

    </UserControl.Resources>
    <!--

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Outtro}" />
        </EventTrigger>
    </UserControl.Triggers>
-->


    <Grid
        x:Name="LayoutRoot"
        Width="1000"
        Height="600"
        
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>


        <Button
            Name="RequesterBorder"
            Width="1000"
            Height="600"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BDR_SH1DEa}" />

        <local:WGT_Heading
            x:Name="RequesterHeader"
            Width="1000"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Divider="{StaticResource Panel_Divider}"
            HeadingText="Load/Save" />

        <!--  These are all the separate Views into the main panel area -->

        <!--  Main 'default' view  -->
        <Grid
            Width="670"
            Height="470"
            Margin="0,80,24,0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Visible"
            Background="{StaticResource Brush.InsetColour1}">

            <Border
                Width="670"
                Height="470"
                Margin="0,0,0,-37"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="#FF000000"
                BorderThickness="2" />

            <ListView Margin="2" Name="FileList"
                      ItemContainerStyle="{StaticResource LoadSave_ListViewItem}">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="{Binding ColumnWidthName}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader  Template="{StaticResource MyGridViewColumnHeader}" Tag="Name" >Name</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                    Margin="0,-4,0,-4"
                                    HorizontalAlignment="Left"
                                    Foreground="Black" 
                                    FontSize="16"
                                    TextTrimming="CharacterEllipsis"
                                    Text = "{Binding Text1}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding ColumnWidthDate}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Template="{StaticResource MyGridViewColumnHeader}" Tag="Date" >Date</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                    Margin="0,-4,0,-4"
                                    HorizontalAlignment="Left"
                                    Foreground="Black" 
                                    FontSize="16"
                                    Text = "{Binding Text2}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding ColumnWidthSize}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Template="{StaticResource MyGridViewColumnHeader}" Tag="Size" ></GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                    Margin="0,-4,0,-4"
                                    HorizontalAlignment="Left"
                                    Foreground="Black" 
                                    FontSize="16"
                                    Text = "{Binding Text4}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding ColumnWidthType}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Template="{StaticResource MyGridViewColumnHeader}" Tag="Type" >Type</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                    Margin="0,-4,0,-4"
                                    HorizontalAlignment="Left"
                                    Foreground="Black" 
                                    FontSize="16"
                                    Text = "{Binding Text3}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBox
                Name="SearchFilter"
                Width="270"
                Margin="196,0,0,-40"
                MaxLength="32"
                TextAlignment="Left"
                Focusable="True"
                Text= "{Binding LoadSaveFilter}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"/>

            <TextBlock
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_126]}"
                Margin="206,0,0,-38"
                FontSize="20"
                Width="250"
                Foreground="#FFEFF3C6"
                TextAlignment="Left"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Visibility="{Binding LoadSaveFilterLabelVis}"
                >
            </TextBlock>
            <Grid
                Visibility="{Binding LoadSaveFilterButtonVis}"
                Width="34"
                Height="34"
                Margin="476,0,0,-40"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                >
                <Button
                    Width="34"
                    Height="34"
                    local:PropEx.Sprite1="{StaticResource UI-Buttons L009}"
                    local:PropEx.Sprite2="{StaticResource UI-Buttons L010}"
                    Command="{Binding ButtonLoadSaveCommand}"
                    CommandParameter="4"
                    Style="{StaticResource BTN_Building}"/>
            </Grid>
        </Grid>

        <!--  Side Buttons & Controls  -->
        <Grid  Grid.Column="0"
               Grid.ColumnSpan="2">

            <TextBox
                    Name="FileName"
                    Width="270"
                    Margin="23,320,0,0"
                    MaxLength="32"
                    TextAlignment="Left"
                    Focusable="True"
                    Text= "{Binding LoadSaveFileName}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>

            <Grid
            Name="RadarRequesterGrid"
            Width="200"
            Height="200"
            Margin="57,100,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{Binding Show_RequesterRadar, Converter={StaticResource booleanToVisibilityConverter}}">
                <!--                Loaded="OnLoadRadarGrid"
            Unloaded="OnUnLoadRadarGrid" -->

                <Image
                Name="RadarRequesterImage"
                IsHitTestVisible="True"
                RenderTransformOrigin="0.5,0.5"
                Source="{Binding RadarRequesterImage}" />

                <Image
                    Visibility="{Binding Show_Radar160Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 160}" />
                <Image
                    Visibility="{Binding Show_Radar300Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 300}" />
                <Image
                    Visibility="{Binding Show_Radar500Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 500}" />
                <Image
                    Visibility="{Binding Show_Radar700Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 700}" />
            </Grid>

            <Button
            Width="200"
            Height="200"
            Margin="57,100,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{Binding Show_RequesterRadar, Converter={StaticResource booleanToVisibilityConverter}}"
            Style="{StaticResource BDR_SH1DEc}" />

            <Button
                    Name="ButtonOpenFolder"
                    Width="220"
                    Margin="45,390,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding LoadSave_FolderText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonLoadSaveCommand}"
                    CommandParameter="3"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}"  />

            <CheckBox 
                x:Name="HideQuicksaveCheck"
                Margin="45,440,67,0"
                Width="300"
                Height="23"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding SaveHideQuicksaveVisible, Converter={StaticResource booleanToVisibilityConverter}}"
                Style="{StaticResource CheckBox_Template}">
                <TextBlock
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_166]}"
                    Margin="0,2,0,-2"
                    FontSize="18"
                    VerticalAlignment="Center">
                </TextBlock>
            </CheckBox>
<!--            <CheckBox 
                x:Name="LockMapCheck"
                Margin="45,450,67,0"
                Width="300"
                Height="23"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding SaveSiegeThatLockVisible, Converter={StaticResource booleanToVisibilityConverter}}"
                >
                <TextBlock
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_129]}"
                    Margin="0,2,0,-2"
                    FontSize="18"
                    VerticalAlignment="Center">
                </TextBlock>
            </CheckBox>
-->            

            <Button
                    Name="ButtonAction"
                    Width="220"
                    Margin="45,498,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding ButtonLoadSaveActionText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonLoadSaveCommand}"
                    CommandParameter="1"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}"  />

            <Button
                    Name="ButtonCancel"
                    Width="220"
                    Margin="45,546,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_018]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonLoadSaveCommand}"
                    CommandParameter="2"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}"  />


        </Grid>

    </Grid>
</UserControl>