                    Command="{Binding OptionsCommand}"
                    CommandParameter="-102"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />


                <!-- Change key 2 -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="200"
                    Margin="436,271,164,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding GameTexts[TEXT_NEW_TEXT_093], Source={x:Static local:Translate.Instance}}" />
                <Button
                    Width="200"
                    Margin="436,319,164,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding OptionsHotKey2}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-103"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

                <!-- Close key panel -->
                <Button
                    Width="200"
                    Margin="475,0,125,197"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_091]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-101"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
            </Grid>

            <Grid
                Width="800"
                Height="600"
                Visibility="{Binding OptionsHotKeyChangeVis}">
                <!-- Press key -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="400"
                    Margin="0,244,0,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding GameTexts[TEXT_NEW_TEXT_095], Source={x:Static local:Translate.Instance}}" />
                <!-- Current key -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="200"
                    Margin="164,271,436,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding GameTexts[TEXT_NEW_TEXT_096], Source={x:Static local:Translate.Instance}}" />
                <!-- New key -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="200"
                    Margin="436,271,164,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding GameTexts[TEXT_NEW_TEXT_097], Source={x:Static local:Translate.Instance}}" />
                <!-- Current key Value -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="200"
                    Margin="164,311,436,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding OptionsHotKeyCurrentKey}" />
                <!-- New key -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="200"
                    Margin="436,311,164,0"
                    FontSize="24"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding OptionsHotKeyNewKey}" />

                <!-- Warning Message -->
                <TextBlock
                    HorizontalAlignment="Center"
                    Width="550"
                    Margin="0,344,0,0"
                    FontSize="18"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    Text="{Binding OptionsHotKeyWarning}" />
                <!-- Cancel Key change -->
                <Button
                    Width="150"
                    Margin="475,0,125,197"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SCENARIO_037]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-104"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
                <!-- Clear Key -->
                <Button
                    Width="150"
                    Margin="0,0,0,197"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_099]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-106"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
                <!-- Apply Key -->
                <Button
                    x:Name="OptionsHotKeyNewKeyApply"
                    Width="150"
                    Margin="125,0,475,197"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_019]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-105"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />
            </Grid>
        </Grid>


        <Grid
            Visibility="{Binding OptionsNewsletterVis}"
            Width="800"
            Height="600"
            Background="{StaticResource Brush.InsetColour1}">

            <Button
                Width="800"
                Height="500"
                Margin="0,0,0,0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BDR_SH1DEb}" />
            <local:WGT_Heading
                Width="800"
                Margin="0,50,0,0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Divider="{StaticResource Panel_Divider}"
                HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_343]}" />
            <Grid
                Width="800"
                Height="500">
               


                <Image
                    Margin="0,75,0,0"
                    Width="700"
                    Height="200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Stretch="Fill"
                    Source="../Images/ScribeUnlock.png"/>

                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="30,285,30,0"
                    FontSize="18"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_348]}" />

                <TextBlock
                    HorizontalAlignment="Right"
                    Margin="0,370,655,0"
                    FontSize="18"
                    VerticalAlignment="Top"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_345]}" />
                
                <TextBox
                    Name="TextBoxNewsletter"
                    Width="600"
                    Margin="0,360,50,0"
                    MaxLength="100"
                    TextAlignment="Left"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />


                <CheckBox
                    Name="NewsletterCheck"
                    Margin="30,0,0,20"
                    Width="500"
                    Height="43"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource CheckBox_Template}">
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_346]}"
                        Margin="0,2,0,-2"
                        FontSize="18"
                        TextWrapping="Wrap"
                        LineHeight="20"
                        LineStackingStrategy="BlockLineHeight"
                        VerticalAlignment="Center" />
                </CheckBox>

                <Button
                    Name="NewsletterSignupButton"
                    Width="200"
                    Margin="0,0,40,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_344]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-20000"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

                <Button
                    Width="200"
                    Margin="0,0,40,50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_004]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding OptionsCommand}"
                    CommandParameter="-20001"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

            </Grid>
        </Grid>

    </Grid>
</UserControl>