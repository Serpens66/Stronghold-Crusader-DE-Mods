<UserControl
    x:Class="CrusaderDE.HUD_CoatOfArms"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="510"
    d:DesignWidth="397"
    mc:Ignorable="d"
    x:Name="root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />


        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FFEFF3C6" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>


        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>

    </UserControl.Resources>

    <Grid
        x:Name="CoA"
        Width="397"
        Height="510"
        
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#00000000"
        UseLayoutRounding="True">
        <Border
            Width="397"
            Height="510"
            Margin="0,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="#FF000000"
            BorderThickness="2"
            Visibility="{Binding CoA_OptionsBorder, Converter={StaticResource booleanToVisibilityConverter}}" />

        <Border
            Width="2"
            Height="620"
            Margin="-9,-15,0,-20"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#FF000000"
            BorderThickness="2"
            Visibility="{Binding CoA_IntroBorder, Converter={StaticResource booleanToVisibilityConverter}}" />

        <Button
            Width="280"
            Height="40"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEb}" />

        <TextBlock
            Margin="0,27,0,0"
            FontSize="22"
            Width="300"
            Height="40"
            Foreground="Black"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Typography.Capitals="SmallCaps"
            Text="{Binding GameTexts[TEXT_NEW_CTEXT_373], Source={x:Static local:Translate.Instance}}" />

        <Image
            Margin="-345,20,0,0"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Source="{StaticResource Charge Icon}" />
        <Button
            Margin="345,20,0,0"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            local:PropEx.Sprite1="{StaticResource Charge_Export_Icon_Up}"
            local:PropEx.Sprite2="{StaticResource Charge_Export_Icon_Over}"
            local:PropEx.Sprite3="{StaticResource Charge_Export_Icon_Over}"
            Command="{Binding CoACommand}"
            CommandParameter="Export"
            Style="{StaticResource BTN_Image}" />


        <TextBlock
            Margin="0,427,0,0"
            FontSize="16"
            Width="300"
            Foreground="Black"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            TextWrapping="Wrap"
            Text="{Binding CoARollover}" />

        <TextBlock
            Margin="0,448,0,0"
            FontSize="14"
            Width="300"
            Foreground="Black"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            TextWrapping="Wrap"
            Text="{Binding GameTexts[TEXT_NEW_CTEXT_375], Source={x:Static local:Translate.Instance}}" />

        <CheckBox
            x:Name="UseSteamAvatarCheck"
            Margin="0,483,0,0"
            Height="23"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsChecked="{Binding ElementName=root, Path=COA_UseSteamAvatar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource CheckBox_Template_Special}">
            <TextBlock
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_374]}"
                Foreground="Black"
                Margin="0,2,0,-2"
                FontSize="14"
                VerticalAlignment="Center" />
        </CheckBox>

        <Image
            Margin="37,77,0,0"
            Width="138"
            Height="138"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
