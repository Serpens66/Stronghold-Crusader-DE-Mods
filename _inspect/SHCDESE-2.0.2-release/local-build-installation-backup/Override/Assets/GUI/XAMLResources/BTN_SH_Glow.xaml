    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <Style x:Key="BTN_SH_GlowS" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowDuration" Value="2500" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="1000" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid
                        x:Name="BaseGrid"
                        RenderTransformOrigin="0.5,0.5"
                        UseLayoutRounding="False">

                        <Rectangle x:Name="HitBox" Fill="#00ffff00" />

                        <Grid
                            x:Name="NormalMode"
                            FlowDirection="LeftToRight"
                            Margin="-1.5,-1.5, -1.5, -1.5"
                            Height="31"
                            Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29.5" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="29.5" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Source="{StaticResource Button_01_Left}" />

                            <Rectangle
                                Grid.Column="1"
                                Margin="-0.5,0,-0.5,0"
                                Opacity="1">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{StaticResource Button_01_Center}"
                                        Viewport="0,0,29.5,31"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Image
                                Grid.Column="2"
                                Source="{StaticResource Button_01_Right}"
                                Stretch="Fill" />
                        </Grid>

                       

                        <Grid
                            x:Name="GlowMode"
                            FlowDirection="LeftToRight"
                            Margin="-1.5,-1.5, -1.5, -1.5"
                            Height="31"
                            Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29.5" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="29.5" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Source="{StaticResource Button_02_Left_}" />

                            <Rectangle
                                Grid.Column="1"
                                Margin="-0.5,0,-0.5,0"
                                Opacity="1">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{StaticResource Button_02_Center}"
                                        Viewport="0,0,29.5,31"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Image
                                Grid.Column="2"
                                Source="{StaticResource Button_02_Right}"
                                Stretch="Fill" />
                        </Grid>

                          
                        <TextBlock
                            x:Name="LeftText"
                            Height="{TemplateBinding local:PropEx.GlowButtonTextHeight}"
                            Margin="12,4,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize ="{TemplateBinding local:PropEx.GlowButtonFontSize}"
                            Foreground ="{StaticResource Brush.Accent7}"
                            Text="{TemplateBinding local:PropEx.TextLeft}"
                            TextAlignment="Left" />

                        <TextBlock
                            x:Name="RightText"
                            Height="{TemplateBinding local:PropEx.GlowButtonTextHeight}"
                            Margin="0,4,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize ="{TemplateBinding local:PropEx.GlowButtonFontSize}"
                            Foreground ="{StaticResource Brush.Accent8}"
                            Text="{TemplateBinding local:PropEx.TextRight}"
                            TextAlignment="Right" />

                        <TextBlock
                            x:Name="CenterText"
                            Height="{TemplateBinding local:PropEx.GlowButtonTextHeight}"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize ="{TemplateBinding local:PropEx.GlowButtonFontSize}"
                            Foreground ="{StaticResource Brush.Accent7}"
                            Text="{TemplateBinding local:PropEx.TextCentre}"
                            TextAlignment="Center" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Hidden" />
                        </Trigger>                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LeftText" Property="Opacity" Value="0.9" />
                            <Setter TargetName="RightText" Property="Opacity" Value="0.9" />
                            <Setter TargetName="CenterText" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NormalMode" Property="Visibility" Value="Visible" />
                            <Setter TargetName="GlowMode" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="LeftText" Property="Opacity" Value="0.6" />
                            <Setter TargetName="RightText" Property="Opacity" Value="0.6" />
                            <Setter TargetName="CenterText" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

