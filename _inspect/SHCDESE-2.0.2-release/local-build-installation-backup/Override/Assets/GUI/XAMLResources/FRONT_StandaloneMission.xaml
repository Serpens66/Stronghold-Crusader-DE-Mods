<!-- NOTDEMOSTART -->
<UserControl
    x:Class="CrusaderDE.FRONT_StandaloneMission"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    d:DesignHeight="768"
    d:DesignWidth="1366"
    mc:Ignorable="d">


    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

    </UserControl.Resources>



    <Grid
        Name="mapgrid"
        Background="Black"
        IsHitTestVisible="True">

        <Image
            Name="Basemap"
            Width="1366"
            Height="768"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="../Images/victory_military_small.png"
            Stretch="UniformToFill" />

        <!-- Header -->
        <Button
            Width="515"
            Height="60"
            Margin="0,25,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEb}"
            />

        <Grid
            Width="515"
            Height="80"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBlock 
                TextAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Foreground="Black" 
                FontSize="40"
                Typography.Capitals="SmallCaps"
                Text = "{Binding StandaloneTitle}"/>

            <Image
                Width="20"
                Height="40"
                Margin="0,20,25,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="1"
                IsHitTestVisible="False"
                Source="{StaticResource Panel_CelticKnot}" />

            <Image
                Width="20"
                Height="40"
                Margin="25,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="1"
                IsHitTestVisible="False"
                Source="{StaticResource Panel_CelticKnot}" />
        </Grid>

        <Viewbox
            Margin="900,22,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="300">
            <Grid
                x:Name="CarouselNext"
                Opacity="0.6"
                >
                <Button
                    Width="515"
                    Height="60"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource BDR_SH1DEb}"
                    Command="{Binding StandaloneMenuCommand}"
                    CommandParameter="Next">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseEnter">
                            <b:InvokeCommandAction Command="{Binding StandaloneMenuCommand}" CommandParameter="MouseEnter_Next" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeave">
                            <b:InvokeCommandAction Command="{Binding StandaloneMenuCommand}" CommandParameter="MouseLeave_Next" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
                <Grid
                    Width="515"
                    Height="80"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    VerticalAlignment="Top">
                    <TextBlock 
                        TextAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        Foreground="Black" 
                        FontSize="40"
                        Typography.Capitals="SmallCaps"
                        IsHitTestVisible="False"
                        Text = "{Binding StandaloneNext}"/>
                    <Image
                        Width="20"
                        Height="40"
                        Margin="0,20,25,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Opacity="1"
                        IsHitTestVisible="False"
                        Source="{StaticResource Panel_CelticKnot}" />

                    <Image
                        Width="20"
                        Height="40"
                        Margin="25,20,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="1"
                        IsHitTestVisible="False"
                        Source="{StaticResource Panel_CelticKnot}" />
                </Grid>
            </Grid>
        </Viewbox>


        <Button
            Width="60"
            Height="60"
            Margin="10,23,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            local:PropEx.Sprite1="{StaticResource Button_Arrow_Left}"
            local:PropEx.Sprite2="{StaticResource Button_Arrow_Left_Over}"
            local:PropEx.Sprite3="{StaticResource Button_Arrow_Left_Over}"
            local:PropEx.Sprite4="{StaticResource Button_Arrow_Left}"
            Command="{Binding StandaloneMenuCommand}"
            CommandParameter="Prev"
            Style="{StaticResource BTN_Image}"
            />

        <Button
            Width="60"
            Height="60"
            Margin="10,23,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            local:PropEx.Sprite1="{StaticResource Button_Arrow}"
            local:PropEx.Sprite2="{StaticResource Button_Arrow_Over}"
            local:PropEx.Sprite3="{StaticResource Button_Arrow_Over}"
            local:PropEx.Sprite4="{StaticResource Button_Arrow}"
            Command="{Binding StandaloneMenuCommand}"
            CommandParameter="Next"
            Style="{StaticResource BTN_Image}"
            />


        <!-- Map List -->
        <Grid
            Margin="50,123,0,0"
            Width="467"
            Height="490"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            >
            <Button
            Name="Border"
            Margin="-3,-3,-3,-3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Style="{StaticResource BDR_SH1DEb}" >
            </Button>

            <ListView Margin="2" 
                      Name="MapList" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemContainerStyle="{StaticResource Standalone_ListViewItem}"
                >
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="40">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader  Template="{StaticResource MyGridViewColumnHeader}" Tag="Type" >Type</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                    Width="30"
                                    Margin="-2,0,0,0"
                                    Source="{Binding TypeImage}"
                                    />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            Width="40">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader
                                    Template="{StaticResource MyGridViewColumnHeader}"
                                    Tag="Size"></GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,-4,0,-4"
                                        HorizontalAlignment="Left"
                                        Foreground="Black"
                                        FontSize="16"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Text3}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="304">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Template="{StaticResource MyGridViewColumnHeader}" Tag="Name" >Name</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                        Margin="0,-4,0,-4"
                                        HorizontalAlignment="Left"
                                        FlowDirection="{Binding GlobalTextFlowAL2R}"
                                        Foreground="Black" 
                                        FontSize="16"
                                        TextTrimming="CharacterEllipsis"
                                        Text = "{Binding Text1}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    
                        <GridViewColumn Width="80">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Template="{StaticResource MyGridViewColumnHeader}" Tag="Date" >Date</GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                        Margin="0,-4,0,-4"
                                        HorizontalAlignment="Left"
                                        Foreground="Black" 
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Text = "{Binding Text2}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Grid
                Margin="-4,0,0,-42"
                Width="50"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    x:Name="IncludeUser"
                    Style="{StaticResource CheckBox_Template}" />
                <Image
                    Margin="22,0,-2,0"
                    Source="{StaticResource user}"
                    Width="30"
                    Height="30"
                    Stretch="Fill" />
            </Grid>
            <Grid
                Margin="54,0,0,-42"
                Width="50"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    x:Name="IncludeBuiltin"
                    Style="{StaticResource CheckBox_Template}" />
                <Image
                    Margin="22,0,-2,0"
                    Source="{StaticResource ff}"
                    Width="30"
                    Height="30"
                    Stretch="Fill" />
            </Grid>
            <Grid
                Margin="114,0,-40,-42"
                Width="50"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    x:Name="IncludeWorkshop"
                    Style="{StaticResource CheckBox_Template}" />
                <Image
                    Margin="22,0,-2,0"
                    Source="{StaticResource steam}"
                    Width="30"
                    Height="30"
                    Stretch="Fill" />
            </Grid>
            <Grid
                Margin="-4,0,0,-80"
                Width="450"
                Height="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    x:Name="ShowCompleted"
                    Width="450"
                    Height="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource CheckBox_Template}">
                    <TextBlock
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_181]}"
                        Margin="0,2,0,-2"
                        FontSize="20"
                        VerticalAlignment="Center" />
                </CheckBox>
            </Grid>
        </Grid>

        <TextBox
            Name="SA_SearchFilter"
            Width="255"
            Margin="230,0,0,110"
            MaxLength="32"
            TextAlignment="Left"
            Focusable="True"
            Text="{Binding StandaloneFilter}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom" />

        <TextBlock
            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_126]}"
            Margin="240,0,0,112"
            FontSize="20"
            Width="235"
            Foreground="#FFEFF3C6"
            TextAlignment="Left"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Visibility="{Binding StandaloneFilterLabelVis}">
        </TextBlock>

        <!--        Visibility="{Binding StandaloneFilterButtonVis}" -->
        <Grid
            Width="34"
            Height="34"
            Margin="305,0,0,110"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">
            <Button
                Width="34"
                Height="34"
                local:PropEx.Sprite1="{StaticResource UI-Buttons L009}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons L010}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="ClearFilter"
                Style="{StaticResource BTN_Building}"
                Margin="185,0,-185,0" />
        </Grid>


        <!-- Mission text -->
        <Grid
            Width="515"
            Height="200"
            Margin="0,120,290,0"
            FlowDirection="{Binding GlobalTextFlowAL2R}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                Style="{StaticResource BDR_SH1DEb}" />

            <TextBlock
                Margin="0,10,0,0"
                Width="398"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                TextAlignment="Center"
                Foreground="Black"
                FontSize="18"
                Text="{Binding StandaloneMissionTitle}" />

            <Image
                Margin="220,37,0,0"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding Show_StandaloneMissionUnBalanced, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{StaticResource Map}" />
            <TextBlock
                Margin="253,40,0,0"
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Left"
                Foreground="Black"
                FontSize="16"
                Visibility="{Binding Show_StandaloneMissionUnBalanced, Converter={StaticResource booleanToVisibilityConverter}}"
                Text="{Binding StandaloneMissionSize}" />

            <Image
                Margin="160,37,0,0"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding Show_StandaloneMissionHasOutposts, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{StaticResource Map}" />
            <TextBlock
                Margin="193,40,0,0"
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Left"
                Foreground="Black"
                FontSize="16"
                Visibility="{Binding Show_StandaloneMissionHasOutposts, Converter={StaticResource booleanToVisibilityConverter}}"
                Text="{Binding StandaloneMissionSize}" />

            <Image
                Margin="330,37,0,0"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding Show_StandaloneMissionHasOutposts, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{StaticResource Animals}" />
            <TextBlock
                Margin="363,40,0,0"
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Left"
                Foreground="Black"
                FontSize="16"
                Visibility="{Binding Show_StandaloneMissionHasOutposts, Converter={StaticResource booleanToVisibilityConverter}}"
                Text="{Binding StandaloneMissionPlayerCount}" />

            <ScrollViewer
                Margin="10,5,10,5"
                Width="475"
                Height="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <TextBlock
                    Margin="20,0,20,0"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Foreground="Black"
                    FontSize="16"
                    Text="{Binding StandaloneMissionText}" />
            </ScrollViewer>
        </Grid>

        <!-- Radar  -->
        <Grid
            Width="200"
            Height="200"
            Margin="0,120,50,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                Style="{StaticResource BDR_SH1DEb}" />
            <Grid
                Name="RadarStandaloneGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Image
                    Name="RadarStandaloneImage"
                    IsHitTestVisible="True"
                    RenderTransformOrigin="0.5,0.5"
                    Source="{Binding RadarStandaloneImage}" />
                <Image
                    Visibility="{Binding Show_Radar160Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 160}" />
                <Image
                    Visibility="{Binding Show_Radar300Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 300}" />
                <Image
                    Visibility="{Binding Show_Radar500Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 500}" />
                <Image
                    Visibility="{Binding Show_Radar700Border, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="{StaticResource Border 700}" />
            </Grid>
            <Button
                Style="{StaticResource BDR_SH1DEc}" />
        </Grid>


        <Button
            Name="StandaloneDifficulyLevel"
            Width="300"
            Margin="0,340,43,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            local:PropEx.TextCentre=""
            local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_025]}"
            local:PropEx.TextRight="{Binding StandaloneDifficultyText}"
            Command="{Binding StandaloneMenuCommand}"
            CommandParameter="Difficulty"
            MouseEnter="CommonRedButtonEnter"
            Style="{StaticResource BTN_SH_GlowS}" />

        <!--         <Button -->
<!--                 Name="StandaloneAttackDefend" -->
<!--                 Width="200" -->
<!--                 Margin="0,340,610,0" -->
<!--                 HorizontalAlignment="Right" -->
<!--                 VerticalAlignment="Top" -->
