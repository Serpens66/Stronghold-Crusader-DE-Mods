        <Button
            Name="StandaloneFreebuildAdvanced"
            Width="200"
            Margin="0,340,610,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_XPLAY_WAITING_ROOM_075]}"
            local:PropEx.TextLeft=""
            local:PropEx.TextRight=""
            Command="{Binding StandaloneMenuCommand}"
            CommandParameter="FreebuildAdvanced"
            MouseEnter="CommonRedButtonEnter"
            Style="{StaticResource BTN_SH_GlowS}" />
        <CheckBox
            x:Name="StandaloneFreebuildHostileAnimals"
            Margin="0,342,240,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="350"
            Height="23"

            Style="{StaticResource CheckBox_Template}">
            <TextBlock
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_262]}"
                Margin="0,2,0,-2"
                FontSize="18"
                Foreground="Black"
                VerticalAlignment="Center" />
        </CheckBox>


        <Grid
            Name="FreebuildOptions"
            Margin="0,0,50,82"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{Binding FreeBuildOptionsVis}"
            Width="755"
            Height="305">
            <Button
                Style="{StaticResource BDR_SH1DEb}" />

            <TextBlock 
                Margin="20,10,0,0"
                Width="340"
                TextAlignment="Center"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="Black" 
                FontSize="20"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_XPLAY_WAITING_ROOM_017]}"
                />
            <Button
                Width="340"
                Margin="20,35,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GOODS_016]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_Gold_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Gold"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_Gold-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>

            <Button
                Width="340"
                Margin="20,74,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_XPLAY_WAITING_ROOM_012]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_Food_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Food"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_Food-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>

            <Button
                Width="340"
                Margin="20,113,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_XPLAY_WAITING_ROOM_014]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_Resources_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Resources"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_Resources-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>

            <Button
                Width="340"
                Margin="20,152,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_XPLAY_WAITING_ROOM_011]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_Weapons_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Weapons"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_Weapons-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>


            <TextBlock 
                Margin="0,10,20,0"
                Width="340"
                TextAlignment="Center"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Foreground="Black" 
                FontSize="20"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_098]}"
                />
            <Button
                Width="340"
                Margin="0,35,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SCENARIO_175]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_RandomEvents_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_RandomEvents"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_RandomEvents-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>

            <Button
                Width="340"
                Margin="0,74,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_097]}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_Invasions_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Invasions"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_Invasions-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>

            <Button
                Width="340"
                Margin="0,113,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre=""
                local:PropEx.TextLeft="{Binding StandaloneFreebuild_InvasionsDifficulty_Label}"
                local:PropEx.TextRight="{Binding StandaloneFreebuild_InvasionsDifficulty_Text}"
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_InvasionsDifficulty"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseRightButtonUp">
                        <b:InvokeCommandAction
                            Command="{Binding StandaloneMenuCommand}"
                            CommandParameter="Freebuild_InvasionsDifficulty-" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>                
            </Button>

            <ToggleButton
                Name="ToggleBedouin"
                Width="107"
                Margin="0,152,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_221]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding StandaloneMenuCommand}"
                CommandParameter="Freebuild_Bedouin"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource ToggleBTN_SH_GlowS}" />

            <ToggleButton
                Name="ToggleArabian"
                Width="107"
                Margin="0,152,137,0"
