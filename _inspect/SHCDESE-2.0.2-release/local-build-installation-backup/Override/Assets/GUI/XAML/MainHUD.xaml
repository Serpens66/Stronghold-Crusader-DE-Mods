        <TextBlock
            x:Name="OST_Feedback_2"
            Margin="10,0,0,200"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="22"
            Foreground="#FFEFF3C6"
            Background="#55000000"
            Text="{Binding OST_Feedback_2_Text}"
