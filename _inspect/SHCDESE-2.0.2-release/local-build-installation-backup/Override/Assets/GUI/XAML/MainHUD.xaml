<UserControl
    x:Class="CrusaderDE.MainHUD"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

        <!-- Pulse -->
        <Storyboard x:Key="Pulse" >
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="ScaleX" Storyboard.TargetName="MainPopularityValueScale">
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="ScaleY" Storyboard.TargetName="MainPopularityValueScale">
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>      
    </UserControl.Resources>

  
    <Grid 
        IsHitTestVisible="True" 
        >

        <Grid
            x:Name="HUD_Main"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Main, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Main Margin="0" />
        </Grid>

        <Grid
            x:Name="HUD_Troops"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Troops, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Troops Margin="0" />
        </Grid>

        <Grid
            x:Name="HUD_Buildings"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Building, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Buildings Margin="0" />
        </Grid>

        <TextBlock
            x:Name="OST_Keep_Message"
            Margin="0,0,100,160"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="18"
            Foreground="#FFEFF3C6"
            Background="#55000000"
            Text="{Binding OST_Keep_Message_Text}"
            Tag="Ignore"
            Visibility="{Binding OST_Keep_Message_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock.Effect>
                <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock
            x:Name="OST_Feedback_1"
            Margin="10,0,0,160"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="22"
            Foreground="#FFEFF3C6"
            Background="#55000000"
            Text="{Binding OST_Feedback_1_Text}"
            Tag="Ignore"
            Visibility="{Binding OST_Feedback_1_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock.Effect>
                <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
            </TextBlock.Effect>
        </TextBlock>

<!--        <TextBlock
            x:Name="OST_Message_Bar"
            Margin="{Binding OST_Message_Bar_Margin}"
            MaxWidth="350"
            TextAlignment="Left"
            TextWrapping="Wrap"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="18"
            Foreground="#FFEFF3C6"
            Background="#55000000"
            Text="{Binding OST_Message_Bar_Text}"
            Tag="Ignore"
            Visibility="{Binding OST_Message_Bar_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock.Effect>
                <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="Black"
                         Opacity="0.8"
                         BlurRadius="0"/>
            </TextBlock.Effect>
        </TextBlock>
-->
        <DockPanel Background="#00000000" LastChildFill="True"
                Width="Auto"
                Margin="{Binding OST_Message_Bar_Margin}"
                Height="Auto"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1"
                Visibility="{Binding OST_Message_Bar_Vis, Converter={StaticResource booleanToVisibilityConverter}}"                >
            <Grid>
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#88000000"
                    BorderBrush="#00000000"
                    CornerRadius="8"
                    BorderThickness="0"
                            />
                <TextBlock
                    x:Name="OST_Message_Bar"
                    MaxWidth="350"
                    Margin="10,3,10,2"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    FlowDirection="{Binding GlobalTextFlowAL2R}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="17"
                    Foreground="#FFEFF3C6"
                    Text="{Binding OST_Message_Bar_Text}"
                    Tag="Ignore"
                            >
                    <TextBlock.Effect>
                        <DropShadowEffect
                                 ShadowDepth="2"
                                 Direction="315"
                                 Color="#CC000000"
                                 BlurRadius="0"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

        </DockPanel>

        <Grid
            Margin="0,0,0,180"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="{Binding OST_WhoOwns_Opacity}"
            Visibility="{Binding OST_WhoOwns_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{Binding OST_WhoOwns_FaceBackground}" />
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{Binding OST_WhoOwns_Face}" />
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{StaticResource Face Border}" />
            <Image
                Grid.Column="1"
                Width="23"
                Height="29"
                Margin="-8,-6,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{Binding OST_WhoOwns_Allies}" />
            <TextBlock
                Grid.Column="1"
                x:Name="OST_WhoOwns"
                Height="28"
                Margin="5,0,0,25"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                TextAlignment="Left"
                TextWrapping="Wrap"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                FontSize="24"
                Foreground="#FFEFF3C6"
                Background="#55000000"
                Text="{Binding OST_WhoOwns_Text}"
                Tag="Ignore"
                >
                <TextBlock.Effect>
                    <DropShadowEffect
                             ShadowDepth="2"
                             Direction="315"
                             Color="#CC000000"
                             BlurRadius="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock
                Grid.Column="1"
                Height="16"
                Margin="5,0,0,5"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                TextAlignment="Left"
                TextWrapping="Wrap"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                FontSize="14"
                Foreground="#FFCCCCCC"
                Background="#33000000"
                Text="{Binding OST_WhoOwns_Building}"
                Tag="Ignore">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- message from -->
        <Grid
            Margin="0,0,80,140"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Visibility="{Binding OST_MessageFrom_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{Binding OST_WhoOwns_FaceBackground}" />
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{Binding OST_WhoOwns_Face}" />
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Tag="Ignore"
                Source="{StaticResource Face Border}" />
            <TextBlock
                Grid.Column="1"
                x:Name="OST_WhoOwnsX"
                Height="28"
                Margin="5,0,0,25"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                TextAlignment="Left"
                TextWrapping="Wrap"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                FontSize="24"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                Foreground="#FFEFF3C6"
                Background="#55000000"
                Text="{Binding OST_WhoOwns_Text}"
                Tag="Ignore">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <TextBlock
            x:Name="OST_WhoOwnsEditor"
            Margin="0,0,0,180"
            TextAlignment="Center"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="24"
            FlowDirection="{Binding GlobalTextFlowAL2R}"
            Foreground="#FFEFF3C6"
            Background="#55000000"
            Text="{Binding OST_WhoOwns_Text}"
            Tag="Ignore"
            Visibility="{Binding OST_WhoOwns_VisEditor, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="2"
                    Direction="315"
                    Color="#CC000000"
                    BlurRadius="0" />
            </TextBlock.Effect>
        </TextBlock>
        <local:HUD_MPChatMessages
            HorizontalAlignment="Left"
            Margin="0,0,100,160"
            VerticalAlignment="Bottom"
            Tag="Ignore"
            Visibility="{Binding Show_HUD_MPChatMessages, Converter={StaticResource booleanToVisibilityConverter}}"
            >
        </local:HUD_MPChatMessages>

        <Grid
            Margin="0,0,280,125"
            Width="500"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Tag="Ignore">
            <DockPanel
                Background="#00000000"
                LastChildFill="True"
                Width="Auto"
                Height="Auto"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1"
                Visibility="{Binding RolloverBuilding_TooltipVis, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid>
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#88000000"
                        BorderBrush="#00000000"
                        CornerRadius="8"
                        BorderThickness="0"
                        Tag="Ignore" />
                    <StackPanel>

                        <TextBlock
                            HorizontalAlignment="Left"
                            FlowDirection="{Binding GlobalTextFlowAL2R}"
                            FontSize="20"
                            Foreground="#FFDDDDDD"
                            Tag="Ignore">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    ShadowDepth="2"
                                    Direction="315"
                                    Color="#CC000000"
                                    BlurRadius="0" />
                            </TextBlock.Effect>
                           <Run Text="{Binding RollOverText}"/><!--
                        --><Run Text="{Binding RollOverText_AmountReq1}"/><!--
                        --><InlineUIContainer><Image Source="{Binding RollOverText_GoodsImage1}" Height="18" Margin="0,4,0,-4" /></InlineUIContainer><!--
                        --><Run Text="{Binding RollOverText_AmountGot1}"/><!--
                        --><Run Text="{Binding RollOverText_AmountReq2}"/><!--
                        --><InlineUIContainer><Image Source="{Binding RollOverText_GoodsImage2}" Height="18" Margin="0,4,0,-4"/></InlineUIContainer><!--
                        --><Run Text="{Binding RollOverText_AmountGot2}"/>
                        </TextBlock>
<!--                    <TextBlock
                    MaxWidth="450"
                    Margin="10,3,10,2"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Foreground="#FFEFF3C6"
                    Text="{Binding RolloverBuilding_TooltipTitle}"
                    Tag="Ignore"
                            >
                    <TextBlock.Effect>
                        <DropShadowEffect
                                 ShadowDepth="2"
                                 Direction="315"
                                 Color="#CC000000"
                                 BlurRadius="0"/>
                    </TextBlock.Effect>
                    </TextBlock>
                    -->
                        <TextBlock
                            MaxWidth="450"
                            Margin="10,1,10,5"
                            TextAlignment="Left"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Left"
                            FlowDirection="{Binding GlobalTextFlowAL2R}"
                            VerticalAlignment="Bottom"
                            FontSize="14"
                            Foreground="#FFEFF3C6"
                            Text="{Binding RolloverBuilding_TooltipBody}"
                            Tag="Ignore">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    ShadowDepth="2"
                                    Direction="315"
                                    Color="#CC000000"
                                    BlurRadius="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                            <TextBlock
                                Margin="10,0,10,0"
                                TextAlignment="Left"
                                HorizontalAlignment="Left"
                                FlowDirection="{Binding GlobalTextFlowAL2R}"
                                VerticalAlignment="Bottom"
                                FontSize="17"
                                Foreground="#FFDDDDDD"
                                Visibility="{Binding RolloverBuilding_TooltipConsumesVis, Converter={StaticResource booleanToVisibilityConverter}}"
                                Tag="Ignore">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        ShadowDepth="2"
                                        Direction="315"
                                        Color="#CC000000"
                                        BlurRadius="0" />
                                </TextBlock.Effect>
                                <Run Text="{Binding GameTexts[TEXT_NEW_TEXT2_079], Source={x:Static local:Translate.Instance}}"/><!--
                             --><Run Text="  "/><!--
                             --><InlineUIContainer><Image Source="{Binding RolloverBuilding_ConsumesImage}" Stretch="Uniform" Width="25" Height="18" Margin="0,4,0,-4" /></InlineUIContainer><!--
                             --><InlineUIContainer><Image Source="{Binding RolloverBuilding_ConsumesImage2}" Stretch="Uniform" Width="25" Height="18" Margin="0,4,0,-4" /></InlineUIContainer>
                            </TextBlock>
                            <TextBlock
                                Margin="10,0,10,2"
                                HorizontalAlignment="Left"
                                FlowDirection="{Binding GlobalTextFlowAL2R}"
                                VerticalAlignment="Bottom"
                                FontSize="17"
                                Foreground="#FFDDDDDD"
                                Visibility="{Binding RolloverBuilding_TooltipProducesVis, Converter={StaticResource booleanToVisibilityConverter}}"
                                Tag="Ignore">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        ShadowDepth="2"
                                        Direction="315"
                                        Color="#CC000000"
                                        BlurRadius="0" />
                                </TextBlock.Effect>
                                <Run Text="{Binding GameTexts[TEXT_NEW_TEXT2_080], Source={x:Static local:Translate.Instance}}"/><!--
                             --><Run Text="  "/><!--
                             --><InlineUIContainer><Image Source="{Binding RolloverBuilding_ProducesImage}" Stretch="Uniform" Width="25" Height="18" Margin="0,4,0,-4" /></InlineUIContainer><!--
                             --><InlineUIContainer><Image Source="{Binding RolloverBuilding_ProducesImage2}" Stretch="Uniform" Width="25" Height="18" Margin="0,4,0,-4" /></InlineUIContainer>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Grid>

