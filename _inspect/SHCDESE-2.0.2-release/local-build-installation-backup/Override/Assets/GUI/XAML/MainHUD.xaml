        <!--  Radar Map / In Game videos  -->
        <Grid
            Name="RadarMapGrid"
            Width="128"
            Height="128"
            Margin="{Binding RadarMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Loaded="OnLoadRadarGrid"
            Unloaded="OnUnLoadRadarGrid">

            <Image
                Name="RadarMapImage"
                Width="124"
                Height="124"
                IsHitTestVisible="True"
                RenderTransformOrigin="0.5,0.5"
                Margin="2,-4,-2,0"
                Source="{Binding RadarMapImage}" />

            <MediaElement
                Name="RadarME"
                Width="124"
                Height="124"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LoadedBehavior="Manual"
                Opacity="1"
                Margin="2,-4,-2,0"
                Stretch="UniformToFill">

                <!--b:Interaction.Triggers>
                    <b:EventTrigger EventName="Loaded">
                        <noesis:PlayMediaAction />
                    </b:EventTrigger>
                </b:Interaction.Triggers-->
            </MediaElement>

        </Grid>

        <Button
            Width="19"
            Height="19"
            Margin="0,0,220,130"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            local:PropEx.Sprite1="{StaticResource UI-Buttons R003}"
            local:PropEx.Sprite2="{StaticResource UI-Buttons R004}"
            local:PropEx.Sprite3="{StaticResource UI-Buttons R004}"
            local:PropEx.Sprite4=""
            Visibility="{Binding Show_ActionPoint, Converter={StaticResource booleanToVisibilityConverter}}"
            Command="{Binding ButtonActionPointCommand}"
            Style="{StaticResource BTN_Image}" />

        <Button
            Width="10"
            Height="10"
            Margin="{Binding RadarPlusMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            local:PropEx.Sprite1="{StaticResource UI-Buttons R019}"
            local:PropEx.Sprite2="{StaticResource UI-Buttons R020}"
            local:PropEx.Sprite3="{StaticResource UI-Buttons R020}"
            local:PropEx.Sprite4=""
            Command="{Binding ButtonRadarZoomCommand}"
            CommandParameter="1"
            Style="{StaticResource BTN_Image}" />

        <Button
            Width="10"
            Height="10"
            Margin="{Binding RadarMinusMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            local:PropEx.Sprite1="{StaticResource UI-Buttons R017}"
            local:PropEx.Sprite2="{StaticResource UI-Buttons R018}"
            local:PropEx.Sprite3="{StaticResource UI-Buttons R018}"
            local:PropEx.Sprite4=""
            Command="{Binding ButtonRadarZoomCommand}"
            CommandParameter="2"
            Style="{StaticResource BTN_Image}" />

        <Image
            Width="19"
            Height="19"
            Margin="0,0,187,130"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Visibility="{Binding Show_KeepEnclosed, Converter={StaticResource booleanToVisibilityConverter}}"
            Source="{StaticResource UI-Buttons L028}"
            />

        <Image
            Width="13"
            Height="40"
            Margin="0,0,157,130"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Source="{Binding MessageShieldImage}"
            Visibility="{Binding Show_MessageShield, Converter={StaticResource booleanToVisibilityConverter}}"
            />
        


        <!--  *** Reports Book*************  -->
        <Grid
            Name="ReportsControl"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Book, Converter={StaticResource booleanToVisibilityConverter}}">



            <Image
                Name="ScribeImage"
                Width="202"
                Height="207"
                Margin="0,0,-73,-10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5"
                FlowDirection="{Binding GlobalTextFlow}"
                Visibility="{Binding Show_HUD_Book, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{Binding ScribeHeadImage}" />

            <Button
                Width="89"
                Height="82"
                Margin="0,0,12,23"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.ImageFlow="{Binding GlobalTextFlow}"
                local:PropEx.Sprite1=""
                local:PropEx.Sprite2="{StaticResource UI-Scribe B045}"
                local:PropEx.Sprite3="{StaticResource UI-Scribe B045}"
                local:PropEx.Sprite4=""
                Command="{Binding ButtonReportsCommand}"
                CommandParameter="0"
                IsEnabled="{Binding Path=Show_HUD_Book}"
                Style="{StaticResource BTN_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseEnter">
                        <b:InvokeCommandAction Command="{Binding ButtonScribeMouseEnterCommand}" CommandParameter="" />
                    </b:EventTrigger>
                    <b:EventTrigger EventName="MouseLeave">
                        <b:InvokeCommandAction Command="{Binding ButtonScribeMouseLeaveCommand}" CommandParameter="" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Button>            
            <Grid
                Width="200"
                Margin="0,0,26,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Visibility="{Binding Show_HUD_Book, Converter={StaticResource booleanToVisibilityConverter}}"
                >
                <TextBlock
                    Name="MainPopularityValue"
                    Margin="140,0,0,45"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    FontSize="{Binding BookPopularityFontSize}"
                    Foreground="{Binding BookPopularityColour}"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.25"
                    Text="{Binding BookPopularityText}">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-18" AngleY="0" />
                            <ScaleTransform ScaleX="1.00" ScaleY="1.00" x:Name="MainPopularityValueScale" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <Image
                    Margin="140,2,0,46"
                    FlowDirection="{Binding GlobalTextFlow}"
                    Source="{StaticResource Pop_Arrow_Negative}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="15"
                    Height="25"
                    IsHitTestVisible="False"
                    Visibility="{Binding PopularityDecreasingVis, Converter={StaticResource booleanToVisibilityConverter}}"
                    />
                <Image
                    Margin="140,2,0,46"
                    FlowDirection="{Binding GlobalTextFlow}"
                    Source="{StaticResource Pop_Arrow_Positive}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="15"
                    Height="25"
                    IsHitTestVisible="False"
                    Visibility="{Binding PopularityIncreasingVis, Converter={StaticResource booleanToVisibilityConverter}}"
                    />

                <Grid
                    Margin="0,0,21,53"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding BookGoldLarge, Converter={StaticResource booleanToVisibilityConverter}}"
                    >
                <TextBlock
                    Width="50"
                    Height="18"
                    TextAlignment="Right"
                    Panel.ZIndex="1"
                    FontSize="{Binding BookGoldLargeFontSize}"
                    FontWeight="Bold"
                    Foreground="#008800"
                    IsHitTestVisible="False"
                    Text="{Binding BookGoldText}">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-25" AngleY="0" />
                            <ScaleTransform ScaleX="0.8" ScaleY="1.2" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                </Grid>
                <Grid
                    Margin="0,0,20,52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding BookGoldSmall, Converter={StaticResource booleanToVisibilityConverter}}"
                    >
                    <TextBlock
                    Width="50"
                    Height="18"
                    TextAlignment="Right"
                    Panel.ZIndex="1"
                    FontSize="{Binding BookGoldSmallFontSize}"
                    FontWeight="Bold"
                    Foreground="#008800"
                    IsHitTestVisible="False"
                    Text="{Binding BookGoldText}">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-25" AngleY="0" />
                                <ScaleTransform ScaleX="0.8" ScaleY="1.2" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <TextBlock
                    Margin="122,0,0,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="1"
                    FontSize="{Binding BookPopulationFontSize}"
                    FontWeight="Bold"
                    Foreground="{Binding BookPopulationColour}"
                    IsHitTestVisible="False"
                    Text="{Binding BookPopulationText}">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-25" AngleY="0" />
                            <ScaleTransform ScaleX="0.8" ScaleY="1.2" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
            <!-- Tutorial overlay arrows -->
            <!-- Keep placement -->
            <Image
            Name="TutorialArrow5"
            HorizontalAlignment="Left"
            Visibility="Hidden"
            IsHitTestVisible="False"
            Source="{StaticResource floats_new-260}"
            Width="40"
            Height="82"
            Margin="146, -42,0,0"/>

        </Grid>

        <!--  Game Hover Text  -->
        <Grid
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="{Binding RollOverText_Margin}"
            Width="550">
            <StackPanel
                Visibility="{Binding RolloverBuilding_TooltipVisNot, Converter={StaticResource booleanToVisibilityConverter}}">
                <TextBlock
                    x:Name="GameHoverText"
                    HorizontalAlignment="Left"
                    FlowDirection="{Binding GlobalTextFlowAL2R}"
                    Panel.ZIndex="1"
                    FontSize="20"
                    Foreground="#FFDDDDDD"
                    Background="#55000000"
                    Tag="Ignore">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform
                                X="-250" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect
                            ShadowDepth="2"
                            Direction="315"
                            Color="#CC000000"
                            BlurRadius="0" />
                    </TextBlock.Effect>
                    <Run Text="{Binding RollOverText}"/><!--
                 --><Run Text="{Binding RollOverText_AmountReq1}"/><!--
                 --><InlineUIContainer><Image Source="{Binding RollOverText_GoodsImage1}" Height="18" Margin="0,4,0,-4" /></InlineUIContainer><!--
                 --><Run Text="{Binding RollOverText_AmountGot1}"/><!--
                 --><Run Text="{Binding RollOverText_AmountReq2}"/><!--
                 --><InlineUIContainer><Image Source="{Binding RollOverText_GoodsImage2}" Height="18" Margin="0,4,0,-4"/></InlineUIContainer><!--
                 --><Run Text="{Binding RollOverText_AmountGot2}"/>
                </TextBlock>
                <TextBlock
                    Visibility="{Binding RolloverBuilding_MakeVis, Converter={StaticResource booleanToVisibilityConverter}}"
                    HorizontalAlignment="Left"
                    Panel.ZIndex="1"
                    FontSize="14"
                    Foreground="#FFEFF3C6"
                    Background="#55000000"
                    Text="{Binding RollOverText2}"
                    Tag="Ignore">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform
                                X="-250" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect
                            ShadowDepth="2"
                            Direction="315"
                            Color="#CC000000"
                            BlurRadius="0" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>