                Command="{Binding ButtonNewSceneCommand}"
                CommandParameter="99"
                Tag="Ignore"
                Content="Back"
                FontSize="10" />
        </StackPanel>
-->
        <!-- scenario editor toggle button -->
        <Button
            Name="ButtonToggleScenerioEditor"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Width="210"
            Margin="0,15,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{Binding Show_HUD_Scenario_Button, Converter={StaticResource booleanToVisibilityConverter}}"
            local:PropEx.TextCentre="{Binding ScenarioEditorButtonText}"
            local:PropEx.TextLeft=""
            local:PropEx.TextRight=""
            Command="{Binding ButtonToggleScenrioEditorCommand}"
            Style="{StaticResource BTN_SH_GlowS}" >

                <Button.RenderTransform>
                    <TranslateTransform />
                </Button.RenderTransform>
            </Button>



        <!-- OST_Framerate -->
        <TextBlock
            x:Name="OST_Framerate"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Margin="{Binding OST_Framerate_Margin}"
