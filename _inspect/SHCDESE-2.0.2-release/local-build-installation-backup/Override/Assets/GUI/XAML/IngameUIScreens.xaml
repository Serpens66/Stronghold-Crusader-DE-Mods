<UserControl
    x:Class="CrusaderDE.IngameUIScreens"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

        <Storyboard x:Key="Intro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonToggleScenerioEditor" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-2000" />
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="BannerTextFade">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BannerLoopText" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Intro}" />
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid IsHitTestVisible="True"
          Width="{Binding UIScaleValueWidth}"
          Height="{Binding UIScaleValueHeight}"
          >

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="16*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="16*" />
            <RowDefinition />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Background="Black"
            Height="{Binding MapLowerEdgeMaskHeight}"
            Visibility="{Binding MapLowerEdgeMaskVisible}"
            Margin="0,0,0,0"
            VerticalAlignment="Bottom"
            >
            <Rectangle
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Height="206"
                >
                <Rectangle.Fill>
                    <ImageBrush
                        ImageSource="{Binding MapLowerEdgeMaskImage}"
                                  Viewport="0,0,173,128"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Left"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- in game UI -->
        <Grid
            x:Name="MainHUD"
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_InGameUI, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:MainHUD Margin="0" />
        </Grid>


        <!-- objectives popup -->
        <Grid
            Name="HUD_ObjectivesPanel"
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"      
            Width="440"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="0,0,0,0"
            Visibility="{Binding Show_HUD_Extras, Converter={StaticResource booleanToVisibilityConverter}}"
            >
        <Grid
            x:Name="HUD_Objectives"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Objectives, Converter={StaticResource booleanToVisibilityConverter}}"
            Margin="-400,0,0,0"
            >
            <local:HUD_Objectives />
        </Grid>
            <Grid
            x:Name="HUD_Goods"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Visibility="{Binding Show_HUD_Goods, Converter={StaticResource booleanToVisibilityConverter}}"
            Margin="-400,0,0,0"
            >
            <local:HUD_Goods />
            </Grid>

            <Grid
                Width="36"
                Height="34"
                Margin="0,0,0,34"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="{Binding Show_HUD_Extras_Button_Objectves, Converter={StaticResource booleanToVisibilityConverter}}"
                >
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    local:PropEx.Sprite1="{StaticResource Objectives_Normal}"
                    local:PropEx.Sprite2="{StaticResource Objectives_Highlight}"
                    Command="{Binding ButtonExtendedFeaturesCommand}"
                    CommandParameter="Objectives"
                    Style="{StaticResource BTN_Building}" />
                </Grid>
            <Grid
                Width="36"
                Height="34"
                Margin="0,0,0,34"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="{Binding Show_HUD_Extras_Button_Freebuild, Converter={StaticResource booleanToVisibilityConverter}}"
                >
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    local:PropEx.Sprite1="{StaticResource Events_Normal}"
                    local:PropEx.Sprite2="{StaticResource Events_Highlight}"
                    Command="{Binding ButtonExtendedFeaturesCommand}"
                    CommandParameter="Freebuild"
                    Style="{StaticResource BTN_Building}" />
            </Grid>
            <Button
                Width="36"
                Height="34"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.Sprite1="{StaticResource Resources_Normal}"
                local:PropEx.Sprite2="{StaticResource Resources_Highlight}"
                Command="{Binding ButtonExtendedFeaturesCommand}"
                CommandParameter="Goods"
                Style="{StaticResource BTN_Building}" />
            <Image
                Width="36"
                Height="34"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="{Binding Show_HUD_Goods_Button_Disabled, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{StaticResource Resources_Disabled}"
                 />
        </Grid>

        <!-- OST_Game_Paused -->
        <TextBlock
            x:Name="OST_Game_Paused"
            Margin="0,0,0,0"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="48"
            Foreground="#FFEFF3C6"
            Text="{Binding OST_Game_Paused_Text}"
            IsHitTestVisible="False"
            Visibility="{Binding OST_Game_Paused_Vis, Converter={StaticResource booleanToVisibilityConverter}}"
            >
            <TextBlock.Effect>
                <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
            </TextBlock.Effect>
        </TextBlock>

        
       <!-- Sands of time timer -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#00000000"
            MinWidth="500"
            Visibility="{Binding Show_OST_SandsOfTimeVis, Converter={StaticResource booleanToVisibilityConverter}}"
            Height="28">
            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#88000000"
                BorderBrush="#aa000000"
                CornerRadius="0"
                BorderThickness="3" />
            <Grid
                Margin="3,3,3,3"
                HorizontalAlignment="Right"
                Width="{Binding OST_sands_progress_bar}"
                Background="#2200ff00"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Time, Converter={StaticResource booleanToVisibilityConverter}}" />
            <TextBlock
                Margin="15,0,0,0"
                FontSize="18"
                TextAlignment="Left"
                VerticalAlignment="Center"
                Tag="Ignore"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Time, Converter={StaticResource booleanToVisibilityConverter}}"
                Text="{Binding GameTexts[TEXT_NEW_CTEXT_240], Source={x:Static local:Translate.Instance}}"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock
                Margin="0,0,45,0"
                FontSize="18"
                TextAlignment="Right"
                VerticalAlignment="Center"
                Tag="Ignore"
                Text="{Binding OST_sands_time_elapsed}"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Time, Converter={StaticResource booleanToVisibilityConverter}}"
                Foreground="{Binding OST_sands_time_elapsed_colour}">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
            <Image
                Margin="0,-10,0,-10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Time, Converter={StaticResource booleanToVisibilityConverter}}"
                Source="{Binding OST_sands_time_image}"
                />

            <Grid
                Margin="3,2,3,15"
                HorizontalAlignment="Right"
                Width="{Binding OST_sands_overall_progress_bar}"
                Background="#CC006600"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Line
                X1="110" Y1="2" X2="110" Y2="14"
                Stroke="#ff333333"
                StrokeThickness="2"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Line
                X1="165" Y1="2" X2="165" Y2="14"
                Stroke="#ff333333"
                StrokeThickness="2"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Line
                X1="220" Y1="2" X2="220" Y2="14"
                Stroke="#ff333333"
                StrokeThickness="2"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Line
                X1="440" Y1="2" X2="440" Y2="14"
                Stroke="#ff333333"
                StrokeThickness="2"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Line
                X1="3" Y1="14" X2="500" Y2="14"
                Stroke="#ff333333"
                StrokeThickness="2"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Image
                Name="OST_Sands_Target_Bar_1"
                Margin="44,-5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                 />

            <Image
                Name="OST_Sands_Target_Bar_2"
                Margin="124,-5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                 />

            <Image
                Name="OST_Sands_Target_Bar_3"
                Margin="178,-5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                 />

            <Image
                Name="OST_Sands_Target_Bar_4"
                Margin="319,-5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                 />

            <Image
                Name="OST_Sands_Target_Bar_5"
                Margin="455,-3,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                />

            <TextBlock
                Margin="60,0,5,0"
                FontSize="12"
                Width="100"
                HorizontalAlignment="Left"
                TextAlignment="Center"
                VerticalAlignment="Bottom"
                Tag="Ignore"
                Text="{Binding OST_same_time_prince}"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock
                Margin="115,0,5,0"
                FontSize="12"
                Width="100"
                HorizontalAlignment="Left"
                TextAlignment="Center"
                VerticalAlignment="Bottom"
                Tag="Ignore"
                Text="{Binding OST_same_time_champion}"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock
                Margin="170,0,5,0"
                FontSize="12"
                Width="100"
                HorizontalAlignment="Left"
                TextAlignment="Center"
                VerticalAlignment="Bottom"
                Tag="Ignore"
                Text="{Binding OST_same_time_warrior}"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock
                Margin="390,0,5,0"
                FontSize="12"
                Width="100"
                HorizontalAlignment="Left"
                TextAlignment="Center"
                VerticalAlignment="Bottom"
                Tag="Ignore"
                Text="{Binding OST_same_time_tribesman}"
                Visibility="{Binding Show_OST_SandsOfTimeVis_Target, Converter={StaticResource booleanToVisibilityConverter}}"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>

            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
                    <b:InvokeCommandAction Command="{Binding SandsTimerMouseOver}" CommandParameter="Enter" />
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseLeave">
                    <b:InvokeCommandAction Command="{Binding SandsTimerMouseOver}" CommandParameter="Leave" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Grid>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="{Binding Compass_Margin}">
            <TextBlock
                Text="{Binding LocalTime}"
                FontSize="24"
                TextAlignment="Right"
                Visibility="{Binding ShowLocalTime}"
                Background="#33000000"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock
                Text="{Binding GameTime}"
                FontSize="24"
                Visibility="{Binding ShowGameTime}"
                TextAlignment="Right"
                Background="#33000000"
                Foreground="#FFEFF3C6">
                <TextBlock.Effect>
                    <DropShadowEffect
                        ShadowDepth="2"
                        Direction="315"
                        Color="#CC000000"
                        BlurRadius="0" />
                </TextBlock.Effect>
            </TextBlock>
            <Grid
                Name="Compass"
                Width="71"
                Height="56"
                Tag="Ignore"
                Visibility="{Binding Compass_Vis, Converter={StaticResource booleanToVisibilityConverter}}"
                >
                <Image  
                    Name="CompassImg" 
                    Opacity="0.7"
                    Source="{StaticResource floats 038}" 
                    Stretch="Fill" 
                    Tag="Ignore" />
            </Grid>
        </StackPanel>

        <!-- Victory banner -->
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoCV"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoAV"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoBV"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoCD"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoAD"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <MediaElement
            Margin="0,-20,0,0"
            Width="528"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            Name="BannerDropVideoBD"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LoadedBehavior="Manual"
            UnloadedBehavior="Close"
            Visibility="Hidden"
            Stretch="Uniform">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="Loaded">
                    <noesis:PlayMediaAction />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </MediaElement>
        <TextBlock
            Name="BannerLoopText"
            Margin="0,132,0,0"
            Width="1000"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="34"
            Opacity="0"
            TextAlignment="Center"
            Visibility="Hidden"
            Foreground="#FF000000">
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="0"
                    Direction="135"
                    Color="#CCC3B85D"
                    BlurRadius="10" />
            </TextBlock.Effect>

        </TextBlock>


        <!-- scenario editor mini window -->
        <Grid
            x:Name="HUD_Scenario_Popup"
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{Binding Show_HUD_Scenario_Button, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Scenario_Popup Margin="0" />
        </Grid>
        
        <!-- scenario editor main window -->
        <Grid
            x:Name="HUD_Scenario"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding Show_HUD_Scenario, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Scenario Margin="0" />
        </Grid>

        <!-- Free build main window -->
        <Grid
            x:Name="HUD_FreebuildMenu"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding Show_HUD_FreebuildMenu, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_FreebuildMenu Margin="0" />
        </Grid>

        <!-- load / save requester -->
        <Grid
            x:Name="HUD_LoadSaveRequester"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="{Binding LoadSaveDepthSorting}"
            Visibility="{Binding Show_HUD_LoadSaveRequester, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_LoadSaveRequester Margin="0" />
        </Grid>

        <!-- in game popup menu -->
        <Grid
            x:Name="HUD_IngameMenu"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2"
            Visibility="{Binding Show_HUD_IngameMenu, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_IngameMenu Margin="0" />
        </Grid>

        <!-- Tutorial -->
        <local:HUD_Tutorial
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            Margin="0,100,0,0"
            Visibility="{Binding Show_HUD_Tutorial, Converter={StaticResource booleanToVisibilityConverter}}">
        </local:HUD_Tutorial>

        <!-- options menu -->
        <Grid
            x:Name="HUD_Options"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding Show_HUD_Options, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Options Margin="0" />
        </Grid>
        <!-- help menu -->
        <Grid
            x:Name="HUD_Help"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding Show_HUD_Help, Converter={StaticResource booleanToVisibilityConverter}}">
            <local:HUD_Help Margin="0" />
        </Grid>

        <!--  *** DEBUG controls *************  -->
