<!-- NOTDEMOSTART -->
<UserControl
    x:Class="CrusaderDE.FRONT_SkirmishMasters"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="768"
    d:DesignWidth="1366"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>
        <Style
            x:Key="HiddenStyle"
            TargetType="{x:Type GridViewColumnHeader}">
            <Setter
                Property="Visibility"
                Value="Collapsed" />
        </Style>
    </UserControl.Resources>


    <Grid
        x:Name="LayoutRoot"
        Background="Black"
        UseLayoutRounding="True">


        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image
                Name="MOBackground"
                Height="768"
                IsHitTestVisible="False"
                Source="../Images/SkirmishMasters.png"
                Stretch="UniformToFill" />

        </Grid>

        <!-- Header -->
        <Button
            Width="715"
            Height="60"
            Margin="0,25,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEa}"
            />

        <Grid
            Width="715"
            Height="80"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBlock 
                TextAlignment="Center"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Foreground="Black" 
                FontSize="40"
                Typography.Capitals="SmallCaps"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SKIRMISH_MASTERS_001]}"/>

            <Image
                Width="20"
                Height="40"
                Margin="0,20,25,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="1"
                IsHitTestVisible="False"
                Source="{StaticResource Panel_CelticKnot}" />

            <Image
                Width="20"
                Height="40"
                Margin="25,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="1"
                IsHitTestVisible="False"
                Source="{StaticResource Panel_CelticKnot}" />
        </Grid>

        <!-- List -->
        <Grid
            Name="MainPanel"
            Width="1100"
            Height="550"
            Margin="0,125,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            >
            <Button
                Style="{StaticResource BDR_SH1DEd}"/>

            <RadioButton
                Name="SortScore"
                Height="33"
                Margin="20,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                GroupName="Sort"
                IsChecked="True"
                local:PropEx.Sprite1="{StaticResource SkirmishMasters_Score}"
                local:PropEx.Sprite2="{StaticResource SkirmishMasters_ScoreOver}"
                local:PropEx.Sprite3="{StaticResource SkirmishMasters_ScoreSelected}"
                local:PropEx.Sprite4="{StaticResource SkirmishMasters_Score}"
                Command="{Binding SkirmishMastersCommand}"
                CommandParameter="SortScore"
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Enter}"
                            CommandParameter="SortScore" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Leave}"
                            CommandParameter="SortScore" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>

            <RadioButton
                Name="SortName"
                Height="33"
                Margin="60,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                GroupName="Sort"
                local:PropEx.Sprite1="{StaticResource SkirmishMasters_Name}"
                local:PropEx.Sprite2="{StaticResource SkirmishMasters_NameOver}"
                local:PropEx.Sprite3="{StaticResource SkirmishMasters_NameSelected}"
                local:PropEx.Sprite4="{StaticResource SkirmishMasters_Name}"
                Command="{Binding SkirmishMastersCommand}"
                CommandParameter="SortName"
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Enter}"
                            CommandParameter="SortName" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Leave}"
                            CommandParameter="SortName" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>

            <RadioButton
                Name="SortTime"
                Height="33"
                Margin="100,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                GroupName="Sort"
                local:PropEx.Sprite1="{StaticResource SkirmishMasters_Time}"
                local:PropEx.Sprite2="{StaticResource SkirmishMasters_TimeOver}"
                local:PropEx.Sprite3="{StaticResource SkirmishMasters_TimeSelected}"
                local:PropEx.Sprite4="{StaticResource SkirmishMasters_Time}"
                Command="{Binding SkirmishMastersCommand}"
                CommandParameter="SortTime"
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Enter}"
                            CommandParameter="SortTime" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Leave}"
                            CommandParameter="SortTime" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>

            <RadioButton
                Name="SortDate"
                Height="33"
                Margin="140,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                GroupName="Sort"
                local:PropEx.Sprite1="{StaticResource SkirmishMasters_Data}"
                local:PropEx.Sprite2="{StaticResource SkirmishMasters_DataOver}"
                local:PropEx.Sprite3="{StaticResource SkirmishMasters_DataSelected}"
                local:PropEx.Sprite4="{StaticResource SkirmishMasters_Data}"
                Command="{Binding SkirmishMastersCommand}"
                CommandParameter="SortDate"
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Enter}"
                            CommandParameter="SortDate" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding SkirmishMastersCommand_Leave}"
                            CommandParameter="SortDate" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>

            <TextBlock
                Margin="350,15,0,0"
                Text="{Binding SkirmishMasters_Sorted}"
                FontSize="20"
                Foreground="Black"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />


            <ListView
                Margin="4,54,4,4"
                Width="1100"
                Height="450"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Name="SkimrishMastersList"
                Background="#00d17c45"

                ItemContainerStyle="{StaticResource SkirmishMasters_ListViewItem}">

                <ListView.View>
                    <GridView
                        ColumnHeaderContainerStyle="{StaticResource HiddenStyle}">
                        <GridViewColumn
                            Header=""
                            >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <local:WGT_SkirmishMastersRow
                                        Margin="0,0,0,0"
                                         />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Rectangle
                Opacity="1"
                Margin="4,49,4,0"
                Width="1100"
                Height="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                SnapsToDevicePixels="True">
                <Rectangle.Fill>
                    <ImageBrush
                        ImageSource="{StaticResource Panel_Divider}"
                        Viewport="0,0,250,7.5"
                        ViewportUnits="Absolute"
                        AlignmentX="Center"
                        AlignmentY="Top"
                        TileMode="Tile" />
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle
                Opacity="1"
                Margin="4,501,4,0"
                Width="1100"
                Height="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                SnapsToDevicePixels="True">
                <Rectangle.Fill>
                    <ImageBrush
                        ImageSource="{StaticResource Panel_Divider}"
                        Viewport="0,0,250,7.5"
                        ViewportUnits="Absolute"
                        AlignmentX="Center"
                        AlignmentY="Top"
                        TileMode="Tile" />
                </Rectangle.Fill>
            </Rectangle>

            <Grid
                Margin="20,0,0,8"
                Width="300"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    IsChecked="True"
                    x:Name="IncludeTrail"
                    Style="{StaticResource CheckBox_Template}" />
                <TextBlock
                    Margin="25,1,0,0"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SKMASTERS_023]}"
                    FontSize="20"
                    Foreground="Black"
                    IsHitTestVisible="False"
                    VerticalAlignment="Center" />
            </Grid>
            <Grid
                Margin="330,0,0,8"
                Width="300"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <CheckBox
                    IsChecked="True"
                    x:Name="IncludeCustom"
                    Style="{StaticResource CheckBox_Template}" />
                <TextBlock
                    Margin="25,1,0,0"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SKMASTERS_024]}"
                    FontSize="20"
                    Foreground="Black"
                    IsHitTestVisible="False"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                Margin="0,0,20,8"
                Width="350"
                Height="30"
                FlowDirection="{Binding GlobalTextFlowAL2R}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <CheckBox
                    x:Name="BestScoreOnly"
                    Style="{StaticResource CheckBox_Template}" />
                <TextBlock
                    Margin="25,1,0,0"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SKMASTERS_025]}"
                    FontSize="20"
                    Foreground="Black"
                    IsHitTestVisible="False"
                    VerticalAlignment="Center" />
            </Grid>

        </Grid>


        <!-- back/play -->
        <Grid
            >

            <!--             <Ellipse
                Width="159"
                Height="70"
                Margin="17,0,0,9"
                Fill="#CC000000"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"/> -->
            <Button
                Name="AStandaloneQuitButton"
                Width="106"
                Height="47"
                Margin="43,0,0,21"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.ImageFlow="{Binding GlobalTextFlow}"
                local:PropEx.Sprite1="{StaticResource UI-Buttons B005}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons B006}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons B007}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons B008}"
                Command="{Binding SkirmishMastersCommand}"
                CommandParameter="Back"
                Style="{StaticResource BTN_Image}" />

        </Grid>
        <Grid
            IsHitTestVisible="False">
            <Button
                Name="BorderXXX"
                Margin="0,0,0,15"
                Width="1000"
                Height="55"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Style="{StaticResource BDR_SH1DEb}">
            </Button>
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Width="950"
                Height="55">
                <TextBlock
                    Margin="0,-11,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="18"
                    Foreground="Black"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_SKIRMISH_MASTERS_006]}" /> 
            </Grid>
        </Grid>

        <!-- confirmation popup -->
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#00000000"
            Visibility="{Binding Show_HUD_ConfirmationSM, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid
                    Width="800"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <local:HUD_ConfirmationPopup
                        Margin="0" />
                </Grid>
        </Grid>

    </Grid>


</UserControl>

<!-- NOTDEMOEND -->