                Margin="380,0,0,30"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_237]}"
