<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">


    <Style
        x:Key="BTN_NewFrontend"
        TargetType="{x:Type Button}">
        <Setter
            Property="OverridesDefaultStyle"
            Value="True" />
        <Setter
            Property="FocusVisualStyle"
            Value="{x:Null}" />
        <Setter
            Property="ToolTipService.ShowDuration"
            Value="2500" />
        <Setter
            Property="ToolTipService.InitialShowDelay"
            Value="1000" />

        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type Button}">
                    <Viewbox>
                        <Grid
                            FlowDirection="{Binding GlobalTextFlow}"
                            x:Name="BaseGrid"
                            Width="720"
                            Height="173"
                            RenderTransformOrigin="0.5,0.5"
                            UseLayoutRounding="False">

                            <Border
                                x:Name="HitBox"
                                Background="#00ff0000" />
                            <Image
                                x:Name="BodyDefault"
                                FlowDirection="{Binding GlobalTextFlow}"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.0,0.0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Source="{StaticResource btn_shield_bar_01}"
                                Visibility="Visible" />

                            <Image
                                x:Name="BodyMouseOver"
                                FlowDirection="{Binding GlobalTextFlow}"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.0,0.0"
                                Source="{StaticResource btn_shield_bar_01_rollover}"
                                Visibility="Hidden">
                            </Image>

                            <Grid
                                Width="123"
                                Height="135"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,0,0,0">
                                <Image
                                    x:Name="ShieldImage"
                                    Width="93"
                                    Height="102"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0.0,0.0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{TemplateBinding local:PropEx.Sprite1}"
                                    Visibility="Visible" />
                            </Grid>
                            <Image
                                x:Name="SpriteLocked"
                                FlowDirection="{Binding GlobalTextFlow}"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.0,0.0"
                                Source="{TemplateBinding local:PropEx.Sprite4}"
                                Visibility="Hidden" />

                            <Grid
                                Width="550"
                                Height="80"
                                Margin="{TemplateBinding local:PropEx.Sprite1Margin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="CenterText"
                                    VerticalAlignment="Center"
                                    Opacity="0.7"
                                    Foreground="#FFFFFFFF"
                                    FontSize="{TemplateBinding local:PropEx.FrontEndButtonFontSize}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    LineStackingStrategy="BlockLineHeight"
                                    LineHeight="{TemplateBinding local:PropEx.FrontEndButtonLineHeight}"
                                    Visibility="Visible">
<!--                            <Run Typography.Capitals="SmallCaps" Text="{TemplateBinding local:PropEx.TextCentre}"/>   -->
                                <Run
                                        Text="{TemplateBinding local:PropEx.TextCentre}" />
                                </TextBlock>
                            </Grid>
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <RotateTransform />
                                </TransformGroup>
                            </Grid.RenderTransform>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        GeneratedDuration="0:0:0.6"
                                        To="Focused">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase
                                                Amplitude="0.5"
                                                EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition
                                        GeneratedDuration="0:0:0.3"
                                        From="Focused">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <SineEase
                                                EasingMode="EaseInOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <VisualState
                                    x:Name="Unfocused" />
                                <VisualState
                                    x:Name="Focused" />
                            </VisualStateGroup>

                            <VisualStateGroup
                                x:Name="CommonStates">

                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        GeneratedDuration="0:0:0.4"
                                        To="MouseOver">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase
                                                Amplitude="1.2"
                                                EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition
                                        GeneratedDuration="0:0:0.2"
                                        From="MouseOver">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <SineEase
                                                EasingMode="EaseInOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>


                                <VisualState
                                    x:Name="Normal" />
                                <VisualState
                                    x:Name="Pressed" />

                                <VisualState
                                    x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="BaseGrid"
                                            Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame
                                                KeyTime="0"
                                                Value="1.02" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetName="BaseGrid"
                                            Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame
                                                KeyTime="0"
                                                Value="1.02" />
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                TargetName="BodyDefault"
                                Property="Visibility"
                                Value="Hidden" />
                            <Setter
                                TargetName="BodyMouseOver"
                                Property="Visibility"
                                Value="Visible" />
                            <Setter
                                TargetName="HitBox"
                                Property="IsHitTestVisible"
                                Value="True" />
                            <Setter
                                TargetName="CenterText"
                                Property="Opacity"
                                Value="0.9" />
                        </Trigger>
                        <Trigger
                            Property="IsPressed"
                            Value="True">
                            <Setter
                                TargetName="BodyDefault"
                                Property="Visibility"
                                Value="Hidden" />
                            <Setter
                                TargetName="BodyMouseOver"
                                Property="Visibility"
                                Value="Visible" />
                            <Setter
                                TargetName="HitBox"
                                Property="IsHitTestVisible"
                                Value="True" />
                            <Setter
                                TargetName="CenterText"
                                Property="Opacity"
                                Value="0.9" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                TargetName="BodyDefault"
                                Property="Visibility"
                                Value="Visible" />
                            <Setter
                                TargetName="BodyMouseOver"
                                Property="Visibility"
                                Value="Hidden" />
                            <Setter
                                TargetName="HitBox"
                                Property="IsHitTestVisible"
                                Value="False" />
                            <Setter
                                TargetName="CenterText"
                                Property="Opacity"
                                Value="0.5" />
                        </Trigger>

                        <EventTrigger
                            RoutedEvent="PreviewMouseLeftButtonDown">
                            <EventTrigger.Actions>
                                <BeginStoryboard
                                    Name="mouseEnterBeginStoryboard">
                                    <Storyboard>
                                        <!-- This animation makes the glass rectangle shrink in the X direction. -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="BaseGrid"
                                            Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                            By="-0.02"
                                            Duration="0:0:0.1" />
                                        <!-- This animation makes the glass rectangle shrink in the Y direction. -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="BaseGrid"
                                            Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                            By="-0.02"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger
                            RoutedEvent="PreviewMouseLeftButtonUp">
                            <EventTrigger.Actions>
                                <!-- Stopping the storyboard sets all animated properties back to default. -->
                                <StopStoryboard
                                    BeginStoryboardName="mouseEnterBeginStoryboard" />
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


