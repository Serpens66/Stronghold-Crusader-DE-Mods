<!-- NOTDEMOSTART -->
<UserControl
    x:Class="CrusaderDE.HUD_Scenario"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Storyboard x:Key="Intro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1000" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Outtro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="1000">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="HiddenStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>



        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>


        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FF000000" />
        </Style>

    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Outtro}" />
        </EventTrigger>
    </UserControl.Triggers>


    <Grid
        x:Name="LayoutRoot"
        Width="800"
        Height="600"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="240" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>


        <Button
            Name="ScenarioBorder"
            Width="800"
            Height="600"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BDR_SH1DEa}" />

        <local:WGT_Heading
            x:Name="ScenarioHeader"
            Width="800"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Divider="{StaticResource Panel_Divider}"
            HeadingText="ScenarioTemp" />

        <!--  These are all the separate Views into the main panel area -->

        <!--  Main 'default' view  -->
        <Grid
            Name="ScenarioViewMain"
            Width="520"
            Height="460"
            Margin="0,80,24,0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Hidden"
            Background="{StaticResource Brush.InsetColour1}">

            <Border
                Width="520"
                Height="460"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="#FF000000"
                BorderThickness="2" />

            <ListView
                Margin="4"
                Name="ScenarioActionList"
                ItemContainerStyle="{StaticResource SCN_Main_ListViewItem}">

                <ListView.View>
                    <GridView
                        ColumnHeaderContainerStyle="{StaticResource HiddenStyle}">
                        <GridViewColumn
                            Header=""
                            Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="#FF000000"
                                        FontSize="16"
                                        Text="{Binding Text1}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            Header=""
                            Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="#FF000000"
                                        FontSize="16"
                                        Text="{Binding Text2}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            Header=""
                            Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="#FF000000"
                                        FontSize="16"
                                        Text="{Binding Text3}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

        </Grid>

