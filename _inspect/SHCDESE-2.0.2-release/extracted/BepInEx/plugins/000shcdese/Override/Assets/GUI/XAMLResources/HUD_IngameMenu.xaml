        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FFEFF3C6" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>


        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>
        
    </UserControl.Resources>
<!--
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Outtro}" />
        </EventTrigger>
    </UserControl.Triggers>
-->

    <Grid
        x:Name="LayoutRoot"
        Width="500"
        Height="438"
        
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#00000000"
        UseLayoutRounding="True">
<!--        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions> -->
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>


        <Button
            Name="ScenarioBorder"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Style="{StaticResource BDR_SH1DEa}" />


        <local:WGT_Heading
            x:Name="ScenarioHeader"
            Width="500"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Divider="{StaticResource Panel_Divider}"
            HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_002]}" />

        <!--  These are all the separate Views into the main panel area -->


        <!--  Side Buttons & Controls  -->
        <Grid  Grid.Column="0">
            <StackPanel
                Name="LeftPanel"
                Width="500"
                Margin="0,72,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility ="Visible">
               
                <Button
                    Name="ButtonSave"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding IngameMessageSaveButtonText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="1"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />

                <Button
                    Name="ButtonLoad"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding IngameMessageLoadButtonText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="2"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />

                <Button
                    Name="ButtonWorkshop"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_112]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="99"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />

                <Button
                    Name="ButtonOptions"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_025]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="3"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />

                <Button
                    Name="ButtonHelp"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_027]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="4"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />
                <Button
                    Name="ButtonRestartMission"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding IngameMessageRestartButtonText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="5"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />

                <Button
                    Name="ButtonQuitMission"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding IngameMessageQuitButtonText}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="6"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />
                <Button
                    Name="ButtonExitStronghold"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_010]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    CommandParameter="7"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />
                <Button
                    Name="ButtonResume"
                    Width="300"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_011]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonIngameMenuCommand}"
                    MouseEnter="CommonRedButtonEnter"
                    CommandParameter="8"
                    Style="{StaticResource BTN_SH_GlowSDisable}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>