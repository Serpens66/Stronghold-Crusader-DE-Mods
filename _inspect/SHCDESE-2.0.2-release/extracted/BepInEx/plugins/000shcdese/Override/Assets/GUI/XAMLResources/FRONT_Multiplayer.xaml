<!-- NOTDEMOSTART -->
<UserControl
    x:Class="CrusaderDE.FRONT_Multiplayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    d:DesignHeight="768"
    d:DesignWidth="1366"
    mc:Ignorable="d">


    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>        
        <Style x:Key="HiddenStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Storyboard x:Key="ReadyButtonAnim">
            <DoubleAnimationUsingKeyFrames Timeline.DesiredFrameRate="300" Storyboard.TargetName="ReadyButtonScale" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.20">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Timeline.DesiredFrameRate="300" Storyboard.TargetName="ReadyButtonScale" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.20">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        
        <Storyboard x:Key="SettingsButtonAnim">
            <DoubleAnimationUsingKeyFrames Timeline.DesiredFrameRate="300" Storyboard.TargetName="MultiplayerSetupInfoScale" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.20">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Timeline.DesiredFrameRate="300" Storyboard.TargetName="MultiplayerSetupInfoScale" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.20">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>



    <Grid
        Name="mapgrid"
        Background="Black"
        IsHitTestVisible="True">

        <Image
            Name="Basemap"
            Width="1366"
            Height="768"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FlowDirection="{Binding GlobalTextFlow}"
            Source="../Images/victory_military_small.png"
            Stretch="UniformToFill" />

        <!-- Header -->

        <Grid
            Margin="50,30,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{Binding Show_MPSteamIdentity, Converter={StaticResource booleanToVisibilityConverter}}">
            <Image
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Width="50" 
                Height="50"
                Source="{Binding MP_SteamIdentity_Avatar}"/>
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="55,16,0,0"
                Foreground="{StaticResource Brush.Accent7}"
                Background="#88000000"
                FontSize="20"
                Text="{Binding MP_SteamIdentity_Name}" />
        </Grid>

        <Grid
            Margin="0,22,45,0"
            Width="300"
            Height="65"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#88000000"
            Visibility="{Binding Show_MPNotSkirmishIsHost, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Foreground="{StaticResource Brush.Accent7}"
                FontSize="18"
                Text="{Binding LobbyTypeHeading}" />
            <Button
                Width="250"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                local:PropEx.TextCentre="{Binding LobbyTypeButton}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="ChangeLobbyType"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowSB}" />
        </Grid>

        <Grid
            Name="HeaderBar"
            Width="545"
            Height="60"
            Margin="0,25,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource BDR_SH1DEb}" />

            <Grid
                Height="80"
                Margin="0,-10,0,-100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <TextBlock
                    TextAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    Foreground="Black"
                    FontSize="40"
                    Typography.Capitals="SmallCaps"
                    Text="{Binding StandaloneTitle}" />

                <Image
                    Width="20"
                    Height="40"
                    Margin="0,20,25,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Opacity="1"
                    IsHitTestVisible="False"
                    Source="{StaticResource Panel_CelticKnot}" />

                <Image
                    Width="20"
                    Height="40"
                    Margin="25,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="1"
                    IsHitTestVisible="False"
                    Source="{StaticResource Panel_CelticKnot}" />
            </Grid>
        </Grid>
        <!-- Lobby =========================================== -->

        <Grid
            Visibility="{Binding Show_MPJoiningLobby, Converter={StaticResource booleanToVisibilityConverter}}">

            <!-- Lobby List -->
            <Grid
                Margin="00,123,0,0"
                Width="800"
                Height="490"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Button
                    Name="BorderX"
                    Margin="-3,-3,-3,-3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Style="{StaticResource BDR_SH1DEb}">
                </Button>

                <ListView
                    Margin="2"
                    Name="LobbyList"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{StaticResource Standalone_ListViewItem}">
                    <ListView.View>
                        <GridView
                            AllowsColumnReorder="False">
                            <!--                            <GridViewColumn Width="40">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Type" >Type</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image
                                    Width="30"
                                    Margin="-2,0,0,0"
                                    Source="{Binding TypeImage}"
                                    />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            -->
                            <GridViewColumn
                                Width="300">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Name">Name</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="0,6,0,3"
                                            Margin="0,-4,0,-4"
                                            HorizontalAlignment="Left"
                                            Foreground="Black"
                                            FontSize="16"
                                            FlowDirection="{Binding GlobalTextFlowAL2R}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Text1}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="280">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Map">Map</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="0,6,0,3"
                                            Margin="0,-4,0,-4"
                                            HorizontalAlignment="Left"
                                            Foreground="Black"
                                            FontSize="16"
                                            TextTrimming="CharacterEllipsis">
                                        <InlineUIContainer><Image
                                                    Source="{Binding BalancedImage}"
                                                    Height="18"
                                                    Margin="0,0,0,-4" /></InlineUIContainer><!--
                                     --><Run
                                                Text="{Binding Text2}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Players">Players</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="0,6,0,3"
                                            Margin="0,-4,0,-4"
                                            HorizontalAlignment="Left"
                                            Foreground="Black"
                                            FontSize="16"
                                            Text="{Binding Text3}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="40">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Country"></GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="0,6,0,3"
                                            Margin="0,-4,0,-4"
                                            HorizontalAlignment="Left"
                                            Foreground="Black"
                                            FontSize="16"
                                            Text="{Binding Text4}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="40">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Type"></GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image
                                            Width="25"
                                            Height="20"
                                            Margin="0,0,0,0"
                                            Source="{Binding TypeImage}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Button
                Width="240"
                Height="180"
                Margin="0,120,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Style="{StaticResource BDR_SH1DEb}">
            </Button>
            
            <TextBlock
                Width="200"
                Margin="0,130,40,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                TextAlignment="Center"
                FontSize="22"
                Foreground="Black"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_208]}" />
            
            <Button
                Width="200"
                Margin="0,170,40,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre="{Binding GameTexts[TEXT_NEW_CTEXT_209], Source={x:Static local:Translate.Instance}}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                local:PropEx.BorderVisibility="{Binding MP_LobbyLocalRegionVis}"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="RegionLocal"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowSB}" />
            <Button
                Width="200"
                Margin="0,210,40,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre="{Binding GameTexts[TEXT_NEW_CTEXT_210], Source={x:Static local:Translate.Instance}}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                local:PropEx.BorderVisibility="{Binding MP_LobbyDefaultRegionVis}"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="RegionDefault"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowSB}" />
            <Button
                Width="200"
                Margin="0,250,40,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                local:PropEx.TextCentre="{Binding GameTexts[TEXT_NEW_CTEXT_237], Source={x:Static local:Translate.Instance}}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                local:PropEx.BorderVisibility="{Binding MP_LobbyGlobalRegionVis}"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="RegionGlobal"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowSB}" />
            <Button
                Name="JoinButton"
                Width="200"
                Margin="0,0,283,106"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_009]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                IsEnabled="False"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="Join"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />
            <Button
                Name="LobbySettingsButton"
                Width="200"
                Margin="0,0,283,66"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_059]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                IsEnabled="False"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="LobbySettings"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />            
            <Button
                Name="RefreshButton"
                Width="200"
                Margin="0,0,0,106"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_053]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="Refresh"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />
            <Button
                Name="HostButton"
                Width="200"
                Margin="283,0,0,106"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_008]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="Host"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />

            <TextBlock
                Margin="0,0,640,24"
                Width="400"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                TextAlignment="{Binding AL2RTextRight}"
                Foreground="Black"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_176]}" />
            <TextBox
                Name="MP_EnterShareCodeText"
                Width="200"
                Height="30"
                Padding="5"
                Margin="0,0,0,25"
                MaxLength="20"
                TextAlignment="Center"
                Focusable="True"
                Text="{Binding MultiplayerEnterShareCode}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            </TextBox>
            <Button
                Name="ShareJoinButton"
                Width="200"
                Margin="450,0,0,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_009]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                IsEnabled="False"
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="ShareJoin"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />

            <Grid
                Background="#88000000"
                Visibility="{Binding Show_CreatingMPHost, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid
                    Width="850"
                    Height="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Button
                        Width="850"
                        Height="350"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BDR_SH1DEb}" />
                    <local:WGT_Heading
                        Width="850"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Divider="{StaticResource Panel_Divider}"
                        HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_054]}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="0,80,0,0"
                        FontSize="24"
                        VerticalAlignment="Top"
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_049]}" />

                    <TextBox
                        Name="TextBoxGameName"
                        Width="500"
                        Margin="0,110,0,0"
                        MaxLength="39"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top" />

                    <TextBlock
                        HorizontalAlignment="Left"
                        TextAlignment="Center"
                        Width="260"
                        Margin="20,200,0,0"
                        FontSize="22"
                        VerticalAlignment="Top"
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_212]}" />                    
                    <Button
                        Width="260"
                        Margin="20,230,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        local:PropEx.TextCentre="{Binding MP_PublicPrivateText}"
                        local:PropEx.TextLeft=""
                        local:PropEx.TextRight=""
                        Command="{Binding MultiplayerMenuCommand}"
                        CommandParameter="TogglePublic"
                        MouseEnter="CommonRedButtonEnter"
                        Style="{StaticResource BTN_SH_GlowS}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Width="260"
                        Margin="0,200,0,0"
                        FontSize="22"
                        VerticalAlignment="Top"
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_213]}" />
                    <Button
                        Width="260"
                        Margin="0,230,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        local:PropEx.TextCentre="{Binding MP_GameTypeText}"
                        local:PropEx.TextLeft=""
                        local:PropEx.TextRight=""
                        Command="{Binding MultiplayerMenuCommand}"
                        CommandParameter="ToggleGameType"
                        MouseEnter="CommonRedButtonEnter"
                        Style="{StaticResource BTN_SH_GlowS}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Width="560"
                        Margin="0,263,0,0"
                        FontSize="18"
                        VerticalAlignment="Top"
                        Text="{Binding MP_GameTypeText_Desc}" />
                    
                    <TextBlock
                        HorizontalAlignment="Right"
                        TextAlignment="Center"
                        Width="260"
                        Margin="0,200,20,0"
                        FontSize="22"
                        VerticalAlignment="Top"
                        Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_214]}" />
                    <Button
                        Width="260"
                        Margin="0,230,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        local:PropEx.TextCentre="{Binding MP_SettingsText}"
                        local:PropEx.TextLeft=""
                        local:PropEx.TextRight=""
                        Command="{Binding MultiplayerMenuCommand}"
                        CommandParameter="ToggleSettings"
                        MouseEnter="CommonRedButtonEnter"
                        Style="{StaticResource BTN_SH_GlowS}" />

                    <Grid
                        Visibility="{Binding Show_MPLobbyMaxPlayers, Converter={StaticResource booleanToVisibilityConverter}}">
                        <StackPanel
                            Width="208"
                            Margin="0,155,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <Slider
                                Name="LobbyMaxPlayersSlider"
                                IsSnapToTickEnabled="True"
                                Minimum="2"
                                Maximum="8"
                                Value="8"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Style="{StaticResource SDR_SH_Plain}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="20"
                            Margin="0,155,0,0"
                            Width="290"
                            TextAlignment="{Binding AL2RTextRight}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_185]}" />
                        <TextBlock
                            FontSize="20"
                            Margin="0,155,0,0"
                            Width="290"
                            TextAlignment="{Binding AL2RTextLeft}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Text="{Binding MPCreateMaxPlayers}" />
                    </Grid>
                    <Button
                        Width="150"
                        Margin="20,0,0,20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_004]}"
                        local:PropEx.TextLeft=""
                        local:PropEx.TextRight=""
                        Command="{Binding MultiplayerMenuCommand}"
                        CommandParameter="CancelHost"
                        MouseEnter="CommonRedButtonEnter"
                        Style="{StaticResource BTN_SH_GlowS}" />

                    <Button
                        Width="250"
                        Margin="0,0,20,20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_008]}"
                        local:PropEx.TextLeft=""
                        local:PropEx.TextRight=""
                        Command="{Binding MultiplayerMenuCommand}"
                        CommandParameter="DoHost"
                        MouseEnter="CommonRedButtonEnter"
                        Style="{StaticResource BTN_SH_GlowS}" />

                </Grid>
            </Grid>

            <!-- Setup -->
            <Grid
                Visibility="{Binding Show_MPLobbySettings, Converter={StaticResource booleanToVisibilityConverter}}">
                <local:FRONT_Multiplayer_Setup
                    Margin="0" />
            </Grid>
        </Grid>

        <!-- Multiplayer setup ======================================= -->
        <Grid
            Visibility="{Binding Show_MPGameCreation, Converter={StaticResource booleanToVisibilityConverter}}">

            <!-- Map List -->
            <Grid
                Margin="50,387,0,0"
                Width="556"
                Height="264"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{Binding Show_MPFileList, Converter={StaticResource booleanToVisibilityConverter}}">
                <Button
                    Name="Border"
                    Margin="-3,-3,-3,-3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Style="{StaticResource BDR_SH1DEb}">
                </Button>

                <ListView
                    Margin="2"
                    Name="MapList"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{StaticResource Standalone_ListViewItem}">
                    <ListView.View>
                        <GridView
                            AllowsColumnReorder="False">
                            <GridViewColumn
                                Width="40">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Type">Type</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image
                                            Width="30"
                                            Margin="-2,0,0,0"
                                            Source="{Binding TypeImage}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="30">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader
                                        Template="{StaticResource MyGridViewColumnHeader}"
                                        Tag="Players">Players</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
