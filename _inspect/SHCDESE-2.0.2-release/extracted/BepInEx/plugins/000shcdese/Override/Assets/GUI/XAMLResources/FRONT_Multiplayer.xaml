                        </Grid>
                    </Viewbox>
                </Grid>
                <!-- confirmation popup -->
                <Grid
                    x:Name="HUD_ConfirmationPopupMP"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#00000000"
                    Visibility="{Binding Show_HUD_ConfirmationMP, Converter={StaticResource booleanToVisibilityConverter}}">
                    <Viewbox
                        Width="{Binding FrontEndConfirmationWidth}"
                        Height="{Binding FrontEndConfirmationHeight}">
                        <Grid
                            Width="{Binding ConfirmationPanelWidthView}"
                            Height="{Binding ConfirmationPanelHeightView}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <local:HUD_ConfirmationPopup
                                Margin="0" />
                        </Grid>
                    </Viewbox>
                </Grid>
                <!-- options menu -->
                <Grid
                    x:Name="HUD_OptionsMainMP"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#00000000"
                    Visibility="{Binding Show_HUD_OptionsMP, Converter={StaticResource booleanToVisibilityConverter}}">
                    <Viewbox
                        Width="{Binding FrontEndOptionsWidth}"
                        Height="{Binding FrontEndOptionsHeight}">
                        <Grid
                            Width="836"
                            Height="636"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <local:HUD_Options
                                Margin="0" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Grid>

            
        </Viewbox>


    </Grid>
</UserControl>

