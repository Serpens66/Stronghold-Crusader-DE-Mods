                x:Name="TroopHelpText"
                Padding="10,2,2,2"
                Margin="10,-18,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                FontSize="16"
                Foreground="#FFDDDDDD"
                Background="#55000000"
                Tag="Ignore"
                Text="{Binding TroopCostText}"
                >
                <TextBlock.Effect>
                    <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
                </TextBlock.Effect>
            </TextBlock>            
            
            <TextBlock
