<UserControl
    x:Class="CrusaderDE.HUD_Buildings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="195"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#FF000000" />
            <!--            <Setter Property="FontFamily" Value="Times New Roman" /> -->
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>

        <Storyboard x:Key="TradeErrorFadeOut">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TradeErrorMessage" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.0" Value="0.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.4" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <StringAnimationUsingKeyFrames Storyboard.TargetName="TradeErrorMessage" Storyboard.TargetProperty="Text">
                <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value="{Binding TradeErrorText}"/>
                <DiscreteStringKeyFrame KeyTime="0:0:4.0" Value="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT2_131]}"/>
            </StringAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" />
    </UserControl.Triggers>

    <Grid
        x:Name="InBuildingLayoutRoot"
        Width="800"
        Height="195"
        Background="#00E2F383"
        Tag="IgnoreSelf"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>



        <!--  Barracks Picture Frame aacks  -->
