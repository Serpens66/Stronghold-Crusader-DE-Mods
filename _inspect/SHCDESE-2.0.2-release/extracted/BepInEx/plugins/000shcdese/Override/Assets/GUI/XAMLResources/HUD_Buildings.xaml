                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                FontSize="16"
                Foreground="#FFDDDDDD"
                Background="#55000000"
                Tag="Ignore"
                TextAlignment="Center"
                >
      <Run Text="{Binding TroopNameCostText}"/><!--
         --><LineBreak/><Run FontSize="12" FlowDirection="LeftToRight" Text="{Binding TroopNameCostText2}"/>
