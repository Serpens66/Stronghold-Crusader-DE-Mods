                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5"
                FlowDirection="{Binding GlobalTextFlow}"
                Source="{StaticResource UI-HUD 005}">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <TextBlock
                x:Name="TroopCostsText"
                Padding="10,2,2,2"
                Margin="10,-18,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                FontSize="16"
                Foreground="#FFDDDDDD"
                Background="#55000000"
                Tag="Ignore"
                >
                <TextBlock.Effect>
                    <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
                </TextBlock.Effect>
            <Run Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_IN_BARRACKS_003]}"/><!--
         --><Run Text="{Binding TroopCostText}"/><!--
         --><InlineUIContainer><Image Source="{StaticResource UISprites F001}" Height="18" Margin="5,5,0,-5" /></InlineUIContainer><!--
         --><Run Text=" "/>
            </TextBlock>

