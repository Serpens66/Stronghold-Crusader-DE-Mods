                                        Width="40">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Template="{StaticResource MyGridViewColumnHeader}"
                                                Tag="Type"></GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image
                                                    Width="30"
                                                    Margin="-2,0,0,0"
                                                    Source="{Binding TypeImage}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                        Width="320">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Template="{StaticResource MyGridViewColumnHeader}"
                                                Tag="Name">Name</GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,-4,0,-4"
                                                    HorizontalAlignment="Left"
                                                    Foreground="Black"
                                                    FlowDirection="{Binding GlobalTextFlowAL2R}"
                                                    TextTrimming="CharacterEllipsis"
