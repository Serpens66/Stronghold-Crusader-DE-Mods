<!-- NOTDEMOSTART -->
<UserControl
    x:Class="CrusaderDE.FRONT_Multiplayer_AISettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    d:DesignHeight="768"
    d:DesignWidth="1366"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
            <Setter Property="Foreground" Value="Black" />
        </Style>        
        <Style x:Key="HiddenStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:KeyTrigger
            FiredOn="KeyDown"
            Key="Escape">
            <b:InvokeCommandAction
                Command="{Binding MPAICommand}"
                CommandParameter="Back" />
        </b:KeyTrigger>
    </b:Interaction.Triggers>


    <!-- Setup -->
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#88000000">
        <Grid
            Margin="00,43,0,0"
            Width="880"
            Height="630"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
<!--            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="800" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions> -->

            <Button
                Name="BorderXX"
                Margin="-3,-3,-3,-3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Grid.ColumnSpan="2"
                Style="{StaticResource BDR_SH1DEa}">
            </Button>
            <local:WGT_Heading
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Divider="{StaticResource Panel_Divider}"
                Grid.ColumnSpan="2"
                HeadingText="{Binding MPAISettingsHeading}" />

            <Viewbox
                Margin="60,57,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="300">
                <Grid
                    x:Name="AIV_Mode"
                    >
                    <Button
                        Width="515"
                        Height="60"
                        Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        
                        Style="{StaticResource BDR_SH1DEb}"
                        Command="{Binding MPAICommand}"
                        CommandParameter="AIV_Mode">
                        <b:Interaction.Triggers>
                            <b:EventTrigger
                                EventName="MouseEnter">
                                <b:InvokeCommandAction
                                    Command="{Binding MPAICommand}"
                                    CommandParameter="MouseEnter_AIV_Mode" />
                            </b:EventTrigger>
                            <b:EventTrigger
                                EventName="MouseLeave">
                                <b:InvokeCommandAction
                                    Command="{Binding MPAICommand}"
                                    CommandParameter="MouseLeave_AIV_Mode" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Button>
                    <Grid
                        Width="515"
                        Height="80"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top">
                        <TextBlock
                            TextAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,16,0,0"
                            Foreground="Black"
                            FontSize="40"
                            Typography.Capitals="SmallCaps"
                            IsHitTestVisible="False"
                            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_CUSTOMISATION_008]}" />
                        <Image
                            Width="20"
                            Height="40"
                            Margin="0,20,25,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Opacity="1"
                            IsHitTestVisible="False"
                            Source="{StaticResource Panel_CelticKnot}" />

                        <Image
                            Width="20"
                            Height="40"
                            Margin="25,20,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Opacity="1"
                            IsHitTestVisible="False"
                            Source="{StaticResource Panel_CelticKnot}" />
                    </Grid>
                </Grid>
            </Viewbox>
 
            <Viewbox
                Margin="60,57,60,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="300">
                <Grid
                    x:Name="Lord_Mode"
                    Opacity="0.7">
                    <Button
                        Width="515"
                        Height="60"
                        Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource BDR_SH1DEb}"
                        Command="{Binding MPAICommand}"
                        CommandParameter="Lord_Mode">
                        <b:Interaction.Triggers>
                            <b:EventTrigger
                                EventName="MouseEnter">
                                <b:InvokeCommandAction
                                    Command="{Binding MPAICommand}"
                                    CommandParameter="MouseEnter_Lord_Mode" />
                            </b:EventTrigger>
                            <b:EventTrigger
                                EventName="MouseLeave">
                                <b:InvokeCommandAction
                                    Command="{Binding MPAICommand}"
                                    CommandParameter="MouseLeave_Lord_Mode" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Button>
                    <Grid
                        Width="515"
                        Height="80"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top">
