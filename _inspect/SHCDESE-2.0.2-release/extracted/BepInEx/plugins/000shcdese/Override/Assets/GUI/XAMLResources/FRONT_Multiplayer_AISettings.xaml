                            Height="40"
                            Margin="25,20,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Opacity="1"
                            IsHitTestVisible="False"
                            Source="{StaticResource Panel_CelticKnot}" />
                    </Grid>
