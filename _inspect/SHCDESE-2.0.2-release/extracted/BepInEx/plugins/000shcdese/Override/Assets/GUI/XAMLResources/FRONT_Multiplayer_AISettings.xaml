                                Margin="0,2,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource UI-Buttons L009}"
                                local:PropEx.Sprite2="{StaticResource UI-Buttons L010}"
                                Command="{Binding MPAICommand}"
                                CommandParameter="Kick_8"
                                Style="{StaticResource BTN_Building}" />
                        </Grid>

                    </StackPanel>

                    <Viewbox
                        Width="150"
                        Margin="130,225,-100,-100">
                        <Button
                            Name="MP_Clear"
                            Width="200"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_099]}"
                            local:PropEx.TextLeft=""
                            local:PropEx.TextRight=""
                            Command="{Binding MPAICommand}"
                            CommandParameter="Clear_Selected"
                            Style="{StaticResource BTN_SH_GlowS}" />
                    </Viewbox>
                    <Grid
                        Name="SelectionDisabledOverlayMP"
                        Background="#88000000"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False" />
                </Grid>

                <Button
                    Name="MP_Add"
                    Width="60"
                    Margin="410,342,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="-->"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding MPAICommand}"
                    CommandParameter="Add_Selected"
                    Visibility="{Binding SkirmishSetupMode, Converter={StaticResource booleanToVisibilityConverter}}"
                    Style="{StaticResource BTN_SH_GlowS}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger
                            EventName="MouseEnter">
                            <b:InvokeCommandAction
                                Command="{Binding MPAICommand}"
                                CommandParameter="MouseEnter_Add" />
                        </b:EventTrigger>
                        <b:EventTrigger
                            EventName="MouseLeave">
                            <b:InvokeCommandAction
                                Command="{Binding MPAICommand}"
                                CommandParameter="MouseLeave_Add" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>

                <Button
                    Name="MP_Replace"
                    Width="60"
                    Margin="410,382,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="==>"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding MPAICommand}"
                    CommandParameter="Replace_Selected"
                    Style="{StaticResource BTN_SH_GlowS}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger
                            EventName="MouseEnter">
                            <b:InvokeCommandAction
                                Command="{Binding MPAICommand}"
                                CommandParameter="MouseEnter_Replace" />
                        </b:EventTrigger>
                        <b:EventTrigger
                            EventName="MouseLeave">
                            <b:InvokeCommandAction
                                Command="{Binding MPAICommand}"
                                CommandParameter="MouseLeave_Replace" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>

            </Grid>

            <!-- Lord Panel -->
            <Grid
                Visibility="{Binding Show_MPAI_Lord_Mode, Converter={StaticResource booleanToVisibilityConverter}}"
                Margin="0,5,0,0">

                <DockPanel
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="230,115,0,0"
                    Height="480">
                    <RadioButton
                        Name="Lord_Default"
                        GroupName="LordType"
                        Margin="20,0,0,5"
                        Width="350"
                        Height="23"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding MPAICommand}"
                        CommandParameter="LordDefault">
                        <TextBlock
                            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_CUSTOMISATION_019]}"
                            Margin="0,2,0,-2"
                            FontSize="20"
                            VerticalAlignment="Center" />
                    </RadioButton>
                    <RadioButton
                        Name="Lord_User"
                        GroupName="LordType"
                        Margin="20,0,0,5"
                        Width="350"
                        Height="23"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding MPAICommand}"
                        CommandParameter="LordUser">
                        <TextBlock
                            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_CUSTOMISATION_020]}"
                            Margin="0,2,0,-2"
                            FontSize="20"
                            VerticalAlignment="Center" />
                    </RadioButton>

                    <TextBlock
                        Margin="20,0,0,0"
                        Width="380"
                        Background="#40000000"
                        TextAlignment="Center"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="Black"
                        FontSize="18"
                        DockPanel.Dock="Top"
                        Text="{Binding CustomLordName}">
                    </TextBlock>
                    
                    <Grid
                        Margin="30,20,0,0"
                        Width="360"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        DockPanel.Dock="Bottom">
                        <Button
                            Name="LordBorder"
                            Margin="-3,-3,-3,-3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Style="{StaticResource BDR_SH1DEb}">
                        </Button>
                        <ListView
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Name="LordList"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ItemContainerStyle="{StaticResource Standalone_ListViewItem}">
                            <ListView.View>
                                <GridView
                                    ColumnHeaderContainerStyle="{StaticResource HiddenStyle}">
                                    <GridViewColumn
                                        Width="40">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Template="{StaticResource MyGridViewColumnHeader}"
                                                Tag="Type"></GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image
                                                    Width="30"
                                                    Margin="-2,0,0,0"
                                                    Source="{Binding TypeImage}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                        Width="320">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Template="{StaticResource MyGridViewColumnHeader}"
                                                Tag="Name">Name</GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Height="30">
                                                    <TextBlock
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Foreground="Black"
                                                        FlowDirection="{Binding GlobalTextFlowAL2R}"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="16"
                                                        Text="{Binding Text1}">
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Grid
                            Name="LordSelectionDisabledOverlay"
                            Background="#88000000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Grid>


            <Button
                Name="MP_OKSettings"
                Width="200"
                Margin="20,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_009]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding MultiplayerMenuCommand}"
                CommandParameter="CancelAISettings"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />
        </Grid>

        <Grid
            Visibility="{Binding Show_AI_Settings_Help, Converter={StaticResource booleanToVisibilityConverter}}"
            Margin="0,0,0,20"
            Width="1280"
            Height="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            
            <Button
                Name="BorderXX3"
                Margin="-3,-3,-3,-3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Grid.ColumnSpan="2"
                Style="{StaticResource BDR_SH1DEa}">
            </Button>
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Width="1150"
                Height="55">
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="18"
                    Text="{Binding AI_Settings_Help}" />
            </Grid>
        </Grid>
    </Grid>

</UserControl>

