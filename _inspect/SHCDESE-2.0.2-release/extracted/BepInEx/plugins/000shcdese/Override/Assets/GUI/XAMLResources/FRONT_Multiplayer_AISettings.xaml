                            FontSize="40"
                            Typography.Capitals="SmallCaps"
                            IsHitTestVisible="False"
                            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_CUSTOMISATION_009]}" />
                        <Image
