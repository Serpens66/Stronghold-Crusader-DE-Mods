<UserControl
    x:Class="CrusaderDE.IntroSequence"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

            <Storyboard x:Key="FadeInLogos">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PartnerLogo" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Logo" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Logo2" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Presents" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:4.2" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    
<!--    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInLogos}" />
        </EventTrigger>
    </UserControl.Triggers>
    
    -->

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Black"
        >
        <Button
            Margin="0"
            Command="{Binding IntroSkipCommand}"
            Content="" Background="#FF000000" BorderBrush="#00000000" Foreground="#00000000" Opacity="0" />
        
        <Viewbox>
            <Grid
                Width="1920"
                Height="1080"
                Margin="0"
                IsHitTestVisible="False"
                >
                <Image
                    Name="Logo"
                    Width="1920"
                    Height="1080"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="../Images/loading background.png"
                    IsHitTestVisible="False"
                     />
                <Image
                    Name="Logo2"
                    Width="1920"
                    Height="1080"
                    Margin="0"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="../Images/logo1.png"
                    IsHitTestVisible="False" />
                <Border
                    Name="ProgressBorder"
                    Width="500"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,100"
                    Background="Black"
                    BorderBrush="#f9c025"
                    CornerRadius="0"
                    BorderThickness="2" />
                <Image
                    Name="ProgressImage"
                    Width="490"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Source="{StaticResource Loading Bar}"
                    Margin="0,0,715,104" />
                <Grid
                    Name="Progress"
                    Width="1"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,715,104"
                    Background="Black"
                     />
                <Image
                    Name="PartnerLogo"
                    Width="1920"
                    Height="1080"
                    Margin="0"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="../Images/Partner_Logos.png"
                    IsHitTestVisible="False"
                     />
                <TextBlock
                    Name="Presents"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="80"
                    FontStyle="Italic"
                    Opacity="0"
                    Foreground="White"
                    IsHitTestVisible="False"
                    Text="{Binding GameTexts[TEXT_NEW_TEXT2_139], Source={x:Static local:Translate.Instance}}">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-25" AngleY="0" />
                            <TranslateTransform X="20"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>

                </TextBlock>

            </Grid>
        </Viewbox>
        <Viewbox>
            <Grid>
            <MediaElement
                Width="1920"
                Height="1080"
                Name="IntroVideo"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LoadedBehavior="Manual"
                UnloadedBehavior="Close"
                Stretch="Uniform"
                IsHitTestVisible="False"
                        >
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Loaded">
                        <noesis:PlayMediaAction />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </MediaElement>
            </Grid>
        </Viewbox>
        <Viewbox>
            <Grid
                Name="EnterYourName"
                Width="1920"
                Height="1080"
                Margin="0"
                Visibility="{Binding EnterYourNameVis, Converter={StaticResource booleanToVisibilityConverter}}"
                Background="Black"
                >
                <Image
                    Source="../Images/MenusBackground.png"
                    Stretch="UniformToFill" />
                <Image
                    Name="LogoMain"
                    Width="604"
                    Height="272"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                     />
                <Viewbox
                    Width="1350"
                    Height="900"
                    >
                    <Grid
                        Width="900"
                        Height="603"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Button
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource BDR_SH1DEa}" />

                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,30,0,0"
                            Width="450"
                            Height="550">
                            <local:WGT_Heading
                                x:Name="ConfirmationHeader"
                                Width="450"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Divider="{StaticResource Panel_Divider}"
                                HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_007]}" />
                            <Rectangle
                                Width="444"
                                Height="7.5"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                SnapsToDevicePixels="True">
                                <Rectangle.Fill>
                                    <ImageBrush
                                        ImageSource="{StaticResource Panel_Divider}"
                                        Viewport="0,0,250,7.5"
                                        ViewportUnits="Absolute"
                                        AlignmentX="Center"
                                        AlignmentY="Top"
                                        TileMode="Tile" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,80,0,0"
                                Width="420"
                                Height="150">
                                <TextBox
                                    Name="EnterYourNameTB"
                                    Margin="0,0,0,0"
                                    Width="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    TextAlignment="Center"
                                    Foreground="{StaticResource Brush.Accent7}"
                                    MaxLength="40"
                                    Text="{Binding EnterYourName}"/>
                            </Grid>


                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,187,0,0"
                                FontSize="24"
                                VerticalAlignment="Top"
                                TextAlignment="Center"
                                Text="{Binding GameTexts[TEXT_GAME_OPTIONS_051], Source={x:Static local:Translate.Instance}}" />

                            <Button
                                Name="CrusaderLordButton"
                                Width="60"
                                Height="60"
                                Margin="-150,230,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Crusader Lord}"
                                local:PropEx.Sprite2="{StaticResource Crusader Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Crusader Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Crusader Lord}"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="CRU"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="CRU_OVER" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="ArabicLordButton"
                                Width="60"
                                Height="60"
                                Margin="0,230,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Arabic Lord}"
                                local:PropEx.Sprite2="{StaticResource Arabic Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Arabic Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Arabic Lord}"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="ARAB"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="ARAB_OVER" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="BedouinLordButton"
                                Width="60"
                                Height="60"
                                Margin="150,230,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Bedouin Lord}"
                                local:PropEx.Sprite2="{StaticResource Bedouin Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Bedouin Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Bedouin Lord}"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="BED"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="BED_OVER" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="FemaleLordButton"
                                Width="60"
                                Height="60"
                                Margin="-150,300,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Female Lord}"
                                local:PropEx.Sprite2="{StaticResource Female Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Female Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Female Lord}"
                                local:PropEx.ImageButtonDisabledOpacity="0.5"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="WQ"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="WQ_OVER" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="ScribeLordButton"
                                Width="60"
                                Height="60"
                                Margin="0,370,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Scribe Lord}"
                                local:PropEx.Sprite2="{StaticResource Scribe Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Scribe Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Scribe Lord}"
                                local:PropEx.ImageButtonDisabledOpacity="0.5"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="SCR"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="SCR_OVER" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                           </Button>
                            <Image
                                Name="ScribeLock"
                                Width="30"
                                Margin="0,382,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Source="{StaticResource Lock}" />
                            <Button
                                Name="ArabicLordFemaleButton"
                                Width="60"
                                Height="60"
                                Margin="0,300,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Arabic Lord}"
                                local:PropEx.Sprite2="{StaticResource Arabic Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Arabic Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Arabic Lord}"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="ARABF"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="ARAB_OVERF" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="BedouinLordFemaleButton"
                                Width="60"
                                Height="60"
                                Margin="150,300,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                local:PropEx.Sprite1="{StaticResource Bedouin Lord}"
                                local:PropEx.Sprite2="{StaticResource Bedouin Lord Over}"
                                local:PropEx.Sprite3="{StaticResource Bedouin Lord Over}"
                                local:PropEx.Sprite4="{StaticResource Bedouin Lord}"
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="BEDF"
                                Style="{StaticResource BTN_Image}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger
                                        EventName="MouseEnter">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="BED_OVERF" />
                                    </b:EventTrigger>
                                    <b:EventTrigger
                                        EventName="MouseLeave">
                                        <b:InvokeCommandAction
                                            Command="{Binding EnterYourNameCommand}"
                                            CommandParameter="OFF" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,0,0,65"
                                FontSize="20"
                                VerticalAlignment="Bottom"
                                Text="{Binding Options_CurrentLord}" />


                            <CheckBox
                                x:Name="Leaderboard_OptOut"
                                Margin="0,125,0,0"
                                Height="23"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                IsChecked="True"
                                Style="{StaticResource CheckBox_Template}">
                                <TextBlock
                                    x:Name="Leaderboard_OptOutText"
                                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_302]}"
                                    Margin="0,2,0,-2"
                                    FontSize="20"
                                    TextWrapping="Wrap"
                                    Foreground="Black"
                                    VerticalAlignment="Center" />
                            </CheckBox>

                            <Button
                                Width="250"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_009]}"
                                local:PropEx.TextLeft=""
                                local:PropEx.TextRight=""
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="OK"
                                MouseEnter="CommonRedButtonEnter"
                                Style="{StaticResource BTN_SH_GlowS}" />
                        </Grid>
                        <Viewbox
                            Width="436"
                            Height="561"
                            Margin="0,20,9,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <local:HUD_CoatOfArms
                                x:Name="Coa"
                                Width="397"
                                Height="510" />
                        </Viewbox>
                    </Grid>
                </Viewbox>

                <Viewbox
                    Width="1200"
                    Height="900"
                    Visibility="{Binding OptionsNewsletterVis}">
                    <Grid
                        Width="800"
                        Height="600"
                        Background="{StaticResource Brush.InsetColour1}">

                        <Button
                            Width="800"
                            Height="500"
                            Margin="0,0,0,0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource BDR_SH1DEb}" />
                        <local:WGT_Heading
                            Width="800"
                            Margin="0,50,0,0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Divider="{StaticResource Panel_Divider}"
                            HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_343]}" />
                        <Grid
                            Width="800"
                            Height="500">



                            <Image
                                Margin="0,75,0,0"
                                Width="700"
                                Height="200"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Stretch="Fill"
                                Source="../Images/ScribeUnlock.png" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="30,285,30,0"
                                FontSize="18"
                                VerticalAlignment="Top"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_348]}" />

                            <TextBlock
                                HorizontalAlignment="Right"
                                Margin="0,370,655,0"
                                FontSize="18"
                                VerticalAlignment="Top"
                                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_345]}" />

                            <TextBox
                                Name="TextBoxNewsletter"
                                Width="600"
                                Margin="0,360,50,0"
                                MaxLength="100"
                                TextAlignment="Left"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top" />


                            <CheckBox
                                Name="NewsletterCheck"
                                Margin="30,0,0,20"
                                Width="500"
                                Height="43"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CheckBox_Template}">
                                <TextBlock
                                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_346]}"
                                    Margin="0,2,0,-2"
                                    FontSize="18"
                                    TextWrapping="Wrap"
                                    Foreground="#FF000000"
                                    LineHeight="20"
                                    LineStackingStrategy="BlockLineHeight"
                                    VerticalAlignment="Center" />
                            </CheckBox>

                            <Button
                                Name="NewsletterSignupButton"
                                Width="200"
                                Margin="0,0,40,15"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_CTEXT_344]}"
                                local:PropEx.TextLeft=""
                                local:PropEx.TextRight=""
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="NEWS"
                                MouseEnter="CommonRedButtonEnter"
                                Style="{StaticResource BTN_SH_GlowS}" />

                            <Button
                                Width="200"
                                Margin="0,0,40,50"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MULTIPLAYER_CONNECTION_004]}"
                                local:PropEx.TextLeft=""
                                local:PropEx.TextRight=""
                                Command="{Binding EnterYourNameCommand}"
                                CommandParameter="NEWSCANCEL"
                                MouseEnter="CommonRedButtonEnter"
                                Style="{StaticResource BTN_SH_GlowS}" />

                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
        </Viewbox>
        <!-- confirmation popup -->
        <Grid
            x:Name="HUD_ConfirmationPopupMain"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#00000000"
            Visibility="{Binding Show_HUD_Confirmation, Converter={StaticResource booleanToVisibilityConverter}}">
            <Viewbox
                Width="{Binding FrontEndConfirmationWidth}"
                Height="{Binding FrontEndConfirmationHeight}">
                <Grid
                    Width="{Binding ConfirmationPanelWidthView}"
                    Height="{Binding ConfirmationPanelHeightView}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <local:HUD_ConfirmationPopup
                        Margin="0" />
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>