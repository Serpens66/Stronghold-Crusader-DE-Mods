    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#FFEFF3C6" /> 
        </Style>
        <BooleanToVisibilityConverter
            x:Key="booleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        Width="1000"
        Height="650"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>



        <!-- main view -->
        <Button
            Width="1000"
            Height="650"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_Wood}" />
       
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            >

            <TextBlock
                Margin="0,27,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="40"
                Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_CUSTOMISATION_055]}"
                >
            </TextBlock>

