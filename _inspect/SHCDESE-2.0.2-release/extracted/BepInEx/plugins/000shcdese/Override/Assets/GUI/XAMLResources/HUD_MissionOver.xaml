                                EventName="MouseEnter">
                                <b:InvokeCommandAction
                                    Command="{Binding MO_ClickCommand_Enter}"
                                    CommandParameter="Troops" />
                            </b:EventTrigger>
                            <b:EventTrigger
                                EventName="MouseLeave">
