<UserControl
    x:Class="CrusaderDE.HUD_MissionOver"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="booleanToVisibilityConverter" />
        <Style
            TargetType="{x:Type TextBlock}">
            <Setter
                Property="FontSize"
                Value="24" />
            <Setter
                Property="HorizontalAlignment"
                Value="Left" />
            <!--            <Setter Property="Foreground" Value="#FFEFF3C6" /> -->
            <Setter
                Property="Foreground"
                Value="#FFEFF3C6" />
            <Setter
                Property="FlowDirection"
                Value="{Binding GlobalTextFlowAL2R}" />
        </Style>
        <Storyboard x:Key="SandsOutro">
            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="TrailInfo"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:11" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
            
            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="TrailMissions"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="TrailMissions"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-260" />
                <EasingDoubleKeyFrame KeyTime="0:0:10" Value="-260">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase
                            EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:11" Value="0"  >
                    <EasingDoubleKeyFrame.EasingFunction> <QuarticEase EasingMode="EaseInOut" /> </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            
           <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="TrailMission"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>            
            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="TrailMission"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-550" />
                <EasingDoubleKeyFrame KeyTime="0:0:5" Value="-550" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase
                            EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:6" Value="0"  >
                    <EasingDoubleKeyFrame.EasingFunction> <QuarticEase EasingMode="EaseInOut" /> </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="MO_SandsCurProgress"
                Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1500" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1500" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase
                            EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:5" Value="{Binding MO_Sands_CurProgressBar}"  >
                    <EasingDoubleKeyFrame.EasingFunction> <QuarticEase EasingMode="EaseOut" /> </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="MO_Sands_Exit"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:11" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
            
            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="MO_Sands_Stats"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="0.00" />
                <LinearDoubleKeyFrame KeyTime="0:0:11" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
            
            

            <DoubleAnimationUsingKeyFrames
                Timeline.DesiredFrameRate="300"
                Storyboard.TargetName="MO_SandsTrailProgress"
                Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1700" />
                <EasingDoubleKeyFrame KeyTime="0:0:11" Value="1700" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase
                            EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:15" Value="{Binding MO_Sands_TrailProgressBar}"  >
                    <EasingDoubleKeyFrame.EasingFunction> <QuarticEase EasingMode="EaseOut" /> </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>            
        </Storyboard>

        <Storyboard x:Key="WeaselTurd1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText1" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:39.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:40" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText2" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:40.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:41" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:43" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:43.5" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText3" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:44" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:44.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:46.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:47" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText4" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:47.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:48" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:1:12" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:1:12.5" Value="0" /> 
            </DoubleAnimationUsingKeyFrames>        
        </Storyboard>
        <Storyboard x:Key="WeaselTurd2">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText1" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:39.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:40" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText2" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:40.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:41" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:43" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:43.5" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText3" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:44" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:44.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:46.5" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:47" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WeaselTurdText5" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:47.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:48" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:1:12" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:1:12.5" Value="0" /> 
            </DoubleAnimationUsingKeyFrames>        
        </Storyboard>    </UserControl.Resources>


    <Grid
