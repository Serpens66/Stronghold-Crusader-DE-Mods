                        Text="{Binding MO_HelpGreatestLord}" />


                    <RadioButton
                        Name="SortTroops"
                        Height="110"
                        Margin="0,-12,160,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        GroupName="Tabs"
                        IsChecked="True"
