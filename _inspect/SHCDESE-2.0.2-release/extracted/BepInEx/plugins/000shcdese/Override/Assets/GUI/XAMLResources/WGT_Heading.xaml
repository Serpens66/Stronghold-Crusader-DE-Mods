<UserControl
    x:Class="CrusaderDE.WGT_Heading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="44"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>
    </UserControl.Resources>


    <Grid
        x:Name="LayoutRoot"
        Height="64"
        Background="#00004400">

        <TextBlock
            x:Name="HeadingTextBlock"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,4,0,0"
            IsHitTestVisible="False"
            Text="{Binding HeadingText}">
        </TextBlock>

        <Image
            Width="20"
            Height="40"
            Margin="0,11,25,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="1"
            IsHitTestVisible="False"
            Source="{StaticResource Panel_CelticKnot}" >
        </Image>

        <Image
            Width="20"
            Height="40"
            Margin="25,11,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="1"
            IsHitTestVisible="False"
            Source="{StaticResource Panel_CelticKnot}" >
        </Image>

        <Rectangle
                Opacity="1"
                Margin="3,56,3,0"
                SnapsToDevicePixels="True">
            <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding Divider}"
                                  Viewport="0,0,250,7.5"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>