<UserControl
    x:Class="CrusaderDE.HUD_Markers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="620"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        Width="620"
        Height="120"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>




        <Button
            Name="ScenarioBorder"
            Width="620"
            Height="120"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEb}" />

        <TextBlock
                    Width="224"
                    Margin="24,17,0,0"
                    HorizontalAlignment="Left"
                    FontSize="22"
                    Foreground="#FF000000"
                    VerticalAlignment="Top"
                    TextAlignment="Left"
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_022]}"/>
        <Button
                    Name="Signpost"
                    Width="176"
                    Margin="432,19,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_BUBBLE_HELP_TEXT_195]}"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_SIGNPOST"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowS}" />

        <Button
                    Name="Marker1"
                    Width="56"
                    Margin="12,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="1"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[0], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT1"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker2"
                    Width="56"
                    Margin="72,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="2"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[1], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT2"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker3"
                    Width="56"
                    Margin="132,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="3"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[2], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT3"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker4"
                    Width="56"
                    Margin="192,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="4"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[3], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT4"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker5"
                    Width="56"
                    Margin="252,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="5"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[4], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT5"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker6"
                    Width="56"
                    Margin="312,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="6"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[5], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT6"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker7"
                    Width="56"
                    Margin="372,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="7"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[6], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT7"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker8"
                    Width="56"
                    Margin="432,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="8"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[7], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT8"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker9"
                    Width="56"
                    Margin="492,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="9"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[8], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT9"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />
        <Button
                    Name="Marker10"
                    Width="56"
                    Margin="552,56,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    local:PropEx.TextCentre="10"
                    local:PropEx.TextLeft=""
                    local:PropEx.TextRight=""
                    local:PropEx.BorderVisibility="{Binding MarkerSelected[9], Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ButtonMECommand}"
                    CommandParameter="MAPPER_MARKER_POINT10"
                    MouseEnter="CommonRedButtonEnter"
                    Style="{StaticResource BTN_SH_GlowSB}" />

        <RadioButton
                x:Name="MarkerInvisible"
                Margin="30,0,0,10"
                Width="150"
                Height="23"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                >
            <TextBlock
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_130]}"
                    Margin="0,0,0,0"
                    FontSize="20"
                    Foreground="Black"
                    VerticalAlignment="Center">
            </TextBlock>
        </RadioButton>

        <RadioButton
                x:Name="MarkerVisible"
                Margin="230,0,0,10"
                Width="150"
                Height="23"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                >
            <TextBlock
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_131]}"
                    Margin="0,0,0,0"
                    Foreground="Black"
                    FontSize="20"
                    VerticalAlignment="Center">
            </TextBlock>
        </RadioButton>


        <RadioButton
                x:Name="MarkerDisappearing"
                Margin="430,0,0,10"
                Width="150"
                Height="23"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                >
            <TextBlock
                    Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_NEW_TEXT_132]}"
                    Margin="0,0,0,0"
                    Foreground="Black"
                    FontSize="20"
                    VerticalAlignment="Center">
            </TextBlock>
        </RadioButton>
    </Grid>

</UserControl>