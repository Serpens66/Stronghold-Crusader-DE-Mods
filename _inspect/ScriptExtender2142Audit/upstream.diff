     // The Object Cache: Maps "Music/track.wav" (The Game's Request) -> AudioClip (The Mod's .ogg)
     private Dictionary<string, AudioClip> _audioClipCache = new(StringComparer.OrdinalIgnoreCase);
+    // Music clips are unloaded by the game; retain decoded samples, not playback clips.
+    private readonly Dictionary<IndexedModResource, CachedMusic> _musicCache = new();
+
+    private sealed class CachedMusic(float[] samples, int channels, int frequency)
+    {
+        internal AudioClip CreateClip(string name)
+        {
+            int position = 0;
+            return AudioClip.Create(name, samples.Length / channels, channels, frequency, true, output =>
+            {
+                int count = Math.Min(output.Length, samples.Length - position);
+                Array.Copy(samples, position, output, 0, count);
+                if (count < output.Length) 
+                    Array.Clear(output, count, output.Length - count);
+
+                position += count;
+            },
+            frame => position = (int)Math.Min(samples.Length, Math.Max(0L, (long)frame * channels)));
+        }
+    }
+
+    private static bool IsMusicResource(string path)
+    {
+        string normalized = path.Replace('\\', '/');
+        return normalized.StartsWith("Music/", StringComparison.OrdinalIgnoreCase) || normalized.IndexOf("/Music/", StringComparison.OrdinalIgnoreCase) >= 0;
+    }
+
+    // Called on Unity's main thread after startup providers have been indexed.
+    internal void PreloadMusic()
+    {
+        foreach (KeyValuePair<string, IndexedModResource> entry in _fileIndex)
+        {
+            if (IsMusicResource(entry.Key) && (entry.Key.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase) || entry.Key.EndsWith(".wav", StringComparison.OrdinalIgnoreCase)))
+                TryCacheMusic(entry.Value, out _);
+        }
+        LogHelper.Information($"Cached {_musicCache.Count} replacement music tracks");
+    }
+
+    private bool TryCacheMusic(IndexedModResource resource, out CachedMusic? music)
+    {
+        if (_musicCache.TryGetValue(resource, out music)) 
+            return true;
+
+        AudioClip? decoded = null;
+        try
+        {
+            decoded = AudioClipExtensions.LoadAudioClipFromBytes(resource.ReadAllBytes());
+            if (decoded == null) 
+                return false;
+
+            float[] samples = new float[checked(decoded.samples * decoded.channels)];
+            if (!decoded.GetData(samples, 0))
+                return false;
+
+            music = new CachedMusic(samples, decoded.channels, decoded.frequency);
+            _musicCache[resource] = music;
+
+            return true;
+        }
+        catch (Exception ex)
+        {
+            LogHelper.Error(ex, $"Failed to cache music [{resource.Path}]");
+            return false;
+        }
+        finally
+        {
+            if (decoded != null) 
+                UnityEngine.Object.Destroy(decoded);
+        }
+    }
+
