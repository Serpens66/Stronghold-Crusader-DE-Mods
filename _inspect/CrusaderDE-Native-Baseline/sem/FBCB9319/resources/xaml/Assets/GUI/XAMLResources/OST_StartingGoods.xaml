<UserControl
    x:Class="CrusaderDE.OST_StartingGoods"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="25" />
        </Style>
        <Storyboard x:Key="CartIntro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cart" Storyboard.TargetProperty="RenderTransform.Children[0].X" Timeline.DesiredFrameRate="300">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-100" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="-100" />
                <LinearDoubleKeyFrame KeyTime="{Binding CartDuration}" Value="{Binding CartDistance}">
                </LinearDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
    </UserControl.Resources>


    <StackPanel
            Tag="Ignore"
            Visibility="{Binding OST_LeftStack_Vis, Converter={StaticResource booleanToVisibilityConverter}}">

        <Image
            x:Name="Cart"
            Width="93"
            Height="39"
            Margin="0,2"
            RenderTransformOrigin="0.5,0.5"
            HorizontalAlignment="Left"
            Visibility="{Binding OST_Cart_Vis, Converter={StaticResource booleanToVisibilityConverter}}"
            Source="{StaticResource UISprites B002}">
            <Image.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Grid
                Visibility="{Binding OST_Time_Until_Vis, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock
                Name="TimeUntilLabel"
                Margin="0,0,0,0"
                Width="180"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                TextAlignment="Center"
                Panel.ZIndex="1"
                FontSize="18"
                Foreground="#FFDDDDDD"
                Background="#55000000"
                Text="{Binding OST_Time_Until_Text}"
                Tag="Ignore">
                <TextBlock.Effect>
                    <DropShadowEffect
                         ShadowDepth="2"
                         Direction="315"
                         Color="#CC000000"
                         BlurRadius="0"/>
                </TextBlock.Effect>

            </TextBlock>

            <Rectangle
                Name="A"
                Width="160"
                Height="12"
                Margin="10,25,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="Black" />

            <Rectangle
                Name="B"
                Width="{Binding OST_Time_Until_Width}"
                Height="10"
                Margin="11,26,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="#FF54B727" />

        </Grid>

        <TextBlock
