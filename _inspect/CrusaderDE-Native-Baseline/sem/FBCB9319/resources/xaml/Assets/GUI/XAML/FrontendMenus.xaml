<UserControl
    x:Class="CrusaderDE.FrontendMenus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
            </Style>
            <Storyboard x:Key="EnlargeModern">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModernScale" Storyboard.TargetProperty="ScaleX">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.05" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModernScale" Storyboard.TargetProperty="ScaleY">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.05" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModern" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.6" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                </DoubleAnimationUsingKeyFrames>                
            </Storyboard>
            <Storyboard x:Key="ShrinkModern">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModernScale" Storyboard.TargetProperty="ScaleX">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.05" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.00" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModernScale" Storyboard.TargetProperty="ScaleY">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.05" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.00" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeModern" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.6" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="EnlargeClassic">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassicScale" Storyboard.TargetProperty="ScaleX">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.05" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassicScale" Storyboard.TargetProperty="ScaleY">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.05" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassic" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.6" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="ShrinkClassic">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassicScale" Storyboard.TargetProperty="ScaleX">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.05" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.00" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassicScale" Storyboard.TargetProperty="ScaleY">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.05" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.00" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ControlSchemeClassic" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.6" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="ShowModernKeybinds">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ModernDisplay" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.00"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.00">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseIn" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClassicDisplay" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.00">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseIn" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="ShowClassicKeybinds">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ModernDisplay" Storyboard.TargetProperty="Opacity">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1.00" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.00">
