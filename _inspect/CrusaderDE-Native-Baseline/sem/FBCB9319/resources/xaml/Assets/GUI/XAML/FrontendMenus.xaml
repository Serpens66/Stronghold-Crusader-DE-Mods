    <Grid>
        <Viewbox
            Visibility="{Binding Show_FrontMenus, Converter={StaticResource booleanToVisibilityConverter}}">
            <Image
                Margin="{Binding FrontEndVideoMargin}"
                Width="3840"
                Height="2160"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="../Images/MenusBackground.png"
                Stretch="UniformToFill"
                Visibility="{Binding Show_FrontMenus_Background_Main, Converter={StaticResource booleanToVisibilityConverter}}" />
        </Viewbox>
        <Viewbox
            Visibility="{Binding Show_FrontMenus, Converter={StaticResource booleanToVisibilityConverter}}">
            <Image
                Width="1920"
                Height="1080"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="../Images/HistoricalCampaignMenu-Background.png"
                Stretch="UniformToFill"
                FlowDirection="{Binding GlobalTextFlow}"
                Visibility="{Binding Show_FrontMenus_Background_Historical, Converter={StaticResource booleanToVisibilityConverter}}" />
        </Viewbox>        
        <Viewbox
            Visibility="{Binding Show_HUD_FrontEndVideo, Converter={StaticResource booleanToVisibilityConverter}}"
            >
            <MediaElement
                Margin="{Binding FrontEndVideoMargin}"
                Width="3840"
                Height="2160"
                Name="FrontendBackVideo"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LoadedBehavior="Manual"
                UnloadedBehavior="Close"
                Stretch="UniformToFill"
                >
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Loaded">
                        <noesis:PlayMediaAction />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </MediaElement>
        </Viewbox>
        <Viewbox>
            <Grid
                Width="1920"
                Height="1080"
                Margin="0"
                Visibility="{Binding Show_FrontMenus, Converter={StaticResource booleanToVisibilityConverter}}"
                >

                <Image
                    Name="Basemap"
                    Width="1920"
                    Height="1080"
                    Margin="0,0,0,0"
                    FlowDirection="{Binding GlobalTextFlow}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding Show_FrontMenusTrailsBackground, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="../Images/SkirmishTrail-Background.png"
                    Stretch="UniformToFill" />
                <Image
                    Name="Basemap2"
                    Width="1920"
                    Height="1080"
                    Margin="0,0,0,0"
                    FlowDirection="{Binding GlobalTextFlow}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding Show_FrontMenusTrailsSandsBackground, Converter={StaticResource booleanToVisibilityConverter}}"
                    Source="../Images/SkirmishTrail-Sands-Background.png"
                    Stretch="UniformToFill" />
                <!-- DEMOSTART -->
                <Image
                    Name="DemoWishlistScreen"
                    Width="1920"
                    Height="1080"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding Show_Frontend_Wish , Converter={StaticResource booleanToVisibilityConverter}}"
                     />
                <Image
                    Name="RoadmapScreen"
                    Width="1920"
                    Height="1080"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="../Images/Roadmap.png"
                    FlowDirection="{Binding GlobalTextFlowAL2R}"
                    Visibility="{Binding Show_Frontend_Roadmap, Converter={StaticResource booleanToVisibilityConverter}}" />
                <!-- DEMOEND -->

                <Grid
                    FlowDirection="LeftToRight">
                    <Image
                        Name="LogoMain"
                        Width="1050"
                        Height="202"
                        Margin="10,10,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="{Binding Show_Frontend_Logo , Converter={StaticResource booleanToVisibilityConverter}}"
                         />
                </Grid>

                <TextBlock
                    Margin="2"
                    Width="200"
                    Height="20"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="14"
                    Opacity="0.4"
                    Text="{Binding VersionString}"
                      />

                <!-- NOTDEMOSTART -->
                <!-- Main Menu -->
                <Grid
                    FlowDirection="LeftToRight"
                    Visibility="{Binding Show_Frontend_MainMenu , Converter={StaticResource booleanToVisibilityConverter}}">
                    <Grid
                        Margin="1082,40,220,0">
                        
                        <!-- Skirmish Button -->
                        <Button
                            Name="MainMenu_CombatButton"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            local:PropEx.TextCentre="{Binding GameTexts[TEXT_NEW_CTEXT_198], Source={x:Static local:Translate.Instance}}"
                            local:PropEx.TextLeft=""
                            local:PropEx.TextRight=""
                            local:PropEx.Sprite1="{StaticResource shield_campaign}"
                            local:PropEx.Sprite1Margin="{Binding FrontEndButtonMargin}"
                            local:PropEx.FrontEndButtonFontSize="{Binding DemoFrontEndButtonFontSize}"
                            local:PropEx.FrontEndButtonLineHeight="{Binding FrontEndButtonLineHeight}"
                            Command="{Binding ButtonMainMenuCommand}"
                            CommandParameter="Skirmish"
                            MouseEnter="MouseEnterMainButtonHandler"
                            MouseLeave="MouseLeaveMainButtonHandler"
                            Typography.Capitals="SmallCaps"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource BTN_NewFrontend}">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1.00" ScaleY="1.00" x:Name="MainMenu_CombatButtonScale" />
                            </Button.RenderTransform>
                        </Button>
                        <Image
                            Margin="550,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Width="25"
                            IsHitTestVisible="False"
                            Visibility="{Binding DLC4PIP1, Converter={StaticResource booleanToVisibilityConverter}}"
                            Source="{StaticResource Notification}" />
                        <DockPanel
                            Background="#00000000"
                            LastChildFill="True"
                            Width="500"
                            Margin="-1000,20,630,0"
                            Height="Auto"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{Binding Show_FrontEndCombat_Skirmish_Help, Converter={StaticResource booleanToVisibilityConverter}}">
                            <Grid>
                                <Border
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="#cc000000"
                                    BorderBrush="#FF816D18"
                                    CornerRadius="4"
                                    BorderThickness="2" />
                                <StackPanel>
                                    <TextBlock
                                        Width="480"
                                        FontSize="28"
                                        Margin="10,3,10,0"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Foreground="White"
                                        Text="{Binding GameTexts[TEXT_NEW_CTEXT_198], Source={x:Static local:Translate.Instance}}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect
                                                ShadowDepth="2"
