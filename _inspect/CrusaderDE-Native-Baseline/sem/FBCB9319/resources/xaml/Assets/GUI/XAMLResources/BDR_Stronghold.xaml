    <Style x:Key="BDR_SH1DEa" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                        FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>

                        <Rectangle
                            Name="BDR_CentreCentre"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Opacity="0.89"
                            Margin="2,2,2,2"
                            SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource Panel_BG}"
                                  Viewport="0,0,256,256"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Center"
                                  TileMode="Tile" />
                            </Rectangle.Fill>
                        </Rectangle>
                            
                        <Image
                            Name="BDR_TopLeft"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="30"
                            Height="30"
                            Opacity="1"
                            Margin="-18,-18,0,0"
                            Source="{StaticResource Panel_Corner_Top_Left}" />
                        <Rectangle
                            Name="BDR_TopCentre"
                            Grid.Row="0"
                            Grid.Column="1"
                            Opacity="1"
                            Margin="-1,-18,-1,0"
                            SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource Panel_Border_Top}"
                                  Viewport="0,0,250,30"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Top"
                                  TileMode="Tile" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image
                            Name="BDR_TopRight"
                            Grid.Row="0"
                            Grid.Column="2"
                            Opacity="1"
                            SnapsToDevicePixels="True"
                            Margin="0,-18,-18,0"
                            Source="{StaticResource Panel_Corner_Top_Right}" />
                        <Rectangle
                            Name="BDR_CentreLeft"
                            Grid.Row="1"
                            Grid.Column="0"
                            Opacity="1"
                            Margin="-18,-1,0,-1"
                            SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource Panel_Border_Left}"
                                  Viewport="0,0,30,250"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Left"  
                                  AlignmentY="Center"
                                  TileMode="Tile" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle
                            Name="BDR_CentreRight"
                            Grid.Row="1"
                            Grid.Column="2"
                            Opacity="1"
                            Margin="0,-1,-18,-1"
                            SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource Panel_Border_Right}"
                                  Viewport="0,0,30,250"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Right"  
                                  AlignmentY="Center"
                                  TileMode="Tile" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image
                            Name="BDR_BottomLeft"
                            Grid.Row="2"
                            Grid.Column="0"
                            Opacity="1"
                            SnapsToDevicePixels="True"
                            Margin="-18,0,0,-18"
                            Source="{StaticResource Panel_Corner_Bottom_Left}" />
                        <Rectangle
                            Name="BDR_BottomCentre"
                            Grid.Row="2"
                            Grid.Column="1"
                            Opacity="1"
                            Margin="-1,0,-1,-18"
                            SnapsToDevicePixels="True">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource Panel_Border_Bottom}"
                                  Viewport="0,0,250,30"
                                  ViewportUnits="Absolute" 
                                  AlignmentX="Center"  
                                  AlignmentY="Bottom"
                                  TileMode="Tile" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image
                            Name="BDR_BottomRight"
                            Grid.Row="3"
                            Grid.Column="2"
                            Opacity="1"
                            SnapsToDevicePixels="True"
                            Margin="0,0,-18,-18"
                            Source="{StaticResource Panel_Corner_Bottom_Right}" />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

