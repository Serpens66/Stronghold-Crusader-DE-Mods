<UserControl
    x:Class="CrusaderDE.HUD_Tutorial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="booleanToVisibilityConverter" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FlowDirection" Value="{Binding GlobalTextFlowAL2R}" />
        </Style>

    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        Width="720"
        Height="200"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#a0000000"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Button
            Width="720"
            Height="200"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource BDR_SH1DEc}" />

        <TextBlock
            Width="668"
            Margin="0,17,0,0"
            HorizontalAlignment="Center"
            FontSize="22"
            Foreground="#FFDDDDDD"
            VerticalAlignment="Top"
            TextAlignment="Center"
            Text="{Binding TutorialHeading}" />
        <TextBlock
            Width="668"
            Height="95"
            Margin="0,50,0,50"
            LineStackingStrategy="BlockLineHeight"
            LineHeight="22"
            HorizontalAlignment="Center"
            FontSize="18"
            Foreground="#FFDDDDDD"
            VerticalAlignment="Top"
            TextAlignment="Center"
            TextWrapping="WrapWithOverflow"
            Text="{Binding TutorialBody}" />
        <StackPanel
            Margin="44, 0, 44, 26"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Button
                Name="ContinueButton"
                Width="183"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding TutorialButton1Text}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Visibility="{Binding TutorialButton1Visible, Converter={StaticResource booleanToVisibilityConverter}}"
                Command="{Binding ButtonTutorialCommand}"
                CommandParameter="1"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />
            <Button
                Name="ExitButton"
                Width="183"
                Margin="200,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding TutorialButton2Text}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding ButtonTutorialCommand}"
                CommandParameter="2"
                MouseEnter="CommonRedButtonEnter"
                Visibility="{Binding TutorialButton2Visible, Converter={StaticResource booleanToVisibilityConverter}}"
                Style="{StaticResource BTN_SH_GlowS}" />
        </StackPanel>
    </Grid>

</UserControl>