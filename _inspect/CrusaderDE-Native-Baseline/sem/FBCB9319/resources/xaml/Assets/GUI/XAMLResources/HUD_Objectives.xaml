<UserControl
    x:Class="CrusaderDE.HUD_Objectives"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        Width="400"
        Height="200"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00000000"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>




<!--        <Button
            Width="400"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Style="{StaticResource BDR_SH1DEd}" />
-->
        <Border
            BorderBrush="#00000000" BorderThickness="1" CornerRadius="12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Width="480"
            Margin="-80,0,0,-30"
            Background="#77000000"
            >

        </Border>
        <StackPanel
            Name="ObjectiveStackPanel"
            FlowDirection="{Binding GlobalTextFlowAL2R}"
            Margin="20,0,0,0"
            >
            <Grid
                Name="ObjectiveTimer"
                Margin="0,-5,0,-5"
                VerticalAlignment="Top">
                <TextBlock
                    Height="30"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Foreground="#FFEFF3C6"
                    FontSize="18"
                    Text="{Binding ObjectiveTimerText}" />

                <Rectangle
                    Width="206"
                    Height="18"
                    Margin="148,39,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    StrokeThickness="0">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#1e1c10"></SolidColorBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle
                    Name="TimerFill"
                    Width="{Binding ObjectiveTimerWidth}"
                    Height="12"
                    Margin="151,42,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    StrokeThickness="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="1" Color="#FF0B290F" />
                            <GradientStop Offset="0.004" Color="#FF26922f" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle
                    Name="Timer"
                    Width="204"
                    Height="16"
                    Margin="149,40,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stroke="#FFEBE6B5"
                    StrokeThickness="2" />

            </Grid>            
        <local:WGT_Objective
                x:Name="WGT_Objective1"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="AB"
                TypeText="TA" />
        <local:WGT_Objective
                x:Name="WGT_Objective2"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        <local:WGT_Objective
                x:Name="WGT_Objective3"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        <local:WGT_Objective
                x:Name="WGT_Objective4"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        <local:WGT_Objective
                x:Name="WGT_Objective5"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        <local:WGT_Objective
                x:Name="WGT_Objective6"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        <local:WGT_Objective
                x:Name="WGT_Objective7"
                Margin="0,-10,0,-13"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#FFEFF3C6"
                AmountText="A"
                TypeText="T" />
        </StackPanel>
    </Grid>

</UserControl>