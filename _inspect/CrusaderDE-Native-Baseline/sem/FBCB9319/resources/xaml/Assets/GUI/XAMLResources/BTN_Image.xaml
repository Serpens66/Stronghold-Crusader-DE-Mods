<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">


    <Style x:Key="BTN_Image" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowDuration" Value="2500" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="1000" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid
                        x:Name="BaseGrid"
                        Visibility="{TemplateBinding local:PropEx.ButtonVisibility}"
                        RenderTransformOrigin="0.5,0.5"
                        UseLayoutRounding="False">

                        <Border x:Name="HitBox" Background="#00ff0000" />


                        <Image
                            x:Name="SpriteInactive"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            FlowDirection="{TemplateBinding local:PropEx.ImageFlow}"
                            Source="{TemplateBinding local:PropEx.Sprite1}"
                            Visibility="Visible" />

                        <Image
                            x:Name="SpriteMouseOver"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            FlowDirection="{TemplateBinding local:PropEx.ImageFlow}"
                            Source="{TemplateBinding local:PropEx.Sprite2}"
                            Visibility="Hidden" />

                        <Image
                            x:Name="SpriteMousePressed"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            FlowDirection="{TemplateBinding local:PropEx.ImageFlow}"
                            Source="{TemplateBinding local:PropEx.Sprite3}"
                            Visibility="Hidden" />

                        <Image
                            x:Name="SpriteLocked"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.0,0.0"
                            Opacity="{TemplateBinding local:PropEx.ImageButtonDisabledOpacity}"
                            FlowDirection="{TemplateBinding local:PropEx.ImageFlow}"
                            Source="{TemplateBinding local:PropEx.Sprite4}"
                            Visibility="Hidden" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="HitBox" Property="IsHitTestVisible" Value="True" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="HitBox" Property="IsHitTestVisible" Value="True" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SpriteLocked" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HitBox" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
