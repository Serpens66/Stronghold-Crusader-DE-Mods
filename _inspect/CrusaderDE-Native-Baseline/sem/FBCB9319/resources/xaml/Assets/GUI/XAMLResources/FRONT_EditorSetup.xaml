            Visibility="{Binding Show_EditorWorkshop_Requester, Converter={StaticResource booleanToVisibilityConverter}}" />

        <Grid
            Visibility="{Binding Show_EditorWorkshop_Requester, Converter={StaticResource booleanToVisibilityConverter}}">
            <DockPanel
                Width="Auto"
                LastChildFill="True"
                Height="530"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#00000000"
                UseLayoutRounding="True">
                <Grid>
                    <Button
