                                        local:PropEx.Sprite4="{StaticResource Face 02}"
                                        Command="{Binding MapEditorSetupCommand}"
                                        CommandParameter="Lord_02"
                                        Style="{StaticResource BTN_Image}">
                                    </Button>
                                </Grid>
                                <Grid
                                    Margin="0,0,3,3"
                                    Width="50"
                                    Height="50"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Image
                                        IsHitTestVisible="False"
                                        Source="{StaticResource Face Background Generic}" />
                                    <Button
                                        local:PropEx.Sprite1="{StaticResource Face 03}"
                                        local:PropEx.Sprite2="{StaticResource Face 03}"
                                        local:PropEx.Sprite3="{StaticResource Face 03}"
                                        local:PropEx.Sprite4="{StaticResource Face 03}"
                                        Command="{Binding MapEditorSetupCommand}"
                                        CommandParameter="Lord_03"
                                        Style="{StaticResource BTN_Image}">
