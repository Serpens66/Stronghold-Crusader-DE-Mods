                    <StackPanel
                        Orientation="Horizontal">
                        <Grid
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="50,120,50,0"
                            Width="500"
                            Height="330">
                            <Button
                                Margin="-3,-3,-3,-3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Style="{StaticResource BDR_SH1DEb}" />
                            <ListView
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Name="UploadList"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ItemContainerStyle="{StaticResource Standalone_ListViewItem}">
                                <ListView.View>
                                    <GridView
                                        ColumnHeaderContainerStyle="{StaticResource HiddenStyle}">
                                        <GridViewColumn
                                            Width="40">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader
                                                    Template="{StaticResource MyGridViewColumnHeader}"
                                                    Tag="Type"></GridViewColumnHeader>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image
                                                        Width="30"
                                                        Margin="-2,0,0,0"
                                                        Source="{Binding TypeImage}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn
                                            Width="420">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader
                                                    Template="{StaticResource MyGridViewColumnHeader}"
                                                    Tag="Name">Name</GridViewColumnHeader>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,-4,0,-4"
                                                        HorizontalAlignment="Left"
                                                        Foreground="Black"
                                                        FlowDirection="{Binding GlobalTextFlowAL2R}"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="16"
                                                        Text="{Binding Text1}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn
                                            Width="40">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader
                                                    Template="{StaticResource MyGridViewColumnHeader}"
                                                    Tag="Count">#</GridViewColumnHeader>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,0,0,0"
                                                        Width="25"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Foreground="Black"
                                                        TextAlignment="Right"
                                                        FlowDirection="{Binding GlobalTextFlowAL2R}"
                                                        FontSize="16"
                                                        Text="{Binding Text2}">
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
