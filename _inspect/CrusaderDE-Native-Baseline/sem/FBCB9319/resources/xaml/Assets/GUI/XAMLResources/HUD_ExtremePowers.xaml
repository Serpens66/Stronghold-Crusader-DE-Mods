            Margin="0,0,15,100"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsEnabled="{Binding ExtremePower5_Enabled}"
            local:PropEx.Sprite1="{StaticResource extreme power 5a}"
            local:PropEx.Sprite2="{StaticResource extreme power 5c}"
            local:PropEx.Sprite3="{StaticResource extreme power 5c}"
            local:PropEx.Sprite4="{StaticResource extreme power 5b}"
            Command="{Binding ButtonExtremeCommand}"
