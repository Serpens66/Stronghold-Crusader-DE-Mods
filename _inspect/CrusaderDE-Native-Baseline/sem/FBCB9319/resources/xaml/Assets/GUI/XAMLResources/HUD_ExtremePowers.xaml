            HorizontalAlignment="Right"
            Background="White"
            Height="1"
            Width="5" />
        <Button
            Width="20"
            Height="20"
            Margin="0,0,15,122"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
