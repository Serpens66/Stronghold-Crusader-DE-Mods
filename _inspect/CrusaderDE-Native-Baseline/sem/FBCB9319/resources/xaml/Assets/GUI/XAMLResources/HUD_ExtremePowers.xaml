                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Button>

        <Grid
            Margin="0,0,10,154"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Background="White"
            Height="1"
            Width="5" />
        <Button
            Width="20"
            Height="20"
            Margin="0,0,15,144"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsEnabled="{Binding ExtremePower7_Enabled}"
            local:PropEx.Sprite1="{StaticResource extreme power 7a}"
            local:PropEx.Sprite2="{StaticResource extreme power 7c}"
            local:PropEx.Sprite3="{StaticResource extreme power 7c}"
            local:PropEx.Sprite4="{StaticResource extreme power 7b}"
            Command="{Binding ButtonExtremeCommand}"
            CommandParameter="6"
            Style="{StaticResource BTN_Image}" >
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
                    <b:InvokeCommandAction Command="{Binding ButtonExtremeEnterCommand}" CommandParameter="6" />
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseLeave">
                    <b:InvokeCommandAction Command="{Binding ButtonExtremeLeaveCommand}" CommandParameter="6" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Button>

        <Grid
            Margin="0,0,10,176"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Background="White"
            Height="1"
            Width="5" />
        <Button
            Width="20"
            Height="20"
            Margin="0,0,15,166"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsEnabled="{Binding ExtremePower8_Enabled}"
            local:PropEx.Sprite1="{StaticResource extreme power 8a}"
            local:PropEx.Sprite2="{StaticResource extreme power 8c}"
            local:PropEx.Sprite3="{StaticResource extreme power 8c}"
            local:PropEx.Sprite4="{StaticResource extreme power 8b}"
