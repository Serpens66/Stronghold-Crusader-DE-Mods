            local:PropEx.Sprite4="{StaticResource extreme power 6b}"
            Command="{Binding ButtonExtremeCommand}"
            CommandParameter="5"
            Style="{StaticResource BTN_Image}" >
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
