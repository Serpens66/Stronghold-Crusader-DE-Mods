<UserControl
    x:Class="CrusaderDE.HUD_ExtremePowers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="80"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        
        <Storyboard x:Key="Story_ShowExtremeHelp">
            <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="ExtremeHelpText" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.0" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:25.0" Value="{x:Static Visibility.Hidden}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="ExtremeHelpArrow" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.0" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:25.0" Value="{x:Static Visibility.Hidden}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid
        Height="240"
        Tag="Ignore"
            >
        <TextBlock
            Name="ExtremeHelpText"
            Width="150"
            Foreground="White"
            Text="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_EXTREME_DEMO_008]}"
            TextWrapping="Wrap"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Hidden"
            IsHitTestVisible="False"
            Margin="0,200,65,-150">
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="2"
                    Direction="315"
                    Color="#CC000000"
                    BlurRadius="0" />
            </TextBlock.Effect>
        </TextBlock>
        <Image
            Name="ExtremeHelpArrow"
            Width="30"
            Margin="0,210,40,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Hidden"
            IsHitTestVisible="False"
            Source="{StaticResource extreme arrow}" />

        <Grid 
            Margin="0,0,2,0"
            Background="White"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Height="240"
            Width="8"
            IsHitTestVisible="False"
              >
            <Grid
                Margin="1,1,1,1"
                Background="Black"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
                <Grid
                    Margin="1,1,1,1"
                    Background="White"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Height="{Binding ExtremePoints}"
                    Width="4">
                </Grid>
            </Grid>
        </Grid>
        <Grid 
            Margin="0,0,10,22"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Background="White"
            Height="1"
            Width="5"
            />
        <Button
            Width="20"
            Height="20"
            Margin="0,0,15,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsEnabled="{Binding ExtremePower1_Enabled}"
            local:PropEx.Sprite1="{StaticResource extreme power 1a}"
            local:PropEx.Sprite2="{StaticResource extreme power 1c}"
            local:PropEx.Sprite3="{StaticResource extreme power 1c}"
            local:PropEx.Sprite4="{StaticResource extreme power 1b}"
            Command="{Binding ButtonExtremeCommand}"
            CommandParameter="0"
            Style="{StaticResource BTN_Image}">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
                    <b:InvokeCommandAction Command="{Binding ButtonExtremeEnterCommand}" CommandParameter="0" />
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseLeave">
                    <b:InvokeCommandAction Command="{Binding ButtonExtremeLeaveCommand}" CommandParameter="0" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Button>

        <Grid
            Margin="0,0,10,44"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Background="White"
            Height="1"
            Width="5" />
        <Button
            Width="20"
            Height="20"
            Margin="0,0,15,34"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsEnabled="{Binding ExtremePower2_Enabled}"
            local:PropEx.Sprite1="{StaticResource extreme power 2a}"
            local:PropEx.Sprite2="{StaticResource extreme power 2c}"
            local:PropEx.Sprite3="{StaticResource extreme power 2c}"
            local:PropEx.Sprite4="{StaticResource extreme power 2b}"
