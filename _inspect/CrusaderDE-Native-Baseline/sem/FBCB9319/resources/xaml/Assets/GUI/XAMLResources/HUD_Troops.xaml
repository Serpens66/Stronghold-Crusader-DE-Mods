                Height="37"
                Margin="80,0,0,43"
                local:PropEx.Sprite1="{StaticResource UI-Buttons J003}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons J002}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons J001}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons J003}"
