                Name="UnitAttackHere"
                Width="37"
                Height="37"
                Margin="2,40,83,3">
                <Button
                    local:PropEx.Sprite1="{StaticResource UI-Buttons J016}"
                    local:PropEx.Sprite2="{StaticResource UI-Buttons J017}"
                    local:PropEx.Sprite3="{StaticResource UI-Buttons J018}"
                    local:PropEx.Sprite4="{StaticResource UI-Buttons J016}"
                    Command="{Binding ButtonUnitAttackHereCommand}"
                    Content=""
                    Style="{StaticResource BTN_Image}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger
                            EventName="MouseEnter">
                            <b:InvokeCommandAction
                                Command="{Binding ButtonTroopPanelMouseEnterCommand}"
                                CommandParameter="UnitAttackHere" />
                        </b:EventTrigger>
                        <b:EventTrigger
                            EventName="MouseLeave">
                            <b:InvokeCommandAction
                                Command="{Binding ButtonTroopPanelMouseLeaveCommand}"
                                CommandParameter="UnitAttackHere" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
                <TextBlock
                    Text="{Binding AmmoLeft}"
                    Width="34"
                    VerticalAlignment="Top"
                    Margin="4,0,0,0"
                    TextAlignment="Left"
                    FontSize="16"
                    IsHitTestVisible="False"
                    Foreground="Black" />
            </Grid>
