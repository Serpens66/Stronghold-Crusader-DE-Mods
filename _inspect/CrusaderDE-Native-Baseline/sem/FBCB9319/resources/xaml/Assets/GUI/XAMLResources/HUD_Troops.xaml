<UserControl
    x:Class="CrusaderDE.HUD_Troops"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CrusaderDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance {x:Type local:MainViewModel},
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="155"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="booleanToVisibilityConverter" />
        <Style
            TargetType="{x:Type TextBlock}">
            <Setter
                Property="FontSize"
                Value="24" />
            <Setter
                Property="HorizontalAlignment"
                Value="Left" />
            <Setter
                Property="Foreground"
                Value="#FFDDDDDD" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger
            RoutedEvent="FrameworkElement.Loaded" />
    </UserControl.Triggers>

    <Grid
        x:Name="LayoutRoot"
        Width="800"
        Height="155"
        Background="#00E2F383"
        Tag="IgnoreSelf"
        UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>





        <!--  Picture Frame troops  -->
        <Grid
            Name="MainFrameTroops"
            Width="800"
            Height="155"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False">
            <Image
                Width="800"
                Height="155"
                IsHitTestVisible="True"
                RenderTransformOrigin="0.5,0.5"
                FlowDirection="{Binding GlobalTextFlow}"
                Source="{StaticResource UI-HUD 006}">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform
                            Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <TextBlock
            x:Name="TroopsPanelRollover"
            Padding="4,2,4,0"
            Margin="140,3,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            FontSize="16"
            Foreground="#FFDDDDDD"
            Background="#55000000"
            FlowDirection="{Binding GlobalTextFlowAL2R}"
            Tag="Ignore">
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="2"
                    Direction="315"
                    Color="#CC000000"
                    BlurRadius="0" />
            </TextBlock.Effect>
            <Run
                Text="{Binding TroopsPanelRollover}" /><!--
         --><Run
                Text="{Binding TroopsPanelRollover_AmountReq1}" /><!--
         --><InlineUIContainer><Image
                    Source="{Binding TroopsPanelRollover_GoodsImage1}"
                    Height="18"
                    Margin="0" /></InlineUIContainer><!--
         --><Run
                Text="{Binding TroopsPanelRollover_AmountGot1}" />
        </TextBlock>

        <TextBlock
            x:Name="TroopsPanelRollover2"
            Padding="4,2,4,0"
            Margin="140,-400,0,127"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            FontSize="16"
            MaxWidth="380"
            TextWrapping="Wrap"
            Foreground="#FFDDDDDD"
            Background="#55000000"
            FlowDirection="{Binding GlobalTextFlowAL2R}"
            Tag="Ignore">
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="2"
                    Direction="315"
                    Color="#CC000000"
                    BlurRadius="0" />
            </TextBlock.Effect>
            <Run
                Text="{Binding TroopsPanelRollover}" /><LineBreak /><!--
         --><Run
                FontSize="12"
                Foreground="#FFEFF3C6"
                Text="{Binding TroopsPanelRollover_AmountGot1}" />
        </TextBlock>

        <Button
            Name="ToggleControlGroups"
            Width="35"
            Height="35"
            Margin="519,11,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="2"
            local:PropEx.Sprite1="{StaticResource Control_Group}"
            local:PropEx.Sprite2="{StaticResource Control_Group_Highlight}"
            local:PropEx.Sprite3="{StaticResource Control_Group_Highlight}"
            local:PropEx.Sprite4="{StaticResource Control_Group_Highlight}"
            Command="{Binding ButtonTroopPanelToggleCGCommand}"
            CommandParameter="ToggleCG"
            Style="{StaticResource BTN_Image}">
            <b:Interaction.Triggers>
                <b:EventTrigger
                    EventName="MouseEnter">
                    <b:InvokeCommandAction
                        Command="{Binding ButtonTroopPanelMouseEnterCommand}"
                        CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type Button}}}" />
                </b:EventTrigger>
                <b:EventTrigger
                    EventName="MouseLeave">
                    <b:InvokeCommandAction
                        Command="{Binding ButtonTroopPanelMouseLeaveCommand}"
                        CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type Button}}}" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Button>

        <!--  Stance Tabs  -->
        <StackPanel
            Name="StanceTabs"
            Width="150"
            Height="64"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#00E2F383"
            Orientation="Horizontal">
            <RadioButton
                Name="GuardStanceButton"
                Width="46"
                Height="65"
                Margin="0,0,0,0"
                local:PropEx.Sprite1="{StaticResource UI-Buttons I001}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons I002}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons I003}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons I001}"
                IsChecked="{Binding GuardStanceActive}"
                Command="{Binding ButtonChangeStanceCommand}"
                CommandParameter="1"
                Content=""
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseEnterCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseLeaveCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>
            <RadioButton
                Name="DefensiveStanceButton"
                Width="40"
                Height="46"
                Margin="0,18,0,0"
                local:PropEx.Sprite1="{StaticResource UI-Buttons I004}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons I005}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons I006}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons I004}"
                IsChecked="{Binding DefensiveStanceActive}"
                Command="{Binding ButtonChangeStanceCommand}"
                CommandParameter="2"
                Content=""
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseEnterCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseLeaveCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>
            <RadioButton
                Name="AggressiveStanceButton"
                Width="43"
                Height="50"
                Margin="0,14,0,0"
                local:PropEx.Sprite1="{StaticResource UI-Buttons I007}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons I008}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons I009}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons I007}"
                IsChecked="{Binding AggressiveStanceActive}"
                Command="{Binding ButtonChangeStanceCommand}"
                CommandParameter="3"
                Content=""
                Style="{StaticResource BTN_RADIO_Image}">
                <b:Interaction.Triggers>
                    <b:EventTrigger
                        EventName="MouseEnter">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseEnterCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                    <b:EventTrigger
                        EventName="MouseLeave">
                        <b:InvokeCommandAction
                            Command="{Binding ButtonTroopPanelMouseLeaveCommand}"
                            CommandParameter="{Binding Path=Name, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type RadioButton}}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </RadioButton>
        </StackPanel>

