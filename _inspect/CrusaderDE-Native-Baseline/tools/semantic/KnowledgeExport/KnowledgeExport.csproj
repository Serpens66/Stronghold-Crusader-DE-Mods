<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(NativeKnowledgeSourceRoot)/*.cs" Link="Catalog/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireCatalog" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NativeKnowledgeSourceRoot)/NativeFieldCatalog.Data.cs')" Text="Supply NativeKnowledgeSourceRoot pointing to the actual catalog sources." />
  </Target>
</Project>
