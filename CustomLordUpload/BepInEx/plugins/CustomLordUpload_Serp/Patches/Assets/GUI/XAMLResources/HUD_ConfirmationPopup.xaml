<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- COMPATIBILITY: Recheck this unique Vanilla binding XPath after game UI or Script Extender XAML updates. -->
  <Operation Type="Replace" XPath="//n:TextBlock[@Text='{Binding ConfirmationMessage}']">
    <Content>
      <ScrollViewer x:Name="CustomLordUploadWarningScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Margin="8,0,8,0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   FontSize="24"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="Black"
                   Text="{Binding ConfirmationMessage}" />
      </ScrollViewer>
    </Content>
  </Operation>
</Patch>
