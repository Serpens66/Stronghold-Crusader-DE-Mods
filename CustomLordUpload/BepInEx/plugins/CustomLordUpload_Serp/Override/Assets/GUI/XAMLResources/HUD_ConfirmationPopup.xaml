        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>


        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#FFEFF3C6" />
        </Style>

    </UserControl.Resources>
<!--
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Outtro}" />
        </EventTrigger>
    </UserControl.Triggers>
-->

    <Grid
        x:Name="LayoutRoot"
        Width="{Binding ConfirmationPanelWidth}"
        Height="{Binding ConfirmationPanelHeight}"

        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#00000000"
        UseLayoutRounding="True">
<!--        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions> -->
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Button
            Name="ScenarioBorder"
            Width="{Binding ConfirmationPanelWidth}"
            Height="{Binding ConfirmationPanelHeight}"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BDR_SH1DEa}" />

        <local:WGT_Heading
            x:Name="ConfirmationHeader"
            Width="{Binding ConfirmationPanelWidth}"
            Margin="0,0,0,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Divider="{StaticResource Panel_Divider}"
            HeadingText="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_002]}" />

        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="0,68,0,72"
            Width="{Binding ConfirmationPanelWidth2}"
            >
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    Margin="8,0,8,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="24"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="Black"
                    Text="{Binding ConfirmationMessage}"
                    />
            </ScrollViewer>
        </Grid>

        <!--  Side Buttons & Controls  -->
        <Grid
            Name="YesNo">
            <Button
                Width="100"
                Margin="80,0,0,42"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_023]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding ButtonConfirmationCommand}"
                CommandParameter="1"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />

            <Button
                Width="100"
                Margin="0,0,80,42"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_GAME_OPTIONS_024]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding ButtonConfirmationCommand}"
                CommandParameter="2"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />

        </Grid>
        <Grid
            Name="OK">
            <Button
                Width="100"
                Margin="0,0,0,42"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                local:PropEx.TextCentre="{Binding Source={x:Static local:Translate.Instance}, Path=GameTexts[TEXT_MAINOPTIONS_009]}"
                local:PropEx.TextLeft=""
                local:PropEx.TextRight=""
                Command="{Binding ButtonConfirmationCommand}"
                CommandParameter="-1"
                MouseEnter="CommonRedButtonEnter"
                Style="{StaticResource BTN_SH_GlowS}" />
        </Grid>

        <CheckBox
            x:Name="ConfirmCheck"
            Margin="0,0,0,10"
            Height="23"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Style="{StaticResource CheckBox_Template}">
            <TextBlock
                x:Name="ConfirmCheckText"
                Text="{Binding ConfirmationCheckLabel}"
                Margin="0,2,0,-2"
                FontSize="20"
                Foreground="Black"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        </CheckBox>
    </Grid>
</UserControl>
