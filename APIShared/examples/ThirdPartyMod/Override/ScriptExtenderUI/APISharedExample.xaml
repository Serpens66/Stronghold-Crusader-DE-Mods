<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:APIShared.ModSettings;assembly=APIShared" xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <ScrollViewer.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#FF181818" />
      <Setter Property="Foreground" Value="#FFF5F5F5" />
      <Setter Property="BorderBrush" Value="#FFAAAAAA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}" />
      <Setter Property="MaxWidth" Value="{x:Static shared:ToolTipPresentation.MaximumWidth}" />
      <Setter Property="ContentTemplate">
        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
      </Setter>
    </Style>
  </ScrollViewer.Resources>
  <StackPanel Margin="16">
    <TextBlock Text="HOST OPTIONS" />
    <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <CheckBox Content="Enable example" IsChecked="{Binding EnableMod}" ToolTip="Allows the host to activate this example." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <TextBlock Text="CLIENT OPTIONS" Margin="0,12,0,0" />
    <StackPanel IsEnabled="{Binding CanEditClientSettings}">
      <CheckBox Content="Show overlay" IsChecked="{Binding ShowOverlay}" ToolTip="Local presentation preference, stored in personal presets." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="{Binding System_PresetLoadText}" Command="{Binding System_OpenPresetLoadCommand}" IsEnabled="{Binding CanChangePreset}" ToolTip="Load settings from an available preset." ToolTipService.ShowDuration="60000" />
      <Button Content="{Binding System_PresetSaveText}" Command="{Binding System_OpenPresetSaveCommand}" ToolTip="Save selected settings to a personal preset." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <StackPanel Visibility="{Binding System_PresetLoadPanelVisibility}" Margin="0,8,0,0">
      <ComboBox ItemsSource="{Binding System_PresetLoadEntries}" SelectedItem="{Binding System_SelectedPresetLoadEntry}" DisplayMemberPath="DisplayText" ToolTip="Choose the preset to load." ToolTipService.ShowDuration="60000" />
      <Button Content="{Binding System_PresetLoadConfirmText}" Command="{Binding System_ConfirmPresetLoadCommand}" ToolTip="Apply this preset as the editable working settings." ToolTipService.ShowDuration="60000" />
      <Button Content="{Binding System_PresetLoadCancelText}" Command="{Binding System_CancelPresetLoadCommand}" ToolTip="Close the preset selection." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <StackPanel Visibility="{Binding System_PresetSavePanelVisibility}" Margin="0,8,0,0">
      <ComboBox ItemsSource="{Binding System_PresetSaveTargets}" SelectedItem="{Binding System_SelectedPresetSaveTarget}" DisplayMemberPath="DisplayText" ToolTip="Create a personal preset or select one you own to overwrite." ToolTipService.ShowDuration="60000" />
      <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_PresetSaveName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of the personal preset." ToolTipService.ShowDuration="60000" />
      <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_PresetSaveDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Description of the personal preset." ToolTipService.ShowDuration="60000" />
      <ComboBox ItemsSource="{Binding System_PresetSaveBulkModeOptions}" SelectedIndex="{Binding System_PresetSaveBulkModeIndex}" ToolTip="Choose which host and client settings to include." ToolTipService.ShowDuration="60000" />
      <Button Content="{Binding System_PresetSaveConfirmText}" Command="{Binding System_ConfirmPresetSaveCommand}" IsEnabled="{Binding System_CanConfirmPresetSave}" ToolTip="Save the selected values to this personal preset." ToolTipService.ShowDuration="60000" />
      <Button Content="{Binding System_PresetSaveCancelText}" Command="{Binding System_CancelPresetSaveCommand}" ToolTip="Close the preset editor." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <StackPanel Visibility="{Binding System_PresetInlineConfirmationVisibility}" Margin="0,8,0,0">
      <TextBlock Text="{Binding System_PresetInlineConfirmationMessage}" TextWrapping="Wrap" />
      <Button Content="Confirm" Command="{Binding System_ConfirmPresetInlineActionCommand}" ToolTip="Confirm the requested preset replacement." ToolTipService.ShowDuration="60000" />
      <Button Content="Cancel" Command="{Binding System_CancelPresetInlineActionCommand}" ToolTip="Cancel the requested preset replacement." ToolTipService.ShowDuration="60000" />
    </StackPanel>
    <TextBlock Text="{Binding System_PresetStatusText}" Visibility="{Binding System_PresetStatusVisibility}" TextWrapping="Wrap" />
  </StackPanel>
</ScrollViewer>
