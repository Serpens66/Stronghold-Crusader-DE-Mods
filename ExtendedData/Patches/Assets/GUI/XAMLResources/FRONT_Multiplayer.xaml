<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:CrusaderDE"
       xmlns:seui="clr-namespace:SHCDESE.UI;assembly=SHCDESE">
  <Operation Type="InsertAfter" XPath="(//n:Button[@CommandParameter='Back'])[1]">
    <Content>
      <Button Name="ExtendedDataUseMapModSettings"
              Width="180"
              Height="45"
              Margin="410,0,0,20"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              local:PropEx.TextCentre="Map preset"
              local:PropEx.TextLeft=""
              local:PropEx.TextRight=""
              Command="{Binding MultiplayerMenuCommand}"
              CommandParameter="ExtendedDataUseMapModSettings"
              MouseEnter="CommonRedButtonEnter"
              ToolTipService.ShowDuration="60000"
              ToolTip="Use the mod settings embedded in the selected map."
              Visibility="Collapsed"
              Style="{StaticResource BTN_SH_GlowS}" />
    </Content>
  </Operation>
</Patch>
