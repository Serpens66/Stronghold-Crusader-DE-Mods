<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Operation Type="AddNamespace" AttributeName="extendedData" Value="clr-namespace:ExtendedData;assembly=ExtendedData" />
  <Operation Type="SetAttribute" XPath="//n:CheckBox[@Name='EnableAdvancedSkirmishCheck']"
             AttributeName="extendedData:TrailMakerAdvancedHelp.Text"
             Value="{Binding ElementName=ExtendedDataTrailMakerAdvancedOptionsHint, Path=DataContext.CoopAdvancedOptionsHint}" />
  <Operation Type="InsertAfter" XPath="//n:CheckBox[@Name='EnableAdvancedSkirmishCheck']">
    <Content>
      <Grid x:Name="ExtendedDataTrailMakerAdvancedOptionsHint" Visibility="Collapsed" />
    </Content>
  </Operation>
</Patch>
