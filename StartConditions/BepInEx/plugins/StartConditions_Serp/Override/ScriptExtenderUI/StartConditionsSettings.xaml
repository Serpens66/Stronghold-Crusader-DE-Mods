<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=StartConditions"
      xmlns:seui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="seui:ToolTipResolutionScale.Enabled" Value="True"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}" MaxWidth="{TemplateBinding MaxWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchIcon" TargetType="{x:Type Path}"><Setter Property="Stroke" Value="#FF77AAFF"/><Style.Triggers><DataTrigger Binding="{Binding System_ModSettingsSearchHasActiveFilter}" Value="True"><Setter Property="Stroke" Value="#FFF2D48A"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="145" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button Command="{Binding System_ToggleModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" Width="30" Height="28" Padding="5" Margin="8,0,0,0"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ModSettingsSearchIcon}" StrokeThickness="2" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16"/></Viewbox></Button>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" shared:ModSettingsSearch.FocusRequest="{Binding System_ModSettingsSearchFocusRequest}" Width="280" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchHelpText}" Foreground="White" Padding="5,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
          <CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button Command="{Binding System_ClearModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" Width="30" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0"><Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Stroke="#FFF2D48A" StrokeThickness="2" Data="M 1,1 L 9,9 M 9,1 L 1,9"/></Viewbox></Button>
        </StackPanel>
        <TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66" HorizontalAlignment="Left" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <StackPanel shared:ModSettingsSearch.SectionKey="start-conditions.section.gold" shared:ModSettingsSearch.SectionTitle="{Binding StartGoldTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding StartGoldTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="start-conditions.set-start-gold" shared:ModSettingsSearch.Title="{Binding SetStartGoldText}" shared:ModSettingsSearch.ToolTipText="{Binding SetStartGoldHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding SetStartGoldHelpText}">
          <Image Source="{Binding GoldIcon}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/>
          <TextBlock Text="{Binding SetStartGoldText}" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="3">
          <Slider Minimum="-1" Maximum="40000" Value="{Binding SetStartGoldAISlider, Mode=TwoWay}" TickFrequency="100" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding SetStartGoldAiToolTipText}"/>
          <TextBox Text="{Binding SetStartGoldAIText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="7" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding SetStartGoldAiToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="3">
          <Slider Minimum="-1" Maximum="40000" Value="{Binding SetStartGoldHumanSlider, Mode=TwoWay}" TickFrequency="100" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding SetStartGoldHumanToolTipText}"/>
          <TextBox Text="{Binding SetStartGoldHumanText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="7" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding SetStartGoldHumanToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="start-conditions.add-start-gold" shared:ModSettingsSearch.Title="{Binding AddStartGoldText}" shared:ModSettingsSearch.ToolTipText="{Binding AddStartGoldHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding AddStartGoldHelpText}">
          <Image Source="{Binding GoldIcon}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/>
          <TextBlock Text="{Binding AddStartGoldText}" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="3">
          <Slider Minimum="-10000" Maximum="10000" Value="{Binding AddStartGoldAISlider, Mode=TwoWay}" TickFrequency="100" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding AddStartGoldAiToolTipText}"/>
          <TextBox Text="{Binding AddStartGoldAIText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="7" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding AddStartGoldAiToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="3">
          <Slider Minimum="-10000" Maximum="10000" Value="{Binding AddStartGoldHumanSlider, Mode=TwoWay}" TickFrequency="100" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding AddStartGoldHumanToolTipText}"/>
          <TextBox Text="{Binding AddStartGoldHumanText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="7" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding AddStartGoldHumanToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        </Grid>
      </Grid>
      </StackPanel>

      <Separator Background="#444466" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="start-conditions.section.goods" shared:ModSettingsSearch.SectionTitle="{Binding StartGoodsTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding StartGoodsTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
      <TextBlock Text="{Binding UnchangedRangeHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Column="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Column="3" Text="{Binding NormalCrusadeText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Column="4" Text="{Binding DeathmatchText}" Foreground="White" FontWeight="Bold"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding StartGoodEntries}" Margin="0,3,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="{Binding Key}" shared:ModSettingsSearch.Title="{Binding DisplayName}" shared:ModSettingsSearch.ToolTipText="{Binding AIAmountToolTip}" Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          ToolTipService.ShowDuration="60000" ToolTip="{Binding Key}"
                          VerticalAlignment="Center"
                          Margin="0,2,8,2">
                <Image Source="{Binding IconImage}"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="3">
                <Slider Minimum="-1" Maximum="500" Value="{Binding AIAmountSlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIAmountToolTip}"/>
                <TextBox Text="{Binding AIAmountText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIAmountToolTip}" MaxLength="5" HorizontalContentAlignment="Right" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="3">
                <Slider Minimum="-1" Maximum="500" Value="{Binding HumanAmountSlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanAmountToolTip}"/>
                <TextBox Text="{Binding HumanAmountText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanAmountToolTip}" MaxLength="5" HorizontalContentAlignment="Right" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
              </StackPanel>
              <TextBlock Grid.Column="3"
                         Text="{Binding NormalCrusaderAmountText}"
                         ToolTipService.ShowDuration="60000" ToolTip="{Binding NormalCrusaderAmountToolTip}"
                         Foreground="#CCCCCC"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="3"/>
              <TextBlock Grid.Column="4"
                         Text="{Binding DeathmatchAmountText}"
                         ToolTipService.ShowDuration="60000" ToolTip="{Binding DeathmatchAmountToolTip}"
                         Foreground="#CCCCCC"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="3"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>

      <Separator Background="#444466" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="start-conditions.section.troops" shared:ModSettingsSearch.SectionTitle="{Binding StartTroopsTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding StartTroopsTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
      <TextBlock Text="{Binding StartTroopArmiesTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,0,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="start-conditions.multiply-start-troops" shared:ModSettingsSearch.Title="{Binding MultiplyStartTroopsText}" shared:ModSettingsSearch.ToolTipText="{Binding StartTroopsMultiplierHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding MultiplyStartTroopsText}" Foreground="White" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding StartTroopsMultiplierHelpText}"/>
        <StackPanel Grid.Column="1" Margin="3">
          <Slider Minimum="0" Maximum="100" Value="{Binding MultiplyStartTroopsAISlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding StartTroopsMultiplierAiToolTipText}"/>
          <TextBox Text="{Binding MultiplyStartTroopsAIText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="3" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding StartTroopsMultiplierAiToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="3">
          <Slider Minimum="0" Maximum="100" Value="{Binding MultiplyStartTroopsHumanSlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding StartTroopsMultiplierHumanToolTipText}"/>
          <TextBox Text="{Binding MultiplyStartTroopsHumanText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MaxLength="3" HorizontalContentAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding StartTroopsMultiplierHumanToolTipText}" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
        </StackPanel>
        </Grid>
      </Grid>

      <TextBlock Text="{Binding StartTroopsMultiplierHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,8,0,6"/>
      <TextBlock Text="{Binding ExtraStartUnitsTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,8,0,4"/>
      <TextBlock Text="{Binding ExtraStartUnitsHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Column="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding StartTroopEntries}" Margin="0,3,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="{Binding Key}" shared:ModSettingsSearch.Title="{Binding DisplayName}" shared:ModSettingsSearch.ToolTipText="{Binding AIAmountToolTip}" Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          ToolTipService.ShowDuration="60000" ToolTip="{Binding Key}"
                          VerticalAlignment="Center"
                          Margin="0,2,8,2">
                <Image Source="{Binding IconImage}"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="3">
                <Slider Minimum="0" Maximum="100" Value="{Binding AIAmountSlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIAmountToolTip}"/>
                <TextBox Text="{Binding AIAmountText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIAmountToolTip}" MaxLength="4" HorizontalContentAlignment="Right" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="3">
                <Slider Minimum="0" Maximum="100" Value="{Binding HumanAmountSlider, Mode=TwoWay}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanAmountToolTip}"/>
                <TextBox Text="{Binding HumanAmountText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanAmountToolTip}" MaxLength="4" HorizontalContentAlignment="Right" Margin="0,2,0,0" ui:KeyboardCaptureBinding.Enabled="True"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
