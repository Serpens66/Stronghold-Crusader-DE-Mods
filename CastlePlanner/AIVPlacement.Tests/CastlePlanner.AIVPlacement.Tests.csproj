    <Compile Include="..\src\AivSpawnPlan.cs" Link="SpawnPlan\AivSpawnPlan.cs" />
    <Compile Include="..\src\AivWorldCoordinateTransform.cs" Link="SpawnPlan\AivWorldCoordinateTransform.cs" />
