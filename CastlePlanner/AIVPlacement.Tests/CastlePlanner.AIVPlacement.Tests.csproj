      <Private>true</Private>
    </Reference>
    <Reference Include="MessagePack">
      <HintPath>$(ExtenderDir)\MessagePack.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MessagePack.Annotations">
      <HintPath>$(ExtenderDir)\MessagePack.Annotations.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
