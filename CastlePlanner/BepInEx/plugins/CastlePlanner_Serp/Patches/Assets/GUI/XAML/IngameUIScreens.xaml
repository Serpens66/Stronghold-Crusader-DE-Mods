<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:CrusaderDE">
  <Operation Type="Add" XPath="/n:UserControl/n:Grid">
    <Content>
      <!-- This root follows Vanilla's UIScaleValueWidth/Height and therefore
           provides the real draggable viewport at every resolution. -->
      <Grid x:Name="CastlePlannerBlueprintHud"
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10000"
            Visibility="{Binding HudVisible, Converter={StaticResource booleanToVisibilityConverter}}"
            Tag="IgnoreSelf">
        <Border x:Name="CastlePlannerBlueprintPanel"
                Width="{Binding PanelWidth}"
                Height="{Binding PanelHeight}"
                Padding="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="10000"
                Background="#E614243A"
                BorderBrush="#CC77AAFF"
                BorderThickness="1"
                Visibility="{Binding SettingsPanelVisible, Converter={StaticResource booleanToVisibilityConverter}}">
          <Border.RenderTransform>
            <TranslateTransform X="{Binding PanelLeft}"
                                Y="{Binding PanelTop}"/>
          </Border.RenderTransform>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="CastlePlannerBlueprintDragHandle"
                    Height="26"
                    Margin="0,0,0,6"
                    Padding="7,2"
                    Background="#AA203A5A"
                    BorderBrush="#8877AAFF"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding SettingsTitleText}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="#FFE8F2FF"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
            <StackPanel>

            <Button Content="{Binding StatusText}"
                    Command="{Binding ToggleCommand}"
                    Height="30"
                    Padding="8,2"
                    FontSize="15"
                    Foreground="#FFE8F2FF"
                    Background="#AA14243A"
                    BorderBrush="#CC77AAFF"
                    BorderThickness="1"
                    IsEnabled="{Binding CanToggle}"/>

            <TextBlock Text="AIVJSON"
                       Foreground="#FFE8F2FF"
                       Margin="0,6,0,2"/>
            <!-- Noesis has no searchable ComboBox. This Popup overlays the
                 closed selector with its search field, so keyboard input and
                 the result list remain in the same popup focus scope. -->
            <Grid x:Name="CastlePlannerCastleSelector"
                  Height="30"
                  IsEnabled="{Binding CanSelectCastle}">
              <!-- A transparent hit surface leaves the native ComboBox template
                   untouched, so the closed selector looks exactly like before. -->
              <ComboBox Height="30"
                        IsEditable="True"
                        IsReadOnly="True"
                        IsHitTestVisible="False"
                        Text="{Binding SelectedCastle}"/>
              <Border x:Name="CastlePlannerCastleOpenSurface"
                      Background="#01000000"/>
              <Popup x:Name="CastlePlannerCastleSearchPopup"
                     Placement="Bottom"
                     PlacementTarget="{Binding ElementName=CastlePlannerCastleSelector}"
                     StaysOpen="False"
                     AllowsTransparency="True">
                <Border Width="{Binding ActualWidth, ElementName=CastlePlannerCastleSelector}"
                        Background="{StaticResource Brush.ComboBox.Normal}"
                        BorderBrush="{StaticResource Brush.ComboBox.Pressed}"
                        BorderThickness="1">
                  <StackPanel>
                    <TextBox x:Name="CastlePlannerCastleSearchTextBox"
                             Height="30"
                             Padding="6,2"
                             Placeholder="{Binding SearchText}"/>
                    <ListBox x:Name="CastlePlannerCastleSearchResults"
                             ItemsSource="{Binding CastleOptions}"
                             MaxHeight="390"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource Brush.ComboBox.Normal}"
                             BorderThickness="0"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <StackPanel Visibility="{Binding PreviewVisible, Converter={StaticResource booleanToVisibilityConverter}}">
              <TextBlock Text="{Binding RotationText}"
                         Foreground="#FFE8F2FF"
                         Margin="0,6,0,2"/>
              <ComboBox x:Name="CastlePlannerRotationComboBox"
                        ItemsSource="{Binding RotationOptions}"
                        SelectedItem="{Binding SelectedRotation, Mode=TwoWay}"
                        IsEnabled="{Binding CanSelectRotation}"
                        Height="30"/>
              <Button Content="{Binding ConfirmCastleText}"
                      Command="{Binding ConfirmCastleCommand}"
                      IsEnabled="{Binding CanConfirmCastle}"
                      Height="32"
                      Margin="0,7,0,0"
                      Padding="10,3"
                      FontWeight="Bold"
                      Foreground="#FFFFFFFF"
                      Background="#CC2F6F42"
                      BorderBrush="#FF77DD99"
                      BorderThickness="1"/>
            </StackPanel>

            <StackPanel Margin="0,7,0,0"
                        Visibility="{Binding NormalBlueprintSettingsVisible, Converter={StaticResource booleanToVisibilityConverter}}">
              <CheckBox IsChecked="{Binding BlueprintShowFortifications, Mode=TwoWay}"
                        Content="{Binding ShowFortificationsText}"
                        ToolTip="{Binding ShowFortificationsHelpText}"
                        ToolTipService.ShowDuration="60000"/>
              <CheckBox IsChecked="{Binding BlueprintShowBuildings, Mode=TwoWay}"
                        Content="{Binding ShowBuildingsText}"
                        ToolTip="{Binding ShowBuildingsHelpText}"
                        ToolTipService.ShowDuration="60000"
                        Margin="0,3,0,0"/>
              <CheckBox IsChecked="{Binding BlueprintShowDefensiveGroundFeatures, Mode=TwoWay}"
                        Content="{Binding ShowDefensiveGroundFeaturesText}"
                        ToolTip="{Binding ShowDefensiveGroundFeaturesHelpText}"
                        ToolTipService.ShowDuration="60000"
                        Margin="0,3,0,0"/>
              <CheckBox IsChecked="{Binding BlueprintShowFearFactorBuildings, Mode=TwoWay}"
                        Content="{Binding ShowFearFactorBuildingsText}"
                        ToolTip="{Binding ShowFearFactorBuildingsHelpText}"
                        ToolTipService.ShowDuration="60000"
                        Margin="0,3,0,0"/>
            </StackPanel>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding IconScaleText}"
                         Foreground="#FFE8F2FF"
                         VerticalAlignment="Center"/>
              <Slider Grid.Column="1"
                      Minimum="0.05"
                      Maximum="1"
                      Value="{Binding BlueprintIconScale, Mode=TwoWay}"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Margin="4,0"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding BlueprintIconScaleText}"
                         Foreground="#FFE8F2FF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,5,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding IconAlphaText}"
                         Foreground="#FFE8F2FF"
                         VerticalAlignment="Center"/>
              <Slider Grid.Column="1"
                      Minimum="0"
                      Maximum="1"
                      Value="{Binding BlueprintIconAlpha, Mode=TwoWay}"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Margin="4,0"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding BlueprintIconAlphaText}"
                         Foreground="#FFE8F2FF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
            </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Width="520"
                Padding="18,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,72,0,0"
                Panel.ZIndex="10002"
                Background="#E614243A"
                BorderBrush="#FF77AAFF"
                BorderThickness="2"
                Visibility="{Binding PreviewVisible, Converter={StaticResource booleanToVisibilityConverter}}"
                Tag="Ignore">
          <StackPanel>
            <TextBlock Text="{Binding PreviewTitleText}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PreviewTimerText}"
                       FontSize="22"
                       Foreground="#FFFFD27A"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>
            <TextBlock Text="{Binding PreviewStatusText}"
                       FontSize="17"
                       Foreground="#FFE8F2FF"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <!-- Keep this fixed trigger above the movable panel and Vanilla HUD. -->
        <Button x:Name="CastlePlannerBlueprintSettingsButton"
                Width="36"
                Height="34"
                Margin="0,0,0,34"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Panel.ZIndex="10001"
                local:PropEx.Sprite1="{StaticResource UI-Buildings A001}"
                local:PropEx.Sprite2="{StaticResource UI-Buildings A002}"
                local:PropEx.Sprite3="{StaticResource UI-Buildings A002}"
                local:PropEx.Sprite4="{StaticResource UI-Buildings A001}"
                Command="{Binding ToggleSettingsPanelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                Style="{StaticResource BTN_Building}">
          <Button.RenderTransform>
            <TranslateTransform Y="{Binding TriggerVerticalOffset}"/>
          </Button.RenderTransform>
        </Button>
      </Grid>
    </Content>
  </Operation>
</Patch>
