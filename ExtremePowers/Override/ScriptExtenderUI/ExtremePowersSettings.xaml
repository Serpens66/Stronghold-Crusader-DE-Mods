<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:Shared;assembly=ExtremePowers" xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE" shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}" shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}" shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="HostHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="Section" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#FFF2D48A"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,9,0,4"/></Style>
    <Style x:Key="Label" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,2,10,2"/></Style>
    <Style x:Key="Edit" TargetType="{x:Type TextBox}"><Setter Property="ui:KeyboardCaptureBinding.Enabled" Value="True"/><Setter Property="Width" Value="110"/><Setter Property="Margin" Value="0,2"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/><Setter Property="ToolTip" Value="{Binding GenericHelp}"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
  </Grid.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="10" MinWidth="650">
    <StackPanel Orientation="Horizontal" shared:ModSettingsSearch.Exclude="True"><TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/><Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0"><CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTip="{Binding HostSettingsActivationHelpText}" ToolTipService.ShowDuration="60000" Foreground="White"/></Border><ComboBox ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset,Mode=TwoWay}" IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ToolTip="{Binding PresetHelpText}" ToolTipService.ShowDuration="60000" Width="145" Margin="12,0"/><Button Command="{Binding System_ToggleModSettingsSearchCommand}" Content="?" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" ToolTipService.ShowDuration="60000" Width="30" Margin="8,0,0,0"/><Button Content="{Binding ResetText}" Command="{Binding ResetToDefaultCommand}" IsEnabled="{Binding CanResetSettings}" ToolTip="{Binding ResetToDefaultHelpText}" ToolTipService.ShowDuration="60000"/></StackPanel>
    <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" shared:ModSettingsSearch.FocusRequest="{Binding System_ModSettingsSearchFocusRequest}" Width="280" ToolTip="{Binding System_ModSettingsSearchHelpText}" ToolTipService.ShowDuration="60000"/><CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" ToolTipService.ShowDuration="60000"/><Button Command="{Binding System_ClearModSettingsSearchCommand}" Content="X" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" ToolTipService.ShowDuration="60000"/></StackPanel><TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66"/></StackPanel>
    <TextBlock Text="{Binding TitleText}" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding HelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,2,0,8"/>
    <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66"/><TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,8,0,4"/>
    <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True" shared:ModSettingsSearch.SectionKey="extreme-powers.host" shared:ModSettingsSearch.SectionTitle="{Binding HostOptionsText}"><TextBlock Text="{Binding RegenerationText}" Style="{StaticResource SectionHeader}"/></Grid><Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.regeneration" shared:ModSettingsSearch.Title="{Binding RegenerationText}" shared:ModSettingsSearch.ToolTipText="{Binding GenericHelp}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RegenerationText}" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Style="{StaticResource Edit}" Text="{Binding RegenerationPercent,Mode=TwoWay}"/></Grid>
      <TextBlock Text="{Binding EffectsText}" Style="{StaticResource Section}"/>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.effects" shared:ModSettingsSearch.Title="{Binding EffectsText}" shared:ModSettingsSearch.ToolTipText="{Binding GenericHelp}"><UniformGrid Columns="4"><TextBlock Text="{Binding ArrowDamageText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding ArrowDamage,Mode=TwoWay}"/><TextBlock Text="{Binding ArrowRadiusText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding ArrowRadius,Mode=TwoWay}"/><TextBlock Text="{Binding ArrowModeText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding ArrowMode,Mode=TwoWay}"/><TextBlock Text="{Binding HealAmountText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding HealAmount,Mode=TwoWay}"/><TextBlock Text="{Binding HealRadiusText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding HealRadius,Mode=TwoWay}"/><TextBlock Text="{Binding RockDamageText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding RockDamage,Mode=TwoWay}"/><TextBlock Text="{Binding RockRadiusText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding RockRadius,Mode=TwoWay}"/><TextBlock Text="{Binding RockModeText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding RockMode,Mode=TwoWay}"/></UniformGrid></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.spawns" shared:ModSettingsSearch.Title="{Binding SpearmenSpawnText}" shared:ModSettingsSearch.ToolTipText="{Binding GenericHelp}"><UniformGrid Columns="4"><TextBlock Text="{Binding SpearmenSpawnText}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding SpearmenType,Mode=TwoWay}"/><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding SpearmenCount,Mode=TwoWay}"/></StackPanel><TextBlock Text="{Binding EngineersSpawnText}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding EngineersType,Mode=TwoWay}"/><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding EngineersCount,Mode=TwoWay}"/></StackPanel><TextBlock Text="{Binding MacemenSpawnText}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding MacemenType,Mode=TwoWay}"/><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding MacemenCount,Mode=TwoWay}"/></StackPanel><TextBlock Text="{Binding KnightsSpawnText}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding KnightsType,Mode=TwoWay}"/><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding KnightsCount,Mode=TwoWay}"/></StackPanel><TextBlock Text="{Binding GoldRangeText}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding GoldMinimum,Mode=TwoWay}"/><TextBox Style="{StaticResource Edit}" Width="52" Text="{Binding GoldMaximum,Mode=TwoWay}"/></StackPanel></UniformGrid></Grid>
      <TextBlock Text="{Binding DemoText}" Style="{StaticResource Section}"/><Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo" shared:ModSettingsSearch.Title="{Binding DemoText}" shared:ModSettingsSearch.ToolTipText="{Binding GenericHelp}"><StackPanel><CheckBox IsChecked="{Binding EnableGoldReplacement,Mode=TwoWay}" Content="{Binding EnableDemoText}" Foreground="White" ToolTip="{Binding GenericHelp}" ToolTipService.ShowDuration="60000"/><UniformGrid Columns="4"><TextBlock Text="{Binding DemoUnitTypeText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding DemoUnitType,Mode=TwoWay}"/><TextBlock Text="{Binding DemoUnitCountText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Text="{Binding DemoSpawnCount,Mode=TwoWay}"/><TextBlock Text="{Binding HudNameText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Width="250" Text="{Binding DemoName,Mode=TwoWay}"/><TextBlock Text="{Binding HudTooltipText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Width="250" Text="{Binding DemoTooltip,Mode=TwoWay}"/><TextBlock Text="{Binding HudSpriteText}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Edit}" Width="250" Text="{Binding DemoSprite,Mode=TwoWay}"/></UniformGrid></StackPanel></Grid>
    </StackPanel><TextBlock Text="{Binding ClientOptionsText}" Style="{StaticResource ClientRoleHeader}" Margin="0,10,0,3"/><TextBlock Text="{Binding NoClientOptionsText}" Foreground="#BBBBBB"/>
  </StackPanel></ScrollViewer>
</Grid>
