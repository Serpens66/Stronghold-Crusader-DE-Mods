<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=ExtremePowers"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/><Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/></MultiBinding></Setter.Value></Setter></Style>
    <Style x:Key="ModSettingsSearchIcon" TargetType="{x:Type Path}"><Setter Property="Stroke" Value="#FF77AAFF"/><Style.Triggers><DataTrigger Binding="{Binding System_ModSettingsSearchHasActiveFilter}" Value="True"><Setter Property="Stroke" Value="#FFF2D48A"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10" MinWidth="700">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0"><CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold"/></Border>
        <TextBlock Text="{Binding PresetText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,6,0" Visibility="{Binding PresetVisibility}"/>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" Width="145" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}"/>
        <Button Command="{Binding System_ToggleModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" Width="30" Height="28" Padding="5" Margin="8,0,0,0"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ModSettingsSearchIcon}" StrokeThickness="2" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16"/></Viewbox></Button>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" shared:ModSettingsSearch.FocusRequest="{Binding System_ModSettingsSearchFocusRequest}" Width="280" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchHelpText}" Foreground="White" Padding="5,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" Foreground="White" Margin="10,0,0,0"/><Button Command="{Binding System_ClearModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" Width="30" Height="26" Margin="8,0,0,0"><Viewbox Width="10" Height="10"><Path Stroke="#FFF2D48A" StrokeThickness="2" Data="M 1,1 L 9,9 M 9,1 L 1,9"/></Viewbox></Button></StackPanel><TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66" Margin="0,4,0,0"/></StackPanel>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
        <StackPanel shared:ModSettingsSearch.SectionKey="extreme-powers.section.regeneration" shared:ModSettingsSearch.SectionTitle="{Binding RegenerationText}"><Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding RegenerationText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/></Grid><Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.regeneration" shared:ModSettingsSearch.Title="{Binding RegenerationText}" shared:ModSettingsSearch.ToolTipText="{Binding RegenerationHelpText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding RegenerationHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="75"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RegenerationText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="10" Value="{Binding RegenerationPercent, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding RegenerationHelpText}"/><TextBox Grid.Column="2" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding RegenerationPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding RegenerationHelpText}"/><TextBlock Grid.Column="3" Text="%" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid></StackPanel>
        <Separator Background="#44FFFFFF" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
        <StackPanel shared:ModSettingsSearch.SectionKey="extreme-powers.section.effects" shared:ModSettingsSearch.SectionTitle="{Binding EffectsText}"><Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding EffectsText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.arrow-damage" shared:ModSettingsSearch.Title="{Binding ArrowDamageText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ArrowDamageText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding ArrowDamageValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid><Grid Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.rock-damage" shared:ModSettingsSearch.Title="{Binding RockDamageText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RockDamageText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding RockDamageValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid>
          <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.arrow-radius" shared:ModSettingsSearch.Title="{Binding ArrowRadiusText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ArrowRadiusText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding ArrowRadiusValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid><Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.rock-radius" shared:ModSettingsSearch.Title="{Binding RockRadiusText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RockRadiusText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding RockRadiusValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid>
          <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.arrow-mode" shared:ModSettingsSearch.Title="{Binding ArrowModeText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ArrowModeText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ArrowMode, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid><Grid Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.rock-mode" shared:ModSettingsSearch.Title="{Binding RockModeText}" shared:ModSettingsSearch.ToolTipText="{Binding VolleyHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RockModeText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RockMode, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding VolleyHelpText}"/></Grid>
          <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.heal-amount" shared:ModSettingsSearch.Title="{Binding HealAmountText}" shared:ModSettingsSearch.ToolTipText="{Binding HealingHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HealAmountText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding HealAmountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HealingHelpText}"/></Grid><Grid Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.heal-radius" shared:ModSettingsSearch.Title="{Binding HealRadiusText}" shared:ModSettingsSearch.ToolTipText="{Binding HealingHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HealRadiusText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding HealRadiusValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HealingHelpText}"/></Grid>
        </Grid></StackPanel>
        <Separator Background="#44FFFFFF" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
        <StackPanel shared:ModSettingsSearch.SectionKey="extreme-powers.section.spawns" shared:ModSettingsSearch.SectionTitle="{Binding SpawnEffectsText}"><Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding SpawnEffectsText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="230"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.spawn-spearmen" shared:ModSettingsSearch.Title="{Binding SpearmenSpawnText}" shared:ModSettingsSearch.ToolTipText="{Binding SpawnHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="230"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SpearmenSpawnText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitTypeOptions}" SelectedIndex="{Binding SpearmenTypeIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}" Margin="0,2"/><TextBox Grid.Column="2" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding SpearmenCountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}"/></Grid>
          <Grid Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.spawn-engineers" shared:ModSettingsSearch.Title="{Binding EngineersSpawnText}" shared:ModSettingsSearch.ToolTipText="{Binding SpawnHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="230"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EngineersSpawnText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitTypeOptions}" SelectedIndex="{Binding EngineersTypeIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}" Margin="0,2"/><TextBox Grid.Column="2" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding EngineersCountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}"/></Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.spawn-macemen" shared:ModSettingsSearch.Title="{Binding MacemenSpawnText}" shared:ModSettingsSearch.ToolTipText="{Binding SpawnHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="230"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MacemenSpawnText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitTypeOptions}" SelectedIndex="{Binding MacemenTypeIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}" Margin="0,2"/><TextBox Grid.Column="2" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding MacemenCountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}"/></Grid>
          <Grid Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.spawn-knights" shared:ModSettingsSearch.Title="{Binding KnightsSpawnText}" shared:ModSettingsSearch.ToolTipText="{Binding SpawnHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="230"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding KnightsSpawnText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitTypeOptions}" SelectedIndex="{Binding KnightsTypeIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}" Margin="0,2"/><TextBox Grid.Column="2" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding KnightsCountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding SpawnHelpText}"/></Grid></Grid></StackPanel>
        <Separator Background="#44FFFFFF" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
        <StackPanel shared:ModSettingsSearch.SectionKey="extreme-powers.section.gold" shared:ModSettingsSearch.SectionTitle="{Binding GoldEffectText}"><Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding GoldEffectText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/></Grid><Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.gold-range" shared:ModSettingsSearch.Title="{Binding GoldRangeText}" shared:ModSettingsSearch.ToolTipText="{Binding GoldHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/><ColumnDefinition Width="20"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GoldRangeText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding GoldMinimumValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding GoldHelpText}"/><TextBlock Grid.Column="2" Text="–" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="3" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Text="{Binding GoldMaximumValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding GoldHelpText}"/></Grid></StackPanel>
        <Separator Background="#44FFFFFF" Margin="0,10" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}"/>
        <StackPanel shared:ModSettingsSearch.SectionKey="extreme-powers.section.demo" shared:ModSettingsSearch.SectionTitle="{Binding DemoText}"><Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding DemoText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/></Grid><Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-enabled" shared:ModSettingsSearch.Title="{Binding EnableDemoText}" shared:ModSettingsSearch.ToolTipText="{Binding DemoEnableHelpText}"><CheckBox IsChecked="{Binding EnableGoldReplacement, Mode=TwoWay}" Content="{Binding EnableDemoText}" Foreground="White" FontWeight="Bold" ToolTipService.ShowDuration="60000" ToolTip="{Binding DemoEnableHelpText}" Margin="0,0,0,6"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-unit" shared:ModSettingsSearch.Title="{Binding DemoUnitTypeText}" shared:ModSettingsSearch.ToolTipText="{Binding DemoUnitHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DemoUnitTypeText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitTypeOptions}" SelectedIndex="{Binding DemoUnitTypeIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding DemoUnitHelpText}" Margin="0,2"/></Grid>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-owner" shared:ModSettingsSearch.Title="{Binding DemoOwnerText}" shared:ModSettingsSearch.ToolTipText="{Binding DemoOwnerHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DemoOwnerText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" IsEnabled="{Binding IsDemoOwnerSelectable}" ItemsSource="{Binding DemoOwnerOptions}" SelectedIndex="{Binding DemoOwnerIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding DemoOwnerHelpText}" Margin="0,2"/></Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-count" shared:ModSettingsSearch.Title="{Binding DemoUnitCountText}" shared:ModSettingsSearch.ToolTipText="{Binding DemoCountHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DemoUnitCountText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Foreground="White" MinWidth="66" MaxWidth="100" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" HorizontalAlignment="Left" Text="{Binding DemoSpawnCountValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTipService.ShowDuration="60000" ToolTip="{Binding DemoCountHelpText}"/></Grid>
          <Grid Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-name" shared:ModSettingsSearch.Title="{Binding HudNameText}" shared:ModSettingsSearch.ToolTipText="{Binding HudNameHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HudNameText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding DemoName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" Padding="4,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" ToolTipService.ShowDuration="60000" ToolTip="{Binding HudNameHelpText}"/></Grid>
          <Grid Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-tooltip" shared:ModSettingsSearch.Title="{Binding HudTooltipText}" shared:ModSettingsSearch.ToolTipText="{Binding HudTooltipHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HudTooltipText}" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding DemoTooltip, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" Padding="4,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" ToolTipService.ShowDuration="60000" ToolTip="{Binding HudTooltipHelpText}"/></Grid>
          <Grid Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extreme-powers.demo-sprite" shared:ModSettingsSearch.Title="{Binding HudSpriteText}" shared:ModSettingsSearch.ToolTipText="{Binding HudSpriteHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HudSpriteText}" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding SpriteOptions}" SelectedIndex="{Binding DemoSpriteIndex, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HudSpriteHelpText}" Margin="0,2"/></Grid></Grid></StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding ClientOptionsText}" Style="{StaticResource ClientRoleHeader}" Margin="0,12,0,5"/>
      <TextBlock Text="{Binding NoClientOptionsText}" Foreground="#BBBBBB" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Grid>
