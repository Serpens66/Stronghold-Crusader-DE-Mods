<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Operation Type="SetAttribute" XPath="//n:Grid[@Name='ReportsArmy1Panel']/n:TextBlock[2]" AttributeName="Name" Value="VirtualUnitsPrototypeArmyNormalArcherCount" />
  <Operation Type="Add" XPath="//n:Grid[@Name='ReportsArmy1Panel']">
    <Content>
      <Grid x:Name="VirtualUnitsPrototypeArmyPresentation" Width="70" Height="92" Margin="0,0,15,18"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="20"
            Visibility="{Binding VirtualArmyVisible, Converter={StaticResource booleanToVisibilityConverter}}">
          <Image Width="58" Height="58" VerticalAlignment="Top" Source="{Binding ArmyIcon}"/>
          <Border Background="#553080FF" Margin="6,0,6,34" IsHitTestVisible="False"/>
          <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Foreground="#FFAED6FF" FontSize="18" Text="{Binding VirtualArcherArmyCount}"/>
      </Grid>
    </Content>
  </Operation>
</Patch>
