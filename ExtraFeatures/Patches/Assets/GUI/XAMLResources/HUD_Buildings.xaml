<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:CrusaderDE"
       xmlns:shared="clr-namespace:Shared;assembly=ExtraFeatures">
  <Operation Type="SetAttribute" XPath="//n:Slider[@Name='Autotrade_Sell_Slider']" AttributeName="Minimum" Value="0" />
  <Operation Type="Add" XPath="//n:Grid[@Name='WorkerPanel']">
    <Content>
      <Grid x:Name="ExtraFeaturesQuarryPileRelocationButtonHost"
            Width="36"
            Height="35"
            Margin="0,38,296,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{Binding ButtonVisibility}">
        <Button x:Name="ExtraFeaturesQuarryPileRelocationButton"
                Width="36"
                Height="35"
                Margin="0"
                local:PropEx.Sprite1="{StaticResource UI-Buttons L020}"
                local:PropEx.Sprite2="{StaticResource UI-Buttons L021}"
                local:PropEx.Sprite3="{StaticResource UI-Buttons L021}"
                local:PropEx.Sprite4="{StaticResource UI-Buttons L021}"
                Command="{Binding RelocateCommand}"
                Content=""
                Style="{StaticResource BTN_Image}" />
      </Grid>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[@Name='WorkerPanel']">
    <Content>
      <TextBlock x:Name="ExtraFeaturesQuarryPileRelocationTooltipHost"
                 Padding="4,2,4,0"
                 Margin="140,-400,0,127"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Panel.ZIndex="1"
                 FontSize="16"
                 FontWeight="Normal"
                 MaxWidth="380"
                 TextWrapping="Wrap"
                 Foreground="#FFDDDDDD"
                 Background="#55000000"
                 FlowDirection="{Binding GlobalTextFlowAL2R}"
                 IsHitTestVisible="False"
                 Tag="Ignore"
                 Text=""
                 Visibility="Hidden">
        <TextBlock.Effect>
          <DropShadowEffect ShadowDepth="2"
                            Direction="315"
                            Color="#CC000000"
                            BlurRadius="0" />
        </TextBlock.Effect>
      </TextBlock>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[@Name='ShowGate']">
    <Content>
      <Grid x:Name="ExtraFeaturesGatehouseAutomationButtonHost"
            Width="57"
            Height="57"
            Margin="0,100,600,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{Binding ButtonVisibility}">
        <Button x:Name="ExtraFeaturesGatehouseAutomationButton"
                Width="57"
                Height="57"
                Margin="0"
                Padding="0"
                Command="{Binding ToggleCommand}"
                ToolTipService.ShowDuration="60000"
                Background="#DD1B1B1B"
                BorderBrush="#FFB08A4A"
                BorderThickness="2">
          <Button.ToolTip>
            <ToolTip Content="{Binding ToolTipText}"
                     Background="#FF1D1710"
                     Foreground="White"
                     FontSize="{x:Static shared:ToolTipPresentation.FontSize}"
                     BorderBrush="#FFF2D48A"
                     BorderThickness="1">
              <ToolTip.Template>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="2"
                          Padding="10,7"
                          MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}">
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               TextWrapping="Wrap"/>
                  </Border>
                </ControlTemplate>
              </ToolTip.Template>
            </ToolTip>
          </Button.ToolTip>
          <Grid Width="53" Height="53">
            <Image Width="49"
                   Height="49"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   Source="{Binding IconImageSource}"
                   Opacity="{Binding IconOpacity}"/>
            <Border Width="48"
                    Height="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFF9C38"
                    BorderBrush="#FF2A1608"
                    BorderThickness="1"
                    Visibility="{Binding ManualIndicatorVisibility}">
              <Border.RenderTransform>
                <RotateTransform Angle="-42"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Button>
      </Grid>
    </Content>
  </Operation>
</Patch>
