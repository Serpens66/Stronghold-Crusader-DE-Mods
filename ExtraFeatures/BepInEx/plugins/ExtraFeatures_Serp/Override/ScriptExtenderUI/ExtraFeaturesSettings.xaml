<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=ExtraFeatures">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <TextBlock Text="{Binding LegacyModWarningText}"
                 Visibility="{Binding LegacyModWarningVisibility}"
                 Foreground="#FF6666"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="170" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">

      <TextBlock Text="{Binding ComfortTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <CheckBox IsChecked="{Binding EnableSingleBuildingPause, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableSingleBuildingPauseHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableSingleBuildingPauseText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableFastRecruitRallyMovement, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableFastRecruitRallyMovementHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableFastRecruitRallyMovementText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding NewFeaturesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding LordHealthTitleText}" Foreground="#DDDDDD" FontWeight="Bold" Margin="0,0,0,4"/>
      <Grid Margin="0,0,0,10" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/><ColumnDefinition Width="24"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
        <Slider Grid.Row="1" Grid.Column="0" Minimum="10" Maximum="500" Value="{Binding HumanLordHealthPercent, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="1" Text="{Binding HumanLordHealthPercentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <Slider Grid.Row="1" Grid.Column="3" Minimum="10" Maximum="500" Value="{Binding AILordHealthPercent, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="4" Text="{Binding AILordHealthPercentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <CheckBox IsChecked="{Binding EnableMonksAlwaysRun, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMonksAlwaysRunHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableMonksAlwaysRunText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableImprovedAssassinPathfinding, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableImprovedAssassinPathfindingHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableImprovedAssassinPathfindingText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox IsChecked="{Binding EnableKnightDismount, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableKnightDismountHelpText}" Margin="0,0,14,0">
          <TextBlock Text="{Binding EnableKnightDismountText}" Foreground="White" TextWrapping="Wrap"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding InstantHorse, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding InstantHorseHelpText}" Margin="0,0,14,0">
          <TextBlock Text="{Binding InstantHorseText}" Foreground="White" TextWrapping="Wrap"/>
        </CheckBox>
      </StackPanel>
      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding GatehousesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <CheckBox IsChecked="{Binding RequireReachableEnemyForAutomaticGateClosing, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding RequireReachableEnemyForAutomaticGateClosingHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding RequireReachableEnemyForAutomaticGateClosingText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HumanGateReopenDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding HumanGateReopenDelaySeconds, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding HumanGateReopenDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AIGateReopenDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding AIGateReopenDelaySeconds, Mode=TwoWay}" TickFrequency="2.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding AIGateReopenDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HumanGateClosingDistanceText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Row="0" Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding HumanGateClosingDistanceTiles, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding HumanGateClosingDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AIGateClosingDistanceText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding AIGateClosingDistanceTiles, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding AIGateClosingDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding AiDefenseRepairTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIRepairEnemyProximityHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AIRepairEnemyProximityText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding AIRepairEnemyProximity, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIRepairEnemyProximityHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AIRepairEnemyProximityValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIRepairEnemyProximityHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AITowerGateRebuildDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="300" Value="{Binding AITowerGateRebuildDelaySeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AITowerGateRebuildDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding BuildingsProductionTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <CheckBox IsChecked="{Binding EnableQuarryPileRelocation, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableQuarryPileRelocationHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableQuarryPileRelocationText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableAIQuarryPileTowardsKeep, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableAIQuarryPileTowardsKeepHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableAIQuarryPileTowardsKeepText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding EnableExtraChurchPriests, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableExtraChurchPriestsHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding EnableExtraChurchPriestsText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding CampfirePeasantsHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding CampfirePeasantsText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="200" Value="{Binding CampfirePeasantsLimit, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding CampfirePeasantsHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding CampfirePeasantsLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding CampfirePeasantsHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding BulldozeTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding BulldozeHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,8,3"><Image Source="{Binding WoodRefundIcon}" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding WoodRefundText}" Foreground="White"/></StackPanel>
        <Slider Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding WoodRefundPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding WoodRefundPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,8,3"><Image Source="{Binding StoneRefundIcon}" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding StoneRefundText}" Foreground="White"/></StackPanel>
        <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding StoneRefundPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding StoneRefundPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,3,8,3"><Image Source="{Binding IronRefundIcon}" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding IronRefundText}" Foreground="White"/></StackPanel>
        <Slider Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding IronRefundPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="2" Text="{Binding IronRefundPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,3,8,3"><Image Source="{Binding PitchRefundIcon}" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding PitchRefundText}" Foreground="White"/></StackPanel>
        <Slider Grid.Row="3" Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding PitchRefundPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Grid.Column="2" Text="{Binding PitchRefundPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,3,8,3"><Image Source="{Binding GoldRefundIcon}" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding GoldRefundText}" Foreground="White"/></StackPanel>
        <Slider Grid.Row="4" Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding GoldRefundPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="4" Grid.Column="2" Text="{Binding GoldRefundPercentValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BulldozeHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <CheckBox IsChecked="{Binding KeepStorageContent, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding KeepStorageContentHelpText}" Margin="0,4,14,4">
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding KeepStorageContentText}" Foreground="White"/><Image Source="{Binding KeepStorageFruitIcon}" Width="18" Height="18" Margin="8,0,0,0"/><Image Source="{Binding KeepStorageWoodIcon}" Width="18" Height="18" Margin="4,0,0,0"/><Image Source="{Binding KeepStorageBowsIcon}" Width="18" Height="18" Margin="4,0,0,0"/></StackPanel>
      </CheckBox>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding EconomyBuffsTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="120"/><ColumnDefinition Width="55"/><ColumnDefinition Width="120"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/><TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MultiplyGoodsGainText}" Foreground="White" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsGainHelpText}"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding MultiplyGoodsGainAI, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsGainHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding MultiplyGoodsGainAIText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsGainHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="5" Value="{Binding MultiplyGoodsGainHuman, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsGainHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="4" Text="{Binding MultiplyGoodsGainHumanText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsGainHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MultiplyGoodsAsMoneyText}" Foreground="White" Margin="0,4" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsAsMoneyHelpText}"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding MultiplyGoodsGainInMoneyAI, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsAsMoneyHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="2" Text="{Binding MultiplyGoodsGainInMoneyAIText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsAsMoneyHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="5" Value="{Binding MultiplyGoodsGainInMoneyHuman, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsAsMoneyHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="4" Text="{Binding MultiplyGoodsGainInMoneyHumanText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplyGoodsAsMoneyHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
