      </CheckBox>
      <TextBlock Text="{Binding MarketGoodPriceMultipliersHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,8,14,6"/>
      <ItemsControl ItemsSource="{Binding MarketGoodPriceItems}" Width="760" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Width="760" ItemWidth="76" ItemHeight="120"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="72" Height="116" Margin="2" Background="#33251D13" BorderBrush="#887B674B" BorderThickness="1" CornerRadius="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GoodToolTip}">
              <Grid Margin="3">
                <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="17"/><RowDefinition Height="23"/><RowDefinition Height="17"/><RowDefinition Height="23"/></Grid.RowDefinitions>
                <Image Grid.Row="0" Source="{Binding Icon}" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Text="{Binding BuyMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="#FF77AAFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BuyToolTip}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
                <Slider Grid.Row="2" Minimum="0" Maximum="5" Value="{Binding BuyMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="62" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding BuyToolTip}"/>
                <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Text="{Binding SellMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="#FF66CC99" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding SellToolTip}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
