      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding PlagueTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding PlagueDurationMultiplierText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0.5" Maximum="20" Value="{Binding PlagueDurationMultiplier, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding PlagueDurationMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ApothecaryPlagueSearchDistanceText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="20" Maximum="200" Value="{Binding ApothecaryPlagueSearchDistance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding ApothecaryPlagueSearchDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding AiEconomyProtectionTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <CheckBox IsChecked="{Binding PreventAIPause, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PreventAIPauseHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding PreventAIPauseText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding PreventEmergencyDemolition, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PreventEmergencyDemolitionHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding PreventEmergencyDemolitionText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding PreventHovelDeletion, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PreventHovelDeletionHelpText}" Margin="0,0,14,8">
        <TextBlock Text="{Binding PreventHovelDeletionText}" Foreground="White" TextWrapping="Wrap"/>
      </CheckBox>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding InaccessibleAIBuildingDemolitionProtectionHelpText}" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding InaccessibleAIBuildingDemolitionProtectionText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding InaccessibleAIBuildingDemolitionProtection, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding InaccessibleAIBuildingDemolitionProtectionHelpText}"/>
        <TextBlock Grid.Column="2" Text="{Binding InaccessibleAIBuildingDemolitionProtectionValueText}" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding MarketPriceMultipliersTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MarketBuyPriceMultiplierText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketBuyPriceMultiplierHelpText}"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding MarketBuyPriceMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketBuyPriceMultiplierHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding MarketBuyPriceMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketBuyPriceMultiplierHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MarketSellPriceMultiplierText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketSellPriceMultiplierHelpText}"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding MarketSellPriceMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketSellPriceMultiplierHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding MarketSellPriceMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketSellPriceMultiplierHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <CheckBox IsChecked="{Binding MarketPricesAlsoForAI, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketPricesAlsoForAIHelpText}" Margin="0,8,14,4">
