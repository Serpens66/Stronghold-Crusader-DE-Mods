                  <CheckBox Content="{Binding PlagueDamageGatesText}" IsChecked="{Binding PlagueDamageGates, Mode=TwoWay}" IsEnabled="{Binding CanEditHostSettings}" Foreground="White" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDamageGatesHelpText}" MinHeight="28" VerticalAlignment="Center" />
                </Grid>
                <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.plague-damage-towers" shared:ModSettingsSearch.Title="{Binding PlagueDamageTowersText}" shared:ModSettingsSearch.ToolTipText="{Binding PlagueDamageTowersHelpText}" Margin="0,0,18,8">
                  <CheckBox Content="{Binding PlagueDamageTowersText}" IsChecked="{Binding PlagueDamageTowers, Mode=TwoWay}" IsEnabled="{Binding CanEditHostSettings}" Foreground="White" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDamageTowersHelpText}" MinHeight="28" VerticalAlignment="Center" />
                </Grid>
                <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.plague-damage-keeps" shared:ModSettingsSearch.Title="{Binding PlagueDamageKeepsText}" shared:ModSettingsSearch.ToolTipText="{Binding PlagueDamageKeepsHelpText}" Margin="0,0,18,8">
                  <CheckBox Content="{Binding PlagueDamageKeepsText}" IsChecked="{Binding PlagueDamageKeeps, Mode=TwoWay}" IsEnabled="{Binding CanEditHostSettings}" Foreground="White" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDamageKeepsHelpText}" MinHeight="28" VerticalAlignment="Center" />
                </Grid>
              </WrapPanel>
            </StackPanel>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.plague-duration" shared:ModSettingsSearch.Title="{Binding PlagueDurationMultiplierText}" shared:ModSettingsSearch.ToolTipText="{Binding PlagueDurationMultiplierHelpText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" MaxWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ScalarValue" MinWidth="90" MaxWidth="130" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding PlagueDurationMultiplierText}" Style="{StaticResource CompactSettingLabel}" Grid.Column="0" />
              <Slider Minimum="0.5" Maximum="20" Value="{Binding PlagueDurationMultiplier, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}" MinHeight="28" VerticalAlignment="Center" Grid.Column="2" Width="160" />
              <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding PlagueDurationMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueDurationMultiplierHelpText}" MinWidth="90" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Margin="0" MinHeight="28" Grid.Column="4" Width="Auto" />
            </Grid>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.apothecary-plague-search-distance" shared:ModSettingsSearch.Title="{Binding ApothecaryPlagueSearchDistanceText}" shared:ModSettingsSearch.ToolTipText="{Binding ApothecaryPlagueSearchDistanceHelpText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" MaxWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ScalarValue" MinWidth="90" MaxWidth="130" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ApothecaryPlagueSearchDistanceText}" Style="{StaticResource CompactSettingLabel}" Grid.Column="0" />
              <Slider Minimum="20" Maximum="200" Value="{Binding ApothecaryPlagueSearchDistance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}" MinHeight="28" VerticalAlignment="Center" Grid.Column="2" Width="160" />
              <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding ApothecaryPlagueSearchDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding ApothecaryPlagueSearchDistanceHelpText}" MinWidth="90" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Margin="0" MinHeight="28" Grid.Column="4" Width="Auto" />
            </Grid>
          </StackPanel>
          <StackPanel Visibility="{Binding SettingsPresentation.HealerOptions.Visibility}" Grid.IsSharedSizeScope="True">
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.healer-targets" shared:ModSettingsSearch.Title="{Binding HealerTargetsText}" shared:ModSettingsSearch.ToolTipText="{Binding HealerTargetsHelpText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HealerTargetsHelpText}">
              <StackPanel>
                <TextBlock Text="{Binding HealerTargetsText}" Style="{StaticResource SubsectionHeader}" />
                <WrapPanel>
                  <CheckBox Content="{Binding HealerTargetsCivilianText}" IsChecked="{Binding HealCivilianTargets, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0" ToolTipService.ShowDuration="60000" ToolTip="{Binding HealerTargetsHelpText}" MinHeight="28" />
                  <CheckBox Content="{Binding HealerTargetsSiegeText}" IsChecked="{Binding HealSiegeTargets, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding HealerTargetsHelpText}" Margin="0,0,18,0" MinHeight="28" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding SettingsPresentation.Market.Visibility}" Margin="0,0,0,6" Width="{Binding ViewportWidth, ElementName=SettingsViewport, Converter={StaticResource SettingsTopicWidthConverter}}" HorizontalAlignment="Left"
                  shared:ModSettingsSearch.SectionKey="extra.topic.market" shared:ModSettingsSearch.SectionTitle="{Binding SettingsPresentation.Market.Title}" shared:ModSettingsSearch.IsSection="True">
        <Button Command="{Binding SettingsPresentation.Market.ToggleCommand}" HorizontalContentAlignment="Stretch" Style="{StaticResource TopicHeading}" ToolTip="{Binding SettingsPresentation.TopicToggleHelpText}" ToolTipService.ShowDuration="60000" shared:ModSettingsSearch.Exclude="True">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path Style="{StaticResource TopicChevron}" DataContext="{Binding SettingsPresentation.Market}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <TextBlock Grid.Column="1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Bold">
              <Run Text="{Binding SettingsPresentation.Market.Title}"/><Run Text=" "/><Run Text="{Binding SettingsPresentation.Market.CountText}" Foreground="#FFBBBBBB" FontSize="14" FontWeight="Normal"/>
            </TextBlock>
          </Grid>
        </Button>
        <StackPanel Visibility="{Binding SettingsPresentation.Market.ContentVisibility}" Margin="8,2,8,6" IsEnabled="{Binding CanEditHostSettings}" Opacity="{Binding HostSettingsOpacity}">
          <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.market-prices-also-ai" shared:ModSettingsSearch.Title="{Binding MarketPricesAlsoForAIText}" shared:ModSettingsSearch.ToolTipText="{Binding MarketPricesAlsoForAIHelpText}">
            <CheckBox IsChecked="{Binding MarketPricesAlsoForAI, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketPricesAlsoForAIHelpText}" Margin="0" MinHeight="28" VerticalAlignment="Center">
              <TextBlock Text="{Binding MarketPricesAlsoForAIText}" Foreground="White" TextWrapping="Wrap" />
            </CheckBox>
          </Grid>
          <StackPanel Visibility="{Binding SettingsPresentation.MarketGeneralOptions.Visibility}" Grid.IsSharedSizeScope="True">
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.market-buy-price-multiplier" shared:ModSettingsSearch.Title="{Binding MarketBuyPriceMultiplierText}" shared:ModSettingsSearch.ToolTipText="{Binding MarketBuyPriceMultiplierHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" MaxWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ScalarValue" MinWidth="90" MaxWidth="130" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding MarketBuyPriceMultiplierText}" Style="{StaticResource CompactSettingLabel}" Grid.Column="0" />
              <Slider Minimum="0" Maximum="5" Value="{Binding MarketBuyPriceMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketBuyPriceMultiplierHelpText}" MinHeight="28" VerticalAlignment="Center" Grid.Column="2" Width="160" />
              <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding MarketBuyPriceMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Left" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketBuyPriceMultiplierHelpText}" MinWidth="90" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Margin="0" MinHeight="28" VerticalAlignment="Center" Grid.Column="4" Width="Auto" />
            </Grid>
            <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.market-sell-price-multiplier" shared:ModSettingsSearch.Title="{Binding MarketSellPriceMultiplierText}" shared:ModSettingsSearch.ToolTipText="{Binding MarketSellPriceMultiplierHelpText}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" MaxWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ScalarValue" MinWidth="90" MaxWidth="130" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding MarketSellPriceMultiplierText}" Style="{StaticResource CompactSettingLabel}" Grid.Column="0" />
              <Slider Minimum="0" Maximum="5" Value="{Binding MarketSellPriceMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketSellPriceMultiplierHelpText}" MinHeight="28" VerticalAlignment="Center" Grid.Column="2" Width="160" />
              <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding MarketSellPriceMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Left" ToolTipService.ShowDuration="60000" ToolTip="{Binding MarketSellPriceMultiplierHelpText}" MinWidth="90" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" Margin="0" MinHeight="28" VerticalAlignment="Center" Grid.Column="4" Width="Auto" />
            </Grid>
          </StackPanel>
          <TextBlock Text="{Binding MarketGoodPriceMultipliersHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,8,14,6" />

          <ItemsControl ItemsSource="{Binding MarketGoodPriceItems}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="72" Height="116" Margin="2" Background="#33251D13" BorderBrush="#887B674B" BorderThickness="1" CornerRadius="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GoodToolTip}">
                  <Border.Visibility>
                    <MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}">
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)" />
                      <Binding Path="BuySearchKey" />
                      <Binding Path="BuySearchTitle" />
                      <Binding Path="BuyToolTip" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)" />
                      <Binding Path="SellSearchKey" />
                      <Binding Path="SellSearchTitle" />
                      <Binding Path="SellToolTip" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)" />
                      <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)" />
                    </MultiBinding>
                  </Border.Visibility>
                  <Grid Margin="3">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="27" />
                      <RowDefinition Height="17" />
                      <RowDefinition Height="23" />
                      <RowDefinition Height="17" />
                      <RowDefinition Height="23" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="{Binding Icon}" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="{Binding BuySearchKey}" shared:ModSettingsSearch.Title="{Binding BuySearchTitle}" shared:ModSettingsSearch.ToolTipText="{Binding BuyToolTip}" Margin="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="17" />
                        <RowDefinition Height="23" />
                      </Grid.RowDefinitions>
                      <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Text="{Binding BuyMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="#FF77AAFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding BuyToolTip}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" />
                      <Slider Grid.Row="1" Minimum="0" Maximum="5" Value="{Binding BuyMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="62" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding BuyToolTip}" />
                    </Grid>
                    <Grid Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="{Binding SellSearchKey}" shared:ModSettingsSearch.Title="{Binding SellSearchTitle}" shared:ModSettingsSearch.ToolTipText="{Binding SellToolTip}" Margin="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="17" />
                        <RowDefinition Height="23" />
                      </Grid.RowDefinitions>
                      <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Text="{Binding SellMultiplierValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="#FF66CC99" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding SellToolTip}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1" />
                      <Slider Grid.Row="1" Minimum="0" Maximum="5" Value="{Binding SellMultiplier, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="62" Margin="0" ToolTipService.ShowDuration="60000" ToolTip="{Binding SellToolTip}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Grid>
