<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=ExtraFeatures"
      shared:ModSettingsSearch.FilterText="{Binding System_ModSettingsSearchText}"
      shared:ModSettingsSearch.IncludeToolTips="{Binding System_ModSettingsSearchIncludeToolTips}"
      shared:ModSettingsSearch.ExactKey="{Binding System_ModSettingsSearchExactKey}">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{x:Static shared:ToolTipPresentation.FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <shared:ModSettingsSearchVisibilityConverter x:Key="ModSettingsSearchVisibilityConverter"/>
    <Style x:Key="ModSettingsSearchTargetGrid" TargetType="{x:Type Grid}">
      <Setter Property="Visibility">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}">
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Key)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.Title)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ToolTipText)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModSettingsSearchSectionGrid" TargetType="{x:Type Grid}">
      <Setter Property="Visibility">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource ModSettingsSearchVisibilityConverter}">
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.FilterText)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.IncludeToolTips)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.ExactKey)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionKey)"/>
            <Binding RelativeSource="{RelativeSource Self}" Path="(shared:ModSettingsSearch.SectionTitle)"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModSettingsSearchIcon" TargetType="{x:Type Path}">
      <Setter Property="Stroke" Value="#FF77AAFF"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding System_ModSettingsSearchHasActiveFilter}" Value="True">
          <Setter Property="Stroke" Value="#FFF2D48A"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <TextBlock Text="{Binding LegacyModWarningText}"
                 Visibility="{Binding LegacyModWarningVisibility}"
                 Foreground="#FF6666"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" shared:ModSettingsSearch.Exclude="True">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="145" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button Command="{Binding System_ToggleModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchToggleHelpText}" Width="30" Height="28" Padding="5" Margin="8,0,0,0">
          <Viewbox Width="16" Height="16"><Path Style="{StaticResource ModSettingsSearchIcon}" StrokeThickness="2" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16"/></Viewbox>
        </Button>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.Exclude="True" Visibility="{Binding System_ModSettingsSearchPanelVisibility}" HorizontalAlignment="Left" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{Binding System_ModSettingsSearchLabelText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox ui:KeyboardCaptureBinding.Enabled="True" Text="{Binding System_ModSettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" shared:ModSettingsSearch.FocusRequest="{Binding System_ModSettingsSearchFocusRequest}" Width="280" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchHelpText}" Foreground="White" Padding="5,2" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
          <CheckBox IsChecked="{Binding System_ModSettingsSearchIncludeToolTips, Mode=TwoWay}" Content="{Binding System_ModSettingsSearchIncludeToolTipsText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchIncludeToolTipsHelpText}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button Command="{Binding System_ClearModSettingsSearchCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding System_ModSettingsSearchClearHelpText}" Width="30" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0">
            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Stroke="#FFF2D48A" StrokeThickness="2" Data="M 1,1 L 9,9 M 9,1 L 1,9"/></Viewbox>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding System_ModSettingsSearchNoResultsText}" Visibility="{Binding System_ModSettingsSearchNoResultsVisibility}" Foreground="#FFCC66" HorizontalAlignment="Left" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">

      <StackPanel shared:ModSettingsSearch.SectionKey="extra.section.new-features" shared:ModSettingsSearch.SectionTitle="{Binding NewFeaturesTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding NewFeaturesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.lord-health" shared:ModSettingsSearch.Title="{Binding LordHealthTitleText}" shared:ModSettingsSearch.ToolTipText="{Binding LordHealthHelpText}">
        <StackPanel>
          <TextBlock Text="{Binding LordHealthTitleText}" Foreground="#DDDDDD" FontWeight="Bold" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,10" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/><ColumnDefinition Width="24"/><ColumnDefinition Width="120"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding HumanText}" Foreground="White" FontWeight="Bold"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding AiText}" Foreground="White" FontWeight="Bold"/>
            <Slider Grid.Row="1" Grid.Column="0" Minimum="10" Maximum="500" Value="{Binding HumanLordHealthPercent, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}"/>
            <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="1" Text="{Binding HumanLordHealthPercentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
            <Slider Grid.Row="1" Grid.Column="3" Minimum="10" Maximum="500" Value="{Binding AILordHealthPercent, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}"/>
            <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="4" Text="{Binding AILordHealthPercentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding LordHealthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
          </Grid>
        </StackPanel>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.monks-always-run" shared:ModSettingsSearch.Title="{Binding EnableMonksAlwaysRunText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableMonksAlwaysRunHelpText}">
        <CheckBox IsChecked="{Binding EnableMonksAlwaysRun, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableMonksAlwaysRunHelpText}" Margin="0,0,14,8">
          <TextBlock Text="{Binding EnableMonksAlwaysRunText}" Foreground="White" TextWrapping="Wrap"/>
        </CheckBox>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.knight-dismount" shared:ModSettingsSearch.Title="{Binding EnableKnightDismountText}" shared:ModSettingsSearch.ToolTipText="{Binding EnableKnightDismountHelpText}">
          <CheckBox IsChecked="{Binding EnableKnightDismount, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableKnightDismountHelpText}" Margin="0,0,14,0">
            <TextBlock Text="{Binding EnableKnightDismountText}" Foreground="White" TextWrapping="Wrap"/>
          </CheckBox>
        </Grid>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.instant-horse" shared:ModSettingsSearch.Title="{Binding InstantHorseText}" shared:ModSettingsSearch.ToolTipText="{Binding InstantHorseHelpText}">
          <CheckBox IsChecked="{Binding InstantHorse, Mode=TwoWay}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding InstantHorseHelpText}" Margin="0,0,14,0">
            <TextBlock Text="{Binding InstantHorseText}" Foreground="White" TextWrapping="Wrap"/>
          </CheckBox>
        </Grid>
      </StackPanel>
      </StackPanel>
      <Separator Background="#444466" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,10"/>
      <StackPanel shared:ModSettingsSearch.SectionKey="extra.section.gatehouses" shared:ModSettingsSearch.SectionTitle="{Binding GatehousesTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding GatehousesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
      <StackPanel>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.human-gate-reopen-delay" shared:ModSettingsSearch.Title="{Binding HumanGateReopenDelayText}" shared:ModSettingsSearch.ToolTipText="{Binding GateReopenDelayHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding HumanGateReopenDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding HumanGateReopenDelaySeconds, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding HumanGateReopenDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.ai-gate-reopen-delay" shared:ModSettingsSearch.Title="{Binding AIGateReopenDelayText}" shared:ModSettingsSearch.ToolTipText="{Binding GateReopenDelayHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding AIGateReopenDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding AIGateReopenDelaySeconds, Mode=TwoWay}" TickFrequency="2.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AIGateReopenDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateReopenDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.human-gate-closing-distance" shared:ModSettingsSearch.Title="{Binding HumanGateClosingDistanceText}" shared:ModSettingsSearch.ToolTipText="{Binding GateClosingDistanceHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding HumanGateClosingDistanceText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding HumanGateClosingDistanceTiles, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding HumanGateClosingDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>
        <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.ai-gate-closing-distance" shared:ModSettingsSearch.Title="{Binding AIGateClosingDistanceText}" shared:ModSettingsSearch.ToolTipText="{Binding GateClosingDistanceHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding AIGateClosingDistanceText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding AIGateClosingDistanceTiles, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AIGateClosingDistanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding GateClosingDistanceHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/></Grid>
      </StackPanel>
      <Separator Background="#444466" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,10"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="extra.section.enemy-proximity" shared:ModSettingsSearch.SectionTitle="{Binding EnemyProximityTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding EnemyProximityTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.human-enemy-proximity-singleplayer" shared:ModSettingsSearch.Title="{Binding HumanEnemyProximitySingleplayerText}" shared:ModSettingsSearch.ToolTipText="{Binding HumanEnemyProximityHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding HumanEnemyProximitySingleplayerText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding HumanEnemyProximitySingleplayer, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding HumanEnemyProximitySingleplayerValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.human-enemy-proximity-multiplayer" shared:ModSettingsSearch.Title="{Binding HumanEnemyProximityMultiplayerText}" shared:ModSettingsSearch.ToolTipText="{Binding HumanEnemyProximityHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding HumanEnemyProximityMultiplayerText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding HumanEnemyProximityMultiplayer, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding HumanEnemyProximityMultiplayerValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding HumanEnemyProximityHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.ai-enemy-proximity-singleplayer" shared:ModSettingsSearch.Title="{Binding AIEnemyProximitySingleplayerText}" shared:ModSettingsSearch.ToolTipText="{Binding AIEnemyProximityHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AIEnemyProximitySingleplayerText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding AIEnemyProximitySingleplayer, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AIEnemyProximitySingleplayerValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.ai-enemy-proximity-multiplayer" shared:ModSettingsSearch.Title="{Binding AIEnemyProximityMultiplayerText}" shared:ModSettingsSearch.ToolTipText="{Binding AIEnemyProximityHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AIEnemyProximityMultiplayerText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="100" Value="{Binding AIEnemyProximityMultiplayer, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AIEnemyProximityMultiplayerValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding AIEnemyProximityHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Style="{StaticResource ModSettingsSearchTargetGrid}" shared:ModSettingsSearch.Key="extra.ai-tower-gate-rebuild-delay" shared:ModSettingsSearch.Title="{Binding AITowerGateRebuildDelayText}" shared:ModSettingsSearch.ToolTipText="{Binding AITowerGateRebuildDelayHelpText}" Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AITowerGateRebuildDelayText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="-1" Maximum="300" Value="{Binding AITowerGateRebuildDelaySeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding AITowerGateRebuildDelayValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding AITowerGateRebuildDelayHelpText}" MinWidth="86" MaxWidth="130" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Separator Background="#444466" Visibility="{Binding System_ModSettingsSearchInactiveVisibility}" Margin="0,10"/>
      </StackPanel>
      <StackPanel shared:ModSettingsSearch.SectionKey="extra.section.buildings-production" shared:ModSettingsSearch.SectionTitle="{Binding BuildingsProductionTitleText}">
      <Grid Style="{StaticResource ModSettingsSearchSectionGrid}" shared:ModSettingsSearch.IsSection="True"><TextBlock Text="{Binding BuildingsProductionTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/></Grid>
