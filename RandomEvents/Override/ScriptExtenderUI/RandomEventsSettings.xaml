<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=RandomEvents">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{x:Static shared:ToolTipPresentation.FontSize}"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="{Binding ModEnabledText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource HostActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleHostSettings}" IsChecked="{Binding HostSettingsEnabled, Mode=TwoWay}" Content="{Binding HostActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding HostSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Border Style="{StaticResource ClientActivationBorder}" Margin="8,0,0,0">
          <CheckBox IsEnabled="{Binding CanToggleClientSettings}" IsChecked="{Binding ClientSettingsEnabled, Mode=TwoWay}" Content="{Binding ClientActivationLabelText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ClientSettingsActivationHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" Width="170" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">

      <TextBlock Text="{Binding ScheduleTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding IntervalHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding IntervalHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding IntervalText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="1" Maximum="90" Value="{Binding IntervalMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding IntervalHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding IntervalMonthsValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding IntervalHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding CooldownHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding CooldownText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding CooldownMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding CooldownHelpText}"/>
        <TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Column="2" Text="{Binding CooldownMonthsValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" ToolTip="{Binding CooldownHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>

      <Separator Background="#444466" Margin="0,8"/>
      <TextBlock Text="{Binding ChancesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding PositiveEventsTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,0,0,4"/>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FairText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FairChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding FairChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ArchersChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding ArchersChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MarriageText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarriageChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="2" Text="{Binding MarriageChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BardText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BardChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Grid.Column="2" Text="{Binding BardChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>

      <TextBlock Text="{Binding NegativeEventsTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,8,0,4"/>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PlagueChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="0" Grid.Column="2" Text="{Binding PlagueChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding WheatInfestationText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding WheatInfestationChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="2" Text="{Binding WheatInfestationChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding HopsBeetlesText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding HopsBeetlesChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="2" Text="{Binding HopsBeetlesChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AppleBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AppleBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Grid.Column="2" Text="{Binding AppleBlightChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding TreeBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TreeBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="4" Grid.Column="2" Text="{Binding TreeBlightChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding RabbitsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RabbitsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="5" Grid.Column="2" Text="{Binding RabbitsChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LionAttackChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="6" Grid.Column="2" Text="{Binding LionAttackChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BanditsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="7" Grid.Column="2" Text="{Binding BanditsChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding MadCowsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MadCowsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="8" Grid.Column="2" Text="{Binding MadCowsChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding GranaryTheftText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GranaryTheftChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="9" Grid.Column="2" Text="{Binding GranaryTheftChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding FireText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FireChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="10" Grid.Column="2" Text="{Binding FireChanceValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" HorizontalAlignment="Right" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding StrengthTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding ScaledStrengthHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="6"/><ColumnDefinition Width="125"/><ColumnDefinition Width="60"/><ColumnDefinition Width="125"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MinimumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding MaximumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><Slider Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding PlagueMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="3" Text="{Binding PlagueMinValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="1" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding PlagueMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="1" Grid.Column="5" Text="{Binding PlagueMaxValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><Slider Grid.Row="2" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding LionMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="3" Text="{Binding LionMinValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="2" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding LionMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="2" Grid.Column="5" Text="{Binding LionMaxValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="3" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding BanditMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Grid.Column="3" Text="{Binding BanditMinValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="3" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding BanditMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="3" Grid.Column="5" Text="{Binding BanditMaxValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="4" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding ArcherMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="4" Grid.Column="3" Text="{Binding ArcherMinValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/><Slider Grid.Row="4" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding ArcherMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBox ui:KeyboardCaptureBinding.Enabled="True" Grid.Row="4" Grid.Column="5" Text="{Binding ArcherMaxValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}" MinWidth="56" MaxWidth="120" Padding="4,1" TextAlignment="Center" Background="#CC1A1A1A" BorderBrush="#FFB08A4A" BorderThickness="1"/>
