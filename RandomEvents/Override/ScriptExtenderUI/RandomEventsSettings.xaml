<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:Shared;assembly=RandomEvents">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="20"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="{x:Static shared:ToolTipPresentation.AutomaticScrollBarVisibility}"
                HorizontalScrollBarVisibility="{x:Static shared:ToolTipPresentation.AutomaticScrollBarVisibility}">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Border Style="{StaticResource HostActivationBorder}"><CheckBox IsEnabled="{Binding CanEditHostSettings}" IsChecked="{Binding EnableMod, Mode=TwoWay}" Content="{Binding EnableModText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableModHelpText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/></Border>
        <TextBlock Text="{Binding PresetText}" Visibility="{Binding PresetVisibility}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"/>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" Width="170" VerticalAlignment="Center"/>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">

      <TextBlock Text="{Binding ScheduleTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding IntervalHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding IntervalHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding IntervalText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="1" Maximum="90" Value="{Binding IntervalMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding IntervalHelpText}"/>
        <TextBlock Grid.Column="2" Text="{Binding IntervalMonthsValueText}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,0,0,8" ToolTipService.ShowDuration="60000" ToolTip="{Binding CooldownHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding CooldownText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding CooldownMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3" ToolTipService.ShowDuration="60000" ToolTip="{Binding CooldownHelpText}"/>
        <TextBlock Grid.Column="2" Text="{Binding CooldownMonthsValueText}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <Separator Background="#444466" Margin="0,8"/>
      <TextBlock Text="{Binding ChancesTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding PositiveEventsTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,0,0,4"/>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FairText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FairChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FairChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ArchersChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ArchersChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MarriageText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarriageChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MarriageChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BardText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BardChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BardChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
      </Grid>

      <TextBlock Text="{Binding NegativeEventsTitleText}" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,8,0,4"/>
      <Grid ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PlagueChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PlagueChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding WheatInfestationText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding WheatInfestationChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WheatInfestationChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding HopsBeetlesText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding HopsBeetlesChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding HopsBeetlesChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AppleBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AppleBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding AppleBlightChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding TreeBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TreeBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TreeBlightChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding RabbitsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RabbitsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding RabbitsChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LionAttackChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LionAttackChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BanditsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding BanditsChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding MadCowsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MadCowsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding MadCowsChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding GranaryTheftText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GranaryTheftChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding GranaryTheftChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding FireText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FireChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ChanceHelpText}"/><TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding FireChanceValueText}" Foreground="White" HorizontalAlignment="Right"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding StrengthTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding ScaledStrengthHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="175"/><ColumnDefinition Width="85"/><ColumnDefinition Width="175"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MinimumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding MaximumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><Slider Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding PlagueMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PlagueMin}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><Slider Grid.Row="1" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding PlagueMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/><TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding PlagueMax}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding PlagueStrengthHelpText}"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><Slider Grid.Row="2" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding LionMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LionMinValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><Slider Grid.Row="2" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding LionMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/><TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding LionMaxValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding LionStrengthHelpText}"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="3" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding BanditMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding BanditMinValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="3" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding BanditMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding BanditMaxValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="4" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding ArcherMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding ArcherMinValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><Slider Grid.Row="4" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding ArcherMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/><TextBlock Grid.Row="4" Grid.Column="5" Text="{Binding ArcherMaxValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding ScaledStrengthHelpText}"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding GranaryTheftText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding TheftStrengthHelpText}"/><Slider Grid.Row="5" Grid.Column="2" Minimum="1" Maximum="100" Value="{Binding TheftMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding TheftStrengthHelpText}"/><TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding TheftMinValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding TheftStrengthHelpText}"/><Slider Grid.Row="5" Grid.Column="4" Minimum="1" Maximum="100" Value="{Binding TheftMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding TheftStrengthHelpText}"/><TextBlock Grid.Row="5" Grid.Column="5" Text="{Binding TheftMaxValueText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding TheftStrengthHelpText}"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding FireText}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding FireStrengthHelpText}"/><Slider Grid.Row="6" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding FireMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding FireStrengthHelpText}"/><TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding FireMin}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding FireStrengthHelpText}"/><Slider Grid.Row="6" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding FireMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTipService.ShowDuration="60000" ToolTip="{Binding FireStrengthHelpText}"/><TextBlock Grid.Row="6" Grid.Column="5" Text="{Binding FireMax}" Foreground="White" ToolTipService.ShowDuration="60000" ToolTip="{Binding FireStrengthHelpText}"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding MultiplayerTitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding MultiplayerModeText}" Foreground="White"/>
      <TextBlock Text="{Binding MultiplayerModeHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,2,0,5"/>
      <ComboBox ItemsSource="{Binding MultiplayerModeOptions}" SelectedIndex="{Binding MultiplayerEventModeIndex, Mode=TwoWay}" Width="260" HorizontalAlignment="Left" ToolTipService.ShowDuration="60000" ToolTip="{Binding MultiplayerModeHelpText}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
