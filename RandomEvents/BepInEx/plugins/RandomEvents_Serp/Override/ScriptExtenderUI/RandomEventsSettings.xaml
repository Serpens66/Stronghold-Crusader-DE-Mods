<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button IsEnabled="{Binding AreSettingsEditable}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Left" Padding="10,3"/>
        <CheckBox IsEnabled="{Binding AreSettingsEditable}" IsChecked="{Binding EnableMod, Mode=TwoWay}" Content="{Binding EnableModText}" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <ComboBox ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}" Width="170" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>
      <StackPanel IsEnabled="{Binding AreSettingsEditable}">

      <TextBlock Text="{Binding IntervalHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding IntervalText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="1" Maximum="90" Value="{Binding IntervalMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3"/>
        <TextBlock Grid.Column="2" Text="{Binding IntervalMonths}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,0,0,8" ToolTip="{Binding CooldownHelpText}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding CooldownText}" Foreground="White" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding CooldownMonths, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="3"/>
        <TextBlock Grid.Column="2" Text="{Binding CooldownMonths}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <Separator Background="#444466" Margin="0,8"/>
      <TextBlock Text="{Binding ChancesTitleText}" Foreground="#77AAFF" FontWeight="Bold" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FairText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FairChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FairChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PlagueChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PlagueChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding WheatInfestationText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding WheatInfestationChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WheatInfestationChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding HopsBeetlesText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding HopsBeetlesChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding HopsBeetlesChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AppleBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AppleBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding AppleBlightChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding TreeBlightText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TreeBlightChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding TreeBlightChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding RabbitsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RabbitsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding RabbitsChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LionAttackChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding LionAttackChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BanditsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding BanditsChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding MadCowsText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MadCowsChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding MadCowsChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ArchersChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding ArchersChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="11" Grid.Column="0" Text="{Binding MarriageText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="11" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarriageChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="11" Grid.Column="2" Text="{Binding MarriageChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding BardText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="12" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BardChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="12" Grid.Column="2" Text="{Binding BardChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="13" Grid.Column="0" Text="{Binding GranaryTheftText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="13" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GranaryTheftChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="13" Grid.Column="2" Text="{Binding GranaryTheftChance}" Foreground="White" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding FireText}" Foreground="White" VerticalAlignment="Center"/><Slider Grid.Row="14" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FireChance, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="14" Grid.Column="2" Text="{Binding FireChance}" Foreground="White" HorizontalAlignment="Right"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding StrengthTitleText}" Foreground="#77AAFF" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding ScaledStrengthHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="190"/><ColumnDefinition Width="35"/><ColumnDefinition Width="190"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MinimumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding MaximumText}" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlagueText}" Foreground="White"/><Slider Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding PlagueMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PlagueMin}" Foreground="White"/><Slider Grid.Row="1" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding PlagueMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding PlagueMax}" Foreground="White"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LionAttackText}" Foreground="White"/><Slider Grid.Row="2" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding LionMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LionMin}" Foreground="White"/><Slider Grid.Row="2" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding LionMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding LionMax}" Foreground="White"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BanditsText}" Foreground="White"/><Slider Grid.Row="3" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding BanditMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding BanditMin}" Foreground="White"/><Slider Grid.Row="3" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding BanditMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding BanditMax}" Foreground="White"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ArchersText}" Foreground="White"/><Slider Grid.Row="4" Grid.Column="2" Minimum="0.1" Maximum="5" Value="{Binding ArcherMin, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding ArcherMin}" Foreground="White"/><Slider Grid.Row="4" Grid.Column="4" Minimum="0.1" Maximum="5" Value="{Binding ArcherMax, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="4" Grid.Column="5" Text="{Binding ArcherMax}" Foreground="White"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding GranaryTheftText}" Foreground="White"/><Slider Grid.Row="5" Grid.Column="2" Minimum="1" Maximum="100" Value="{Binding TheftMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding TheftMin}" Foreground="White"/><Slider Grid.Row="5" Grid.Column="4" Minimum="1" Maximum="100" Value="{Binding TheftMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="5" Grid.Column="5" Text="{Binding TheftMax}" Foreground="White"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding FireText}" Foreground="White"/><Slider Grid.Row="6" Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding FireMin, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding FireMin}" Foreground="White"/><Slider Grid.Row="6" Grid.Column="4" Minimum="1" Maximum="10" Value="{Binding FireMax, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="6" Grid.Column="5" Text="{Binding FireMax}" Foreground="White"/>
      </Grid>

      <Separator Background="#444466" Margin="0,10"/>
      <TextBlock Text="{Binding MultiplayerModeText}" Foreground="White"/>
      <TextBlock Text="{Binding MultiplayerModeHelpText}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,2,0,5"/>
      <ComboBox ItemsSource="{Binding MultiplayerModeOptions}" SelectedIndex="{Binding MultiplayerEventModeIndex, Mode=TwoWay}" Width="260" HorizontalAlignment="Left"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
