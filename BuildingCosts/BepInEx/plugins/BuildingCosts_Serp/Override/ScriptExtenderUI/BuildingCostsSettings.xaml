<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE"
      xmlns:shared="clr-namespace:Shared;assembly=BuildingCosts">
  <Grid.Resources>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="20"/><Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,7" MaxWidth="{x:Static shared:ToolTipPresentation.MaximumWidth}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="HostRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#332F5F9F"/><Setter Property="Foreground" Value="#77AAFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="ClientRoleHeader" TargetType="{x:Type TextBlock}"><Setter Property="Background" Value="#33306950"/><Setter Property="Foreground" Value="#66CC99"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="HostActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#443B6EA5"/><Setter Property="BorderBrush" Value="#FF77AAFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="ClientActivationBorder" TargetType="{x:Type Border}"><Setter Property="Background" Value="#44306950"/><Setter Property="BorderBrush" Value="#FF66CC99"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="{x:Static shared:ToolTipPresentation.AutomaticScrollBarVisibility}"
                HorizontalScrollBarVisibility="{x:Static shared:ToolTipPresentation.AutomaticScrollBarVisibility}">
    <StackPanel Margin="10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Border Style="{StaticResource HostActivationBorder}"><CheckBox IsEnabled="{Binding CanEditHostSettings}"
                  IsChecked="{Binding EnableMod, Mode=TwoWay}"
                  Content="{Binding EnableModText}" ToolTipService.ShowDuration="60000" ToolTip="{Binding EnableModHelpText}"
                  Foreground="White"
                  FontWeight="Bold"
                  VerticalAlignment="Center"/></Border>
        <TextBlock Text="{Binding PresetText}" Visibility="{Binding PresetVisibility}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"/>
        <ComboBox IsEnabled="{Binding CanChangePreset}" Visibility="{Binding PresetVisibility}" ItemsSource="{Binding PresetOptions}" ToolTipService.ShowDuration="60000" ToolTip="{Binding PresetHelpText}"
                  SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"
                  Width="170"
                  VerticalAlignment="Center"/>
        <Button IsEnabled="{Binding CanResetSettings}" Content="{Binding ResetToDefaultText}" Command="{Binding ResetToDefaultCommand}" ToolTipService.ShowDuration="60000" ToolTip="{Binding ResetToDefaultHelpText}" HorizontalAlignment="Left" Padding="10,3" Margin="14,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ActionsScopeNoticeText}" Visibility="{Binding ActionsScopeNoticeVisibility}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostReadOnlyNoticeText}" Visibility="{Binding HostReadOnlyNoticeVisibility}" Foreground="#FFCC66" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HostOptionsText}" Style="{StaticResource HostRoleHeader}" Margin="0,2,0,6"/>
      <StackPanel IsEnabled="{Binding CanEditHostSettings}">
      <TextBlock Text="{Binding TitleText}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding HelpText}"
                 Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <Grid Margin="0,2,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding BuildingHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="1" Margin="3,0">
          <Image Source="{Binding WoodHeaderIcon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,1"/>
          <TextBlock Text="{Binding WoodHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" TextAlignment="Right"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="3,0">
          <Image Source="{Binding StoneHeaderIcon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,1"/>
          <TextBlock Text="{Binding StoneHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" TextAlignment="Right"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="3,0">
          <Image Source="{Binding IronHeaderIcon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,1"/>
          <TextBlock Text="{Binding IronHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" TextAlignment="Right"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Margin="3,0">
          <Image Source="{Binding PitchHeaderIcon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,1"/>
          <TextBlock Text="{Binding PitchHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" TextAlignment="Right"/>
        </StackPanel>
        <StackPanel Grid.Column="5" Margin="3,0">
          <Image Source="{Binding GoldHeaderIcon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,0,1"/>
          <TextBlock Text="{Binding GoldHeaderText}" Foreground="#CCCCCC" FontWeight="Bold" TextAlignment="Right"/>
        </StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding CostEntries}" Margin="0,3,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="78"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          ToolTipService.ShowDuration="60000" ToolTip="{Binding BuildingToolTip}"
                          VerticalAlignment="Center"
                          Margin="0,2,8,2">
                <Image Source="{Binding IconImage}"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <TextBox Grid.Column="1"
                       Text="{Binding WoodText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                       ToolTipService.ShowDuration="60000" ToolTip="{Binding WoodToolTip}"
                       MaxLength="4"
                       HorizontalContentAlignment="Right"
                       Margin="3"
                       ui:KeyboardCaptureBinding.Enabled="True"/>
              <TextBox Grid.Column="2"
                       Text="{Binding StoneText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                       ToolTipService.ShowDuration="60000" ToolTip="{Binding StoneToolTip}"
                       MaxLength="4"
                       HorizontalContentAlignment="Right"
                       Margin="3"
                       ui:KeyboardCaptureBinding.Enabled="True"/>
              <TextBox Grid.Column="3"
                       Text="{Binding IronText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                       ToolTipService.ShowDuration="60000" ToolTip="{Binding IronToolTip}"
                       MaxLength="4"
                       HorizontalContentAlignment="Right"
                       Margin="3"
                       ui:KeyboardCaptureBinding.Enabled="True"/>
              <TextBox Grid.Column="4"
                       Text="{Binding PitchText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                       ToolTipService.ShowDuration="60000" ToolTip="{Binding PitchToolTip}"
                       MaxLength="4"
                       HorizontalContentAlignment="Right"
                       Margin="3"
                       ui:KeyboardCaptureBinding.Enabled="True"/>
              <TextBox Grid.Column="5"
                       Text="{Binding GoldText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                       ToolTipService.ShowDuration="60000" ToolTip="{Binding GoldToolTip}"
                       MaxLength="4"
                       HorizontalContentAlignment="Right"
                       Margin="3"
                       ui:KeyboardCaptureBinding.Enabled="True"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
