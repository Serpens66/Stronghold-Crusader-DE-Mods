<?xml version="1.0" encoding="utf-8"?>
<Patch xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
       xmlns:pathfindingApi="clr-namespace:APIShared.ModSettings;assembly=APIShared"
       xmlns:local="clr-namespace:CrusaderDE"
       xmlns:pathfinding="clr-namespace:Pathfinding;assembly=Pathfinding">
  <Operation Type="AddNamespace" AttributeName="pathfindingApi" Value="clr-namespace:APIShared.ModSettings;assembly=APIShared" />
  <Operation Type="AddNamespace"
             AttributeName="pathfinding"
             Value="clr-namespace:Pathfinding;assembly=Pathfinding" />
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content>
      <Style x:Key="PathfindingAssassinActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BTN_Image}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Visibility="{TemplateBinding local:PropEx.ButtonVisibility}" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                <Border x:Name="HitBox" Background="Transparent"/>
                <Image x:Name="SpriteInactive" RenderTransformOrigin="0,0" FlowDirection="{TemplateBinding local:PropEx.ImageFlow}" Source="{TemplateBinding local:PropEx.Sprite1}" IsHitTestVisible="False"/>
                <Image x:Name="SpriteMouseOver" RenderTransformOrigin="0,0" FlowDirection="{TemplateBinding local:PropEx.ImageFlow}" Source="{TemplateBinding local:PropEx.Sprite2}" IsHitTestVisible="False" Visibility="Hidden"/>
                <Image x:Name="SpriteMousePressed" RenderTransformOrigin="0,0" FlowDirection="{TemplateBinding local:PropEx.ImageFlow}" Source="{TemplateBinding local:PropEx.Sprite3}" IsHitTestVisible="False" Visibility="Hidden"/>
                <Image x:Name="SpriteLocked" Opacity="{TemplateBinding local:PropEx.ImageButtonDisabledOpacity}" RenderTransformOrigin="0,0" FlowDirection="{TemplateBinding local:PropEx.ImageFlow}" Source="{TemplateBinding local:PropEx.Sprite4}" IsHitTestVisible="False" Visibility="Hidden"/>
                <Border Width="4" Height="43" Background="#FFE02020" BorderBrush="#FF5A0000" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding ForbiddenMarkVisibility}" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><RotateTransform Angle="-45"/></Border.RenderTransform>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden"/>
                  <Setter TargetName="SpriteLocked" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="HitBox" Property="IsHitTestVisible" Value="False"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Content>
  </Operation>
<Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconVanilla"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="3"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="9"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="4" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="10" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="16" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="22" Canvas.Top="15"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="27"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconBlock"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="21"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconLine"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="2" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="26" Canvas.Top="14"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconColumn"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="2"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="8"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="20"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="26"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconWedge"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="4"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="12"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="12"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="12"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="2" Canvas.Top="20"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="8" Canvas.Top="20"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="20"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="20" Canvas.Top="20"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="26" Canvas.Top="20"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:UserControl.Resources">
    <Content><DataTemplate x:Key="BugfixesFormationIconCircle"><Canvas Width="32" Height="32" IsHitTestVisible="False"><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="3"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="7"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="3" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="10" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="18" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="25" Canvas.Top="14"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="7" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="21" Canvas.Top="21"/><Ellipse Width="4" Height="4" Fill="#FFF1E2B7" Canvas.Left="14" Canvas.Top="25"/></Canvas></DataTemplate></Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[@x:Name='LayoutRoot']">
    <Content>
      <Grid x:Name="PathfindingFormationMenuHost" Width="520" Height="178" Margin="-1000,-1000,80,150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="100" Visibility="{Binding MenuVisible, Converter={StaticResource booleanToVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid.Resources>
          <Style x:Key="ModSettingsToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#FF1D1710"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{x:Static pathfindingApi:ToolTipPresentation.AutomaticFontSize}"/>
            <Setter Property="MaxWidth" Value="{x:Static pathfindingApi:ToolTipPresentation.AutomaticMaximumWidth}"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="BorderThickness" Value="4.5"/>
            <Setter Property="BorderBrush" Value="#FFF2D48A"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" MaxWidth="{TemplateBinding MaxWidth}">
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/>
              </Border>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </Grid.Resources>
        <Border Background="#CC17130E" BorderBrush="#AA806B45" BorderThickness="1" CornerRadius="12" Padding="10,8">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#66000000" CornerRadius="6"/><Border Grid.Row="2" Background="#66000000" CornerRadius="6"/>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="#FFF1E2B7" FontSize="15" Text="{Binding LineupText}" TextWrapping="Wrap"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding VanillaBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Vanilla">
                  <ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconVanilla}"/>
                  <b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Vanilla"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers>
                </Button>
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding BlockBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Block">
                  <ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconBlock}"/>
                  <b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Block"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers>
                </Button>
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding LineBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Line"><ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconLine}"/><b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Line"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers></Button>
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding ColumnBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Column"><ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconColumn}"/><b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Column"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers></Button>
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding WedgeBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Wedge"><ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconWedge}"/><b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Wedge"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers></Button>
                <Button Width="40" Height="40" Margin="2" Padding="0" Background="{Binding CircleBackground}" Command="{Binding SelectFormationCommand}" CommandParameter="Circle"><ContentControl Content="Formation" Width="32" Height="32" IsHitTestVisible="False" ContentTemplate="{StaticResource BugfixesFormationIconCircle}"/><b:Interaction.Triggers><b:EventTrigger EventName="MouseEnter"><b:InvokeCommandAction Command="{Binding ShowRolloverCommand}" CommandParameter="Circle"/></b:EventTrigger><b:EventTrigger EventName="MouseLeave"><b:InvokeCommandAction Command="{Binding HideRolloverCommand}"/></b:EventTrigger></b:Interaction.Triggers></Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="#FFF1E2B7" FontSize="15" Text="{Binding DensityText}" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="72" Height="28" Margin="2" Content="{Binding TightText}" FontSize="12" Background="{Binding TightBackground}" Command="{Binding SelectDensityCommand}" CommandParameter="1"/><Button Width="76" Height="28" Margin="2" Content="{Binding NormalText}" FontSize="12" Background="{Binding NormalBackground}" Command="{Binding SelectDensityCommand}" CommandParameter="2"/><Button Width="68" Height="28" Margin="2" Content="{Binding FarText}" FontSize="12" Background="{Binding FarBackground}" Command="{Binding SelectDensityCommand}" CommandParameter="3"/><Button Width="88" Height="28" Margin="2" Content="{Binding VeryFarText}" FontSize="12" Background="{Binding VeryFarBackground}" Command="{Binding SelectDensityCommand}" CommandParameter="4"/></StackPanel></Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="#FFF1E2B7" FontSize="15" Text="{Binding RangedSiegeText}" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="76" Height="28" Margin="2" Content="{Binding OffText}" FontSize="12" Background="{Binding PlacementOffBackground}" Command="{Binding SelectPlacementCommand}" CommandParameter="Off"/><Button Width="76" Height="28" Margin="2" Content="{Binding RearText}" FontSize="12" Background="{Binding PlacementRearBackground}" Command="{Binding SelectPlacementCommand}" CommandParameter="Rear"/><Button Width="86" Height="28" Margin="2" Content="{Binding CenterText}" FontSize="12" Background="{Binding PlacementCenterBackground}" Command="{Binding SelectPlacementCommand}" CommandParameter="Center"/></StackPanel></Grid>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="8,0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock VerticalAlignment="Center" Foreground="#FFF1E2B7" FontSize="15" Text="{Binding RoleMarkersText}" TextWrapping="Wrap" MaxWidth="120"/><Ellipse x:Name="PathfindingFormationRoleMarkerFront" Width="8" Height="8" Margin="8,0,0,0" Fill="#FFE63726" Stroke="#FF0A0A0A" StrokeThickness="1"/><Ellipse x:Name="PathfindingFormationRoleMarkerProtected" Width="8" Height="8" Margin="3,0,0,0" Fill="#FF26D959" Stroke="#FF0A0A0A" StrokeThickness="1"/><Ellipse x:Name="PathfindingFormationRoleMarkerRear" Width="8" Height="8" Margin="3,0,0,0" Fill="#FF338CFF" Stroke="#FF0A0A0A" StrokeThickness="1"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="64" Height="28" Margin="2" Content="{Binding OnText}" FontSize="12" Background="{Binding RoleMarkersOnBackground}" Command="{Binding SelectRoleMarkersCommand}" CommandParameter="True"/><Button Width="64" Height="28" Margin="2" Content="{Binding OffText}" FontSize="12" Background="{Binding RoleMarkersOffBackground}" Command="{Binding SelectRoleMarkersCommand}" CommandParameter="False"/><CheckBox Width="166" Height="28" Foreground="#FFF1E2B7" FlowDirection="{Binding GlobalTextFlowAL2R, Source={x:Static local:MainViewModel.Instance}}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Content="{Binding RememberRowsText}" IsChecked="{Binding RememberAspectRatio, Mode=TwoWay}" ToolTipService.ShowDuration="60000" Style="{StaticResource CheckBox_Template}"><CheckBox.ToolTip><ToolTip Style="{StaticResource ModSettingsToolTipStyle}" pathfindingApi:SharedToolTipSizing.Enabled="True" Content="{Binding RememberRowsHelp}"/></CheckBox.ToolTip></CheckBox></StackPanel></Grid>
          </Grid>
        </Border>
      </Grid>
    </Content>
  </Operation>
  <Operation Type="Add" XPath="//n:Grid[@x:Name='LayoutRoot']">
    <Content>
      <TextBlock x:Name="PathfindingFormationRolloverHost" Padding="4,2,4,0" Margin="140,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="101" FontSize="16" Foreground="#FFDDDDDD" Background="#55000000" IsHitTestVisible="False" Tag="Ignore" Text="{Binding RolloverText}" Visibility="{Binding RolloverVisible, Converter={StaticResource booleanToVisibilityConverter}, FallbackValue=Collapsed}"><TextBlock.Effect><DropShadowEffect ShadowDepth="2" Direction="315" Color="#CC000000" BlurRadius="0"/></TextBlock.Effect></TextBlock>
    </Content>
  </Operation>
</Patch>
