<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsTestProject Condition="'$(MSBuildProjectName)' != 'APISharedPresetConsumerTests'">true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'APISharedPresetConsumerTests'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
</Project>
