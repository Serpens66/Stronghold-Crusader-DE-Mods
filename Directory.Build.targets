<Project>
  <!-- Explicit MSBuild global properties take precedence; otherwise inherit the driver's SDK selection. -->
  <PropertyGroup>
    <ModWorkspaceRoot>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileFullPath)'))</ModWorkspaceRoot>
    <WorkspaceApiSharedRoot>$(MSBuildThisFileDirectory)APIShared</WorkspaceApiSharedRoot>
    <ApiSharedDir Condition="'$(SHCDE_API_SHARED_DIR)' != ''">$(SHCDE_API_SHARED_DIR)</ApiSharedDir>
    <ApiSharedDir Condition="'$(SHCDE_API_SHARED_DIR)' == ''">$(WorkspaceApiSharedRoot)\BepInEx\plugins\APIShared_Serp</ApiSharedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Update="APIShared"><HintPath>$(ApiSharedDir)\APIShared.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="ValidateWorkspaceApiSharedPackage" BeforeTargets="ResolveAssemblyReferences" Condition="'@(Reference->WithMetadataValue('Identity', 'APIShared'))' != ''">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Shared\Tools\ApiSharedRepository\Test-ConsumerPackage.ps1&quot; -Workspace &quot;$(ModWorkspaceRoot)&quot; -PackageDirectory &quot;$(ApiSharedDir)&quot;" />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)Shared/Tools/Paths/Paths.targets" />
</Project>
