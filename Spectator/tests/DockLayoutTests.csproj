<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion><OutputType>Exe</OutputType><AssemblyName>DockLayoutTests</AssemblyName><LangVersion>latest</LangVersion></PropertyGroup>
  <!-- External Extender checkout; Test-DockLayout.ps1 passes it explicitly (also from Git worktrees). -->
  <PropertyGroup><ScriptExtenderSourceRoot Condition="'$(ScriptExtenderSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\shcde-script-extender</ScriptExtenderSourceRoot>
    <XamlPatcherSource>$(ScriptExtenderSourceRoot)\src\SHCDESE.BepInEx\API\Components\Noesis\XAML</XamlPatcherSource></PropertyGroup>
  <ItemGroup><Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Xml"/><Reference Include="System.Xml.Linq"/>
    <Compile Include="DockLayoutTests.cs"/><Compile Include="..\src\ToolbarLayout.cs"/>
    <Compile Include="$(XamlPatcherSource)\XamlPatcher.cs"/>
    <Compile Include="$(XamlPatcherSource)\XmlPatchOperation.cs"/>
    <Compile Include="$(XamlPatcherSource)\XmlPatchType.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
  <Target Name="ValidateScriptExtenderSource" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(XamlPatcherSource)\XamlPatcher.cs')" Text="Script Extender XAML patcher sources not found below '$(ScriptExtenderSourceRoot)'. Set ScriptExtenderSourceRoot." />
  </Target>
</Project>
